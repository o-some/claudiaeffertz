<section class="ch-section ch-hero" id="ChHero-{{ section.id }}" style="--ch-bg:{{ section.settings.background }};--ch-color:{{ section.settings.text_color }};--ch-button-bg:{{ section.settings.button_background }};--ch-button-text:{{ section.settings.button_text }};--ch-radius:{{ settings.ch_radius | default: 22 }}px">
  <div class="ch-shell ch-hero__grid">
    <div>
      {% if section.settings.eyebrow != blank %}<p>{{ section.settings.eyebrow | escape }}</p>{% endif %}
      <h1>{{ section.settings.heading }}</h1>
      <div class="rte">{{ section.settings.text }}</div>
      {% if section.settings.primary_label != blank and section.settings.primary_link != blank %}<a class="ch-button" href="{{ section.settings.primary_link }}">{{ section.settings.primary_label | escape }}</a>{% endif %}
    </div>
    {% if section.settings.image != blank %}
      <div class="ch-hero__media">{{ section.settings.image | image_url: width: 1600 | image_tag: widths: '480, 720, 960, 1280, 1600', sizes: '(min-width: 750px) 50vw, 100vw', loading: 'eager', fetchpriority: 'high', alt: section.settings.image_alt }}</div>
    {% elsif section.settings.generated_image_asset != blank %}
      <div class="ch-hero__media"><img src="{{ section.settings.generated_image_asset | asset_url }}" width="1600" height="1000" loading="eager" fetchpriority="high" alt="{{ section.settings.image_alt | escape }}"></div>
    {% endif %}
  </div>
</section>

{% style %}
  #shopify-section-{{ section.id }} {
    margin-block-start: {{ section.settings.section_gap_top | default: 0 }}px;
    margin-block-end: {{ section.settings.section_gap_bottom | default: 0 }}px;
  }
{% endstyle %}

{% schema %}
{
  "name": "Chelonaki – Hero",
  "tag": "section",
  "class": "ch-hero-section",
  "settings": [
    {"type":"header","content":"Abstand zum nächsten Abschnitt"},
    {"type":"range","id":"section_gap_top","label":"Zusätzlicher Abstand oben","min":0,"max":200,"step":4,"unit":"px","default":0},
    {"type":"range","id":"section_gap_bottom","label":"Zusätzlicher Abstand unten","min":0,"max":200,"step":4,"unit":"px","default":0},
    { "type": "text", "id": "eyebrow", "label": "Kleine Überschrift", "default": "Willkommen" },
    { "type": "inline_richtext", "id": "heading", "label": "Überschrift", "default": "Eine Marke mit klarer Haltung." },
    { "type": "richtext", "id": "text", "label": "Text", "default": "<p>Beschreibe hier kurz, was deine Marke besonders macht.</p>" },
    { "type": "image_picker", "id": "image", "label": "Bild" },
    { "type": "text", "id": "generated_image_asset", "label": "Generiertes Bild-Asset", "info": "Wird vom Chelonaki-Generator gesetzt." },
    { "type": "text", "id": "image_alt", "label": "Alternativtext" },
    { "type": "text", "id": "primary_label", "label": "Button-Text", "default": "Shop entdecken" },
    { "type": "url", "id": "primary_link", "label": "Button-Link" },
    { "type": "color", "id": "background", "label": "Hintergrund", "default": "#FBF8F0" },
    { "type": "color", "id": "text_color", "label": "Text", "default": "#22312A" },
    { "type": "color", "id": "button_background", "label": "Button", "default": "#1F3A2A" },
    { "type": "color", "id": "button_text", "label": "Button-Text", "default": "#FFFFFF" }
  ],
  "presets": [{ "name": "Chelonaki – Hero" }]
}
{% endschema %}
