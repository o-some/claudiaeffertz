{% comment %} Chelonaki Shop Theme · © Chelonaki · Build: CHELONAKI-BUILD-0000-MASTER · Nutzung nur mit gültiger Lizenz {% endcomment %}

<section data-mgu-effect="{{ section.settings.effect | default: 'up' }}" data-mgu-speed="{{ section.settings.effect_speed | default: 'normal' }}" class="mgu mgu-kurse mgu-block" id="mgu-kurse-{{ section.id }}">
  <div class="mgu-wrap">
    <div class="mgu-sec-head mgu-reveal">
      {%- if section.settings.eyebrow != blank -%}
        <span class="mgu-eyebrow">{{ section.settings.eyebrow }}</span>
      {%- endif -%}
      <h2>{{ section.settings.heading }}</h2>
    </div>
    <div class="mgu-kurse-banner mgu-reveal">
      {%- if section.settings.image != blank -%}
        <img width="{{ section.settings.image.width }}" height="{{ section.settings.image.height }}" src="{{ section.settings.image | image_url: width: 1800 }}"
             alt="{{ section.settings.image.alt | escape }}"
             loading="lazy">
      {%- endif -%}
      <div class="mgu-kurse-inner">
        {%- if section.settings.badge != blank -%}
          <span class="mgu-badge-soon">{{ section.settings.badge }}</span>
        {%- endif -%}
        <h3>{{ section.settings.subheading }}</h3>
        {%- if section.settings.text != blank -%}
          <p>{{ section.settings.text }}</p>
        {%- endif -%}

        {%- if section.settings.show_form -%}
          {%- assign course_form_id = 'MguCourseForm-' | append: section.id -%}
          {%- form 'customer', id: course_form_id, class: 'mgu-kurse-form' -%}
            <input type="hidden" name="contact[tags]" value="newsletter,videokurse">
            {%- if form.posted_successfully? -%}
              <p class="mgu-form-success" role="status" tabindex="-1">{{ section.settings.success_text }}</p>
            {%- else -%}
              <label class="visually-hidden" for="MguCourseEmail-{{ section.id }}">E-Mail-Adresse</label>
              <input id="MguCourseEmail-{{ section.id }}" type="email"
                     name="contact[email]"
                     required
                     placeholder="{{ section.settings.placeholder | escape }}"
                     {% if form.errors %}aria-invalid="true" aria-describedby="MguCourseErrors-{{ section.id }}"{% endif %}
                     autocomplete="email">
              <button class="mgu-btn mgu-btn--gold" type="submit">{{ section.settings.button_label }}</button>
              {%- if form.errors -%}
                <p class="mgu-form-error" id="MguCourseErrors-{{ section.id }}" role="alert">Bitte gib eine gültige E-Mail-Adresse ein.</p>
              {%- endif -%}
            {%- endif -%}
          {%- endform -%}
        {%- endif -%}
      </div>
    </div>
  </div>
</section>

{% style %}
  #shopify-section-{{ section.id }} {
    margin-block-start: {{ section.settings.section_gap_top | default: 0 }}px;
    margin-block-end: {{ section.settings.section_gap_bottom | default: 0 }}px;
  }
{% endstyle %}

{% schema %}
{
  "name": "Chelonaki – Videokurse",
  "tag": "div",
  "settings": [
    {"type":"header","content":"Abstand zum nächsten Abschnitt"},
    {"type":"range","id":"section_gap_top","label":"Zusätzlicher Abstand oben","min":0,"max":200,"step":4,"unit":"px","default":0},
    {"type":"range","id":"section_gap_bottom","label":"Zusätzlicher Abstand unten","min":0,"max":200,"step":4,"unit":"px","default":0},
    {
      "type": "header",
      "content": "Scroll-Effekt"
    },
    {
      "type": "select",
      "id": "effect",
      "label": "Erscheinen beim Scrollen",
      "default": "up",
      "options": [
        {
          "value": "none",
          "label": "Kein Effekt"
        },
        {
          "value": "fade",
          "label": "Einblenden"
        },
        {
          "value": "up",
          "label": "Von unten (Standard)"
        },
        {
          "value": "left",
          "label": "Von links"
        },
        {
          "value": "right",
          "label": "Von rechts"
        },
        {
          "value": "zoom",
          "label": "Sanfter Zoom"
        },
        {
          "value": "blur",
          "label": "Aus der Unschärfe"
        }
      ]
    },
    {
      "type": "select",
      "id": "effect_speed",
      "label": "Effekt-Tempo",
      "default": "normal",
      "options": [
        {
          "value": "schnell",
          "label": "Schnell"
        },
        {
          "value": "normal",
          "label": "Normal"
        },
        {
          "value": "langsam",
          "label": "Langsam"
        }
      ]
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Kicker-Zeile",
      "default": "Demnächst"
    },
    {
      "type": "inline_richtext",
      "id": "heading",
      "label": "Überschrift (kursiv = <em>)",
      "default": "Bald verfügbar – <em>sei dabei.</em>"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Hintergrundbild"
    },
    {
      "type": "text",
      "id": "badge",
      "label": "Badge-Text",
      "default": "Bald verfügbar"
    },
    {
      "type": "inline_richtext",
      "id": "subheading",
      "label": "Banner-Überschrift (kursiv = <em>)",
      "default": "Das Nächste kommt – <em>trag dich ein.</em>"
    },
    {
      "type": "textarea",
      "id": "text",
      "label": "Text",
      "default": "Kündige hier dein kommendes Produkt an und sammle Interessenten per E-Mail ein."
    },
    {
      "type": "header",
      "content": "Newsletter-Formular"
    },
    {
      "type": "checkbox",
      "id": "show_form",
      "label": "E-Mail-Formular anzeigen",
      "default": true,
      "info": "Trägt Interessenten als Kunden mit Newsletter-Tag in Shopify ein."
    },
    {
      "type": "text",
      "id": "placeholder",
      "label": "Platzhalter im Eingabefeld",
      "default": "Deine E-Mail-Adresse"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button-Beschriftung",
      "default": "Benachrichtigen"
    },
    {
      "type": "text",
      "id": "success_text",
      "label": "Erfolgsmeldung",
      "default": "Danke! Wir melden uns zum Start."
    }
  ],
  "presets": [
    {
      "name": "Chelonaki – Videokurse"
    }
  ]
}
{% endschema %}
