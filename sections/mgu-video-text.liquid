{% comment %} Chelonaki Shop Theme · © Chelonaki · Build: CHELONAKI-BUILD-0000-MASTER · Nutzung nur mit gültiger Lizenz {% endcomment %}
<style>
  .mgu-vt{display:grid;grid-template-columns:1fr 1fr;gap:clamp(28px,5vw,64px);align-items:center}
  .mgu-vt.mgu-vt--links{direction:rtl}.mgu-vt.mgu-vt--links>*{direction:ltr}
  @media(max-width:820px){.mgu-vt{grid-template-columns:1fr}}
  .mgu-vt-media{position:relative;border-radius:20px;overflow:hidden;aspect-ratio:16/9;background:var(--mgu-forest-deep)}
  .mgu-vt-media iframe,.mgu-vt-media video{position:absolute;inset:0;width:100%;height:100%;border:0}
  .mgu-vt-consent{position:absolute;inset:0;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:12px;text-align:center;padding:24px;color:#FCF9F1;cursor:pointer;background:linear-gradient(rgba(20,37,25,.6),rgba(20,37,25,.75))}
  .mgu-vt-consent p{margin:0;font-size:13.5px;max-width:340px;opacity:.9}
  .mgu-vt-play{width:64px;height:64px;border-radius:50%;background:var(--mgu-gold);color:var(--mgu-forest-deep);display:flex;align-items:center;justify-content:center;font-size:24px}
</style>
<section data-mgu-effect="{{ section.settings.effect | default: 'up' }}" data-mgu-speed="{{ section.settings.effect_speed | default: 'normal' }}" class="mgu mgu-block" style="background:{{ section.settings.bg }}">
  <div class="mgu-wrap">
    <div class="mgu-vt {% if section.settings.medien_seite == 'links' %}mgu-vt--links{% endif %}">
      <div class="mgu-vt-media mgu-reveal" data-mgu-video data-typ="{{ section.settings.typ }}" data-id="{{ section.settings.video_id | escape }}" data-title="{{ section.settings.heading | strip_html | escape }}" data-consent="{{ section.settings.consent }}">
        {%- if section.settings.typ == 'mp4' and section.settings.mp4 != blank -%}
          <video controls preload="none" {% if section.settings.poster != blank %}poster="{{ section.settings.poster | image_url: width: 1200 }}"{% endif %}>
            <source src="{{ section.settings.mp4 }}" type="video/mp4">
          </video>
        {%- else -%}
          <button type="button" class="mgu-vt-consent" data-mgu-video-load>
            <span class="mgu-vt-play" aria-hidden="true">▶</span>
            <strong>{{ section.settings.consent_titel }}</strong>
            {%- if section.settings.consent -%}<p>{{ section.settings.consent_text }}</p>{%- endif -%}
          </button>
        {%- endif -%}
      </div>
      <div class="mgu-reveal" style="transition-delay:.1s">
        {%- if section.settings.eyebrow != blank -%}<span class="mgu-eyebrow">{{ section.settings.eyebrow }}</span>{%- endif -%}
        <h2>{{ section.settings.heading }}</h2>
        <div style="color:var(--mgu-ink-soft);font-size:16px;line-height:1.7">{{ section.settings.text }}</div>
        {%- if section.settings.button_label != blank and section.settings.button_link != blank -%}
          <a class="mgu-btn mgu-btn--primary" style="margin-top:16px" href="{{ section.settings.button_link }}">{{ section.settings.button_label }}</a>
        {%- endif -%}
      </div>
    </div>
  </div>
</section>
<script>
(function(){
  var box=document.currentScript.previousElementSibling.querySelector('[data-mgu-video]');
  if(!box) box=document.querySelector('[data-mgu-video]:not([data-init])');
  document.querySelectorAll('[data-mgu-video]:not([data-init])').forEach(function(b){
    b.dataset.init='1';
    var btn=b.querySelector('[data-mgu-video-load]'); if(!btn) return;
    btn.addEventListener('click',function(){
      var typ=b.dataset.typ,id=b.dataset.id,src='';
      if(typ==='youtube'&&/^[A-Za-z0-9_-]{6,20}$/.test(id)) src='https://www.youtube-nocookie.com/embed/'+id+'?autoplay=1&rel=0';
      else if(typ==='vimeo'&&/^\d{6,15}$/.test(id)) src='https://player.vimeo.com/video/'+id+'?autoplay=1';
      if(!src) return;
      var f=document.createElement('iframe');
      f.src=src; f.allow='autoplay; fullscreen; picture-in-picture'; f.setAttribute('allowfullscreen','');
      f.referrerPolicy='strict-origin-when-cross-origin';
      f.title=b.dataset.title || 'Video'; b.innerHTML=''; b.appendChild(f); f.focus();
    });
  });
})();
</script>
{% style %}
  #shopify-section-{{ section.id }} {
    margin-block-start: {{ section.settings.section_gap_top | default: 0 }}px;
    margin-block-end: {{ section.settings.section_gap_bottom | default: 0 }}px;
  }
{% endstyle %}

{% schema %}
{
  "name": "Chelonaki · Video & Text",
  "settings": [
    {"type":"header","content":"Abstand zum nächsten Abschnitt"},
    {"type":"range","id":"section_gap_top","label":"Zusätzlicher Abstand oben","min":0,"max":200,"step":4,"unit":"px","default":0},
    {"type":"range","id":"section_gap_bottom","label":"Zusätzlicher Abstand unten","min":0,"max":200,"step":4,"unit":"px","default":0},
    { "type": "header", "content": "Scroll-Effekt" },
    { "type": "select", "id": "effect", "label": "Erscheinen beim Scrollen", "default": "up", "options": [ { "value": "none", "label": "Kein Effekt" }, { "value": "fade", "label": "Einblenden" }, { "value": "up", "label": "Von unten (Standard)" }, { "value": "left", "label": "Von links" }, { "value": "right", "label": "Von rechts" }, { "value": "zoom", "label": "Sanfter Zoom" }, { "value": "blur", "label": "Aus der Unschärfe" } ] },
    { "type": "select", "id": "effect_speed", "label": "Effekt-Tempo", "default": "normal", "options": [ { "value": "schnell", "label": "Schnell" }, { "value": "normal", "label": "Normal" }, { "value": "langsam", "label": "Langsam" } ] },
    { "type": "header", "content": "Video" },
    { "type": "select", "id": "typ", "label": "Quelle", "default": "youtube", "options": [ { "value": "youtube", "label": "YouTube" }, { "value": "vimeo", "label": "Vimeo" }, { "value": "mp4", "label": "MP4 (Datei/URL)" } ] },
    { "type": "text", "id": "video_id", "label": "YouTube-/Vimeo-ID", "info": "Nur die ID, z.B. dQw4w9WgXcQ" },
    { "type": "url", "id": "mp4", "label": "MP4-Datei-URL (bei Quelle MP4)" },
    { "type": "image_picker", "id": "poster", "label": "Vorschaubild (MP4)" },
    { "type": "select", "id": "medien_seite", "label": "Video-Seite", "default": "rechts", "options": [ { "value": "links", "label": "Links" }, { "value": "rechts", "label": "Rechts" } ] },
    { "type": "header", "content": "Datenschutz (Zwei-Klick)" },
    { "type": "checkbox", "id": "consent", "label": "Consent-Hinweis vor Laden anzeigen", "default": true },
    { "type": "text", "id": "consent_titel", "label": "Consent-Titel", "default": "Video abspielen" },
    { "type": "textarea", "id": "consent_text", "label": "Consent-Text", "default": "Mit dem Abspielen werden Daten an den Anbieter übertragen. YouTube wird im No-Cookie-Modus geladen." },
    { "type": "header", "content": "Text" },
    { "type": "text", "id": "eyebrow", "label": "Kicker-Zeile", "default": "Ansehen" },
    { "type": "inline_richtext", "id": "heading", "label": "Überschrift", "default": "Sieh selbst, <em>wie es wirkt.</em>" },
    { "type": "richtext", "id": "text", "label": "Text", "default": "<p>Erkläre in wenigen Sätzen, was das Video zeigt und warum es überzeugt.</p>" },
    { "type": "text", "id": "button_label", "label": "Button (optional)" },
    { "type": "url", "id": "button_link", "label": "Button-Link" },
    { "type": "color", "id": "bg", "label": "Hintergrundfarbe", "default": "#FBF8F0" }
  ],
  "presets": [{ "name": "Chelonaki – Video mit Text" }]
}
{% endschema %}
