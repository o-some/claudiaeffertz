{% comment %} Chelonaki Shop Theme · © Chelonaki · Wiederverwendbare Landingpage-Sektion {% endcomment %}
{{ 'ch-core.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign section_anchor = section.settings.anchor | handle
  assign content_width = section.settings.content_width | default: 1180
-%}

{%- style -%}
  #shopify-section-{{ section.id }} .ch-landingpage {
    --ch-landing-bg: {{ section.settings.background }};
    --ch-landing-text: {{ section.settings.text_color }};
    --ch-landing-accent: {{ section.settings.accent_color }};
    background: var(--ch-landing-bg);
    color: var(--ch-landing-text);
    padding-block: {{ section.settings.spacing_top }}px {{ section.settings.spacing_bottom }}px;
  }
  #shopify-section-{{ section.id }} .ch-landingpage__inner {
    margin-inline: auto;
    max-width: {{ content_width }}px;
    padding-inline: clamp(20px, 4vw, 48px);
  }
  #shopify-section-{{ section.id }} .ch-landingpage__stack {
    display: grid;
    gap: clamp(18px, 3vw, 32px);
  }
  #shopify-section-{{ section.id }} .ch-landingpage__heading {
    color: inherit;
    font-size: clamp(2rem, 5vw, 4.5rem);
    line-height: 1.05;
    margin: 0;
  }
  #shopify-section-{{ section.id }} .ch-landingpage__text { font-size: clamp(1rem, 1.5vw, 1.2rem); line-height: 1.7; }
  #shopify-section-{{ section.id }} .ch-landingpage__text > :first-child { margin-top: 0; }
  #shopify-section-{{ section.id }} .ch-landingpage__text > :last-child { margin-bottom: 0; }
  #shopify-section-{{ section.id }} .ch-landingpage__image { display: block; height: auto; max-width: 100%; width: 100%; }
  #shopify-section-{{ section.id }} .ch-landingpage__button {
    align-items: center;
    background: var(--ch-landing-accent);
    border: 1px solid var(--ch-landing-accent);
    border-radius: 999px;
    color: {{ section.settings.button_text_color }};
    display: inline-flex;
    justify-content: center;
    min-height: 48px;
    padding: 12px 24px;
    text-decoration: none;
    width: fit-content;
  }
  #shopify-section-{{ section.id }} .ch-landingpage__button:focus-visible { outline: 3px solid currentColor; outline-offset: 3px; }
  #shopify-section-{{ section.id }} .ch-landingpage__spacer { height: var(--ch-spacer); }
{%- endstyle -%}

<section
  {% if section_anchor != blank %}id="{{ section_anchor }}"{% endif %}
  class="ch-landingpage"
  aria-label="{{ section.settings.accessibility_label | escape }}"
>
  <div class="ch-landingpage__inner">
    <div class="ch-landingpage__stack">
      {%- for block in section.blocks -%}
        {%- case block.type -%}
          {%- when 'heading' -%}
            <h2 class="ch-landingpage__heading" {{ block.shopify_attributes }}>{{ block.settings.heading }}</h2>
          {%- when 'text' -%}
            <div class="ch-landingpage__text rte" {{ block.shopify_attributes }}>{{ block.settings.text }}</div>
          {%- when 'image' -%}
            <div {{ block.shopify_attributes }}>
              {%- if block.settings.image != blank -%}
                {{ block.settings.image
                  | image_url: width: 2400
                  | image_tag:
                    class: 'ch-landingpage__image',
                    loading: 'lazy',
                    widths: '375, 550, 750, 1100, 1500, 2000, 2400',
                    sizes: '(min-width: 1200px) 1120px, calc(100vw - 40px)',
                    alt: block.settings.alt_text
                }}
              {%- else -%}
                {{ 'lifestyle-1' | placeholder_svg_tag: 'placeholder-svg ch-landingpage__image' }}
              {%- endif -%}
            </div>
          {%- when 'button' -%}
            <div {{ block.shopify_attributes }}>
              {%- if block.settings.label != blank and block.settings.link != blank -%}
                <a class="ch-landingpage__button" href="{{ block.settings.link }}">{{ block.settings.label | escape }}</a>
              {%- endif -%}
            </div>
          {%- when 'spacer' -%}
            <div class="ch-landingpage__spacer" style="--ch-spacer: {{ block.settings.height }}px" aria-hidden="true" {{ block.shopify_attributes }}></div>
          {%- when 'html' -%}
            <div class="ch-landingpage__html" {{ block.shopify_attributes }}>{{ block.settings.code }}</div>
        {%- endcase -%}
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Chelonaki · Landingpage",
  "tag": "section",
  "class": "section",
  "max_blocks": 50,
  "settings": [
    { "type": "text", "id": "anchor", "label": "Menü-Anker", "info": "Zum Beispiel angebot. Verlinkung im Menü: /pages/deine-seite#angebot" },
    { "type": "text", "id": "accessibility_label", "label": "Bereichsbeschreibung", "default": "Landingpage-Inhalt" },
    { "type": "range", "id": "content_width", "label": "Maximale Breite", "min": 600, "max": 1600, "step": 20, "unit": "px", "default": 1180 },
    { "type": "color", "id": "background", "label": "Hintergrund", "default": "#fbf8f0" },
    { "type": "color", "id": "text_color", "label": "Textfarbe", "default": "#123525" },
    { "type": "color", "id": "accent_color", "label": "Akzent und Button", "default": "#b99a48" },
    { "type": "color", "id": "button_text_color", "label": "Button-Text", "default": "#ffffff" },
    { "type": "range", "id": "spacing_top", "label": "Abstand oben", "min": 0, "max": 200, "step": 4, "unit": "px", "default": 64 },
    { "type": "range", "id": "spacing_bottom", "label": "Abstand unten", "min": 0, "max": 200, "step": 4, "unit": "px", "default": 64 }
  ],
  "blocks": [
    {
      "type": "heading",
      "name": "Überschrift",
      "settings": [
        { "type": "inline_richtext", "id": "heading", "label": "Überschrift", "default": "Eine Landingpage mit <em>Charakter.</em>" }
      ]
    },
    {
      "type": "text",
      "name": "Text",
      "settings": [
        { "type": "richtext", "id": "text", "label": "Text", "default": "<p>Inhalte können hier ohne Programmierung gepflegt werden.</p>" }
      ]
    },
    {
      "type": "image",
      "name": "Bild",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Bild" },
        { "type": "text", "id": "alt_text", "label": "Alternativtext", "info": "Beschreibt den Bildinhalt für Screenreader." }
      ]
    },
    {
      "type": "button",
      "name": "Button",
      "settings": [
        { "type": "text", "id": "label", "label": "Beschriftung", "default": "Mehr erfahren" },
        { "type": "url", "id": "link", "label": "Link" }
      ]
    },
    {
      "type": "spacer",
      "name": "Abstand",
      "settings": [
        { "type": "range", "id": "height", "label": "Höhe", "min": 8, "max": 160, "step": 8, "unit": "px", "default": 32 }
      ]
    },
    {
      "type": "html",
      "name": "HTML / Liquid (Profi)",
      "settings": [
        { "type": "liquid", "id": "code", "label": "Geprüfter HTML-/Liquid-Code", "info": "Nur vertrauenswürdigen, zuvor geprüften Code einfügen. Für normale Inhalte die anderen Blöcke verwenden." }
      ]
    }
  ],
  "presets": [
    {
      "name": "Chelonaki · Landingpage",
      "blocks": [
        { "type": "heading" },
        { "type": "text" },
        { "type": "button" }
      ]
    }
  ]
}
{% endschema %}
