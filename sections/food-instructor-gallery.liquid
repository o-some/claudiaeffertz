<section class="fi-gallery" id="FiGallery" data-fi-reveal-scope style="--fi-module-bg:{{ section.settings.module_bg }};--fi-heading-color:{{ section.settings.heading_color }};--fi-text-color:{{ section.settings.text_color }};--fi-accent-color:{{ section.settings.accent_color }};--fi-caption-color:{{ section.settings.caption_color }};--fi-caption-overlay:{{ section.settings.caption_overlay }}">
  <div class="fi-section-head fi-section-head--center fi-reveal">
    {% if section.settings.eyebrow != blank %}<span class="fi-eyebrow">{{ section.settings.eyebrow | escape }}</span>{% endif %}
    <h2>{{ section.settings.heading }}</h2>
  </div>

  <div class="fi-marquee-viewport"{% if section.settings.pause_on_hover %} data-pause-on-hover{% endif %}>
    <div class="fi-marquee" aria-label="{{ section.settings.gallery_label | escape }}" style="--fi-marquee-duration:{{ section.settings.speed }}s">
      {% for pass in (1..2) %}
        {% for block in section.blocks %}
          {% liquid
            case forloop.index
              when 1
                assign fallback_asset = 'fi-static-005.jpg'
              when 2
                assign fallback_asset = 'fi-static-006.jpg'
              when 3
                assign fallback_asset = 'fi-static-007.jpg'
              when 4
                assign fallback_asset = 'fi-static-008.jpg'
              when 5
                assign fallback_asset = 'fi-static-009.jpg'
              else
                assign fallback_asset = 'fi-static-010.jpg'
            endcase
          %}
          <figure class="fi-gallery-item"{% if pass == 2 %} aria-hidden="true"{% endif %}{% if pass == 1 %} {{ block.shopify_attributes }}{% endif %}>
            {% if block.settings.image != blank %}
              {{ block.settings.image | image_url: width: 1000 | image_tag: widths: '320, 480, 640, 800, 1000', sizes: '(max-width: 700px) 240px, 26vw', loading: 'lazy', alt: block.settings.image_alt }}
            {% else %}
              <img src="{{ fallback_asset | asset_url }}" width="760" height="506" loading="lazy" decoding="async" alt="{% if pass == 1 %}{{ block.settings.image_alt | escape }}{% endif %}">
            {% endif %}
            {% if block.settings.label != blank %}<figcaption>{{ block.settings.label | escape }}</figcaption>{% endif %}
          </figure>
        {% endfor %}
      {% endfor %}
    </div>
  </div>

  {% if section.settings.note != blank %}<p class="fi-gallery-note">{{ section.settings.note | escape }}</p>{% endif %}
</section>

{% style %}
  #shopify-section-{{ section.id }} {
    margin-block-start: {{ section.settings.section_gap_top | default: 0 }}px;
    margin-block-end: {{ section.settings.section_gap_bottom | default: 0 }}px;
  }
{% endstyle %}

{% schema %}
{
  "name": "Chelonaki · Web Galerie",
  "tag": "section",
  "class": "fi-gallery-section",
  "max_blocks": 6,
  "settings": [
    {"type":"header","content":"Abstand zum nächsten Abschnitt"},
    {"type":"range","id":"section_gap_top","label":"Zusätzlicher Abstand oben","min":0,"max":200,"step":4,"unit":"px","default":0},
    {"type":"range","id":"section_gap_bottom","label":"Zusätzlicher Abstand unten","min":0,"max":200,"step":4,"unit":"px","default":0},
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Kleine Überschrift",
      "default": "Einblicke"
    },
    {
      "type": "inline_richtext",
      "id": "heading",
      "label": "Überschrift",
      "default": "Rezepte, die nach <em>echtem Essen</em> schmecken."
    },
    {
      "type": "text",
      "id": "gallery_label",
      "label": "Barrierefreie Galeriebeschreibung",
      "default": "Bildergalerie mit Rezepten aus den Büchern"
    },
    {
      "type": "text",
      "id": "note",
      "label": "Hinweis unter der Galerie",
      "default": "Originalrezepte aus „Die Longevity-Küche neu gedacht“"
    },
    {
      "type": "range",
      "id": "speed",
      "label": "Animationsdauer",
      "min": 20,
      "max": 80,
      "step": 2,
      "unit": "s",
      "default": 42
    },
    {
      "type": "checkbox",
      "id": "pause_on_hover",
      "label": "Animation bei Mausberührung pausieren",
      "default": true
    },
    {
      "type": "header",
      "content": "Farben dieses Moduls"
    },
    {
      "type": "color",
      "id": "module_bg",
      "label": "Modul-Hintergrund",
      "default": "#FBF8F0"
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Überschrift",
      "default": "#1F3A2A"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Beschreibung / Hinweis",
      "default": "#5C6B60"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Akzenttext",
      "default": "#B9912F"
    },
    {
      "type": "color",
      "id": "caption_color",
      "label": "Bildbeschriftung",
      "default": "#FFFFFF"
    },
    {
      "type": "color",
      "id": "caption_overlay",
      "label": "Dunkler Bildverlauf",
      "default": "#142519"
    }
  ],
  "blocks": [
    {
      "type": "image",
      "name": "Galeriebild",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Bild"
        },
        {
          "type": "text",
          "id": "image_alt",
          "label": "Bildbeschreibung"
        },
        {
          "type": "text",
          "id": "label",
          "label": "Kurzer Bildtitel"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Chelonaki · Web Galerie",
      "blocks": [
        {
          "type": "image",
          "settings": {
            "image_alt": "Mediterrane Bowl-Vielfalt mit Lachs",
            "label": "Mediterrane Vielfalt"
          }
        },
        {
          "type": "image",
          "settings": {
            "image_alt": "Frischer Avocado-Tomaten-Salat",
            "label": "Frische Salate"
          }
        },
        {
          "type": "image",
          "settings": {
            "image_alt": "Kürbiskernbrötchen, selbst gebacken",
            "label": "Selbst gebacken"
          }
        },
        {
          "type": "image",
          "settings": {
            "image_alt": "Frittata aus der Pfanne mit Rucola",
            "label": "Aus der Pfanne"
          }
        },
        {
          "type": "image",
          "settings": {
            "image_alt": "Auberginen-Gratin mit Mozzarella",
            "label": "Ofengerichte"
          }
        },
        {
          "type": "image",
          "settings": {
            "image_alt": "Herzhafte Pasta-Gemüse-Pfanne",
            "label": "Alltagstauglich"
          }
        }
      ]
    }
  ]
}
{% endschema %}
