<section class="fi-block fi-training" id="FiTraining" data-fi-reveal-scope style="--fi-module-bg:{{ section.settings.module_bg }};--fi-heading-color:{{ section.settings.heading_color }};--fi-text-color:{{ section.settings.text_color }};--fi-accent-color:{{ section.settings.accent_color }};--fi-line-color:{{ section.settings.line_color }};--fi-circle-bg:{{ section.settings.circle_bg }};--fi-circle-text:{{ section.settings.circle_text }};--fi-circle-border:{{ section.settings.circle_border }};--fi-button-bg:{{ section.settings.button_bg }};--fi-button-text:{{ section.settings.button_text }};--fi-button-hover-bg:{{ section.settings.button_hover_bg }};--fi-button-hover-text:{{ section.settings.button_hover_text }};--fi-card-bg:{{ section.settings.card_bg }};--fi-card-heading:{{ section.settings.card_heading }};--fi-card-text:{{ section.settings.card_text }};--fi-card-border:{{ section.settings.card_border }}">
  <div class="fi-wrap fi-training-grid">
    <div class="fi-reveal">
      {% if section.settings.eyebrow != blank %}<span class="fi-eyebrow">{{ section.settings.eyebrow | escape }}</span>{% endif %}
      <h2>{{ section.settings.heading }}</h2>
      <div class="fi-training-lead rte">{{ section.settings.text }}</div>

      <div class="fi-training-points">
        {% assign point_number = 0 %}
        {% for block in section.blocks %}
          {% if block.type == 'point' %}
            {% assign point_number = point_number | plus: 1 %}
            <div class="fi-training-point" {{ block.shopify_attributes }}>
              <div class="fi-number" aria-hidden="true">{{ point_number }}</div>
              <div><h3>{{ block.settings.title | escape }}</h3><div class="rte">{{ block.settings.text }}</div></div>
            </div>
          {% endif %}
        {% endfor %}
      </div>

      {% liquid
        assign button_link = section.settings.button_link
        if button_link == blank and section.settings.button_target != blank
          assign button_link = section.settings.button_target
        endif
      %}
      {% if button_link != blank and section.settings.button_label != blank %}
        <a class="fi-btn fi-btn--gold" href="{{ button_link | escape }}">{{ section.settings.button_label | escape }}{% render 'fi-arrow-icon' %}</a>
      {% endif %}
    </div>

    <div class="fi-training-side fi-reveal" style="--fi-reveal-delay:.15s">
      <div class="fi-training-cover">
        {% if section.settings.image != blank %}
          {{ section.settings.image | image_url: width: 900 | image_tag: widths: '320, 480, 640, 900', sizes: '(max-width: 900px) 70vw, 340px', loading: 'lazy', alt: section.settings.image_alt }}
        {% else %}
          <img src="{{ 'fi-static-004.jpg' | asset_url }}" width="538" height="760" loading="lazy" decoding="async" alt="{{ section.settings.image_alt | escape }}">
        {% endif %}
      </div>

      <div class="fi-method-card">
        {% if section.settings.method_title != blank %}<span class="fi-serif">{{ section.settings.method_title | escape }}</span>{% endif %}
        {% for block in section.blocks %}
          {% if block.type == 'method' %}
            <div class="fi-method-row" {{ block.shopify_attributes }}>
              <b aria-hidden="true">{{ block.settings.letter | escape }}</b>
              <div><h3>{{ block.settings.title | escape }}</h3><div class="rte">{{ block.settings.text }}</div></div>
            </div>
          {% endif %}
        {% endfor %}
      </div>
    </div>
  </div>
</section>

{% style %}
  #shopify-section-{{ section.id }} {
    margin-block-start: {{ section.settings.section_gap_top | default: 0 }}px;
    margin-block-end: {{ section.settings.section_gap_bottom | default: 0 }}px;
  }
{% endstyle %}

