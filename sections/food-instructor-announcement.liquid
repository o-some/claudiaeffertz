{%- if section.settings.enabled and section.blocks.size > 0 -%}
{%- liquid
  assign fa_justify = 'center'
  if section.settings.alignment == 'left'
    assign fa_justify = 'flex-start'
  elsif section.settings.alignment == 'right'
    assign fa_justify = 'flex-end'
  endif
-%}
<style>
  #FiAnnouncement-{{ section.id }}{
    --fa-bg:{{ section.settings.background }};
    --fa-text:{{ section.settings.text_color }};
    --fa-link:{{ section.settings.link_color }};
    --fa-link-hover:{{ section.settings.link_hover_color }};
    --fa-border:{{ section.settings.border_color }};
    display:block;
    width:100%;
    position:relative;
    z-index:80;
    overflow:hidden;
    isolation:isolate;
    background:
      radial-gradient(circle at 50% -180%,rgba(217,188,106,.13),transparent 58%),
      linear-gradient(105deg,
        color-mix(in srgb,var(--fa-bg) 90%,#071d12) 0%,
        var(--fa-bg) 52%,
        color-mix(in srgb,var(--fa-bg) 94%,#b9912f) 100%);
    color:var(--fa-text);
    border-bottom:1px solid var(--fa-border);
    box-shadow:0 5px 18px -17px rgba(3,18,11,.8);
    font-family:var(--fi-font-body,system-ui,sans-serif);
    font-size:{{ section.settings.font_size }}px;
  }
  #FiAnnouncement-{{ section.id }}::before{
    content:"";
    position:absolute;
    z-index:-1;
    inset:0 auto 0 -35%;
    width:28%;
    background:linear-gradient(90deg,transparent,rgba(255,255,255,.075),transparent);
    transform:skewX(-18deg);
    animation:fa-sheen-{{ section.id }} 9s ease-in-out infinite;
    pointer-events:none;
  }
  #FiAnnouncement-{{ section.id }}::after{
    content:"";
    position:absolute;
    z-index:2;
    inset:auto 0 0;
    height:1px;
    background:linear-gradient(90deg,transparent,var(--fa-border),transparent);
    opacity:.72;
    pointer-events:none;
  }
  #FiAnnouncement-{{ section.id }}[hidden]{display:none!important}
  #FiAnnouncement-{{ section.id }} .fa-inner{
    position:relative;
    width:min(1120px,100%);
    min-height:{{ section.settings.min_height }}px;
    margin:0 auto;
    padding:{{ section.settings.padding_y }}px clamp(16px,3vw,42px);
    display:flex;
    align-items:center;
  }
  #FiAnnouncement-{{ section.id }} .fa-viewport{width:100%;min-width:0;padding-inline:76px;text-align:{{ section.settings.alignment }}}
  #FiAnnouncement-{{ section.id }} .fa-slide[hidden]{display:none!important}
  #FiAnnouncement-{{ section.id }} .fa-slide.is-active .fa-content{animation:fa-message-in-{{ section.id }} .42s cubic-bezier(.2,.7,.2,1) both}
  #FiAnnouncement-{{ section.id }} .fa-content{display:flex;align-items:center;justify-content:{{ fa_justify }};gap:8px 11px;flex-wrap:wrap}
  #FiAnnouncement-{{ section.id }} .fa-icon{position:relative;display:grid;place-items:center;width:22px;height:22px;border:1px solid color-mix(in srgb,var(--fa-border) 48%,transparent);border-radius:50%;background:rgba(255,255,255,.035);color:var(--fa-link);font-size:.72em;line-height:1;box-shadow:0 0 0 0 rgba(217,188,106,0),inset 0 0 0 1px rgba(255,255,255,.02);animation:fa-icon-pulse-{{ section.id }} 4.5s ease-in-out infinite}
  #FiAnnouncement-{{ section.id }} .fa-text{font-weight:650;letter-spacing:.035em;line-height:1.3;text-wrap:balance}
  #FiAnnouncement-{{ section.id }} .fa-text p{display:inline;margin:0}
  #FiAnnouncement-{{ section.id }} .fa-link{display:inline-flex;align-items:center;gap:6px;padding:6px 12px;border:1px solid color-mix(in srgb,var(--fa-link) 48%,transparent);border-radius:999px;background:rgba(255,255,255,.035);color:var(--fa-link)!important;font-size:.92em;font-weight:800;text-decoration:none;transition:background .2s ease,color .2s ease,transform .2s ease}
  #FiAnnouncement-{{ section.id }} .fa-link:hover{background:var(--fa-link);color:var(--fa-link-hover)!important;transform:translateY(-1px)}
  #FiAnnouncement-{{ section.id }} .fa-prev{position:absolute;z-index:3;left:clamp(12px,2.2vw,30px);top:50%;transform:translateY(-50%)}
  #FiAnnouncement-{{ section.id }} .fa-controls{position:absolute;z-index:3;right:clamp(12px,2.2vw,30px);top:50%;display:flex;align-items:center;gap:4px;transform:translateY(-50%)}
  #FiAnnouncement-{{ section.id }} .fa-button{display:grid;place-items:center;width:27px;height:27px;padding:0;border:1px solid transparent;border-radius:50%;background:transparent;color:var(--fa-text);cursor:pointer;opacity:.62;transition:background .2s ease,border-color .2s ease,opacity .2s ease,transform .2s ease}
  #FiAnnouncement-{{ section.id }} .fa-button[hidden]{display:none!important}
  #FiAnnouncement-{{ section.id }} .fa-button:hover{border-color:rgba(255,255,255,.12);background:rgba(255,255,255,.08);opacity:1;transform:scale(1.04)}
  #FiAnnouncement-{{ section.id }} .fa-prev:hover{transform:translateY(-50%) scale(1.04)}
  @keyframes fa-message-in-{{ section.id }}{from{opacity:0;transform:translateY(5px)}to{opacity:1;transform:none}}
  @keyframes fa-sheen-{{ section.id }}{0%,58%{left:-35%;opacity:0}65%{opacity:1}82%,100%{left:115%;opacity:0}}
  @keyframes fa-icon-pulse-{{ section.id }}{0%,55%,100%{box-shadow:0 0 0 0 rgba(217,188,106,0),inset 0 0 0 1px rgba(255,255,255,.02)}70%{box-shadow:0 0 0 5px rgba(217,188,106,.08),inset 0 0 0 1px rgba(255,255,255,.02)}}
  #FiAnnouncement-{{ section.id }} .fa-button svg{width:17px;height:17px}
  @media(max-width:760px){
    {% unless section.settings.show_mobile %}#FiAnnouncement-{{ section.id }}{display:none!important}{% endunless %}
    #FiAnnouncement-{{ section.id }} .fa-inner{padding:7px 12px;min-height:40px}
    #FiAnnouncement-{{ section.id }} .fa-viewport{padding-inline:38px}
    #FiAnnouncement-{{ section.id }} .fa-viewport{text-align:center}
    #FiAnnouncement-{{ section.id }} .fa-content{justify-content:center;gap:5px 8px}
    #FiAnnouncement-{{ section.id }} .fa-link{padding:5px 9px;font-size:.92em}
    #FiAnnouncement-{{ section.id }} .fa-text{letter-spacing:.025em}
    #FiAnnouncement-{{ section.id }} .fa-prev,#FiAnnouncement-{{ section.id }} .fa-next{display:none}
    #FiAnnouncement-{{ section.id }} .fa-controls{right:8px}
  }
  @media(prefers-reduced-motion:reduce){
    #FiAnnouncement-{{ section.id }}::before{display:none}
    #FiAnnouncement-{{ section.id }} .fa-icon{animation:none}
    #FiAnnouncement-{{ section.id }} .fa-slide.is-active .fa-content{animation:none}
    #FiAnnouncement-{{ section.id }} .fa-link,#FiAnnouncement-{{ section.id }} .fa-button{transition:none}
  }
</style>

<fi-announcement-clean id="FiAnnouncement-{{ section.id }}" data-autoplay="{{ section.settings.autoplay }}" data-interval="{{ section.settings.interval | times: 1000 }}" data-remember="{{ section.settings.remember_close }}" data-key="fi-announcement-{{ section.id }}" role="region" aria-label="{{ section.settings.aria_label | escape }}">
  <div class="fa-inner">
    <button class="fa-button fa-prev" type="button" data-fa-prev aria-label="Vorherige Meldung"{% unless section.settings.show_arrows and section.blocks.size > 1 %} hidden{% endunless %}><svg viewBox="0 0 24 24" aria-hidden="true"><path d="m15 5-7 7 7 7" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg></button>
    <div class="fa-viewport" aria-live="polite">
      {% for block in section.blocks %}
        <div class="fa-slide{% if forloop.first %} is-active{% endif %}" data-fa-slide {{ block.shopify_attributes }}{% unless forloop.first %} hidden{% endunless %}>
          <div class="fa-content">
            {% if block.settings.icon != blank %}<span class="fa-icon" aria-hidden="true">{{ block.settings.icon }}</span>{% endif %}
            <span class="fa-text">{{ block.settings.text }}</span>
            {% if block.settings.link_label != blank and block.settings.link != blank %}<a class="fa-link" href="{{ block.settings.link }}">{{ block.settings.link_label | escape }} <span aria-hidden="true">→</span></a>{% endif %}
          </div>
        </div>
      {% endfor %}
    </div>
    <div class="fa-controls">
      <button class="fa-button fa-next" type="button" data-fa-next aria-label="Nächste Meldung"{% unless section.settings.show_arrows and section.blocks.size > 1 %} hidden{% endunless %}><svg viewBox="0 0 24 24" aria-hidden="true"><path d="m9 5 7 7-7 7" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg></button>
      {% if section.settings.closeable %}<button class="fa-button" type="button" data-fa-close aria-label="{{ section.settings.close_label | escape }}"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M6 6l12 12M18 6 6 18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg></button>{% endif %}
    </div>
  </div>
</fi-announcement-clean>

<script>
if(!customElements.get('fi-announcement-clean')) customElements.define('fi-announcement-clean',class extends HTMLElement{
  connectedCallback(){
    if(this.ready)return;
    this.ready=true;
    this.slides=[...this.querySelectorAll('[data-fa-slide]')];
    this.i=Math.max(0,this.slides.findIndex((slide)=>slide.classList.contains('is-active')));
    this.editor=!!(window.Shopify&&Shopify.designMode);
    this.page=this.closest('[data-fi-page]');
    this.interval=Math.max(3000,Number(this.dataset.interval)||6000);
    this.onScroll=()=>{
      if(this.layoutFrame)return;
      this.layoutFrame=requestAnimationFrame(()=>{this.layoutFrame=0;this.syncLayout()});
    };
    this.onResize=this.onScroll;
    this.onBlockSelect=(event)=>{
      const slide=event.target?.closest?.('[data-fa-slide]');
      if(!slide||!this.contains(slide))return;
      const index=this.slides.indexOf(slide);
      if(index>-1)this.show(index,false);
    };

    try{
      if(!this.editor&&this.dataset.remember==='true'&&localStorage.getItem(this.dataset.key)==='1'){
        this.hidden=true;
      }
    }catch(error){}

    const prev=this.querySelector('[data-fa-prev]');
    const next=this.querySelector('[data-fa-next]');
    const close=this.querySelector('[data-fa-close]');
    if(this.slides.length<2){
      if(prev)prev.hidden=true;
      if(next)next.hidden=true;
    }
    prev?.addEventListener('click',()=>{this.show(this.i-1);this.restart()});
    next?.addEventListener('click',()=>{this.show(this.i+1);this.restart()});
    close?.addEventListener('click',()=>{
      this.hidden=true;
      this.stop();
      try{if(!this.editor&&this.dataset.remember==='true')localStorage.setItem(this.dataset.key,'1')}catch(error){}
      this.syncLayout();
    });

    this.addEventListener('mouseenter',()=>this.stop());
    this.addEventListener('mouseleave',()=>this.start());
    this.addEventListener('focusin',()=>this.stop());
    this.addEventListener('focusout',()=>this.start());
    window.addEventListener('scroll',this.onScroll,{passive:true});
    window.addEventListener('resize',this.onResize,{passive:true});
    document.addEventListener('shopify:block:select',this.onBlockSelect);
    if('ResizeObserver'in window){
      this.resizeObserver=new ResizeObserver(()=>this.syncLayout());
      this.resizeObserver.observe(this);
    }
    this.syncLayout();
    this.start();
  }

  syncLayout(){
    if(!this.page)return;
    if(this.hidden){
      this.page.style.setProperty('--fi-announcement-height','0px');
      this.page.style.setProperty('--fi-announcement-offset','0px');
      return;
    }
    const rect=this.getBoundingClientRect();
    const height=Math.max(0,Math.round(rect.height));
    const visible=Math.max(0,Math.min(height,Math.round(rect.bottom)));
    this.page.style.setProperty('--fi-announcement-height',`${height}px`);
    this.page.style.setProperty('--fi-announcement-offset',`${visible}px`);
  }

  show(n,announce=true){
    if(!this.slides.length)return;
    this.i=(n+this.slides.length)%this.slides.length;
    this.slides.forEach((slide,index)=>{
      const active=index===this.i;
      slide.hidden=!active;
      slide.classList.toggle('is-active',active);
    });
    if(announce)this.querySelector('.fa-viewport')?.setAttribute('aria-live','polite');
    this.syncLayout();
  }

  start(){
    if(this.hidden||this.dataset.autoplay!=='true'||this.slides.length<2||matchMedia('(prefers-reduced-motion:reduce)').matches)return;
    this.stop();
    this.timer=setInterval(()=>this.show(this.i+1),this.interval);
  }

  stop(){
    if(this.timer){clearInterval(this.timer);this.timer=0;}
  }

  restart(){this.stop();this.start();}

  disconnectedCallback(){
    this.stop();
    if(this.layoutFrame)cancelAnimationFrame(this.layoutFrame);
    window.removeEventListener('scroll',this.onScroll);
    window.removeEventListener('resize',this.onResize);
    document.removeEventListener('shopify:block:select',this.onBlockSelect);
    this.resizeObserver?.disconnect();
    if(this.page){
      this.page.style.setProperty('--fi-announcement-height','0px');
      this.page.style.setProperty('--fi-announcement-offset','0px');
    }
    this.ready=false;
  }
});
</script>
{%- endif -%}

{% schema %}
{
  "name":"Chelonaki · Web Hinweis",
  "tag":"section",
  "class":"fi-announcement-section",
  "settings":[
    {"type":"checkbox","id":"enabled","label":"Ankündigungsleiste anzeigen","default":true},
    {"type":"text","id":"aria_label","label":"Barrierefreie Bezeichnung","default":"Aktuelle Hinweise"},
    {"type":"checkbox","id":"show_mobile","label":"Auf Mobilgeräten anzeigen","default":true},
    {"type":"select","id":"alignment","label":"Textausrichtung","default":"center","options":[{"value":"left","label":"Links"},{"value":"center","label":"Mittig"},{"value":"right","label":"Rechts"}]},
    {"type":"range","id":"font_size","label":"Schriftgröße","min":11,"max":18,"step":1,"unit":"px","default":13},
    {"type":"range","id":"min_height","label":"Mindesthöhe","min":38,"max":70,"step":2,"unit":"px","default":40},
    {"type":"range","id":"padding_y","label":"Innenabstand oben/unten","min":5,"max":18,"step":1,"unit":"px","default":6},
    {"type":"header","content":"Mehrere Meldungen"},
    {"type":"checkbox","id":"autoplay","label":"Meldungen automatisch wechseln","default":true,"info":"Der automatische Wechsel startet, sobald mindestens zwei Meldungen angelegt sind."},
    {"type":"range","id":"interval","label":"Wechselintervall","min":3,"max":12,"step":1,"unit":"s","default":6},
    {"type":"checkbox","id":"show_arrows","label":"Pfeile anzeigen","default":true},
    {"type":"header","content":"Schließen"},
    {"type":"checkbox","id":"closeable","label":"Leiste kann geschlossen werden","default":true},
    {"type":"checkbox","id":"remember_close","label":"Schließen im Browser merken","default":true},
    {"type":"text","id":"close_label","label":"Bezeichnung Schließen-Button","default":"Ankündigungsleiste schließen"},
    {"type":"header","content":"Farben"},
    {"type":"color","id":"background","label":"Hintergrund","default":"#162C49"},
    {"type":"color","id":"text_color","label":"Textfarbe","default":"#FBF8F2"},
    {"type":"color","id":"link_color","label":"Linkfarbe","default":"#DFBD7C"},
    {"type":"color","id":"link_hover_color","label":"Linktext bei Hover","default":"#162C49"},
    {"type":"color","id":"border_color","label":"Trennlinie","default":"#C69A4B"}
  ],
  "blocks":[{"type":"message","name":"Meldung","settings":[
    {"type":"text","id":"icon","label":"Icon (optional)"},
    {"type":"inline_richtext","id":"text","label":"Text","default":"Buch & Edition: 24 Impulse für Führung und Veränderung"},
    {"type":"text","id":"link_label","label":"Linktext (optional)","default":"Entdecken"},
    {"type":"url","id":"link","label":"Link"}
  ]}],
  "max_blocks":8,
  "presets":[{"name":"Chelonaki · Web Hinweis","blocks":[{"type":"message"}]}]
}
{% endschema %}
