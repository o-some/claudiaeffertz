{% comment %} Chelonaki Shop Theme · © Chelonaki · Build: CHELONAKI-BUILD-0000-MASTER · Nutzung nur mit gültiger Lizenz {% endcomment %}

{%- liquid
  assign sprite_urls = ''
  if section.settings.sprite_1 != blank
    assign u1 = section.settings.sprite_1 | image_url: width: 5760
    assign sprite_urls = sprite_urls | append: '"' | append: u1 | append: '"'
  endif
  if section.settings.sprite_2 != blank
    assign u2 = section.settings.sprite_2 | image_url: width: 5760
    if sprite_urls != ''
      assign sprite_urls = sprite_urls | append: ','
    endif
    assign sprite_urls = sprite_urls | append: '"' | append: u2 | append: '"'
  endif
-%}

<section class="mgu mgu-scrub-section" id="mgu-scrub-{{ section.id }}">
  <div class="mgu-scrub"
       data-mgu-scrub
       data-sprites='[{{ sprite_urls }}]'
       data-cols="{{ section.settings.cols }}"
       data-rows="{{ section.settings.rows }}"
       data-fw="{{ section.settings.frame_w }}"
       data-fh="{{ section.settings.frame_h }}"
       style="height: {{ section.settings.scroll_length }}vh;">
    <div class="mgu-scrub-sticky">
      <canvas aria-label="{{ section.settings.aria_label | escape }}" role="img"></canvas>
      <div class="mgu-scrub-shade"></div>

      {%- for block in section.blocks -%}
        <div class="mgu-scrub-cap"
             data-from="{{ block.settings.from | divided_by: 100.0 }}"
             data-to="{{ block.settings.to | divided_by: 100.0 }}"
             {{ block.shopify_attributes }}>
          <div class="mgu-scrub-panel">
            {%- if block.settings.kicker != blank -%}
              <span class="mgu-k">{{ block.settings.kicker }}</span>
            {%- endif -%}
            <h2>{{ block.settings.heading }}</h2>
          </div>
        </div>
      {%- endfor -%}

      <div class="mgu-scrub-progress" aria-hidden="true"><i></i></div>
      <span class="mgu-scrub-loading" role="status" aria-live="polite">{{ 'mgu.allgemein.laedt' | t }}</span>
    </div>
  </div>
</section>

{% style %}
  #shopify-section-{{ section.id }} {
    margin-block-start: {{ section.settings.section_gap_top | default: 0 }}px;
    margin-block-end: {{ section.settings.section_gap_bottom | default: 0 }}px;
  }
{% endstyle %}

{% schema %}
{
  "name": "Chelonaki – Scroll-Video",
  "tag": "div",
  "settings": [
    {"type":"header","content":"Abstand zum nächsten Abschnitt"},
    {"type":"range","id":"section_gap_top","label":"Zusätzlicher Abstand oben","min":0,"max":200,"step":4,"unit":"px","default":0},
    {"type":"range","id":"section_gap_bottom","label":"Zusätzlicher Abstand unten","min":0,"max":200,"step":4,"unit":"px","default":0},
    { "type": "header", "content": "Sprite-Sheets (Bildsequenz)" },
    { "type": "paragraph", "content": "Lade die beiden vorbereiteten Sprite-Bilder hoch (mgu-sprite-1.jpg und mgu-sprite-2.jpg). Jedes enthält 48 Frames in einem 8×6-Raster." },
    { "type": "image_picker", "id": "sprite_1", "label": "Sprite-Sheet 1 (Frames 1–48)" },
    { "type": "image_picker", "id": "sprite_2", "label": "Sprite-Sheet 2 (Frames 49–96)" },
    { "type": "header", "content": "Raster-Einstellungen" },
    { "type": "range", "id": "cols", "label": "Spalten pro Sheet", "min": 1, "max": 12, "step": 1, "default": 8 },
    { "type": "range", "id": "rows", "label": "Reihen pro Sheet", "min": 1, "max": 12, "step": 1, "default": 6 },
    { "type": "number", "id": "frame_w", "label": "Frame-Breite (px)", "default": 720 },
    { "type": "number", "id": "frame_h", "label": "Frame-Höhe (px)", "default": 405 },
    { "type": "header", "content": "Verhalten" },
    { "type": "range", "id": "scroll_length", "label": "Scroll-Strecke (vh)", "min": 200, "max": 700, "step": 20, "default": 420, "info": "Je höher, desto langsamer läuft das Video beim Scrollen." },
    { "type": "text", "id": "aria_label", "label": "Barrierefreiheit: Bildbeschreibung", "default": "Video-Szene wird beim Scrollen abgespielt" }
  ],
  "blocks": [
    {
      "type": "caption",
      "name": "Text-Einblendung",
      "settings": [
        { "type": "text", "id": "kicker", "label": "Kicker-Zeile", "default": "Kapitel eins" },
        { "type": "inline_richtext", "id": "heading", "label": "Überschrift (kursiv = <em>)", "default": "Alles beginnt mit <em>guten Zutaten.</em>" },
        { "type": "range", "id": "from", "label": "Sichtbar ab (% des Scrolls)", "min": 0, "max": 100, "step": 1, "default": 0 },
        { "type": "range", "id": "to", "label": "Sichtbar bis (% des Scrolls)", "min": 0, "max": 100, "step": 1, "default": 26 }
      ]
    }
  ],
  "presets": [
    {
      "name": "Chelonaki – Scroll-Video",
      "blocks": [
        { "type": "caption", "settings": { "kicker": "Kapitel eins", "heading": "Alles beginnt mit <em>guten Zutaten.</em>", "from": 0, "to": 26 } },
        { "type": "caption", "settings": { "kicker": "Handwerk statt Hektik", "heading": "Einfach zubereitet. <em>Bewusst genossen.</em>", "from": 30, "to": 55 } },
        { "type": "caption", "settings": { "kicker": "Kapitel drei", "heading": "Ein Ergebnis, <em>das bleibt.</em>", "from": 60, "to": 85 } },
        { "type": "caption", "settings": { "kicker": "Deine Marke", "heading": "So fühlt sich <em>deine Marke an.</em>", "from": 88, "to": 100 } }
      ]
    }
  ]
}
{% endschema %}
