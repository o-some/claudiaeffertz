<header class="ch-header{% if section.settings.sticky %} ch-header--sticky{% endif %}" id="ChHeader-{{ section.id }}" data-ch-navigation>
  {% if section.settings.show_announcement and section.settings.announcement_text != blank %}
    <div class="ch-announcement" role="region" aria-label="{{ section.settings.announcement_label | escape }}">
      {% if section.settings.announcement_link != blank %}<a href="{{ section.settings.announcement_link }}">{% endif %}
      {{ section.settings.announcement_text | escape }}
      {% if section.settings.announcement_link != blank %}</a>{% endif %}
    </div>
  {% endif %}
  <div class="ch-shell ch-header__inner">
    <a class="ch-brand" href="{{ routes.root_url }}" aria-label="{{ settings.ch_brand_name | default: shop.name | escape }} – Startseite">
      {% if settings.ch_generated_logo_asset != blank %}
        <img src="{{ settings.ch_generated_logo_asset | asset_url }}" width="180" height="60" alt="{{ settings.ch_brand_name | default: shop.name | escape }}">
      {% else %}
        <span>{{ settings.ch_brand_name | default: shop.name | escape }}{% if settings.ch_brand_suffix != blank %} {{ settings.ch_brand_suffix | escape }}{% endif %}</span>
      {% endif %}
    </a>

    <nav class="ch-nav" aria-label="{{ section.settings.navigation_label | escape }}">
      {% if settings.ch_generated_navigation %}
        {% render 'ch-generated-navigation', home_anchor_prefix: routes.root_url %}
      {% else %}
        <ul class="ch-nav__list">{% render 'ch-menu-links', links: section.settings.menu.links %}</ul>
      {% endif %}
    </nav>

    <div class="ch-header__actions">
      {% if section.settings.show_search %}<a href="{{ routes.search_url }}" data-ch-nav-link>{{ 'general.search.search' | t }}</a>{% endif %}
      {% if section.settings.show_account %}{% render 'ch-account-entry', menu_handle: section.settings.customer_account_menu, label: section.settings.account_label %}{% endif %}
      {% if section.settings.show_cart %}<a href="{{ routes.cart_url }}" data-ch-nav-link aria-label="{{ 'templates.cart.cart' | t }} – {{ cart.item_count }}">{{ 'templates.cart.cart' | t }} <span class="ch-cart-count" aria-hidden="true">{{ cart.item_count }}</span></a>{% endif %}
    </div>

    <details class="ch-mobile-nav" data-ch-mobile-nav>
      <summary aria-label="{{ section.settings.mobile_menu_label | escape }}" data-open-label="{{ section.settings.mobile_menu_label | escape }}" data-close-label="{{ section.settings.mobile_close_label | escape }}"><span aria-hidden="true">☰</span></summary>
      <nav class="ch-mobile-nav__panel" aria-label="{{ section.settings.navigation_label | escape }}">
        {% if settings.ch_generated_navigation %}
          {% render 'ch-generated-navigation', home_anchor_prefix: routes.root_url %}
        {% else %}
          <ul class="ch-mobile-nav__list">{% render 'ch-menu-links', links: section.settings.menu.links %}</ul>
        {% endif %}
        {% if section.settings.show_search %}<a href="{{ routes.search_url }}" data-ch-nav-link>{{ 'general.search.search' | t }}</a>{% endif %}
        {% if section.settings.show_account and shop.customer_accounts_enabled %}<a href="{{ routes.account_url }}" data-ch-nav-link rel="nofollow">{{ section.settings.account_label | escape }}</a>{% endif %}
        {% if section.settings.show_cart %}<a href="{{ routes.cart_url }}" data-ch-nav-link>{{ 'templates.cart.cart' | t }} ({{ cart.item_count }})</a>{% endif %}
      </nav>
    </details>
  </div>
</header>

{% schema %}
{
  "name": "Chelonaki – Header",
  "tag": "section",
  "class": "ch-header-section",
  "settings": [
    { "type": "checkbox", "id": "sticky", "label": "Header fixieren", "default": true },
    { "type": "checkbox", "id": "show_announcement", "label": "Hinweisleiste anzeigen", "default": false },
    { "type": "text", "id": "announcement_label", "label": "Bezeichnung der Hinweisleiste", "default": "Aktueller Hinweis" },
    { "type": "text", "id": "announcement_text", "label": "Hinweistext" },
    { "type": "url", "id": "announcement_link", "label": "Hinweislink" },
    { "type": "link_list", "id": "menu", "label": "Navigation" },
    { "type": "text", "id": "navigation_label", "label": "Barrierefreie Bezeichnung", "default": "Hauptnavigation" },
    { "type": "text", "id": "mobile_menu_label", "label": "Mobiles Menü", "default": "Menü öffnen" },
    { "type": "text", "id": "mobile_close_label", "label": "Mobiles Menü schließen", "default": "Menü schließen" },
    { "type": "checkbox", "id": "show_search", "label": "Suche anzeigen", "default": true },
    { "type": "checkbox", "id": "show_account", "label": "Kundenkonto anzeigen", "default": true },
    { "type": "text", "id": "account_label", "label": "Bezeichnung Kundenkonto", "default": "Konto" },
    { "type": "link_list", "id": "customer_account_menu", "label": "Menü im Kundenkonto", "default": "customer-account-main-menu" },
    { "type": "checkbox", "id": "show_cart", "label": "Warenkorb anzeigen", "default": true }
  ]
}
{% endschema %}
