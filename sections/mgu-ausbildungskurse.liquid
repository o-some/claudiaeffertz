{% comment %} Chelonaki / Food Instructor – Buchbare Ausbildungskurse {% endcomment %}

{%- liquid
  assign section_anchor = section.settings.anchor_id | strip | handleize
  if section_anchor == blank
    assign section_anchor = 'ausbildungskurse'
  endif
-%}

<style>
  #shopify-section-{{ section.id }} {
    --course-bg: {{ section.settings.bg }};
    --course-heading: {{ section.settings.heading_color }};
    --course-text: {{ section.settings.text_color }};
    --course-accent: {{ section.settings.accent_color }};
    --course-card-bg: {{ section.settings.card_bg }};
    --course-card-border: {{ section.settings.card_border }};
    --course-btn-bg: {{ section.settings.button_bg }};
    --course-btn-text: {{ section.settings.button_text }};
    --course-btn-hover-bg: {{ section.settings.button_hover_bg }};
    --course-btn-hover-text: {{ section.settings.button_hover_text }};
  }
  #shopify-section-{{ section.id }} .mgu-courses { padding: {{ section.settings.padding_top }}px clamp(18px, 4vw, 48px) {{ section.settings.padding_bottom }}px; background: var(--course-bg); color: var(--course-text); }
  #shopify-section-{{ section.id }} .mgu-courses__wrap { max-width: {{ section.settings.max_width }}px; margin: 0 auto; }
  #shopify-section-{{ section.id }} .mgu-courses__head { max-width: 780px; margin: 0 auto clamp(36px, 5vw, 64px); text-align: {{ section.settings.text_align }}; }
  #shopify-section-{{ section.id }} .mgu-courses__eyebrow { margin: 0 0 12px; color: var(--course-accent); font-size: 12px; font-weight: 800; letter-spacing: .22em; text-transform: uppercase; }
  #shopify-section-{{ section.id }} .mgu-courses__title { margin: 0; color: var(--course-heading); font-family: var(--mgu-font-heading, Georgia, serif); font-size: clamp(2.1rem, 4.6vw, 4rem); line-height: 1.06; }
  #shopify-section-{{ section.id }} .mgu-courses__title em { color: var(--course-accent); font-weight: 400; }
  #shopify-section-{{ section.id }} .mgu-courses__intro { margin: 18px 0 0; color: var(--course-text); font-size: clamp(1rem, 1.5vw, 1.15rem); }
  #shopify-section-{{ section.id }} .mgu-courses__grid { display: grid; grid-template-columns: repeat({{ section.settings.columns_desktop }}, minmax(0, 1fr)); gap: {{ section.settings.gap }}px; align-items: stretch; }
  #shopify-section-{{ section.id }} .mgu-course-card { position: relative; overflow: hidden; display: flex; flex-direction: column; min-width: 0; background: var(--course-card-bg); border: 1px solid var(--course-card-border); border-radius: {{ section.settings.card_radius }}px; box-shadow: 0 18px 55px rgba(16, 45, 31, .09); }
  #shopify-section-{{ section.id }} .mgu-course-card--featured { border-color: var(--course-accent); box-shadow: 0 24px 65px rgba(185, 145, 47, .18); }
  #shopify-section-{{ section.id }} .mgu-course-card__featured { position: absolute; top: 14px; right: 14px; z-index: 2; padding: 7px 12px; border-radius: 999px; background: var(--course-accent); color: #10291D; font-size: 10px; font-weight: 850; letter-spacing: .13em; text-transform: uppercase; }
  #shopify-section-{{ section.id }} .mgu-course-card__media { aspect-ratio: {{ section.settings.image_ratio }}; overflow: hidden; background: rgba(23, 58, 42, .06); }
  #shopify-section-{{ section.id }} .mgu-course-card__media img { width: 100%; height: 100%; object-fit: cover; transition: transform .45s ease; }
  #shopify-section-{{ section.id }} .mgu-course-card:hover .mgu-course-card__media img { transform: scale(1.035); }
  #shopify-section-{{ section.id }} .mgu-course-card__placeholder { height: 100%; display: grid; place-items: center; color: var(--course-accent); }
  #shopify-section-{{ section.id }} .mgu-course-card__body { padding: clamp(23px, 3vw, 32px); display: flex; flex: 1; flex-direction: column; }
  #shopify-section-{{ section.id }} .mgu-course-card__kicker { margin: 0 0 7px; color: var(--course-accent); font-size: 11px; font-weight: 850; letter-spacing: .15em; text-transform: uppercase; }
  #shopify-section-{{ section.id }} .mgu-course-card__title { margin: 0 0 12px; color: var(--course-heading); font-family: var(--mgu-font-heading, Georgia, serif); font-size: clamp(1.55rem, 2.3vw, 2.1rem); line-height: 1.12; }
  #shopify-section-{{ section.id }} .mgu-course-card__meta { display: flex; flex-wrap: wrap; gap: 8px; margin-bottom: 18px; }
  #shopify-section-{{ section.id }} .mgu-course-card__meta span { padding: 7px 11px; border: 1px solid var(--course-card-border); border-radius: 999px; color: var(--course-text); font-size: 12px; }
  #shopify-section-{{ section.id }} .mgu-course-card__text { color: var(--course-text); }
  #shopify-section-{{ section.id }} .mgu-course-card__text > *:first-child { margin-top: 0; }
  #shopify-section-{{ section.id }} .mgu-course-card__features { margin: 18px 0 0; padding: 0; list-style: none; }
  #shopify-section-{{ section.id }} .mgu-course-card__features li { position: relative; padding: 8px 0 8px 25px; border-bottom: 1px solid var(--course-card-border); color: var(--course-text); }
  #shopify-section-{{ section.id }} .mgu-course-card__features li:last-child { border-bottom: 0; }
  #shopify-section-{{ section.id }} .mgu-course-card__features li::before { content: '✓'; position: absolute; left: 0; color: var(--course-accent); font-weight: 900; }
  #shopify-section-{{ section.id }} .mgu-course-card__footer { margin-top: auto; padding-top: 24px; }
  #shopify-section-{{ section.id }} .mgu-course-card__price { display: flex; align-items: baseline; gap: 8px; margin-bottom: 16px; }
  #shopify-section-{{ section.id }} .mgu-course-card__price strong { color: var(--course-heading); font-family: var(--mgu-font-heading, Georgia, serif); font-size: 2rem; }
  #shopify-section-{{ section.id }} .mgu-course-card__price span { color: var(--course-text); font-size: 13px; }
  #shopify-section-{{ section.id }} .mgu-course-card__button { display: flex; width: 100%; min-height: 50px; align-items: center; justify-content: center; padding: 0 20px; border-radius: 999px; background: var(--course-btn-bg); color: var(--course-btn-text); font-weight: 750; text-decoration: none; transition: .2s ease; }
  #shopify-section-{{ section.id }} .mgu-course-card__button:hover { background: var(--course-btn-hover-bg); color: var(--course-btn-hover-text); transform: translateY(-1px); }
  #shopify-section-{{ section.id }} .mgu-course-card__note { margin: 12px 0 0; color: var(--course-text); text-align: center; font-size: 12px; }
  @media (max-width: 990px) { #shopify-section-{{ section.id }} .mgu-courses__grid { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (max-width: 680px) {
    #shopify-section-{{ section.id }} .mgu-courses { padding-top: calc({{ section.settings.padding_top }}px * .72); padding-bottom: calc({{ section.settings.padding_bottom }}px * .72); }
    #shopify-section-{{ section.id }} .mgu-courses__grid { grid-template-columns: 1fr; }
  }
</style>

<section id="{{ section_anchor }}" class="mgu-courses">
  <div class="mgu-courses__wrap">
    <header class="mgu-courses__head">
      {%- if section.settings.eyebrow != blank -%}<p class="mgu-courses__eyebrow">{{ section.settings.eyebrow }}</p>{%- endif -%}
      {%- if section.settings.heading != blank -%}<h2 class="mgu-courses__title">{{ section.settings.heading }}</h2>{%- endif -%}
      {%- if section.settings.intro != blank -%}<div class="mgu-courses__intro rte">{{ section.settings.intro }}</div>{%- endif -%}
    </header>

    <div class="mgu-courses__grid">
      {%- for block in section.blocks -%}
        <article class="mgu-course-card{% if block.settings.featured %} mgu-course-card--featured{% endif %}" {{ block.shopify_attributes }}>
          {%- if block.settings.featured and block.settings.featured_label != blank -%}<span class="mgu-course-card__featured">{{ block.settings.featured_label }}</span>{%- endif -%}
          {%- if block.settings.image != blank or section.settings.show_placeholders -%}
            <div class="mgu-course-card__media">
              {%- if block.settings.image != blank -%}
                {{ block.settings.image | image_url: width: 1000 | image_tag: loading: 'lazy', widths: '360, 540, 720, 900, 1000', sizes: '(max-width: 680px) 100vw, (max-width: 990px) 50vw, 33vw', alt: block.settings.image_alt }}
              {%- else -%}<div class="mgu-course-card__placeholder">{{ 'image' | placeholder_svg_tag }}</div>{%- endif -%}
            </div>
          {%- endif -%}
          <div class="mgu-course-card__body">
            {%- if block.settings.kicker != blank -%}<p class="mgu-course-card__kicker">{{ block.settings.kicker }}</p>{%- endif -%}
            <h3 class="mgu-course-card__title">{{ block.settings.title }}</h3>
            <div class="mgu-course-card__meta">
              {%- if block.settings.duration != blank -%}<span>⏱ {{ block.settings.duration }}</span>{%- endif -%}
              {%- if block.settings.date != blank -%}<span>📅 {{ block.settings.date }}</span>{%- endif -%}
              {%- if block.settings.location != blank -%}<span>📍 {{ block.settings.location }}</span>{%- endif -%}
            </div>
            {%- if block.settings.description != blank -%}<div class="mgu-course-card__text rte">{{ block.settings.description }}</div>{%- endif -%}
            {%- assign features = block.settings.features | newline_to_br | split: '<br />' -%}
            {%- if block.settings.features != blank -%}
              <ul class="mgu-course-card__features">
                {%- for feature in features -%}{%- assign clean_feature = feature | strip -%}{%- if clean_feature != blank -%}<li>{{ clean_feature }}</li>{%- endif -%}{%- endfor -%}
              </ul>
            {%- endif -%}
            <div class="mgu-course-card__footer">
              {%- if block.settings.price != blank -%}<div class="mgu-course-card__price"><strong>{{ block.settings.price }}</strong>{%- if block.settings.price_note != blank -%}<span>{{ block.settings.price_note }}</span>{%- endif -%}</div>{%- endif -%}
              {%- if block.settings.button_label != blank and block.settings.button_link != blank -%}<a class="mgu-course-card__button" href="{{ block.settings.button_link }}">{{ block.settings.button_label }}</a>{%- elsif block.settings.button_label != blank -%}<span class="mgu-course-card__button" role="link" aria-disabled="true">{{ block.settings.button_label }}</span>{%- endif -%}
              {%- if block.settings.note != blank -%}<p class="mgu-course-card__note">{{ block.settings.note }}</p>{%- endif -%}
            </div>
          </div>
        </article>
      {%- else -%}<p>Füge im Theme-Editor Kurse hinzu.</p>{%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Chelonaki · Lehrgänge",
  "tag": "section",
  "class": "section",
  "max_blocks": 9,
  "settings": [
    { "type": "text", "id": "anchor_id", "label": "Menü-Anker / ID", "default": "ausbildungskurse", "info": "Im Menü kannst du auf #ausbildungskurse verlinken." },
    { "type": "text", "id": "eyebrow", "label": "Kleine Überschrift", "default": "Ausbildung & Weiterbildung" },
    { "type": "inline_richtext", "id": "heading", "label": "Überschrift", "default": "Wähle deine passende <em>Ausbildung.</em>" },
    { "type": "richtext", "id": "intro", "label": "Einleitung", "default": "<p>Drei praxisnahe Ausbildungswege – von den Grundlagen bis zur professionellen Begleitung anderer Menschen.</p>" },
    { "type": "select", "id": "text_align", "label": "Ausrichtung der Einleitung", "default": "center", "options": [{"value":"left","label":"Links"},{"value":"center","label":"Zentriert"}] },
    { "type": "range", "id": "columns_desktop", "label": "Spalten auf Desktop", "min": 2, "max": 4, "step": 1, "default": 3 },
    { "type": "range", "id": "gap", "label": "Abstand zwischen Kursen", "min": 12, "max": 48, "step": 4, "unit": "px", "default": 24 },
    { "type": "range", "id": "max_width", "label": "Maximale Inhaltsbreite", "min": 900, "max": 1500, "step": 50, "unit": "px", "default": 1200 },
    { "type": "select", "id": "image_ratio", "label": "Bildformat", "default": "4 / 3", "options": [{"value":"16 / 9","label":"Breit 16:9"},{"value":"4 / 3","label":"Querformat 4:3"},{"value":"1 / 1","label":"Quadratisch"}] },
    { "type": "checkbox", "id": "show_placeholders", "label": "Platzhalter anzeigen, wenn kein Bild gewählt ist", "default": true },
    { "type": "range", "id": "card_radius", "label": "Abrundung der Karten", "min": 0, "max": 36, "step": 2, "unit": "px", "default": 22 },
    { "type": "range", "id": "padding_top", "label": "Abstand oben", "min": 20, "max": 160, "step": 10, "unit": "px", "default": 90 },
    { "type": "range", "id": "padding_bottom", "label": "Abstand unten", "min": 20, "max": 160, "step": 10, "unit": "px", "default": 90 },
    { "type": "header", "content": "Farben" },
    { "type": "color", "id": "bg", "label": "Hintergrund", "default": "#F3EDDF" },
    { "type": "color", "id": "heading_color", "label": "Überschriften", "default": "#173A2A" },
    { "type": "color", "id": "text_color", "label": "Fließtext", "default": "#66756D" },
    { "type": "color", "id": "accent_color", "label": "Akzent", "default": "#B9912F" },
    { "type": "color", "id": "card_bg", "label": "Karten-Hintergrund", "default": "#FFFFFF" },
    { "type": "color", "id": "card_border", "label": "Karten-Rahmen", "default": "#D8DED9" },
    { "type": "color", "id": "button_bg", "label": "Button-Hintergrund", "default": "#173A2A" },
    { "type": "color", "id": "button_text", "label": "Button-Schrift", "default": "#FFFFFF" },
    { "type": "color", "id": "button_hover_bg", "label": "Button-Hover-Hintergrund", "default": "#B9912F" },
    { "type": "color", "id": "button_hover_text", "label": "Button-Hover-Schrift", "default": "#10291D" }
  ],
  "blocks": [
    {
      "type": "course",
      "name": "Kurs",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Kursbild" },
        { "type": "text", "id": "image_alt", "label": "Bildbeschreibung" },
        { "type": "text", "id": "kicker", "label": "Kleine Bezeichnung", "default": "Ausbildung" },
        { "type": "text", "id": "title", "label": "Kurstitel", "default": "Basis Coach Metabolic Nutrition" },
        { "type": "textarea", "id": "description", "label": "Kurzbeschreibung", "default": "Fundiertes Basiswissen verständlich lernen und sicher im Alltag anwenden." },
        { "type": "text", "id": "duration", "label": "Dauer", "default": "2 Tage" },
        { "type": "text", "id": "date", "label": "Termin", "default": "Termin nach Auswahl" },
        { "type": "text", "id": "location", "label": "Ort", "default": "Bensheim" },
        { "type": "textarea", "id": "features", "label": "Leistungen – eine pro Zeile", "default": "Schulungsunterlagen\nPraxisbeispiele\nTeilnahmezertifikat\nPersönliche Begleitung" },
        { "type": "text", "id": "price", "label": "Preis", "default": "Preis auf Anfrage" },
        { "type": "text", "id": "price_note", "label": "Zusatz zum Preis", "default": "inkl. Unterlagen" },
        { "type": "text", "id": "button_label", "label": "Button-Text", "default": "Kurs buchen" },
        { "type": "url", "id": "button_link", "label": "Buchungslink", "info": "Zum Beispiel Calendly, Produkt, Kontakt- oder Buchungsseite." },
        { "type": "text", "id": "note", "label": "Hinweis unter dem Button", "default": "Unverbindliche Anfrage möglich" },
        { "type": "checkbox", "id": "featured", "label": "Kurs hervorheben", "default": false },
        { "type": "text", "id": "featured_label", "label": "Text der Hervorhebung", "default": "Empfohlen" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Chelonaki – Ausbildungskurse",
      "blocks": [
        { "type": "course", "settings": { "kicker": "Grundlagen", "title": "Basis Coach Metabolic Nutrition", "description": "Fundiertes Ernährungswissen verständlich lernen und sicher weitergeben.", "duration": "2 Tage", "features": "Stoffwechsel-Grundlagen\nBlutzucker und Insulin\nPraxisnahe Fallbeispiele\nTeilnahmezertifikat", "featured": false } },
        { "type": "course", "settings": { "kicker": "Aufbau", "title": "Food Instructor Coach", "description": "Menschen professionell begleiten und alltagstaugliche Lösungen entwickeln.", "duration": "Mehrmodulig", "features": "Coachingmethodik\nErnährungsanalyse\nGesprächsführung\nPraxisbegleitung", "featured": true, "featured_label": "Beliebteste Ausbildung" } },
        { "type": "course", "settings": { "kicker": "Spezialisierung", "title": "Longevity & Prävention", "description": "Vertiefe dein Wissen rund um langfristige Gesundheit und präventive Ernährung.", "duration": "Intensivkurs", "features": "Longevity-Grundlagen\nEntzündungsarme Ernährung\nMuskel- und Gelenkversorgung\nUmsetzung im Alltag", "featured": false } }
      ]
    }
  ]
}
{% endschema %}
