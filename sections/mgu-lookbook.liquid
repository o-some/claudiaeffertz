{% comment %} Chelonaki Shop Theme · © Chelonaki · Build: CHELONAKI-BUILD-0000-MASTER · Nutzung nur mit gültiger Lizenz {% endcomment %}

<style>
  .mgu-look{position:relative;border-radius:24px;overflow:hidden;box-shadow:0 40px 80px -35px rgba(20,37,25,.45)}
  .mgu-look img{width:100%;display:block}
  .mgu-hotspot{
    position:absolute;width:34px;height:34px;border-radius:50%;border:none;cursor:pointer;
    background:rgba(251,248,240,.95);transform:translate(-50%,-50%);
    display:flex;align-items:center;justify-content:center;
    box-shadow:0 0 0 6px rgba(217,188,106,.35),0 8px 20px -6px rgba(0,0,0,.4);
    transition:transform .3s;z-index:2;
  }
  .mgu-hotspot::before{content:"+";color:var(--mgu-forest);font-size:19px;font-weight:600;line-height:1}
  .mgu-hotspot:hover{transform:translate(-50%,-50%) scale(1.15)}
  .mgu-hotspot::after{
    content:"";position:absolute;inset:-6px;border-radius:50%;
    border:1.5px solid var(--mgu-gold-soft);animation:mguRing 2.2s infinite;
  }
  @keyframes mguRing{0%{transform:scale(.8);opacity:1}100%{transform:scale(1.6);opacity:0}}
</style>

<section data-mgu-effect="{{ section.settings.effect | default: 'up' }}" data-mgu-speed="{{ section.settings.effect_speed | default: 'normal' }}" class="mgu mgu-block" style="background:{{ section.settings.bg }}">
  <div class="mgu-wrap">
    <div class="mgu-sec-head mgu-reveal">
      {%- if section.settings.eyebrow != blank -%}<span class="mgu-eyebrow">{{ section.settings.eyebrow }}</span>{%- endif -%}
      <h2>{{ section.settings.heading }}</h2>
    </div>
    <div class="mgu-look mgu-reveal">
      {%- if section.settings.image != blank -%}
        <img width="{{ section.settings.image.width }}" height="{{ section.settings.image.height }}" src="{{ section.settings.image | image_url: width: 1800 }}" alt="{{ section.settings.image.alt | escape }}" loading="lazy">
      {%- else -%}
        {{ 'lifestyle-2' | placeholder_svg_tag }}
      {%- endif -%}
      {%- for block in section.blocks -%}
        {%- if block.settings.produkt != blank -%}
          <button class="mgu-hotspot" type="button"
                  style="left:{{ block.settings.x }}%;top:{{ block.settings.y }}%"
                  aria-label="{{ block.settings.produkt.title | escape }}"
                  onclick="window.__mguOpenQV && window.__mguOpenQV('{{ block.settings.produkt.handle }}')"
                  {{ block.shopify_attributes }}></button>
        {%- endif -%}
      {%- endfor -%}
    </div>
  </div>
</section>

{% style %}
  #shopify-section-{{ section.id }} {
    margin-block-start: {{ section.settings.section_gap_top | default: 0 }}px;
    margin-block-end: {{ section.settings.section_gap_bottom | default: 0 }}px;
  }
{% endstyle %}

{% schema %}
{
  "name": "Chelonaki · Lookbook",
  "settings": [
    {"type":"header","content":"Abstand zum nächsten Abschnitt"},
    {"type":"range","id":"section_gap_top","label":"Zusätzlicher Abstand oben","min":0,"max":200,"step":4,"unit":"px","default":0},
    {"type":"range","id":"section_gap_bottom","label":"Zusätzlicher Abstand unten","min":0,"max":200,"step":4,"unit":"px","default":0},
    { "type": "header", "content": "Scroll-Effekt" },
    { "type": "select", "id": "effect", "label": "Erscheinen beim Scrollen", "default": "up", "options": [ { "value": "none", "label": "Kein Effekt" }, { "value": "fade", "label": "Einblenden" }, { "value": "up", "label": "Von unten (Standard)" }, { "value": "left", "label": "Von links" }, { "value": "right", "label": "Von rechts" }, { "value": "zoom", "label": "Sanfter Zoom" }, { "value": "blur", "label": "Aus der Unschärfe" } ] },
    { "type": "select", "id": "effect_speed", "label": "Effekt-Tempo", "default": "normal", "options": [ { "value": "schnell", "label": "Schnell" }, { "value": "normal", "label": "Normal" }, { "value": "langsam", "label": "Langsam" } ] },
    { "type": "text", "id": "eyebrow", "label": "Kicker-Zeile", "default": "Shop the Look" },
    { "type": "inline_richtext", "id": "heading", "label": "Überschrift", "default": "Ein Bild, <em>alle Produkte dazu.</em>" },
    { "type": "image_picker", "id": "image", "label": "Großes Bild" },
    { "type": "color", "id": "bg", "label": "Hintergrundfarbe", "default": "#FBF8F0" }
  ],
  "blocks": [
    {
      "type": "punkt",
      "name": "Hotspot",
      "settings": [
        { "type": "product", "id": "produkt", "label": "Produkt" },
        { "type": "range", "id": "x", "label": "Position horizontal (%)", "min": 2, "max": 98, "step": 1, "default": 50 },
        { "type": "range", "id": "y", "label": "Position vertikal (%)", "min": 2, "max": 98, "step": 1, "default": 50 }
      ]
    }
  ],
  "presets": [{ "name": "Chelonaki – Lookbook (Hotspots)", "blocks": [ { "type": "punkt" }, { "type": "punkt" } ] }]
}
{% endschema %}
