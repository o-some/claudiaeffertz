{% liquid
  assign home_anchor_prefix = ''
  unless request.page_type == 'index'
    assign home_anchor_prefix = routes.root_url
  endunless
  assign shop_is_active = false
  if request.page_type == 'collection' or request.page_type == 'product' or request.page_type == 'search'
    assign shop_is_active = true
  endif
  assign cta_url = section.settings.cta_link | default: section.settings.cta_target | default: routes.all_products_collection_url
  assign cta_url_first_character = cta_url | slice: 0
  if request.page_type != 'index' and cta_url_first_character == '#'
    assign cta_url = routes.root_url | append: cta_url
  endif
%}
<header class="fi-header{% unless section.settings.sticky_header %} fi-header--static{% endunless %}" id="FiHeader-{{ section.id }}" data-fi-header style="--fi-module-bg:{{ section.settings.module_bg }};--fi-heading-color:{{ section.settings.heading_color }};--fi-text-color:{{ section.settings.text_color }};--fi-accent-color:{{ section.settings.accent_color }};--fi-button-bg:{{ section.settings.button_bg }};--fi-button-text:{{ section.settings.button_text }};--fi-button-hover-bg:{{ section.settings.button_hover_bg }};--fi-button-hover-text:{{ section.settings.button_hover_text }};--fi-border-color:{{ section.settings.border_color }};--fi-cart-color:{{ section.settings.cart_color }};--fi-cart-badge-bg:{{ section.settings.cart_badge_bg }};--fi-cart-badge-text:{{ section.settings.cart_badge_text }}">
  <a class="fi-brand" href="{{ routes.root_url }}" aria-label="{{ section.settings.home_label | escape }}">
    {% render 'fi-logo', width: 34, height: 34 %}
    <span class="fi-brand-name">{{ section.settings.brand_name | escape }} <b>{{ section.settings.brand_suffix | escape }}</b></span>
  </a>

  {% if section.settings.show_navigation %}
    <nav class="fi-nav fi-nav--desktop" aria-label="{{ section.settings.navigation_label | escape }}">
      {% if section.settings.navigation_menu != blank %}
        {% render 'fi-navigation-menu', menu: section.settings.navigation_menu, home_anchor_prefix: home_anchor_prefix %}
      {% elsif settings.fi_generated_navigation %}
        {% render 'fi-generated-navigation', home_anchor_prefix: home_anchor_prefix %}
      {% else %}
        {% render 'fi-generated-navigation', home_anchor_prefix: home_anchor_prefix %}
      {% endif %}
      {% if section.settings.show_shop_shortcut and section.settings.shop_label != blank %}
        <a class="fi-nav-shop{% if shop_is_active %} is-active{% endif %}" href="{{ section.settings.shop_link | default: section.settings.shop_target | default: '#shop' }}"{% if shop_is_active %} aria-current="page"{% endif %}>{{ section.settings.shop_label | escape }}</a>
      {% endif %}
      {% if section.settings.cta_label != blank %}
        <a class="fi-nav-cta" href="{{ cta_url }}">{{ section.settings.cta_label | escape }}</a>
      {% endif %}
      {% if section.settings.show_cart %}
        <a id="cart-icon-bubble" class="fi-cart-link" href="{{ routes.cart_url }}" aria-label="{{ section.settings.cart_label | escape }}{% if cart.item_count > 0 %} - {{ cart.item_count }} Artikel{% endif %}">
          <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M3 4h2l1.7 10.2a2 2 0 0 0 2 1.7h7.9a2 2 0 0 0 2-1.6L20 7H6.1M9 20a1 1 0 1 0 0-2 1 1 0 0 0 0 2Zm8 0a1 1 0 1 0 0-2 1 1 0 0 0 0 2Z" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>
          {% if section.settings.show_cart_text %}<span class="fi-cart-link__text">{{ section.settings.cart_label | escape }}</span>{% endif %}
          {% if cart.item_count > 0 %}<span class="fi-cart-count" aria-hidden="true">{{ cart.item_count }}</span>{% endif %}
        </a>
      {% endif %}
    </nav>

    <details class="fi-mobile-nav" data-fi-mobile-nav>
      <summary aria-label="{{ section.settings.mobile_menu_label | escape }}" aria-expanded="false" aria-controls="FiMobileMenu-{{ section.id }}">
        <span class="fi-mobile-nav__line"></span>
        <span class="fi-mobile-nav__line"></span>
        <span class="fi-mobile-nav__line"></span>
      </summary>
      <nav id="FiMobileMenu-{{ section.id }}" class="fi-mobile-nav__panel" aria-label="{{ section.settings.navigation_label | escape }}">
        {% if section.settings.navigation_menu != blank %}
          {% render 'fi-navigation-menu', menu: section.settings.navigation_menu, home_anchor_prefix: home_anchor_prefix %}
        {% elsif settings.fi_generated_navigation %}
          {% render 'fi-generated-navigation', home_anchor_prefix: home_anchor_prefix %}
        {% else %}
          {% render 'fi-generated-navigation', home_anchor_prefix: home_anchor_prefix %}
        {% endif %}
        {% if section.settings.show_shop_shortcut and section.settings.shop_label != blank %}
          <a{% if shop_is_active %} class="is-active" aria-current="page"{% endif %} href="{{ section.settings.shop_link | default: section.settings.shop_target | default: '#shop' }}">{{ section.settings.shop_label | escape }}</a>
        {% endif %}
        {% if section.settings.show_cart %}
          <a href="{{ routes.cart_url }}">{{ section.settings.cart_label | escape }}{% if cart.item_count > 0 %} ({{ cart.item_count }}){% endif %}</a>
        {% endif %}
        {% if section.settings.cta_label != blank %}
          <a class="fi-nav-cta" href="{{ cta_url }}">{{ section.settings.cta_label | escape }}</a>
        {% endif %}
      </nav>
    </details>
  {% endif %}
</header>

{% schema %}
{
  "name": "Chelonaki · Web Header",
  "tag": "section",
  "class": "fi-header-section",
  "settings": [
    {
      "type": "checkbox",
      "id": "sticky_header",
      "label": "Header beim Scrollen fixieren",
      "default": true
    },
    {
      "type": "text",
      "id": "brand_name",
      "label": "Markenname",
      "default": "CLAUDIA"
    },
    {
      "type": "text",
      "id": "brand_suffix",
      "label": "Markenzusatz",
      "default": "EFFERTZ"
    },
    {
      "type": "text",
      "id": "home_label",
      "label": "Barrierefreier Logo-Link",
      "default": "Claudia Effertz - Startseite"
    },
    {
      "type": "checkbox",
      "id": "show_navigation",
      "label": "Navigation anzeigen",
      "default": true
    },
    {
      "type": "text",
      "id": "navigation_label",
      "label": "Bezeichnung der Navigation",
      "default": "Hauptnavigation"
    },
    {
      "type": "link_list",
      "id": "navigation_menu",
      "label": "Hauptmenü auswählen",
      "info": "Reihenfolge, Namen und Untermenüs bearbeitest du anschließend unter Inhalte > Menüs. Desktop und Handy verwenden immer dasselbe Menü."
    },
    {
      "type": "text",
      "id": "mobile_menu_label",
      "label": "Barrierefreie Bezeichnung des mobilen Menüs",
      "default": "Menü öffnen"
    },
    {
      "type": "text",
      "id": "team_label",
      "label": "Menütext Team",
      "default": "Team"
    },
    {
      "type": "text",
      "id": "books_label",
      "label": "Menütext Bücher",
      "default": "Bücher"
    },
    {
      "type": "text",
      "id": "gallery_label",
      "label": "Menütext Einblicke",
      "default": "Einblicke"
    },
    {
      "type": "text",
      "id": "training_label",
      "label": "Menütext Ausbildung",
      "default": "Ausbildung"
    },
    {
      "type": "text",
      "id": "courses_label",
      "label": "Menütext Videokurse",
      "default": "Videokurse"
    },
    {
      "type": "header",
      "content": "Shop und Warenkorb"
    },
    {
      "type": "checkbox",
      "id": "show_shop_shortcut",
      "label": "Shop-Link zusätzlich anzeigen",
      "default": false,
      "info": "Das gewählte Shopify-Menü bleibt weiterhin vollständig bearbeitbar. Dieser Link ist eine optionale, feste Shop-Abkürzung."
    },
    {
      "type": "text",
      "id": "shop_label",
      "label": "Shop-Link Text",
      "default": "Shop"
    },
    {
      "type": "url",
      "id": "shop_link",
      "label": "Shop-Link auswählen",
      "info": "Zum Beispiel eine Kollektion, die Katalogseite oder eine Shop-Landingpage."
    },
    {
      "type": "text",
      "id": "shop_target",
      "label": "Shop-Anker als Alternative",
      "default": "/collections/all"
    },
    {
      "type": "checkbox",
      "id": "show_cart",
      "label": "Warenkorb anzeigen",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_cart_text",
      "label": "Text neben Warenkorb-Symbol anzeigen",
      "default": false
    },
    {
      "type": "text",
      "id": "cart_label",
      "label": "Warenkorb-Bezeichnung",
      "default": "Warenkorb"
    },
    {
      "type": "text",
      "id": "cta_label",
      "label": "CTA-Text",
      "default": "Kontakt"
    },
    {
      "type": "url",
      "id": "cta_link",
      "label": "CTA-Link auswählen",
      "info": "Hier kannst du eine Shopify-Seite, Landingpage, ein Produkt oder eine externe URL auswählen."
    },
    {
      "type": "text",
      "id": "cta_target",
      "label": "CTA-Anker als Alternative",
      "default": "#kontakt",
      "info": "Nur verwenden, wenn kein CTA-Link ausgewählt ist, z. B. /collections/all."
    },
    {
      "type": "header",
      "content": "Farben dieses Moduls"
    },
    {
      "type": "color",
      "id": "module_bg",
      "label": "Header-Hintergrund",
      "default": "#FBF8F2"
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Markenname / Haupttext",
      "default": "#1E3A5F"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Menütext",
      "default": "#2B3A4A"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Logo-Akzent / Markenzusatz",
      "default": "#C69A4B"
    },
    {
      "type": "color",
      "id": "button_bg",
      "label": "CTA-Hintergrund",
      "default": "#1E3A5F"
    },
    {
      "type": "color",
      "id": "button_text",
      "label": "CTA-Schrift",
      "default": "#FBF8F2"
    },
    {
      "type": "color",
      "id": "button_hover_bg",
      "label": "CTA-Hintergrund bei Hover",
      "default": "#144953"
    },
    {
      "type": "color",
      "id": "button_hover_text",
      "label": "CTA-Schrift bei Hover",
      "default": "#FFFFFF"
    },
    {
      "type": "color",
      "id": "cart_color",
      "label": "Warenkorb-Symbol",
      "default": "#1E3A5F"
    },
    {
      "type": "color",
      "id": "cart_badge_bg",
      "label": "Warenkorb-Zähler Hintergrund",
      "default": "#C69A4B"
    },
    {
      "type": "color",
      "id": "cart_badge_text",
      "label": "Warenkorb-Zähler Schrift",
      "default": "#162C49"
    },
    {
      "type": "color",
      "id": "border_color",
      "label": "Trennlinie",
      "default": "#DFD3BE"
    }
  ]
}
{% endschema %}
