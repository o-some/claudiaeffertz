{% comment %} Chelonaki Shop Theme · © Chelonaki · Build: CHELONAKI-BUILD-0000-MASTER · Nutzung nur mit gültiger Lizenz {% endcomment %}
<style>
  .mgu-sr{max-width:720px;margin:0 auto}
  .mgu-sr-table{width:100%;border-collapse:collapse;font-size:14.5px;border:1px solid var(--mgu-line);border-radius:16px;overflow:hidden}
  .mgu-sr-table th{background:var(--mgu-forest);color:#FCF9F1;font-weight:500;text-align:left;padding:12px 18px;font-family:var(--mgu-font-heading)}
  .mgu-sr-table td{padding:12px 18px;border-top:1px solid var(--mgu-line)}
  .mgu-sr-table tr:nth-child(odd) td{background:var(--mgu-cream)}
  .mgu-sr-pct{font-weight:700;color:var(--mgu-gold)}
  .mgu-sr-note{font-size:13px;color:var(--mgu-ink-soft);margin-top:16px;line-height:1.6}
</style>
<section class="mgu" style="background:{{ section.settings.bg }};padding:clamp(34px,5vw,60px) clamp(20px,4vw,48px)">
  <div class="mgu-sr">
    {%- if section.settings.eyebrow != blank -%}<span class="mgu-eyebrow">{{ section.settings.eyebrow }}</span>{%- endif -%}
    <h2 style="margin:0 0 8px">{{ section.settings.heading }}</h2>
    {%- if section.settings.intro != blank -%}<div style="color:var(--mgu-ink-soft);font-size:15px;margin-bottom:18px">{{ section.settings.intro }}</div>{%- endif -%}
    {%- if section.blocks.size > 0 -%}
      <table class="mgu-sr-table">
        <thead><tr><th>{{ section.settings.spalte_zeit }}</th><th>{{ section.settings.spalte_gebuehr }}</th></tr></thead>
        <tbody>
          {%- for block in section.blocks -%}
            <tr {{ block.shopify_attributes }}>
              <td>{{ block.settings.zeitraum }}</td>
              <td class="mgu-sr-pct">{{ block.settings.gebuehr }}</td>
            </tr>
          {%- endfor -%}
        </tbody>
      </table>
    {%- endif -%}
    {%- if section.settings.hinweis != blank -%}<p class="mgu-sr-note">{{ section.settings.hinweis }}</p>{%- endif -%}
  </div>
</section>
{% style %}
  #shopify-section-{{ section.id }} {
    margin-block-start: {{ section.settings.section_gap_top | default: 0 }}px;
    margin-block-end: {{ section.settings.section_gap_bottom | default: 0 }}px;
  }
{% endstyle %}

{% schema %}
{
  "name": "Chelonaki · Stornoregeln",
  "settings": [
    {"type":"header","content":"Abstand zum nächsten Abschnitt"},
    {"type":"range","id":"section_gap_top","label":"Zusätzlicher Abstand oben","min":0,"max":200,"step":4,"unit":"px","default":0},
    {"type":"range","id":"section_gap_bottom","label":"Zusätzlicher Abstand unten","min":0,"max":200,"step":4,"unit":"px","default":0},
    { "type": "paragraph", "content": "Zeigt Stornobedingungen transparent an (z.B. bei Terminbuchungen). WICHTIG: Diese Section zeigt die Regel nur an – sie erhebt keine Gebühren und hält keine Zahlungsdaten zurück. Die tatsächliche Kautions-Einbehaltung/Rückerstattung braucht eine Buchungs-App mit Zahlungsanbindung (z.B. Sesami, Appointo, BookThatApp) oder ein manuelles Prozedere. Rechtstexte anwaltlich prüfen lassen." },
    { "type": "text", "id": "eyebrow", "label": "Kicker-Zeile", "default": "Wichtig zu wissen" },
    { "type": "inline_richtext", "id": "heading", "label": "Überschrift", "default": "Stornobedingungen" },
    { "type": "richtext", "id": "intro", "label": "Einleitung", "default": "<p>Bei Absage deines Termins gelten je nach Zeitpunkt folgende Stornogebühren:</p>" },
    { "type": "text", "id": "spalte_zeit", "label": "Spalte 1: Titel", "default": "Absage bis" },
    { "type": "text", "id": "spalte_gebuehr", "label": "Spalte 2: Titel", "default": "Gebühr" },
    { "type": "textarea", "id": "hinweis", "label": "Fußnote", "default": "Die Gebühr wird auf Basis des vereinbarten Termin-/Behandlungspreises berechnet. Bei Fragen zu deiner Stornierung wende dich bitte direkt an uns." },
    { "type": "color", "id": "bg", "label": "Hintergrundfarbe", "default": "#FBF8F0" }
  ],
  "blocks": [
    { "type": "regel", "name": "Stornoregel",
      "settings": [
        { "type": "text", "id": "zeitraum", "label": "Zeitraum", "default": "Mehr als 7 Tage vorher" },
        { "type": "text", "id": "gebuehr", "label": "Gebühr", "default": "0 %" }
      ]}
  ],
  "presets": [{
    "name": "Chelonaki – Stornobedingungen",
    "blocks": [
      { "type": "regel", "settings": { "zeitraum": "Mehr als 7 Tage vorher", "gebuehr": "0 %" } },
      { "type": "regel", "settings": { "zeitraum": "Bis 7 Tage vorher", "gebuehr": "100 %" } }
    ]
  }]
}
{% endschema %}
