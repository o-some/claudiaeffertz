<script src="{{ 'ch-consent-embed.js' | asset_url }}" defer="defer"></script>
<section class="ch-section ch-consent-embed" id="ChConsentEmbed-{{ section.id }}">
  <div class="ch-shell">
    {% if section.settings.heading != blank %}<h2>{{ section.settings.heading | escape }}</h2>{% endif %}
    <ch-consent-embed data-source="{{ section.settings.source_url | escape }}" data-domains="{{ section.settings.allowed_domains | escape }}" data-title="{{ section.settings.frame_title | escape }}" data-loaded-text="{{ section.settings.loaded_text | escape }}" data-error-text="{{ section.settings.error_text | escape }}">
      <div class="ch-consent-embed__target" data-ch-consent-target></div>
      <div class="ch-consent-embed__controls">
        <div class="rte">{{ section.settings.consent_text }}</div>
        <button class="ch-button" type="button" data-ch-consent-load>{{ section.settings.button_label | escape }}</button>
        <p role="status" aria-live="polite" data-ch-consent-status></p>
      </div>
    </ch-consent-embed>
  </div>
</section>
{% style %}
  #shopify-section-{{ section.id }} {
    margin-block-start: {{ section.settings.section_gap_top | default: 0 }}px;
    margin-block-end: {{ section.settings.section_gap_bottom | default: 0 }}px;
  }
{% endstyle %}

{% schema %}
{
  "name": "Chelonaki – Consent Embed",
  "tag": "section",
  "class": "ch-consent-embed-section",
  "settings": [
    {"type":"header","content":"Abstand zum nächsten Abschnitt"},
    {"type":"range","id":"section_gap_top","label":"Zusätzlicher Abstand oben","min":0,"max":200,"step":4,"unit":"px","default":0},
    {"type":"range","id":"section_gap_bottom","label":"Zusätzlicher Abstand unten","min":0,"max":200,"step":4,"unit":"px","default":0},
    { "type": "text", "id": "heading", "label": "Überschrift", "default": "Externer Inhalt" },
    { "type": "url", "id": "source_url", "label": "HTTPS-Embed-URL" },
    { "type": "text", "id": "allowed_domains", "label": "Erlaubte Domains", "info": "Kommagetrennt, zum Beispiel youtube-nocookie.com, maps.google.com" },
    { "type": "text", "id": "frame_title", "label": "Barrierefreier Titel", "default": "Externer Inhalt" },
    { "type": "richtext", "id": "consent_text", "label": "Consent-Hinweis", "default": "<p>Beim Laden werden Daten an den externen Anbieter übertragen.</p>" },
    { "type": "text", "id": "button_label", "label": "Button", "default": "Inhalt laden" },
    { "type": "text", "id": "loaded_text", "label": "Erfolgsmeldung", "default": "Externer Inhalt geladen." },
    { "type": "text", "id": "error_text", "label": "Fehlermeldung", "default": "Dieser Inhalt wurde blockiert." }
  ],
  "presets": [{ "name": "Chelonaki – Consent Embed" }]
}
{% endschema %}
