{%- assign txt = product.metafields.custom.lieferzeit | default: section.settings.text -%}
{%- if txt != blank -%}
<p class="mgu" style="display:flex;align-items:center;gap:9px;margin:12px 0;font-size:14.5px;font-weight:600;color:#2E6B45">
  <span style="width:9px;height:9px;border-radius:50%;background:#2E6B45;flex-shrink:0"></span>{{ txt }}
</p>
{%- endif -%}
{% style %}
  #shopify-section-{{ section.id }} {
    margin-block-start: {{ section.settings.section_gap_top | default: 0 }}px;
    margin-block-end: {{ section.settings.section_gap_bottom | default: 0 }}px;
  }
{% endstyle %}

{% schema %}
{
  "name": "Chelonaki – Lieferzeit",
  "settings": [
    {"type":"header","content":"Abstand zum nächsten Abschnitt"},
    {"type":"range","id":"section_gap_top","label":"Zusätzlicher Abstand oben","min":0,"max":200,"step":4,"unit":"px","default":0},
    {"type":"range","id":"section_gap_bottom","label":"Zusätzlicher Abstand unten","min":0,"max":200,"step":4,"unit":"px","default":0},
    { "type": "paragraph", "content": "Zeigt die Lieferzeit nahe dem Preis. Standardtext hier; pro Produkt überschreibbar über Metafeld custom.lieferzeit." },
    { "type": "text", "id": "text", "label": "Standard-Lieferzeit", "default": "Lieferzeit: 2–4 Werktage" }
  ],
  "enabled_on": { "templates": ["product"] },
  "presets": [{ "name": "Chelonaki – Lieferzeit" }]
}
{% endschema %}
