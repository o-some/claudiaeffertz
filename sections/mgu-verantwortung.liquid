{% comment %} Chelonaki Shop Theme · © Chelonaki · Build: CHELONAKI-BUILD-0000-MASTER · Nutzung nur mit gültiger Lizenz {% endcomment %}
<section data-mgu-effect="{{ section.settings.effect | default: 'fade' }}" data-mgu-speed="{{ section.settings.effect_speed | default: 'normal' }}" class="mgu mgu-block" style="background:{{ section.settings.bg }}">
  <div class="mgu-wrap">
    <div class="mgu-reveal" style="max-width:760px;margin:0 auto;text-align:center;border:1.5px solid var(--mgu-gold-soft);border-radius:20px;padding:clamp(26px,4vw,40px)">
      {%- if section.settings.symbol != blank -%}<div style="font-size:2rem;margin-bottom:8px" aria-hidden="true">{{ section.settings.symbol }}</div>{%- endif -%}
      <h2 style="margin:0 0 10px">{{ section.settings.heading }}</h2>
      <div style="color:var(--mgu-ink-soft);font-size:15.5px;line-height:1.7">{{ section.settings.text }}</div>
      {%- if section.settings.link_label != blank and section.settings.link != blank -%}
        <a class="mgu-btn mgu-btn--ghost" style="margin-top:16px" href="{{ section.settings.link }}" {% if section.settings.extern %}target="_blank" rel="noopener"{% endif %}>{{ section.settings.link_label }}</a>
      {%- endif -%}
    </div>
  </div>
</section>
{% style %}
  #shopify-section-{{ section.id }} {
    margin-block-start: {{ section.settings.section_gap_top | default: 0 }}px;
    margin-block-end: {{ section.settings.section_gap_bottom | default: 0 }}px;
  }
{% endstyle %}

{% schema %}
{
  "name": "Chelonaki · Konsumhinweis",
  "settings": [
    {"type":"header","content":"Abstand zum nächsten Abschnitt"},
    {"type":"range","id":"section_gap_top","label":"Zusätzlicher Abstand oben","min":0,"max":200,"step":4,"unit":"px","default":0},
    {"type":"range","id":"section_gap_bottom","label":"Zusätzlicher Abstand unten","min":0,"max":200,"step":4,"unit":"px","default":0},
    { "type": "paragraph", "content": "Hinweisbereich für Jugendschutz / verantwortungsvollen Konsum (z.B. für Alkohol-Shops). Für Footer-nahe Platzierung oder eigene Seite." },
    { "type": "header", "content": "Scroll-Effekt" },
    { "type": "select", "id": "effect", "label": "Erscheinen beim Scrollen", "default": "up", "options": [ { "value": "none", "label": "Kein Effekt" }, { "value": "fade", "label": "Einblenden" }, { "value": "up", "label": "Von unten (Standard)" }, { "value": "left", "label": "Von links" }, { "value": "right", "label": "Von rechts" }, { "value": "zoom", "label": "Sanfter Zoom" }, { "value": "blur", "label": "Aus der Unschärfe" } ] },
    { "type": "select", "id": "effect_speed", "label": "Effekt-Tempo", "default": "normal", "options": [ { "value": "schnell", "label": "Schnell" }, { "value": "normal", "label": "Normal" }, { "value": "langsam", "label": "Langsam" } ] },
    { "type": "text", "id": "symbol", "label": "Symbol (Emoji)", "default": "🔞" },
    { "type": "inline_richtext", "id": "heading", "label": "Überschrift", "default": "Verantwortungsvoll <em>genießen.</em>" },
    { "type": "richtext", "id": "text", "label": "Text", "default": "<p>Unsere Produkte sind ausschließlich für Personen ab dem gesetzlichen Mindestalter bestimmt. Bitte konsumiere verantwortungsvoll. Bei der Zustellung kann eine Alterskontrolle erfolgen.</p>" },
    { "type": "text", "id": "link_label", "label": "Button-Text (optional)", "default": "Mehr zum Jugendschutz" },
    { "type": "url", "id": "link", "label": "Button-Link" },
    { "type": "checkbox", "id": "extern", "label": "Link in neuem Tab öffnen", "default": true },
    { "type": "color", "id": "bg", "label": "Hintergrundfarbe", "default": "#F3EDDF" }
  ],
  "presets": [{ "name": "Chelonaki – Verantwortungsvoller Konsum" }]
}
{% endschema %}
