{% comment %} Chelonaki Shop Theme · © Chelonaki · Build: CHELONAKI-BUILD-0000-MASTER · Nutzung nur mit gültiger Lizenz {% endcomment %}
{%- if section.blocks.size > 0 -%}
<div class="mgu" style="margin:18px 0;border:1px solid var(--mgu-line);border-radius:16px;overflow:hidden">
  <p style="margin:0;padding:12px 18px;background:var(--mgu-cream);font-weight:700;font-size:13px;letter-spacing:.08em;text-transform:uppercase;color:var(--mgu-gold)">{{ section.settings.titel }}</p>
  <table style="width:100%;border-collapse:collapse;font-size:14.5px">
    {%- for block in section.blocks -%}
      <tr {{ block.shopify_attributes }}>
        <td style="padding:11px 18px;border-top:1px solid var(--mgu-line);color:var(--mgu-ink)">{{ block.settings.menge }}</td>
        <td style="padding:11px 18px;border-top:1px solid var(--mgu-line);text-align:right;font-weight:700;color:var(--mgu-forest)">{{ block.settings.vorteil }}</td>
      </tr>
    {%- endfor -%}
  </table>
  {%- if section.settings.hinweis != blank -%}
    <p style="margin:0;padding:10px 18px;font-size:12.5px;color:var(--mgu-ink-soft);border-top:1px solid var(--mgu-line)">{{ section.settings.hinweis }}</p>
  {%- endif -%}
</div>
{%- endif -%}
{% style %}
  #shopify-section-{{ section.id }} {
    margin-block-start: {{ section.settings.section_gap_top | default: 0 }}px;
    margin-block-end: {{ section.settings.section_gap_bottom | default: 0 }}px;
  }
{% endstyle %}

{% schema %}
{
  "name": "Chelonaki – Staffelpreise",
  "settings": [
    {"type":"header","content":"Abstand zum nächsten Abschnitt"},
    {"type":"range","id":"section_gap_top","label":"Zusätzlicher Abstand oben","min":0,"max":200,"step":4,"unit":"px","default":0},
    {"type":"range","id":"section_gap_bottom","label":"Zusätzlicher Abstand unten","min":0,"max":200,"step":4,"unit":"px","default":0},
    { "type": "paragraph", "content": "Reine ANZEIGE der Mengenvorteile. Die eigentlichen Rabatte in Shopify anlegen: Rabatte → Mengenrabatt/automatischer Rabatt." },
    { "type": "text", "id": "titel", "label": "Titel", "default": "Mengenrabatt" },
    { "type": "text", "id": "hinweis", "label": "Fußnote", "default": "Rabatt wird automatisch im Warenkorb abgezogen." }
  ],
  "blocks": [
    { "type": "stufe", "name": "Staffel",
      "settings": [
        { "type": "text", "id": "menge", "label": "Menge", "default": "Ab 3 Stück" },
        { "type": "text", "id": "vorteil", "label": "Vorteil", "default": "−10 %" }
      ]}
  ],
  "enabled_on": { "templates": ["product"] },
  "presets": [{ "name": "Chelonaki – Staffelpreise", "blocks": [ { "type": "stufe" }, { "type": "stufe", "settings": { "menge": "Ab 6 Stück", "vorteil": "−15 %" } } ] }]
}
{% endschema %}
