{% comment %} Chelonaki Shop Theme · © Chelonaki · Build: CHELONAKI-BUILD-0000-MASTER · Nutzung nur mit gültiger Lizenz {% endcomment %}
<style>
  .mgu-nw{background:var(--mgu-cream);border:1px solid var(--mgu-line);border-radius:20px;padding:clamp(20px,3vw,30px);margin:24px 0;max-width:520px}
  .mgu-nw h3{font-size:1.05rem;color:var(--mgu-forest);margin:0 0 14px;letter-spacing:.02em}
  .mgu-nw table{width:100%;border-collapse:collapse;font-size:14.5px}
  .mgu-nw td{padding:9px 4px;border-bottom:1px solid var(--mgu-line);color:var(--mgu-ink)}
  .mgu-nw td:last-child{text-align:right;font-weight:600}
  .mgu-nw tr.mgu-nw-sub td:first-child{padding-left:22px;color:var(--mgu-ink-soft);font-size:13.5px}
  .mgu-nw tr:last-child td{border-bottom:none}
</style>
{%- liquid
  assign mf = product.metafields.custom
  assign hat = false
  if mf.nw_energie_kcal != blank or mf.nw_fett != blank or mf.nw_kohlenhydrate != blank or mf.nw_eiweiss != blank
    assign hat = true
  endif
-%}
{%- if hat -%}
<div class="mgu mgu-nw">
  <h3>{{ section.settings.heading }} {{ section.settings.bezug }}</h3>
  <table>
    {%- if mf.nw_energie_kj != blank or mf.nw_energie_kcal != blank -%}
      <tr><td>{{ 'mgu.food.energie' | t }}</td><td>{% if mf.nw_energie_kj != blank %}{{ mf.nw_energie_kj }} kJ / {% endif %}{{ mf.nw_energie_kcal }} kcal</td></tr>
    {%- endif -%}
    {%- if mf.nw_fett != blank -%}<tr><td>{{ 'mgu.food.fett' | t }}</td><td>{{ mf.nw_fett }} g</td></tr>{%- endif -%}
    {%- if mf.nw_fett_gesaettigt != blank -%}<tr class="mgu-nw-sub"><td>{{ 'mgu.food.fett_ges' | t }}</td><td>{{ mf.nw_fett_gesaettigt }} g</td></tr>{%- endif -%}
    {%- if mf.nw_kohlenhydrate != blank -%}<tr><td>{{ 'mgu.food.kh' | t }}</td><td>{{ mf.nw_kohlenhydrate }} g</td></tr>{%- endif -%}
    {%- if mf.nw_zucker != blank -%}<tr class="mgu-nw-sub"><td>{{ 'mgu.food.zucker' | t }}</td><td>{{ mf.nw_zucker }} g</td></tr>{%- endif -%}
    {%- if mf.nw_ballaststoffe != blank -%}<tr><td>{{ 'mgu.food.ballast' | t }}</td><td>{{ mf.nw_ballaststoffe }} g</td></tr>{%- endif -%}
    {%- if mf.nw_eiweiss != blank -%}<tr><td>{{ 'mgu.food.eiweiss' | t }}</td><td>{{ mf.nw_eiweiss }} g</td></tr>{%- endif -%}
    {%- if mf.nw_salz != blank -%}<tr><td>{{ 'mgu.food.salz' | t }}</td><td>{{ mf.nw_salz }} g</td></tr>{%- endif -%}
  </table>
</div>
{%- endif -%}
{% style %}
  #shopify-section-{{ section.id }} {
    margin-block-start: {{ section.settings.section_gap_top | default: 0 }}px;
    margin-block-end: {{ section.settings.section_gap_bottom | default: 0 }}px;
  }
{% endstyle %}

{% schema %}
{
  "name": "Chelonaki · Nährwerte",
  "settings": [
    {"type":"header","content":"Abstand zum nächsten Abschnitt"},
    {"type":"range","id":"section_gap_top","label":"Zusätzlicher Abstand oben","min":0,"max":200,"step":4,"unit":"px","default":0},
    {"type":"range","id":"section_gap_bottom","label":"Zusätzlicher Abstand unten","min":0,"max":200,"step":4,"unit":"px","default":0},
    { "type": "paragraph", "content": "Zeigt die Nährwerttabelle aus Produkt-Metafeldern (custom.nw_energie_kj, nw_energie_kcal, nw_fett, nw_fett_gesaettigt, nw_kohlenhydrate, nw_zucker, nw_ballaststoffe, nw_eiweiss, nw_salz). Anlegen: siehe HANDBUCH.md, Abschnitt 4. Blendet sich ohne Daten aus. Hinweis: ersetzt keine rechtliche Prüfung." },
    { "type": "text", "id": "heading", "label": "Überschrift", "default": "Nährwerte" },
    { "type": "text", "id": "bezug", "label": "Bezugsgröße", "default": "pro 100 g" }
  ],
  "enabled_on": { "templates": ["product"] },
  "presets": [{ "name": "Chelonaki – Nährwerttabelle" }]
}
{% endschema %}
