{% comment %} Chelonaki Shop Theme · © Chelonaki · Build: CHELONAKI-BUILD-0000-MASTER · Nutzung nur mit gültiger Lizenz {% endcomment %}

<section data-mgu-effect="{{ section.settings.effect | default: 'up' }}" data-mgu-speed="{{ section.settings.effect_speed | default: 'normal' }}" class="mgu mgu-galerie" id="mgu-galerie-{{ section.id }}" style="--mgu-marquee-speed: {{ section.settings.speed }}s;">
  <div class="mgu-sec-head mgu-reveal">
    {%- if section.settings.eyebrow != blank -%}
      <span class="mgu-eyebrow">{{ section.settings.eyebrow }}</span>
    {%- endif -%}
    <h2>{{ section.settings.heading }}</h2>
  </div>
  <div class="mgu-marquee" aria-label="Bildergalerie">
    {%- for i in (1..2) -%}
      {%- for block in section.blocks -%}
        <div class="mgu-m-item" {% if i == 2 %}aria-hidden="true"{% else %}{{ block.shopify_attributes }}{% endif %}>
          {%- if block.settings.image != blank -%}
            <img width="{{ block.settings.image.width }}" height="{{ block.settings.image.height }}" src="{{ block.settings.image | image_url: width: 720 }}"
                 alt="{% if i == 1 %}{{ block.settings.image.alt | default: block.settings.label | escape }}{% endif %}"
                 loading="lazy">
          {%- else -%}
            {{ 'lifestyle-1' | placeholder_svg_tag }}
          {%- endif -%}
          {%- if block.settings.label != blank -%}
            <span>{{ block.settings.label }}</span>
          {%- endif -%}
        </div>
      {%- endfor -%}
    {%- endfor -%}
  </div>
  {%- if section.settings.note != blank -%}
    <p class="mgu-galerie-note">{{ section.settings.note }}</p>
  {%- endif -%}
</section>

{% style %}
  #shopify-section-{{ section.id }} {
    margin-block-start: {{ section.settings.section_gap_top | default: 0 }}px;
    margin-block-end: {{ section.settings.section_gap_bottom | default: 0 }}px;
  }
{% endstyle %}

{% schema %}
{
  "name": "Chelonaki – Galerie",
  "tag": "div",
  "settings": [
    {"type":"header","content":"Abstand zum nächsten Abschnitt"},
    {"type":"range","id":"section_gap_top","label":"Zusätzlicher Abstand oben","min":0,"max":200,"step":4,"unit":"px","default":0},
    {"type":"range","id":"section_gap_bottom","label":"Zusätzlicher Abstand unten","min":0,"max":200,"step":4,"unit":"px","default":0},
    {
      "type": "header",
      "content": "Scroll-Effekt"
    },
    {
      "type": "select",
      "id": "effect",
      "label": "Erscheinen beim Scrollen",
      "default": "up",
      "options": [
        {
          "value": "none",
          "label": "Kein Effekt"
        },
        {
          "value": "fade",
          "label": "Einblenden"
        },
        {
          "value": "up",
          "label": "Von unten (Standard)"
        },
        {
          "value": "left",
          "label": "Von links"
        },
        {
          "value": "right",
          "label": "Von rechts"
        },
        {
          "value": "zoom",
          "label": "Sanfter Zoom"
        },
        {
          "value": "blur",
          "label": "Aus der Unschärfe"
        }
      ]
    },
    {
      "type": "select",
      "id": "effect_speed",
      "label": "Effekt-Tempo",
      "default": "normal",
      "options": [
        {
          "value": "schnell",
          "label": "Schnell"
        },
        {
          "value": "normal",
          "label": "Normal"
        },
        {
          "value": "langsam",
          "label": "Langsam"
        }
      ]
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Kicker-Zeile",
      "default": "Einblicke"
    },
    {
      "type": "inline_richtext",
      "id": "heading",
      "label": "Überschrift (kursiv = <em>)",
      "default": "Einblicke in <em>deine Welt.</em>"
    },
    {
      "type": "text",
      "id": "note",
      "label": "Hinweiszeile unter der Galerie",
      "default": "Bildunterschrift oder Quellenhinweis (optional)"
    },
    {
      "type": "range",
      "id": "speed",
      "label": "Laufgeschwindigkeit (Sekunden pro Durchlauf)",
      "min": 15,
      "max": 90,
      "step": 5,
      "default": 40,
      "info": "Höher = langsamer. Bei Hover pausiert das Band automatisch."
    }
  ],
  "blocks": [
    {
      "type": "bild",
      "name": "Bild",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Foto"
        },
        {
          "type": "text",
          "id": "label",
          "label": "Bildunterschrift",
          "default": "Frische Salate"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Chelonaki – Galerie",
      "blocks": [
        {
          "type": "bild",
          "settings": {
            "label": "Mediterrane Vielfalt"
          }
        },
        {
          "type": "bild",
          "settings": {
            "label": "Frische Salate"
          }
        },
        {
          "type": "bild",
          "settings": {
            "label": "Selbst gebacken"
          }
        },
        {
          "type": "bild",
          "settings": {
            "label": "Aus der Pfanne"
          }
        },
        {
          "type": "bild",
          "settings": {
            "label": "Ofengerichte"
          }
        },
        {
          "type": "bild",
          "settings": {
            "label": "Alltagstauglich"
          }
        }
      ]
    }
  ]
}
{% endschema %}
