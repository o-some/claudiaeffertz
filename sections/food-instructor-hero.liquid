<section class="fi-hero" id="FiTop" data-fi-reveal-scope style="--fi-module-bg:{{ section.settings.module_bg }};--fi-heading-color:{{ section.settings.heading_color }};--fi-text-color:{{ section.settings.text_color }};--fi-accent-color:{{ section.settings.accent_color }};--fi-primary-bg:{{ section.settings.primary_bg }};--fi-primary-text:{{ section.settings.primary_text }};--fi-primary-hover-bg:{{ section.settings.primary_hover_bg }};--fi-primary-hover-text:{{ section.settings.primary_hover_text }};--fi-secondary-bg:{{ section.settings.secondary_bg }};--fi-secondary-text:{{ section.settings.secondary_text }};--fi-secondary-border:{{ section.settings.secondary_border }};--fi-secondary-hover-bg:{{ section.settings.secondary_hover_bg }};--fi-secondary-hover-text:{{ section.settings.secondary_hover_text }};--fi-secondary-hover-border:{{ section.settings.secondary_hover_border }}">
  <div class="fi-hero-copy fi-reveal">
    {% if section.settings.eyebrow != blank %}<span class="fi-eyebrow">{{ section.settings.eyebrow | escape }}</span>{% endif %}
    {% if section.settings.heading_level == 'h2' %}<h2>{{ section.settings.heading }}</h2>{% else %}<h1>{{ section.settings.heading }}</h1>{% endif %}
    <div class="fi-lead rte">{{ section.settings.text }}</div>
    <div class="fi-button-row">
      {% if section.settings.primary_label != blank %}
        <a class="fi-btn fi-btn--primary" href="{{ section.settings.primary_link | default: '#FiBooks' | escape }}">
          {{ section.settings.primary_label | escape }}{% render 'fi-arrow-icon' %}
        </a>
      {% endif %}
      {% if section.settings.secondary_label != blank %}
        <a class="fi-btn fi-btn--ghost" href="{{ section.settings.secondary_link | default: '#FiTraining' | escape }}">{{ section.settings.secondary_label | escape }}</a>
      {% endif %}
    </div>
  </div>

  <div class="fi-hero-visual fi-reveal" style="--fi-reveal-delay:.08s">
    <div class="fi-hero-halo" aria-hidden="true"></div>
    {% if section.settings.hero_image != blank %}
      {{ section.settings.hero_image | image_url: width: 1200 | image_tag: class: 'fi-hero-book', widths: '420, 600, 800, 1000, 1200', sizes: '(max-width: 860px) 72vw, 42vw', loading: 'eager', fetchpriority: 'high', alt: section.settings.hero_image_alt }}
    {% else %}
      <img class="fi-hero-book" src="{{ 'fi-static-001.jpg' | asset_url }}" width="900" height="900" fetchpriority="high" decoding="async" alt="{{ section.settings.hero_image_alt | escape }}">
    {% endif %}
  </div>

  {% if section.settings.show_scroll_hint %}<div class="fi-scroll-hint" aria-hidden="true">{{ section.settings.scroll_hint | escape }}</div>{% endif %}
</section>

{% style %}
  #shopify-section-{{ section.id }} {
    margin-block-start: {{ section.settings.section_gap_top | default: 0 }}px;
    margin-block-end: {{ section.settings.section_gap_bottom | default: 0 }}px;
  }
{% endstyle %}

{% schema %}
{
  "name": "Chelonaki · Web Hero",
  "tag": "section",
  "class": "fi-hero-section",
  "settings": [
    { "type": "select", "id": "heading_level", "label": "Überschriftenebene", "default": "h1", "options": [{ "value": "h1", "label": "H1 – Hauptüberschrift der Seite" }, { "value": "h2", "label": "H2 – Untergeordneter Abschnitt" }] },
    {"type":"header","content":"Abstand zum nächsten Abschnitt"},
    {"type":"range","id":"section_gap_top","label":"Zusätzlicher Abstand oben","min":0,"max":200,"step":4,"unit":"px","default":0},
    {"type":"range","id":"section_gap_bottom","label":"Zusätzlicher Abstand unten","min":0,"max":200,"step":4,"unit":"px","default":0},
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Kleine Überschrift",
      "default": "Markus Riebel · Bücher & Ausbildungen"
    },
    {
      "type": "inline_richtext",
      "id": "heading",
      "label": "Hauptüberschrift",
      "default": "Die Longevity-Küche <em>neu gedacht.</em>"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Einleitung",
      "default": "<p>Bewusste Ernährung, die in ein echtes Leben passt: frische Zutaten, einfache Rezepte und Wissen, das man wirklich umsetzen kann. Ohne Verbote. Ohne komplizierte Regeln. Mit Genuss.</p>"
    },
    {
      "type": "image_picker",
      "id": "hero_image",
      "label": "Hero-Bild (optional)"
    },
    {
      "type": "text",
      "id": "hero_image_alt",
      "label": "Bildbeschreibung",
      "default": "Buchcover: Die Longevity-Küche neu gedacht – Food Instructor MGU von Markus Riebel"
    },
    {
      "type": "text",
      "id": "primary_label",
      "label": "Primärer Button",
      "default": "Bücher entdecken"
    },
    {
      "type": "text",
      "id": "primary_link",
      "label": "Primärer Link oder Anker",
      "default": "#FiBooks"
    },
    {
      "type": "text",
      "id": "secondary_label",
      "label": "Sekundärer Button",
      "default": "Zur Ausbildung"
    },
    {
      "type": "text",
      "id": "secondary_link",
      "label": "Sekundärer Link oder Anker",
      "default": "#FiTraining"
    },
    {
      "type": "checkbox",
      "id": "show_scroll_hint",
      "label": "Scroll-Hinweis anzeigen",
      "default": true
    },
    {
      "type": "text",
      "id": "scroll_hint",
      "label": "Scroll-Hinweis",
      "default": "Scrollen"
    },
    {
      "type": "header",
      "content": "Farben dieses Moduls"
    },
    {
      "type": "color",
      "id": "module_bg",
      "label": "Modul-Hintergrund",
      "default": "#FBF8F0"
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Überschrift",
      "default": "#1F3A2A"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Fließtext",
      "default": "#5C6B60"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Akzenttext",
      "default": "#B9912F"
    },
    {
      "type": "color",
      "id": "primary_bg",
      "label": "Primärer Button – Hintergrund",
      "default": "#1F3A2A"
    },
    {
      "type": "color",
      "id": "primary_text",
      "label": "Primärer Button – Schrift",
      "default": "#FBF8F0"
    },
    {
      "type": "color",
      "id": "primary_hover_bg",
      "label": "Primärer Button – Hover-Hintergrund",
      "default": "#142519"
    },
    {
      "type": "color",
      "id": "primary_hover_text",
      "label": "Primärer Button – Hover-Schrift",
      "default": "#FFFFFF"
    },
    {
      "type": "color",
      "id": "secondary_bg",
      "label": "Sekundärer Button – Hintergrund",
      "default": "#FBF8F0"
    },
    {
      "type": "color",
      "id": "secondary_text",
      "label": "Sekundärer Button – Schrift",
      "default": "#1F3A2A"
    },
    {
      "type": "color",
      "id": "secondary_border",
      "label": "Sekundärer Button – Rahmen",
      "default": "#D9D2C3"
    },
    {
      "type": "color",
      "id": "secondary_hover_bg",
      "label": "Sekundärer Button – Hover-Hintergrund",
      "default": "#F3EDDF"
    },
    {
      "type": "color",
      "id": "secondary_hover_text",
      "label": "Sekundärer Button – Hover-Schrift",
      "default": "#B9912F"
    },
    {
      "type": "color",
      "id": "secondary_hover_border",
      "label": "Sekundärer Button – Hover-Rahmen",
      "default": "#B9912F"
    }
  ],
  "presets": [
    {
      "name": "Chelonaki · Web Hero"
    }
  ]
}
{% endschema %}
