{%- liquid
  assign gift_product = section.settings.product
  assign product_is_gift_card = false
  if gift_product != blank and gift_product.gift_card?
    assign product_is_gift_card = true
  endif

  assign promo_image = section.settings.image
  if promo_image == blank and product_is_gift_card
    assign promo_image = gift_product.featured_image
  endif
-%}

<section
  class="ch-gift-card"
  id="ChGiftCard-{{ section.id }}"
  aria-labelledby="ChGiftCardHeading-{{ section.id }}"
  style="--ch-gift-bg: {{ section.settings.background }}; --ch-gift-surface: {{ section.settings.surface_color }}; --ch-gift-text: {{ section.settings.text_color }}; --ch-gift-accent: {{ section.settings.accent_color }}; --ch-gift-button-text: {{ section.settings.button_text_color }};"
>
  <div class="ch-gift-card__shell">
    <div class="ch-gift-card__layout ch-gift-card__layout--{{ section.settings.image_position }}{% unless promo_image != blank %} ch-gift-card__layout--text-only{% endunless %}">
      <div class="ch-gift-card__content">
        {% if section.settings.eyebrow != blank %}<p class="ch-gift-card__eyebrow">{{ section.settings.eyebrow | escape }}</p>{% endif %}
        <h2 id="ChGiftCardHeading-{{ section.id }}">{{ section.settings.heading | escape }}</h2>
        {% if section.settings.text != blank %}<div class="ch-gift-card__text rte">{{ section.settings.text }}</div>{% endif %}

        {% if section.blocks.size > 0 %}
          <ul class="ch-gift-card__benefits" role="list">
            {% for block in section.blocks %}
              {% if block.settings.text != blank %}
                <li {{ block.shopify_attributes }}><span aria-hidden="true">✓</span>{{ block.settings.text | escape }}</li>
              {% endif %}
            {% endfor %}
          </ul>
        {% endif %}

        {% if product_is_gift_card %}
          <div class="ch-gift-card__purchase">
            <p class="ch-gift-card__price">
              {% if gift_product.price_varies %}<span>{{ section.settings.from_label | escape }}</span> {% endif %}{{ gift_product.price | money }}
            </p>
            <a class="ch-gift-card__button" href="{{ gift_product.url }}">{{ section.settings.button_label | escape }}</a>
          </div>
        {% else %}
          <div class="ch-gift-card__empty" role="status">
            <strong>{{ section.settings.empty_heading | escape }}</strong>
            <span>{{ section.settings.empty_text | escape }}</span>
          </div>
          {% if request.design_mode and gift_product != blank %}
            <p class="ch-gift-card__editor-warning">Das ausgewählte Produkt „{{ gift_product.title | escape }}“ ist kein Shopify-Gutscheinprodukt. Bitte unter Produkte → Gutscheine einen Gutschein erstellen und hier auswählen.</p>
          {% endif %}
        {% endif %}
      </div>

      {% if promo_image != blank %}
        <div class="ch-gift-card__media">
          {{ promo_image
            | image_url: width: 1600
            | image_tag:
              widths: '360, 540, 720, 960, 1200, 1600',
              sizes: '(min-width: 990px) 48vw, calc(100vw - 40px)',
              loading: 'lazy',
              alt: section.settings.image_alt
          }}
          <span class="ch-gift-card__media-badge">{{ section.settings.badge_text | escape }}</span>
        </div>
      {% endif %}
    </div>
  </div>
</section>

{% style %}
  #ChGiftCard-{{ section.id }} { background: linear-gradient(135deg, var(--ch-gift-bg), color-mix(in srgb, var(--ch-gift-bg) 84%, var(--ch-gift-accent))); color: var(--ch-gift-text); padding-block: clamp(56px, 8vw, 112px); }
  #ChGiftCard-{{ section.id }} * { box-sizing: border-box; }
  #ChGiftCard-{{ section.id }} .ch-gift-card__shell { width: min(calc(100% - 32px), 1240px); margin-inline: auto; }
  #ChGiftCard-{{ section.id }} .ch-gift-card__layout { display: grid; overflow: hidden; align-items: stretch; border: 1px solid color-mix(in srgb, var(--ch-gift-text) 12%, transparent); border-radius: clamp(24px, 4vw, 42px); background: var(--ch-gift-surface); box-shadow: 0 28px 70px rgb(20 37 25 / 14%); }
  #ChGiftCard-{{ section.id }} .ch-gift-card__layout--text-only { max-width: 820px; margin-inline: auto; }
  #ChGiftCard-{{ section.id }} .ch-gift-card__content { display: flex; flex-direction: column; justify-content: center; padding: clamp(32px, 6vw, 76px); }
  #ChGiftCard-{{ section.id }} .ch-gift-card__eyebrow { margin: 0 0 14px; color: color-mix(in srgb, var(--ch-gift-accent) 50%, var(--ch-gift-text)); font-size: 1.2rem; font-weight: 750; letter-spacing: .18em; text-transform: uppercase; }
  #ChGiftCard-{{ section.id }} h2 { max-width: 13ch; margin: 0 0 20px; color: inherit; font-family: var(--ch-font-heading, Georgia, serif); font-size: clamp(3.2rem, 5vw, 6.4rem); font-weight: 500; letter-spacing: -.025em; line-height: 1.02; text-wrap: balance; }
  #ChGiftCard-{{ section.id }} .ch-gift-card__text { max-width: 58ch; font-size: clamp(1.6rem, 1.6vw, 1.9rem); line-height: 1.65; opacity: .82; }
  #ChGiftCard-{{ section.id }} .ch-gift-card__text > :first-child { margin-top: 0; }
  #ChGiftCard-{{ section.id }} .ch-gift-card__text > :last-child { margin-bottom: 0; }
  #ChGiftCard-{{ section.id }} .ch-gift-card__benefits { display: grid; gap: 13px; margin: 30px 0 0; padding: 0; list-style: none; }
  #ChGiftCard-{{ section.id }} .ch-gift-card__benefits li { display: flex; align-items: center; gap: 12px; font-weight: 650; }
  #ChGiftCard-{{ section.id }} .ch-gift-card__benefits li span { display: inline-grid; width: 28px; height: 28px; flex: 0 0 28px; place-items: center; border-radius: 50%; background: color-mix(in srgb, var(--ch-gift-accent) 18%, transparent); color: var(--ch-gift-accent); font-size: 1.4rem; }
  #ChGiftCard-{{ section.id }} .ch-gift-card__purchase { display: flex; flex-wrap: wrap; gap: 20px; align-items: center; margin-top: 36px; }
  #ChGiftCard-{{ section.id }} .ch-gift-card__price { margin: 0; font-family: var(--ch-font-heading, Georgia, serif); font-size: clamp(2.6rem, 3.4vw, 4rem); font-weight: 650; line-height: 1; }
  #ChGiftCard-{{ section.id }} .ch-gift-card__price span { font-family: var(--ch-font-body, Arial, sans-serif); font-size: .48em; font-weight: 650; text-transform: uppercase; }
  #ChGiftCard-{{ section.id }} .ch-gift-card__button { display: inline-flex; min-height: 52px; align-items: center; justify-content: center; padding: 14px 28px; border: 1px solid var(--ch-gift-text); border-radius: 999px; background: var(--ch-gift-text); color: var(--ch-gift-button-text); font-weight: 750; line-height: 1.2; text-decoration: none; transition: transform 180ms ease, box-shadow 180ms ease, background-color 180ms ease; }
  #ChGiftCard-{{ section.id }} .ch-gift-card__button:hover { transform: translateY(-2px); box-shadow: 0 12px 24px rgb(20 37 25 / 18%); }
  #ChGiftCard-{{ section.id }} .ch-gift-card__button:focus-visible { outline: 3px solid var(--ch-gift-accent); outline-offset: 4px; }
  #ChGiftCard-{{ section.id }} .ch-gift-card__empty { display: grid; gap: 4px; margin-top: 30px; padding: 18px 20px; border: 1px dashed color-mix(in srgb, var(--ch-gift-text) 28%, transparent); border-radius: 16px; background: color-mix(in srgb, var(--ch-gift-bg) 52%, transparent); }
  #ChGiftCard-{{ section.id }} .ch-gift-card__editor-warning { margin: 12px 0 0; padding: 14px 16px; border-left: 4px solid #b42318; background: #fff1f0; color: #7a271a; font-weight: 650; }
  #ChGiftCard-{{ section.id }} .ch-gift-card__media { position: relative; min-height: 360px; background: color-mix(in srgb, var(--ch-gift-bg) 78%, white); }
  #ChGiftCard-{{ section.id }} .ch-gift-card__media img { display: block; width: 100%; height: 100%; min-height: 360px; object-fit: cover; }
  #ChGiftCard-{{ section.id }} .ch-gift-card__media-badge { position: absolute; inset: 24px 24px auto auto; padding: 9px 14px; border-radius: 999px; background: color-mix(in srgb, var(--ch-gift-surface) 90%, transparent); box-shadow: 0 8px 24px rgb(20 37 25 / 12%); color: var(--ch-gift-text); font-size: 1.2rem; font-weight: 750; letter-spacing: .08em; text-transform: uppercase; backdrop-filter: blur(8px); }
  @media (min-width: 990px) {
    #ChGiftCard-{{ section.id }} .ch-gift-card__layout:not(.ch-gift-card__layout--text-only) { grid-template-columns: minmax(0, 1.02fr) minmax(420px, .98fr); }
    #ChGiftCard-{{ section.id }} .ch-gift-card__layout--left .ch-gift-card__media { order: -1; }
  }
  @media (max-width: 749px) {
    #ChGiftCard-{{ section.id }} .ch-gift-card__shell { width: min(calc(100% - 24px), 1240px); }
    #ChGiftCard-{{ section.id }} .ch-gift-card__content { padding: 32px 24px 38px; }
    #ChGiftCard-{{ section.id }} .ch-gift-card__media { order: -1; min-height: 280px; }
    #ChGiftCard-{{ section.id }} .ch-gift-card__media img { min-height: 280px; }
    #ChGiftCard-{{ section.id }} .ch-gift-card__purchase { align-items: stretch; }
    #ChGiftCard-{{ section.id }} .ch-gift-card__button { width: 100%; }
  }
  @media (prefers-reduced-motion: reduce) {
    #ChGiftCard-{{ section.id }} .ch-gift-card__button { transition: none; }
    #ChGiftCard-{{ section.id }} .ch-gift-card__button:hover { transform: none; }
  }
{% endstyle %}

{% style %}
  #shopify-section-{{ section.id }} {
    margin-block-start: {{ section.settings.section_gap_top | default: 0 }}px;
    margin-block-end: {{ section.settings.section_gap_bottom | default: 0 }}px;
  }
{% endstyle %}

{% schema %}
{
  "name": "Chelonaki · Gutscheine",
  "tag": "section",
  "class": "ch-gift-card-section",
  "settings": [
    {"type":"header","content":"Abstand zum nächsten Abschnitt"},
    {"type":"range","id":"section_gap_top","label":"Zusätzlicher Abstand oben","min":0,"max":200,"step":4,"unit":"px","default":0},
    {"type":"range","id":"section_gap_bottom","label":"Zusätzlicher Abstand unten","min":0,"max":200,"step":4,"unit":"px","default":0},
    { "type": "text", "id": "eyebrow", "label": "Kleine Überschrift", "default": "Freude verschenken" },
    { "type": "text", "id": "heading", "label": "Überschrift", "default": "Der Gutschein für jeden Geschmack" },
    { "type": "richtext", "id": "text", "label": "Text", "default": "<p>Verschenke freie Auswahl – unkompliziert, persönlich und sofort verfügbar.</p>" },
    { "type": "product", "id": "product", "label": "Shopify-Gutscheinprodukt", "info": "Nur echte Shopify-Gutscheinprodukte werden verlinkt." },
    { "type": "text", "id": "from_label", "label": "Text vor variablem Preis", "default": "Ab" },
    { "type": "text", "id": "button_label", "label": "Button-Text", "default": "Gutschein auswählen" },
    { "type": "text", "id": "empty_heading", "label": "Titel ohne Gutschein", "default": "Gutschein wird vorbereitet" },
    { "type": "text", "id": "empty_text", "label": "Hinweis ohne Gutschein", "default": "Wähle im Theme-Editor ein echtes Shopify-Gutscheinprodukt aus." },
    { "type": "image_picker", "id": "image", "label": "Eigenes Bild (optional)" },
    { "type": "text", "id": "image_alt", "label": "Bildbeschreibung", "default": "Geschenkgutschein" },
    { "type": "text", "id": "badge_text", "label": "Text auf Bild", "default": "Digitaler Gutschein" },
    { "type": "select", "id": "image_position", "label": "Bildposition am Desktop", "default": "right", "options": [{ "value": "left", "label": "Links" }, { "value": "right", "label": "Rechts" }] },
    { "type": "color", "id": "background", "label": "Außenfläche", "default": "#efe6cf" },
    { "type": "color", "id": "surface_color", "label": "Kartenfläche", "default": "#fbf8f0" },
    { "type": "color", "id": "text_color", "label": "Textfarbe", "default": "#163524" },
    { "type": "color", "id": "accent_color", "label": "Akzentfarbe", "default": "#b9912f" },
    { "type": "color", "id": "button_text_color", "label": "Button-Textfarbe", "default": "#fbf8f0" }
  ],
  "blocks": [
    { "type": "benefit", "name": "Vorteil", "limit": 6, "settings": [{ "type": "text", "id": "text", "label": "Text", "default": "Digital und sofort verfügbar" }] }
  ],
  "presets": [
    {
      "name": "Chelonaki · Gutscheine",
      "blocks": [
        { "type": "benefit", "settings": { "text": "Digital und sofort verfügbar" } },
        { "type": "benefit", "settings": { "text": "Flexible Beträge zur Auswahl" } },
        { "type": "benefit", "settings": { "text": "Persönlich und unkompliziert" } }
      ]
    }
  ]
}
{% endschema %}
