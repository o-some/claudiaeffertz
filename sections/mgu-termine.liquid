{% comment %} Chelonaki Shop Theme · © Chelonaki · Build: CHELONAKI-BUILD-0000-MASTER · Nutzung nur mit gültiger Lizenz {% endcomment %}

<style>
  .mgu-termin-box{
    background:var(--mgu-paper);border:1px solid var(--mgu-line);
    border-radius:24px;overflow:hidden;
    box-shadow:0 30px 60px -30px rgba(20,37,25,.3);
  }
  .mgu-termin-frame{width:100%;border:0;display:block}
  .mgu-termin-consent{
    display:flex;flex-direction:column;align-items:center;justify-content:center;
    gap:18px;text-align:center;padding:60px 24px;min-height:380px;
  }
  .mgu-termin-consent p{color:var(--mgu-ink-soft);font-size:15px;max-width:480px;margin:0}
  .mgu-termin-consent svg{width:46px;height:46px;stroke:var(--mgu-gold);fill:none;stroke-width:1.6}
  .mgu-termin-actions{display:flex;flex-wrap:wrap;justify-content:center;gap:12px}
  .mgu-termin-fallback{font-size:13px;color:var(--mgu-ink-soft);text-decoration:underline;text-underline-offset:3px}
  .mgu-termin-status{font-size:13px;color:var(--mgu-ink-soft);margin:0;min-height:1.4em}
  @media(max-width:749px){
    .mgu-termin-consent{padding:42px 18px;min-height:330px}
    .mgu-termin-actions{width:100%}
    .mgu-termin-actions .mgu-btn{width:100%;max-width:360px}
    .mgu-termin-frame{min-height:700px}
  }
</style>

<section data-mgu-effect="{{ section.settings.effect | default: 'up' }}" data-mgu-speed="{{ section.settings.effect_speed | default: 'normal' }}" class="mgu mgu-block" id="mgu-termine-{{ section.id }}" style="--mgu-space-top:{{ section.settings.spacing_top }}px;--mgu-space-bottom:{{ section.settings.spacing_bottom }}px;background:{{ section.settings.bg }}">
  <div class="mgu-wrap">
    <div class="mgu-sec-head mgu-reveal" style="text-align:center;margin-left:auto;margin-right:auto">
      {%- if section.settings.eyebrow != blank -%}<span class="mgu-eyebrow">{{ section.settings.eyebrow }}</span>{%- endif -%}
      <h2>{{ section.settings.heading }}</h2>
      {%- if section.settings.text != blank -%}<p>{{ section.settings.text }}</p>{%- endif -%}
    </div>

    {%- liquid
      assign url = ''
      if section.settings.anbieter == 'calendly'
        assign url = section.settings.calendly_url
      else
        assign url = section.settings.google_url
      endif
    -%}

    <div class="mgu-termin-box mgu-reveal">
      {%- if url == blank -%}
        <div class="mgu-termin-consent"><p>Bitte in den Section-Einstellungen die Buchungs-URL eintragen ({{ section.settings.anbieter | capitalize }}).</p></div>
      {%- else -%}
        <div class="mgu-termin-consent"
          data-mgu-termin
          data-provider="{{ section.settings.anbieter | escape }}"
          data-url="{{ url | strip | escape }}"
          data-auto-load="{% if section.settings.consent %}false{% else %}true{% endif %}"
          data-hoehe="{{ section.settings.hoehe }}"
          data-title="Terminbuchung">
          <svg viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="5" width="18" height="16" rx="3"/><path d="M8 3v4M16 3v4M3 10h18"/></svg>
          <p{% unless section.settings.consent %} hidden{% endunless %}>{{ section.settings.consent_text }}</p>
          <div class="mgu-termin-actions">
            <button type="button" class="mgu-btn mgu-btn--primary" data-mgu-termin-load>
              {% if section.settings.consent %}{{ section.settings.consent_button }}{% else %}Kalender wird sicher geladen …{% endif %}
            </button>
          </div>
          <p class="mgu-termin-status" data-mgu-termin-status aria-live="polite"></p>
          <a class="mgu-termin-fallback" data-mgu-termin-fallback hidden target="_blank" rel="noopener noreferrer">
            Kalender alternativ in neuem Fenster öffnen
          </a>
        </div>
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Chelonaki – Terminbuchung",
  "settings": [
    { "type": "header", "content": "Scroll-Effekt" },
    { "type": "select", "id": "effect", "label": "Erscheinen beim Scrollen", "default": "up", "options": [ { "value": "none", "label": "Kein Effekt" }, { "value": "fade", "label": "Einblenden" }, { "value": "up", "label": "Von unten (Standard)" }, { "value": "left", "label": "Von links" }, { "value": "right", "label": "Von rechts" }, { "value": "zoom", "label": "Sanfter Zoom" }, { "value": "blur", "label": "Aus der Unschärfe" } ] },
    { "type": "select", "id": "effect_speed", "label": "Effekt-Tempo", "default": "normal", "options": [ { "value": "schnell", "label": "Schnell" }, { "value": "normal", "label": "Normal" }, { "value": "langsam", "label": "Langsam" } ] },
    { "type": "text", "id": "eyebrow", "label": "Kicker-Zeile", "default": "Beratung" },
    { "type": "inline_richtext", "id": "heading", "label": "Überschrift", "default": "Buche dein <em>persönliches Gespräch.</em>" },
    { "type": "textarea", "id": "text", "label": "Text", "default": "Wähle einfach einen freien Termin – wir freuen uns auf dich." },
    { "type": "header", "content": "Kalender-Anbieter" },
    { "type": "select", "id": "anbieter", "label": "Anbieter", "default": "calendly",
      "options": [
        { "value": "calendly", "label": "Calendly" },
        { "value": "google", "label": "Google Kalender (Terminplan)" }
      ]},
    { "type": "text", "id": "calendly_url", "label": "Calendly-Link", "info": "z.B. https://calendly.com/dein-name/beratung – findest du in Calendly unter „Teilen“" },
    { "type": "text", "id": "google_url", "label": "Google-Terminplan-Link", "info": "Google Kalender → Terminplan erstellen → „Website-Einbindung/Link teilen“ → URL hier einfügen" },
    { "type": "range", "id": "hoehe", "label": "Höhe (px)", "min": 500, "max": 1200, "step": 50, "default": 750 },
    { "type": "header", "content": "Datenschutz (Zwei-Klick-Lösung)" },
    { "type": "checkbox", "id": "consent", "label": "Kalender erst nach Klick laden (DSGVO-freundlich)", "default": true },
    { "type": "textarea", "id": "consent_text", "label": "Hinweistext", "default": "Zum Buchen wird der externe Kalender geladen. Dabei werden Daten an den Anbieter (Calendly bzw. Google) übertragen." },
    { "type": "text", "id": "consent_button", "label": "Button-Beschriftung", "default": "Kalender laden & Termin wählen" },
    { "type": "header", "content": "Abstände zum nächsten Abschnitt" },
    { "type": "range", "id": "spacing_top", "label": "Abstand oben", "min": 0, "max": 160, "step": 8, "unit": "px", "default": 80 },
    { "type": "range", "id": "spacing_bottom", "label": "Abstand unten", "min": 0, "max": 160, "step": 8, "unit": "px", "default": 80 },
    { "type": "color", "id": "bg", "label": "Hintergrundfarbe", "default": "#F3EDDF" }
  ],
  "presets": [{ "name": "Chelonaki – Terminbuchung" }]
}
{% endschema %}
