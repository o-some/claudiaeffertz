{% comment %} Chelonaki Shop Theme · © Chelonaki · Build: CHELONAKI-BUILD-0000-MASTER · Nutzung nur mit gültiger Lizenz {% endcomment %}

<section data-mgu-effect="{{ section.settings.effect | default: 'up' }}" data-mgu-speed="{{ section.settings.effect_speed | default: 'normal' }}" class="mgu mgu-books mgu-block" id="mgu-books-{{ section.id }}">
  <div class="mgu-wrap">
    <div class="mgu-sec-head mgu-reveal">
      {%- if section.settings.eyebrow != blank -%}
        <span class="mgu-eyebrow">{{ section.settings.eyebrow }}</span>
      {%- endif -%}
      <h2>{{ section.settings.heading }}</h2>
      {%- if section.settings.text != blank -%}
        <p>{{ section.settings.text }}</p>
      {%- endif -%}
    </div>
    <div class="mgu-book-grid">
      {%- for block in section.blocks -%}
        <article class="mgu-card mgu-reveal" {% if forloop.index > 1 %}style="transition-delay:{{ forloop.index0 | times: 0.1 }}s"{% endif %} {{ block.shopify_attributes }}>
          {%- if block.settings.tag != blank -%}
            <span class="mgu-tag">{{ block.settings.tag }}</span>
          {%- endif -%}
          <div class="mgu-card-cover">
            {%- if block.settings.image != blank -%}
              <img width="{{ block.settings.image.width }}" height="{{ block.settings.image.height }}" src="{{ block.settings.image | image_url: width: 600 }}"
                   srcset="{{ block.settings.image | image_url: width: 400 }} 400w, {{ block.settings.image | image_url: width: 600 }} 600w"
                   sizes="(max-width: 960px) 90vw, 360px"
                   alt="{{ block.settings.image.alt | default: block.settings.title | escape }}"
                   loading="lazy">
            {%- else -%}
              {{ 'product-1' | placeholder_svg_tag }}
            {%- endif -%}
          </div>
          <h3>{{ block.settings.title }}</h3>
          <p>{{ block.settings.text }}</p>
          {%- if block.settings.link != blank -%}<a class="mgu-card-cta" href="{{ block.settings.link }}">
            {{ block.settings.link_label | default: 'Buch ansehen' }}
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none"><path d="M5 12h14M13 6l6 6-6 6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
          </a>{%- endif -%}
        </article>
      {%- endfor -%}
    </div>
  </div>
</section>

{% style %}
  #shopify-section-{{ section.id }} {
    margin-block-start: {{ section.settings.section_gap_top | default: 0 }}px;
    margin-block-end: {{ section.settings.section_gap_bottom | default: 0 }}px;
  }
{% endstyle %}

{% schema %}
{
  "name": "Chelonaki – Bücher",
  "tag": "div",
  "settings": [
    {"type":"header","content":"Abstand zum nächsten Abschnitt"},
    {"type":"range","id":"section_gap_top","label":"Zusätzlicher Abstand oben","min":0,"max":200,"step":4,"unit":"px","default":0},
    {"type":"range","id":"section_gap_bottom","label":"Zusätzlicher Abstand unten","min":0,"max":200,"step":4,"unit":"px","default":0},
    {
      "type": "header",
      "content": "Scroll-Effekt"
    },
    {
      "type": "select",
      "id": "effect",
      "label": "Erscheinen beim Scrollen",
      "default": "up",
      "options": [
        {
          "value": "none",
          "label": "Kein Effekt"
        },
        {
          "value": "fade",
          "label": "Einblenden"
        },
        {
          "value": "up",
          "label": "Von unten (Standard)"
        },
        {
          "value": "left",
          "label": "Von links"
        },
        {
          "value": "right",
          "label": "Von rechts"
        },
        {
          "value": "zoom",
          "label": "Sanfter Zoom"
        },
        {
          "value": "blur",
          "label": "Aus der Unschärfe"
        }
      ]
    },
    {
      "type": "select",
      "id": "effect_speed",
      "label": "Effekt-Tempo",
      "default": "normal",
      "options": [
        {
          "value": "schnell",
          "label": "Schnell"
        },
        {
          "value": "normal",
          "label": "Normal"
        },
        {
          "value": "langsam",
          "label": "Langsam"
        }
      ]
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Kicker-Zeile",
      "default": "Unsere Produkte"
    },
    {
      "type": "inline_richtext",
      "id": "heading",
      "label": "Überschrift (kursiv = <em>)",
      "default": "Unsere <em>Highlights.</em>"
    },
    {
      "type": "textarea",
      "id": "text",
      "label": "Text",
      "default": "Stelle hier deine drei wichtigsten Produkte oder Angebote vor."
    }
  ],
  "blocks": [
    {
      "type": "book",
      "name": "Buch",
      "settings": [
        {
          "type": "text",
          "id": "tag",
          "label": "Kategorie-Tag",
          "default": "Kochbuch"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Cover"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Titel",
          "default": "Buchtitel"
        },
        {
          "type": "textarea",
          "id": "text",
          "label": "Beschreibung"
        },
        {
          "type": "text",
          "id": "link_label",
          "label": "Link-Beschriftung",
          "default": "Buch ansehen"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link (z.B. Produktseite)"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Chelonaki – Bücher",
      "blocks": [
        {
          "type": "book",
          "settings": {
            "tag": "Kategorie",
            "title": "Produkt eins",
            "text": "Kurze Beschreibung des ersten Produkts."
          }
        },
        {
          "type": "book",
          "settings": {
            "tag": "Kategorie",
            "title": "Produkt zwei",
            "text": "Kurze Beschreibung des zweiten Produkts."
          }
        },
        {
          "type": "book",
          "settings": {
            "tag": "Kategorie",
            "title": "Produkt drei",
            "text": "Kurze Beschreibung des dritten Produkts.",
            "link_label": "Mehr erfahren"
          }
        }
      ]
    }
  ]
}
{% endschema %}
