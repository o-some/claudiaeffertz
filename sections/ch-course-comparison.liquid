<section class="ch-section ch-comparison" aria-labelledby="ChComparisonHeading-{{ section.id }}">
  <div class="ch-shell">
    <h2 id="ChComparisonHeading-{{ section.id }}">{{ section.settings.heading | escape }}</h2>
    {% if section.settings.intro != blank %}<div class="rte">{{ section.settings.intro }}</div>{% endif %}
    <div class="ch-comparison__grid">
      {% for block in section.blocks %}
        {% assign product = block.settings.product %}
        <article class="ch-card ch-comparison__card" {{ block.shopify_attributes }}>
          <h3>{% if product != blank %}{{ product.title | escape }}{% else %}{{ block.settings.title | escape }}{% endif %}</h3>
          {% if product != blank %}{% render 'price', product: product, use_variant: true %}{% endif %}
          {% if block.settings.features != blank %}<div class="rte">{{ block.settings.features }}</div>{% endif %}
          {% if product != blank %}<a class="ch-button" href="{{ product.url }}">{{ block.settings.action_label | escape }}</a>{% endif %}
        </article>
      {% endfor %}
    </div>
  </div>
</section>
{% style %}
  #shopify-section-{{ section.id }} {
    margin-block-start: {{ section.settings.section_gap_top | default: 0 }}px;
    margin-block-end: {{ section.settings.section_gap_bottom | default: 0 }}px;
  }
{% endstyle %}

{% schema %}
{
  "name": "Chelonaki – Kursvergleich",
  "settings": [
    {"type":"header","content":"Abstand zum nächsten Abschnitt"},
    {"type":"range","id":"section_gap_top","label":"Zusätzlicher Abstand oben","min":0,"max":200,"step":4,"unit":"px","default":0},
    {"type":"range","id":"section_gap_bottom","label":"Zusätzlicher Abstand unten","min":0,"max":200,"step":4,"unit":"px","default":0},
    { "type": "text", "id": "heading", "label": "Überschrift", "default": "Welcher Kurs passt zu dir?" },
    { "type": "richtext", "id": "intro", "label": "Einleitung" }
  ],
  "blocks": [{ "type": "offer", "name": "Kurs oder Paket", "limit": 4, "settings": [
    { "type": "product", "id": "product", "label": "Shopify-Produkt/Bundle" },
    { "type": "text", "id": "title", "label": "Fallback-Titel" },
    { "type": "richtext", "id": "features", "label": "Enthaltene Leistungen" },
    { "type": "text", "id": "action_label", "label": "Aktion", "default": "Details ansehen" }
  ] }],
  "presets": [{ "name": "Chelonaki – Kursvergleich" }]
}
{% endschema %}
