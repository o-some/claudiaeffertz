    {
      "type": "select",
      "id": "effect_speed",
      "label": "Effekt-Tempo",
      "default": "normal",
      "options": [
        {
          "value": "schnell",
          "label": "Schnell"
        },
        {
          "value": "normal",
          "label": "Normal"
        },
        {
          "value": "langsam",
          "label": "Langsam"
        }
      ]
    },
    {
      "type": "color",
      "id": "bg",
      "label": "Hintergrundfarbe",
      "default": "#F3EDDF"
    }
  ],
  "blocks": [
    {
      "type": "usp",
      "name": "Vorteil",
      "settings": [
        {
          "type": "text",
          "id": "icon",
          "label": "Symbol (Emoji)",
          "default": "✓"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Titel",
          "default": "Schneller Versand"
        },
        {
          "type": "text",
          "id": "text",
          "label": "Text",
          "default": "In 2–4 Werktagen bei dir"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Chelonaki – Vorteile / USP",
      "blocks": [
        {
          "type": "usp",
          "settings": {
            "icon": "📦",
            "title": "Schneller Versand",
            "text": "In 2–4 Werktagen bei dir"
          }
        },
        {
          "type": "usp",
          "settings": {
            "icon": "🌿",
            "title": "Bewusste Qualität",
            "text": "Nach der MGU-Methode entwickelt"
          }
        },
        {
          "type": "usp",
          "settings": {
            "icon": "🔒",
            "title": "Sicher bezahlen",
            "text": "SSL-verschlüsselt & geprüft"
          }
        },
        {
          "type": "usp",
          "settings": {
            "icon": "💬",
            "title": "Persönliche Beratung",
            "text": "Wir sind für dich da"
          }
        }
      ]
    }
  ]
}
