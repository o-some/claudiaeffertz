        {
          "value": "fade",
          "label": "Einblenden"
        },
        {
          "value": "up",
          "label": "Von unten (Standard)"
        },
        {
          "value": "left",
          "label": "Von links"
        },
        {
          "value": "right",
          "label": "Von rechts"
        },
        {
          "value": "zoom",
          "label": "Sanfter Zoom"
        },
        {
          "value": "blur",
          "label": "Aus der Unschärfe"
        }
      ]
