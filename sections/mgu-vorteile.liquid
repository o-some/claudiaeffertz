{% comment %} Chelonaki Shop Theme · © Chelonaki · Build: CHELONAKI-BUILD-0000-MASTER · Nutzung nur mit gültiger Lizenz {% endcomment %}

<style>
  .mgu-trust-grid{
    display:grid;grid-template-columns:repeat(auto-fit,minmax(220px,1fr));
    gap:18px;max-width:var(--mgu-max);margin:0 auto;
  }
  .mgu-trust-item{
    display:flex;align-items:flex-start;gap:16px;
    background:var(--mgu-paper);border:1px solid var(--mgu-line);
    border-radius:18px;padding:22px 24px;
    transition:transform .3s,box-shadow .3s;
  }
  .mgu-trust-item:hover{transform:translateY(-4px);box-shadow:0 20px 40px -22px rgba(20,37,25,.3)}
  .mgu-trust-icon{
    flex-shrink:0;width:44px;height:44px;border-radius:50%;
    background:var(--mgu-forest);color:var(--mgu-gold-soft);
    display:flex;align-items:center;justify-content:center;font-size:20px;
  }
  .mgu-trust-item h3{font-size:15.5px;font-weight:600;color:var(--mgu-forest);margin:0}
  .mgu-trust-item p{font-size:14px;color:var(--mgu-ink-soft);margin-top:3px}
</style>

<section data-mgu-effect="{{ section.settings.effect | default: 'up' }}" data-mgu-speed="{{ section.settings.effect_speed | default: 'normal' }}" class="mgu" id="mgu-trust-{{ section.id }}"
         style="background:{{ section.settings.bg }};padding:clamp(34px,4vw,56px) clamp(20px,4vw,48px);">
  <div class="mgu-trust-grid">
    {%- for block in section.blocks -%}
      <div class="mgu-trust-item mgu-reveal"
           {% if forloop.index > 1 %}style="transition-delay:{{ forloop.index0 | times: 0.07 }}s"{% endif %}
           {{ block.shopify_attributes }}>
        <span class="mgu-trust-icon">{{ block.settings.icon }}</span>
        <div>
          <h3>{{ block.settings.title }}</h3>
          {%- if block.settings.text != blank -%}<p>{{ block.settings.text }}</p>{%- endif -%}
        </div>
      </div>
    {%- endfor -%}
  </div>
</section>

{% style %}
  #shopify-section-{{ section.id }} {
    margin-block-start: {{ section.settings.section_gap_top | default: 0 }}px;
    margin-block-end: {{ section.settings.section_gap_bottom | default: 0 }}px;
  }
{% endstyle %}

{% schema %}
{
  "name": "Chelonaki · Vorteile",
  "tag": "div",
  "settings": [
    {"type":"header","content":"Abstand zum nächsten Abschnitt"},
