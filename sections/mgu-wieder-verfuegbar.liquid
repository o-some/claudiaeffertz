{% comment %} Chelonaki Shop Theme · © Chelonaki · Build: CHELONAKI-BUILD-0000-MASTER · Nutzung nur mit gültiger Lizenz {% endcomment %}

{%- unless product.available -%}
<div class="mgu" style="margin:18px 0;padding:22px;border:1.5px dashed var(--mgu-gold-soft);border-radius:18px;background:var(--mgu-cream)">
  <p style="margin:0 0 12px;font-weight:600;color:var(--mgu-forest)">{{ section.settings.heading }}</p>
  {%- assign back_in_stock_form_id = 'BackInStockForm-' | append: section.id -%}
  {%- form 'customer', id: back_in_stock_form_id, class: 'mgu-kurse-form' -%}
    <input type="hidden" name="contact[tags]" value="backinstock,bis-{{ product.handle }}">
    {%- if form.posted_successfully? -%}
      <p style="color:var(--mgu-forest);font-weight:600;margin:0" role="status" tabindex="-1">{{ section.settings.success }}</p>
    {%- else -%}
      <label class="visually-hidden" for="BackInStockEmail-{{ section.id }}">E-Mail-Adresse</label>
      <input id="BackInStockEmail-{{ section.id }}" type="email" name="contact[email]" required autocomplete="email" placeholder="{{ section.settings.placeholder | escape }}"{% if form.errors %} aria-invalid="true" aria-describedby="BackInStockErrors-{{ section.id }}"{% endif %}
             style="flex:1;min-width:200px;padding:12px 18px;border-radius:99px;border:1.5px solid rgba(31,58,42,.2);font-family:inherit">
      <button class="mgu-btn mgu-btn--primary" type="submit">{{ section.settings.button }}</button>
      {%- if form.errors -%}<p id="BackInStockErrors-{{ section.id }}" role="alert">{{ form.errors | default_errors }}</p>{%- endif -%}
    {%- endif -%}
  {%- endform -%}
</div>
{%- endunless -%}

{% style %}
  #shopify-section-{{ section.id }} {
    margin-block-start: {{ section.settings.section_gap_top | default: 0 }}px;
    margin-block-end: {{ section.settings.section_gap_bottom | default: 0 }}px;
  }
{% endstyle %}

{% schema %}
{
  "name": "Chelonaki · Verfügbarkeit",
  "settings": [
    {"type":"header","content":"Abstand zum nächsten Abschnitt"},
    {"type":"range","id":"section_gap_top","label":"Zusätzlicher Abstand oben","min":0,"max":200,"step":4,"unit":"px","default":0},
    {"type":"range","id":"section_gap_bottom","label":"Zusätzlicher Abstand unten","min":0,"max":200,"step":4,"unit":"px","default":0},
    { "type": "paragraph", "content": "Zeigt sich nur bei ausverkauften Produkten. Interessenten werden mit Tags 'backinstock' + 'bis-produkthandle' als Kunden gespeichert – beim Nachfüllen einfach diese Kundengruppe anschreiben." },
    { "type": "text", "id": "heading", "label": "Überschrift", "default": "Ausverkauft – wir benachrichtigen dich, sobald es wieder da ist:" },
    { "type": "text", "id": "placeholder", "label": "Platzhalter", "default": "Deine E-Mail-Adresse" },
    { "type": "text", "id": "button", "label": "Button", "default": "Benachrichtigen" },
    { "type": "text", "id": "success", "label": "Erfolgsmeldung", "default": "Alles klar – wir melden uns!" }
  ],
  "enabled_on": { "templates": ["product"] },
  "presets": [{ "name": "Chelonaki – Wieder verfügbar" }]
}
{% endschema %}
