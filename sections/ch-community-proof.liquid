<section class="ch-section ch-community" aria-labelledby="ChCommunityHeading-{{ section.id }}">
  <div class="ch-shell"><h2 id="ChCommunityHeading-{{ section.id }}">{{ section.settings.heading | escape }}</h2>
    {% if section.settings.intro != blank %}<div class="rte">{{ section.settings.intro }}</div>{% endif %}
    <div class="ch-community__grid">
      {% for block in section.blocks %}<article class="ch-card ch-community__item" {{ block.shopify_attributes }}>
        {% if block.type == 'review' %}
          <p aria-label="{{ block.settings.rating }} von 5 Sternen">{{ block.settings.rating }}/5</p>
          <blockquote>{{ block.settings.body | escape }}</blockquote>
          <p>{{ block.settings.author | escape }}{% if block.settings.verification_source != blank %} · <span class="ch-badge">{{ section.settings.verified_label | escape }}</span>{% endif %}</p>
        {% else %}<h3>{{ block.settings.question | escape }}</h3><p>{{ block.settings.answer | escape }}</p>{% endif %}
      </article>{% else %}<p>{{ section.settings.empty_text | escape }}</p>{% endfor %}
    </div>
  </div>
</section>
{% style %}
  #shopify-section-{{ section.id }} {
    margin-block-start: {{ section.settings.section_gap_top | default: 0 }}px;
    margin-block-end: {{ section.settings.section_gap_bottom | default: 0 }}px;
  }
{% endstyle %}

{% schema %}
{
  "name": "Chelonaki – Community",
  "settings": [
    {"type":"header","content":"Abstand zum nächsten Abschnitt"},
    {"type":"range","id":"section_gap_top","label":"Zusätzlicher Abstand oben","min":0,"max":200,"step":4,"unit":"px","default":0},
    {"type":"range","id":"section_gap_bottom","label":"Zusätzlicher Abstand unten","min":0,"max":200,"step":4,"unit":"px","default":0},
    { "type": "text", "id": "heading", "label": "Überschrift", "default": "Erfahrungen und Fragen" },
    { "type": "richtext", "id": "intro", "label": "Einleitung" },
    { "type": "text", "id": "verified_label", "label": "Nachweis-Bezeichnung", "default": "Verifizierte Quelle" },
    { "type": "text", "id": "empty_text", "label": "Leerzustand", "default": "Noch keine freigegebenen Beiträge vorhanden." }
  ],
  "blocks": [
    { "type": "review", "name": "Bewertung", "settings": [
      { "type": "range", "id": "rating", "label": "Bewertung", "min": 1, "max": 5, "step": 1, "default": 5 },
      { "type": "textarea", "id": "body", "label": "Text" }, { "type": "text", "id": "author", "label": "Anzeigename" },
      { "type": "url", "id": "verification_source", "label": "Prüfbare Anbieterquelle" }
    ] },
    { "type": "question", "name": "Produktfrage", "settings": [
      { "type": "text", "id": "question", "label": "Frage" }, { "type": "textarea", "id": "answer", "label": "Moderierte Antwort" }
    ] }
  ],
  "presets": [{ "name": "Chelonaki – Community" }]
}
{% endschema %}
