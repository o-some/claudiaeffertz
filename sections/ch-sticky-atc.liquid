{{ 'ch-sticky-atc.css' | asset_url | stylesheet_tag }}
<script src="{{ 'ch-sticky-atc.js' | asset_url }}" defer="defer"></script>

{% assign current_variant = product.selected_or_first_available_variant %}
{% if product != blank and section.settings.enabled %}
  <ch-sticky-atc class="ch-sticky-atc" data-section-id="{{ section.id }}" data-share-success="{{ section.settings.share_success | escape }}" data-share-error="{{ section.settings.share_error | escape }}" hidden>
    <div class="ch-sticky-atc__inner">
      <div class="ch-sticky-atc__product">
        {% if product.featured_image != blank %}{{ product.featured_image | image_url: width: 120 | image_tag: loading: 'lazy', widths: '60, 90, 120', sizes: '60px', alt: '' }}{% endif %}
        <div><strong>{{ product.title | escape }}</strong><span data-ch-sticky-price>{{ current_variant.price | money_with_currency }}</span></div>
      </div>
      <div class="ch-sticky-atc__adapters">
        {% if section.settings.compare_link != blank and section.settings.compare_label != blank %}<a href="{{ section.settings.compare_link }}" data-ch-feature-adapter="compare">{{ section.settings.compare_label | escape }}</a>{% endif %}
        {% if section.settings.wishlist_link != blank and section.settings.wishlist_label != blank %}<a href="{{ section.settings.wishlist_link }}" data-ch-feature-adapter="wishlist">{{ section.settings.wishlist_label | escape }}</a>{% endif %}
        {% if section.settings.show_share %}<button type="button" data-ch-sticky-share data-share-url="{{ product.url | within: collection }}">{{ section.settings.share_label | escape }}</button>{% endif %}
      </div>
      <button class="ch-button ch-sticky-atc__button" type="button" data-ch-sticky-submit{% unless current_variant.available %} disabled{% endunless %}>
        <span data-ch-sticky-label>{% if current_variant.available %}{{ section.settings.button_label | escape }}{% else %}{{ section.settings.sold_out_label | escape }}{% endif %}</span>
      </button>
      <p class="ch-visually-hidden" role="status" data-ch-sticky-status></p>
    </div>
  </ch-sticky-atc>
{% endif %}

{% schema %}
{
  "name": "Chelonaki – Sticky Kaufen",
  "tag": "section",
  "class": "ch-sticky-atc-section",
  "enabled_on": { "templates": ["product"] },
  "settings": [
    { "type": "checkbox", "id": "enabled", "label": "Auf Mobilgeräten aktiv", "default": true },
    { "type": "text", "id": "button_label", "label": "Kaufen-Text", "default": "In den Warenkorb" },
    { "type": "text", "id": "sold_out_label", "label": "Ausverkauft-Text", "default": "Ausverkauft" },
    { "type": "header", "content": "Optionale Adapter" },
    { "type": "text", "id": "compare_label", "label": "Vergleich-Text", "default": "Vergleichen" },
    { "type": "url", "id": "compare_link", "label": "Vergleich-Link", "info": "Ohne bestätigte Zielseite bleibt die Aktion verborgen." },
    { "type": "text", "id": "wishlist_label", "label": "Merken-Text", "default": "Merken" },
    { "type": "url", "id": "wishlist_link", "label": "Merken-Link", "info": "Ohne bestätigte App-/Zielseite bleibt die Aktion verborgen." },
    { "type": "checkbox", "id": "show_share", "label": "Teilen anzeigen", "default": false },
    { "type": "text", "id": "share_label", "label": "Teilen-Text", "default": "Teilen" },
    { "type": "text", "id": "share_success", "label": "Teilen-Erfolg", "default": "Link wurde geteilt." },
    { "type": "text", "id": "share_error", "label": "Teilen-Fehler", "default": "Teilen ist momentan nicht verfügbar." }
  ],
  "presets": [{ "name": "Chelonaki – Sticky Kaufen" }]
}
{% endschema %}
