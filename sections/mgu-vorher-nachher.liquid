{% comment %} Chelonaki Shop Theme · © Chelonaki · Build: CHELONAKI-BUILD-0000-MASTER · Nutzung nur mit gültiger Lizenz {% endcomment %}

<style>
  .mgu-vn{position:relative;width:100%;max-width:var(--mgu-vn-max-width);height:var(--mgu-vn-height);margin-inline:auto;border-radius:24px;overflow:hidden;box-shadow:0 40px 80px -35px rgba(20,37,25,.45);user-select:none;background:rgba(20,37,25,.08)}
  .mgu-vn img{width:100%;height:100%;display:block;object-fit:cover;object-position:center;pointer-events:none}
  .mgu-vn-top{position:absolute;inset:0;overflow:hidden}
  .mgu-vn-top img{position:absolute;inset:0}
  .mgu-vn input{position:absolute;z-index:4;inset:0;width:100%;height:100%;opacity:0;cursor:ew-resize;margin:0}
  .mgu-vn-line{position:absolute;z-index:3;top:0;bottom:0;width:4px;background:#fff;box-shadow:0 0 0 1px rgba(20,37,25,.28),0 0 16px rgba(20,37,25,.3);transform:translateX(-50%);pointer-events:none}
  .mgu-vn-handle{position:absolute;top:50%;left:50%;transform:translate(-50%,-50%);min-width:64px;min-height:64px;padding:8px 10px;border:3px solid #fff;border-radius:999px;background:var(--mgu-gold);color:var(--mgu-forest-deep);display:flex;flex-direction:column;align-items:center;justify-content:center;gap:1px;font-weight:800;line-height:1;box-shadow:0 12px 30px -8px rgba(0,0,0,.55)}
  .mgu-vn-handle__arrows{font-size:24px;letter-spacing:-.08em}
  .mgu-vn-handle__text{font-size:10px;letter-spacing:.08em;text-transform:uppercase}
  .mgu-vn:focus-within .mgu-vn-handle{outline:3px solid var(--mgu-forest-deep);outline-offset:4px}
  .mgu-vn-tag{position:absolute;top:16px;z-index:2;background:rgba(20,37,25,.7);color:#FCF9F1;font-size:12px;font-weight:600;letter-spacing:.12em;text-transform:uppercase;padding:7px 14px;border-radius:99px;backdrop-filter:blur(6px)}
  .mgu-vn-tag--l{left:16px}.mgu-vn-tag--r{right:16px}
  @media(max-width:749px){.mgu-vn{height:var(--mgu-vn-height-mobile);border-radius:18px}.mgu-vn-handle{min-width:58px;min-height:58px}.mgu-vn-tag{top:12px;padding:6px 10px;font-size:10px}.mgu-vn-tag--l{left:12px}.mgu-vn-tag--r{right:12px}}
</style>

<section data-mgu-effect="{{ section.settings.effect | default: 'up' }}" data-mgu-speed="{{ section.settings.effect_speed | default: 'normal' }}" class="mgu mgu-block" style="background:{{ section.settings.bg }}">
  <div class="mgu-wrap">
    <div class="mgu-sec-head mgu-reveal">
      {%- if section.settings.eyebrow != blank -%}<span class="mgu-eyebrow">{{ section.settings.eyebrow }}</span>{%- endif -%}
      <h2>{{ section.settings.heading }}</h2>
      {%- if section.settings.intro != blank -%}<div class="mgu-vn-intro rte">{{ section.settings.intro }}</div>{%- endif -%}
    </div>
    <div class="mgu-vn mgu-reveal"
         style="--mgu-vn-max-width:{{ section.settings.max_width }}px;--mgu-vn-height:{{ section.settings.image_height }}px;--mgu-vn-height-mobile:{{ section.settings.image_height_mobile }}px"
         oninput="var v=this.querySelector('input').value;this.querySelector('.mgu-vn-top').style.clipPath='inset(0 '+(100-v)+'% 0 0)';this.querySelector('.mgu-vn-line').style.left=v+'%'">
      {%- if section.settings.nachher != blank -%}
        <img width="{{ section.settings.nachher.width }}" height="{{ section.settings.nachher.height }}" src="{{ section.settings.nachher | image_url: width: 1600 }}" alt="{{ section.settings.label_nachher | escape }}">
      {%- else -%}{{ 'lifestyle-1' | placeholder_svg_tag }}{%- endif -%}
      <div class="mgu-vn-top" style="clip-path:inset(0 50% 0 0)">
        {%- if section.settings.vorher != blank -%}
          <img width="{{ section.settings.vorher.width }}" height="{{ section.settings.vorher.height }}" src="{{ section.settings.vorher | image_url: width: 1600 }}" alt="{{ section.settings.label_vorher | escape }}">
        {%- endif -%}
      </div>
      <span class="mgu-vn-tag mgu-vn-tag--l">{{ section.settings.label_vorher }}</span>
      <span class="mgu-vn-tag mgu-vn-tag--r">{{ section.settings.label_nachher }}</span>
      <div class="mgu-vn-line" style="left:50%" aria-hidden="true">
        <span class="mgu-vn-handle">
          <span class="mgu-vn-handle__arrows">↔</span>
          {%- if section.settings.drag_hint != blank -%}<span class="mgu-vn-handle__text">{{ section.settings.drag_hint | escape }}</span>{%- endif -%}
        </span>
      </div>
      <input type="range" min="0" max="100" value="50" aria-label="{{ section.settings.slider_label | escape }}">
    </div>
    {%- if section.settings.caption != blank -%}<div class="mgu-vn-caption rte mgu-reveal">{{ section.settings.caption }}</div>{%- endif -%}
  </div>
</section>

{% style %}
  #shopify-section-{{ section.id }} {
    margin-block-start: {{ section.settings.section_gap_top | default: 0 }}px;
    margin-block-end: {{ section.settings.section_gap_bottom | default: 0 }}px;
  }
  #shopify-section-{{ section.id }} .mgu-vn-intro { max-width: 760px; margin: 18px auto 0; color: var(--mgu-ink-soft); font-size: clamp(1rem,1.4vw,1.15rem); }
  #shopify-section-{{ section.id }} .mgu-vn-caption { max-width: 820px; margin: clamp(24px,4vw,40px) auto 0; text-align: center; color: var(--mgu-ink-soft); font-size: clamp(1rem,1.4vw,1.15rem); line-height: 1.75; }
  #shopify-section-{{ section.id }} .mgu-vn-caption strong { color: var(--mgu-forest); }
{% endstyle %}

{% schema %}
{
  "name": "Chelonaki · Bildvergleich",
  "settings": [
    {"type":"header","content":"Abstand zum nächsten Abschnitt"},
    {"type":"range","id":"section_gap_top","label":"Zusätzlicher Abstand oben","min":0,"max":200,"step":4,"unit":"px","default":0},
    {"type":"range","id":"section_gap_bottom","label":"Zusätzlicher Abstand unten","min":0,"max":200,"step":4,"unit":"px","default":0},
    { "type": "header", "content": "Scroll-Effekt" },
    { "type": "select", "id": "effect", "label": "Erscheinen beim Scrollen", "default": "up", "options": [ { "value": "none", "label": "Kein Effekt" }, { "value": "fade", "label": "Einblenden" }, { "value": "up", "label": "Von unten (Standard)" }, { "value": "left", "label": "Von links" }, { "value": "right", "label": "Von rechts" }, { "value": "zoom", "label": "Sanfter Zoom" }, { "value": "blur", "label": "Aus der Unschärfe" } ] },
    { "type": "select", "id": "effect_speed", "label": "Effekt-Tempo", "default": "normal", "options": [ { "value": "schnell", "label": "Schnell" }, { "value": "normal", "label": "Normal" }, { "value": "langsam", "label": "Langsam" } ] },
    { "type": "text", "id": "eyebrow", "label": "Kicker-Zeile", "default": "Der Unterschied" },
    { "type": "inline_richtext", "id": "heading", "label": "Überschrift", "default": "Vorher / <em>Nachher.</em>" },
    { "type": "richtext", "id": "intro", "label": "Einleitung über dem Bild", "default": "<p>Aus Wissen wird Sicherheit – und aus Sicherheit entsteht die Fähigkeit, andere Menschen verständlich zu begleiten.</p>" },
    { "type": "image_picker", "id": "vorher", "label": "Bild „Vorher“ (links)" },
    { "type": "image_picker", "id": "nachher", "label": "Bild „Nachher“ (rechts)" },
    { "type": "header", "content": "Bildgröße" },
    { "type": "range", "id": "max_width", "label": "Maximale Bildbreite", "min": 560, "max": 1400, "step": 20, "unit": "px", "default": 1000 },
    { "type": "range", "id": "image_height", "label": "Bildhöhe Desktop", "min": 320, "max": 900, "step": 20, "unit": "px", "default": 600 },
    { "type": "range", "id": "image_height_mobile", "label": "Bildhöhe Mobil", "min": 260, "max": 700, "step": 20, "unit": "px", "default": 420 },
    { "type": "header", "content": "Ziehgriff" },
    { "type": "text", "id": "drag_hint", "label": "Hinweis am Ziehgriff", "default": "Ziehen" },
    { "type": "text", "id": "slider_label", "label": "Barrierefreie Beschreibung", "default": "Vorher-Nachher-Vergleich nach links oder rechts verschieben" },
    { "type": "text", "id": "label_vorher", "label": "Beschriftung links", "default": "Vorher" },
    { "type": "text", "id": "label_nachher", "label": "Beschriftung rechts", "default": "Nachher" },
    { "type": "richtext", "id": "caption", "label": "Text unter dem Bild", "default": "<p><strong>Dein nächster Schritt:</strong> In der Ausbildung verbindest du fundiertes Ernährungswissen mit praktischer Beratung. Du lernst, Zusammenhänge klar zu erklären, individuelle Lösungen zu entwickeln und Menschen auf Augenhöhe zu nachhaltigen Veränderungen zu begleiten.</p>" },
    { "type": "color", "id": "bg", "label": "Hintergrundfarbe", "default": "#F3EDDF" }
  ],
  "presets": [{ "name": "Chelonaki – Vorher/Nachher" }]
}
{% endschema %}
