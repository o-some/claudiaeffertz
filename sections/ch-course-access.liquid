<section class="ch-section ch-course-access" aria-labelledby="ChAccessHeading-{{ section.id }}">
  <div class="ch-shell ch-course-access__inner">
    <h2 id="ChAccessHeading-{{ section.id }}">{{ section.settings.heading | escape }}</h2>
    <div class="ch-alert" role="status">
      <p>{{ section.settings.secure_message | escape }}</p>
      {% if shop.customer_accounts_enabled %}<a class="ch-button" href="{{ routes.account_url }}" rel="nofollow">{{ section.settings.account_label | escape }}</a>{% endif %}
    </div>
    {% if section.settings.preview_video != blank %}
      <div class="ch-course-access__preview">
        <h3>{{ section.settings.preview_heading | escape }}</h3>
        {{ section.settings.preview_video | video_tag: controls: true, autoplay: false, loop: false, muted: false, image_size: '1200x' }}
        {% if section.settings.transcript != blank %}<details><summary>{{ section.settings.transcript_label | escape }}</summary><div class="rte">{{ section.settings.transcript }}</div></details>{% endif %}
      </div>
    {% endif %}
  </div>
</section>
{% style %}
  #shopify-section-{{ section.id }} {
    margin-block-start: {{ section.settings.section_gap_top | default: 0 }}px;
    margin-block-end: {{ section.settings.section_gap_bottom | default: 0 }}px;
  }
{% endstyle %}

{% schema %}
{
  "name": "Chelonaki – Kurszugang",
  "settings": [
    {"type":"header","content":"Abstand zum nächsten Abschnitt"},
    {"type":"range","id":"section_gap_top","label":"Zusätzlicher Abstand oben","min":0,"max":200,"step":4,"unit":"px","default":0},
    {"type":"range","id":"section_gap_bottom","label":"Zusätzlicher Abstand unten","min":0,"max":200,"step":4,"unit":"px","default":0},
    { "type": "text", "id": "heading", "label": "Überschrift", "default": "Dein Kurszugang" },
    { "type": "textarea", "id": "secure_message", "label": "Sicherheitshinweis", "default": "Melde dich an, um deine serverseitig freigeschalteten Kurse zu öffnen." },
    { "type": "text", "id": "account_label", "label": "Konto-Aktion", "default": "Zu meinen Kursen" },
    { "type": "text", "id": "preview_heading", "label": "Vorschau-Überschrift", "default": "Kostenlose Vorschau" },
    { "type": "video", "id": "preview_video", "label": "Öffentliches Vorschauvideo" },
    { "type": "text", "id": "transcript_label", "label": "Transkript-Bezeichnung", "default": "Transkript anzeigen" },
    { "type": "richtext", "id": "transcript", "label": "Transkript" }
  ],
  "presets": [{ "name": "Chelonaki – Kurszugang" }]
}
{% endschema %}
