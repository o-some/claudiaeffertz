<script src="{{ 'ch-dialog.js' | asset_url }}" defer="defer"></script>
<section class="ch-section" id="ChModal-{{ section.id }}">
  <div class="ch-shell">
    <ch-dialog>
      <button class="ch-button" type="button" data-ch-dialog-open>{{ section.settings.button_label | escape }}</button>
      <dialog class="ch-dialog" aria-labelledby="ChModalTitle-{{ section.id }}">
        <div class="ch-dialog__inner">
          <button type="button" data-ch-dialog-close aria-label="{{ section.settings.close_label | escape }}">×</button>
          <h2 id="ChModalTitle-{{ section.id }}">{{ section.settings.heading | escape }}</h2>
          <div class="rte">{{ section.settings.text }}</div>
          {% if section.settings.link_label != blank and section.settings.link != blank %}<a class="ch-button" href="{{ section.settings.link }}">{{ section.settings.link_label | escape }}</a>{% endif %}
        </div>
      </dialog>
    </ch-dialog>
  </div>
</section>
{% schema %}
{
  "name": "Chelonaki – Dialog",
  "tag": "section",
  "class": "ch-modal-section",
  "settings": [
    { "type": "text", "id": "button_label", "label": "Öffnen-Button", "default": "Mehr erfahren" },
    { "type": "text", "id": "close_label", "label": "Schließen-Text", "default": "Dialog schließen" },
    { "type": "text", "id": "heading", "label": "Überschrift", "default": "Weitere Informationen" },
    { "type": "richtext", "id": "text", "label": "Text", "default": "<p>Ergänze hier die Inhalte.</p>" },
    { "type": "text", "id": "link_label", "label": "Link-Text" },
    { "type": "url", "id": "link", "label": "Link" }
  ],
  "presets": [{ "name": "Chelonaki – Dialog" }]
}
{% endschema %}
