{% comment %} Food Instructor MGU · Kurse & Beratung {% endcomment %}

<section class="mgu-kb" id="KurseBeratung-{{ section.id }}">
  <div class="mgu-kb__hero">
    <div class="mgu-kb__hero-copy">
      <p class="mgu-kb__eyebrow">{{ section.settings.eyebrow | escape }}</p>
      <h1>{{ section.settings.heading }}</h1>
      <div class="mgu-kb__lead rte">{{ section.settings.intro }}</div>
      <div class="mgu-kb__hero-actions">
        <a class="mgu-kb__button mgu-kb__button--gold" href="#Angebote-{{ section.id }}">Angebote ansehen <span aria-hidden="true">↓</span></a>
        <a class="mgu-kb__button mgu-kb__button--outline" href="/pages/contact">Unverbindlich anfragen <span aria-hidden="true">→</span></a>
      </div>
      <ul class="mgu-kb__quickfacts" aria-label="Angebotsübersicht">
        <li><span aria-hidden="true">✓</span> Online & persönlich</li>
        <li><span aria-hidden="true">✓</span> Ab 60 Minuten</li>
        <li><span aria-hidden="true">✓</span> Gruppen mit 4–10 Personen</li>
      </ul>
    </div>

    <div class="mgu-kb__hero-visual" aria-label="Persönliches Lernen im Einzelgespräch oder in der Gruppe">
      <div class="mgu-kb__visual-card mgu-kb__visual-card--one">
        <span class="mgu-kb__visual-icon" aria-hidden="true">
          <svg viewBox="0 0 48 48"><circle cx="24" cy="16" r="7"/><path d="M10 39c1-9 6-14 14-14s13 5 14 14"/></svg>
        </span>
        <div><small>Online</small><strong>Einzelcoaching</strong><span>Persönlich ab 60 Minuten</span></div>
      </div>
      <div class="mgu-kb__visual-line" aria-hidden="true"></div>
      <div class="mgu-kb__visual-card mgu-kb__visual-card--group">
        <span class="mgu-kb__visual-icon" aria-hidden="true">
          <svg viewBox="0 0 48 48"><circle cx="16" cy="17" r="5"/><circle cx="32" cy="17" r="5"/><circle cx="24" cy="13" r="6"/><path d="M5 38c1-8 5-12 11-12M43 38c-1-8-5-12-11-12M11 39c1-10 6-15 13-15s12 5 13 15"/></svg>
        </span>
        <div><small>Gemeinsam</small><strong>Gruppenkurse</strong><span>Praxisnah für 4–10 Personen</span></div>
      </div>
      <span class="mgu-kb__visual-badge">Wissen, das im Alltag ankommt.</span>
    </div>
  </div>

  <div class="mgu-kb__offers" id="Angebote-{{ section.id }}">
    <div class="mgu-kb__section-head">
      <p class="mgu-kb__eyebrow">Zwei Wege · ein persönliches Ziel</p>
      <h2>So kannst du mit Markus <em>arbeiten.</em></h2>
      <p>Wähle die Form, die zu deiner Frage, deinem Team und deinem Alltag passt.</p>
    </div>

    <div class="mgu-kb__offer-grid">
      <article class="mgu-kb__offer mgu-kb__offer--light">
        <div class="mgu-kb__offer-top">
          <span class="mgu-kb__offer-number">01</span>
          <span class="mgu-kb__offer-label">Online · 1:1</span>
        </div>
        <h3>Persönliches Einzelcoaching</h3>
        <p class="mgu-kb__offer-intro">Deine Stunde für konkrete Fragen, neue Klarheit und Lösungen, die zu dir passen.</p>
        <div class="mgu-kb__offer-fact"><strong>Ab 60 Minuten</strong><span>flexibel online buchbar</span></div>
        <ul>
          <li>Individuelle Fragen zu Ernährung und Alltag</li>
          <li>Persönliche Vertiefung nach einer Ausbildung</li>
          <li>Fallbesprechung und fachliche Orientierung</li>
          <li>Klare nächste Schritte statt allgemeiner Ratschläge</li>
        </ul>
        <a href="/pages/contact" class="mgu-kb__button mgu-kb__button--forest">Einzelcoaching anfragen <span aria-hidden="true">→</span></a>
      </article>

      <article class="mgu-kb__offer mgu-kb__offer--dark">
        <div class="mgu-kb__offer-top">
          <span class="mgu-kb__offer-number">02</span>
          <span class="mgu-kb__offer-label">Vor Ort oder online</span>
        </div>
        <h3>Gruppenkurse</h3>
        <p class="mgu-kb__offer-intro">Gemeinsam verstehen, ausprobieren und voneinander lernen – in einer überschaubaren Gruppe.</p>
        <div class="mgu-kb__offer-fact"><strong>4–10 Personen</strong><span>Termin und Thema nach Absprache</span></div>
        <ul>
          <li>Individuell abgestimmte Kursthemen</li>
          <li>Verständliches Wissen mit praktischen Beispielen</li>
          <li>Raum für Fragen und persönlichen Austausch</li>
          <li>Geeignet für private Gruppen, Praxen und Teams</li>
        </ul>
        <a href="/pages/contact" class="mgu-kb__button mgu-kb__button--gold">Gruppenkurs anfragen <span aria-hidden="true">→</span></a>
      </article>
    </div>
  </div>

  <div class="mgu-kb__fit">
    <div class="mgu-kb__fit-copy">
      <p class="mgu-kb__eyebrow">Für wen ist das gedacht?</p>
      <h2>Wenn du Wissen nicht nur hören, sondern <em>anwenden</em> möchtest.</h2>
      <p>Die Angebote richten sich an Menschen, die Orientierung suchen, vorhandenes Wissen vertiefen oder ein bestimmtes Thema gemeinsam erarbeiten möchten.</p>
    </div>
    <div class="mgu-kb__fit-list">
      <div><span>01</span><p><strong>Für dich persönlich</strong>Bei konkreten Fragen, neuen Zielen oder dem Wunsch nach einer klaren fachlichen Einordnung.</p></div>
      <div><span>02</span><p><strong>Für Absolventinnen und Absolventen</strong>Zur Vertiefung, Reflexion und praktischen Sicherheit nach einer Ausbildung.</p></div>
      <div><span>03</span><p><strong>Für Gruppen und Teams</strong>Wenn ihr gemeinsam verständlich und praxisnah an einem Ernährungsthema arbeiten möchtet.</p></div>
    </div>
  </div>

  <div class="mgu-kb__process">
    <div class="mgu-kb__section-head">
      <p class="mgu-kb__eyebrow">Einfach starten</p>
      <h2>In drei Schritten zum <em>passenden Termin.</em></h2>
    </div>
    <ol>
      <li><span>1</span><div><strong>Anfrage senden</strong><p>Teile uns kurz mit, ob du ein Einzelcoaching oder einen Gruppenkurs suchst.</p></div></li>
      <li><span>2</span><div><strong>Thema abstimmen</strong><p>Wir klären dein Ziel, den passenden Umfang und bei Gruppen die Teilnehmerzahl.</p></div></li>
      <li><span>3</span><div><strong>Termin vereinbaren</strong><p>Du erhältst einen passenden Terminvorschlag und alle Informationen zur Durchführung.</p></div></li>
    </ol>
  </div>

  <div class="mgu-kb__closing">
    <div>
      <p class="mgu-kb__eyebrow">Dein nächster Schritt</p>
      <h2>Was möchtest du <em>vertiefen?</em></h2>
      <p>Schreib uns kurz, worum es dir geht. Wir empfehlen dir ehrlich das passende Format.</p>
    </div>
    <a href="/pages/contact" class="mgu-kb__button mgu-kb__button--gold">Jetzt unverbindlich anfragen <span aria-hidden="true">→</span></a>
  </div>
</section>

{% style %}
  #shopify-section-{{ section.id }} {
    background: #fbf8f0;
  }

  #shopify-section-{{ section.id }} .mgu-kb {
    --kb-forest: #142519;
    --kb-green: #1f3a2a;
    --kb-gold: #b9912f;
    --kb-gold-soft: #d9bc6a;
    --kb-cream: #fbf8f0;
    --kb-paper: #fffdf8;
    --kb-muted: #667168;
    --kb-line: #ded7c8;
    color: var(--kb-forest);
    overflow: hidden;
  }

  #shopify-section-{{ section.id }} .mgu-kb__hero,
  #shopify-section-{{ section.id }} .mgu-kb__offers,
  #shopify-section-{{ section.id }} .mgu-kb__fit,
  #shopify-section-{{ section.id }} .mgu-kb__process,
  #shopify-section-{{ section.id }} .mgu-kb__closing {
    width: min(1180px, calc(100% - 40px));
    margin-inline: auto;
  }

  #shopify-section-{{ section.id }} .mgu-kb__hero {
    display: grid;
    grid-template-columns: minmax(0, 1.03fr) minmax(400px, .97fr);
    align-items: center;
    gap: clamp(52px, 7vw, 96px);
    min-height: min(780px, calc(100vh - 64px));
    padding: clamp(92px, 10vw, 142px) 0 clamp(76px, 9vw, 120px);
  }

  #shopify-section-{{ section.id }} .mgu-kb__eyebrow {
    margin: 0 0 18px;
    color: var(--kb-gold);
    font-size: 11px;
    font-weight: 800;
    letter-spacing: .2em;
    line-height: 1.4;
    text-transform: uppercase;
  }

  #shopify-section-{{ section.id }} h1,
  #shopify-section-{{ section.id }} h2,
  #shopify-section-{{ section.id }} h3 {
    color: var(--kb-forest);
    font-family: var(--mgu-font-heading, Georgia, serif);
    font-weight: 400;
  }

  #shopify-section-{{ section.id }} h1 {
    max-width: 720px;
    margin: 0;
    font-size: clamp(4.4rem, 6.4vw, 7.8rem);
    line-height: .98;
    letter-spacing: -.025em;
  }

  #shopify-section-{{ section.id }} h1 em,
  #shopify-section-{{ section.id }} h2 em {
    color: var(--kb-gold);
    font-weight: inherit;
  }

  #shopify-section-{{ section.id }} .mgu-kb__lead {
    max-width: 650px;
    margin-top: 28px;
    color: var(--kb-muted);
    font-size: clamp(1.7rem, 1.7vw, 2rem);
    line-height: 1.7;
  }

  #shopify-section-{{ section.id }} .mgu-kb__lead p {
    margin: 0;
  }

  #shopify-section-{{ section.id }} .mgu-kb__hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: 32px;
  }

  #shopify-section-{{ section.id }} .mgu-kb__button {
    display: inline-flex;
    min-height: 52px;
    align-items: center;
    justify-content: space-between;
    gap: 28px;
    padding: 12px 21px;
    border: 1px solid transparent;
    border-radius: 999px;
    font-size: 14px;
    font-weight: 750;
    line-height: 1.2;
    text-decoration: none;
    transition: transform .2s ease, background-color .2s ease, color .2s ease, border-color .2s ease;
  }

  #shopify-section-{{ section.id }} .mgu-kb__button:hover {
    transform: translateY(-2px);
  }

  #shopify-section-{{ section.id }} .mgu-kb__button:focus-visible {
    outline: 3px solid color-mix(in srgb, var(--kb-gold) 45%, transparent);
    outline-offset: 3px;
  }

  #shopify-section-{{ section.id }} .mgu-kb__button--gold { background: var(--kb-gold); color: var(--kb-forest); }
  #shopify-section-{{ section.id }} .mgu-kb__button--gold:hover { background: var(--kb-gold-soft); color: var(--kb-forest); }
  #shopify-section-{{ section.id }} .mgu-kb__button--outline { border-color: var(--kb-forest); color: var(--kb-forest); }
  #shopify-section-{{ section.id }} .mgu-kb__button--outline:hover { background: var(--kb-forest); color: var(--kb-paper); }
  #shopify-section-{{ section.id }} .mgu-kb__button--forest { background: var(--kb-forest); color: var(--kb-paper); }

  #shopify-section-{{ section.id }} .mgu-kb__quickfacts {
    display: flex;
    flex-wrap: wrap;
    gap: 11px 24px;
    margin: 30px 0 0;
    padding: 0;
    color: var(--kb-muted);
    font-size: 13px;
    list-style: none;
  }

  #shopify-section-{{ section.id }} .mgu-kb__quickfacts span { color: var(--kb-gold); font-weight: 800; }

  #shopify-section-{{ section.id }} .mgu-kb__hero-visual {
    position: relative;
    display: grid;
    gap: 22px;
    padding: clamp(28px, 4vw, 52px);
    border: 1px solid color-mix(in srgb, var(--kb-gold) 35%, transparent);
    border-radius: 34px;
    background:
      radial-gradient(circle at 88% 12%, rgba(217, 188, 106, .18), transparent 30%),
      var(--kb-forest);
    box-shadow: 0 38px 80px -42px rgba(20, 37, 25, .55);
  }

  #shopify-section-{{ section.id }} .mgu-kb__visual-card {
    display: grid;
    grid-template-columns: 68px 1fr;
    align-items: center;
    gap: 18px;
    padding: 22px;
    border: 1px solid rgba(255, 253, 248, .16);
    border-radius: 22px;
    background: rgba(255, 253, 248, .075);
    color: var(--kb-paper);
    backdrop-filter: blur(8px);
  }

  #shopify-section-{{ section.id }} .mgu-kb__visual-card--group { margin-left: clamp(18px, 4vw, 54px); }
  #shopify-section-{{ section.id }} .mgu-kb__visual-icon { display: grid; width: 68px; height: 68px; place-items: center; border-radius: 50%; background: var(--kb-gold); color: var(--kb-forest); }
  #shopify-section-{{ section.id }} .mgu-kb__visual-icon svg { width: 39px; fill: none; stroke: currentColor; stroke-linecap: round; stroke-linejoin: round; stroke-width: 1.7; }
  #shopify-section-{{ section.id }} .mgu-kb__visual-card small { display: block; margin-bottom: 5px; color: var(--kb-gold-soft); font-size: 10px; font-weight: 800; letter-spacing: .17em; text-transform: uppercase; }
  #shopify-section-{{ section.id }} .mgu-kb__visual-card strong { display: block; font-family: var(--mgu-font-heading, Georgia, serif); font-size: clamp(2rem, 2.5vw, 2.7rem); font-weight: 400; }
  #shopify-section-{{ section.id }} .mgu-kb__visual-card div > span { display: block; margin-top: 5px; color: rgba(255, 253, 248, .72); font-size: 13px; }
  #shopify-section-{{ section.id }} .mgu-kb__visual-line { position: absolute; top: 50%; left: 51px; width: 1px; height: 48px; background: var(--kb-gold); transform: translateY(-50%); opacity: .5; }
  #shopify-section-{{ section.id }} .mgu-kb__visual-badge { justify-self: end; color: var(--kb-gold-soft); font-family: var(--mgu-font-heading, Georgia, serif); font-size: 15px; font-style: italic; }

  #shopify-section-{{ section.id }} .mgu-kb__offers {
    padding: clamp(88px, 10vw, 132px) 0;
  }

  #shopify-section-{{ section.id }} .mgu-kb__section-head {
    max-width: 760px;
    margin: 0 auto clamp(42px, 6vw, 68px);
    text-align: center;
  }

  #shopify-section-{{ section.id }} .mgu-kb__section-head h2,
  #shopify-section-{{ section.id }} .mgu-kb__fit h2,
  #shopify-section-{{ section.id }} .mgu-kb__closing h2 {
    margin: 0;
    font-size: clamp(3.4rem, 4.7vw, 5.8rem);
    line-height: 1.08;
  }

  #shopify-section-{{ section.id }} .mgu-kb__section-head > p:last-child,
  #shopify-section-{{ section.id }} .mgu-kb__fit-copy > p:last-child,
  #shopify-section-{{ section.id }} .mgu-kb__closing div > p:last-child {
    margin: 20px 0 0;
    color: var(--kb-muted);
    font-size: 16px;
    line-height: 1.65;
  }

  #shopify-section-{{ section.id }} .mgu-kb__offer-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 24px;
  }

  #shopify-section-{{ section.id }} .mgu-kb__offer {
    display: flex;
    min-height: 620px;
    flex-direction: column;
    padding: clamp(30px, 4vw, 50px);
    border-radius: 30px;
  }

  #shopify-section-{{ section.id }} .mgu-kb__offer--light { border: 1px solid var(--kb-line); background: var(--kb-paper); }
  #shopify-section-{{ section.id }} .mgu-kb__offer--dark { background: var(--kb-forest); color: rgba(255, 253, 248, .82); }
  #shopify-section-{{ section.id }} .mgu-kb__offer-top { display: flex; align-items: center; justify-content: space-between; gap: 16px; }
  #shopify-section-{{ section.id }} .mgu-kb__offer-number { display: grid; width: 48px; height: 48px; place-items: center; border: 1px solid var(--kb-gold); border-radius: 50%; color: var(--kb-gold); font-size: 12px; font-weight: 800; }
  #shopify-section-{{ section.id }} .mgu-kb__offer-label { color: var(--kb-gold); font-size: 10px; font-weight: 800; letter-spacing: .17em; text-transform: uppercase; }
  #shopify-section-{{ section.id }} .mgu-kb__offer h3 { margin: 30px 0 0; font-size: clamp(3rem, 3.7vw, 4.6rem); line-height: 1.08; }
  #shopify-section-{{ section.id }} .mgu-kb__offer--dark h3 { color: var(--kb-paper); }
  #shopify-section-{{ section.id }} .mgu-kb__offer-intro { min-height: 78px; margin: 18px 0 0; color: var(--kb-muted); font-size: 16px; line-height: 1.65; }
  #shopify-section-{{ section.id }} .mgu-kb__offer--dark .mgu-kb__offer-intro { color: rgba(255, 253, 248, .72); }
  #shopify-section-{{ section.id }} .mgu-kb__offer-fact { display: flex; align-items: baseline; justify-content: space-between; gap: 18px; margin-top: 28px; padding: 18px 0; border-block: 1px solid color-mix(in srgb, var(--kb-gold) 32%, transparent); }
  #shopify-section-{{ section.id }} .mgu-kb__offer-fact strong { color: var(--kb-gold); font-family: var(--mgu-font-heading, Georgia, serif); font-size: 23px; font-weight: 400; }
  #shopify-section-{{ section.id }} .mgu-kb__offer-fact span { color: var(--kb-muted); font-size: 12px; text-align: right; }
  #shopify-section-{{ section.id }} .mgu-kb__offer--dark .mgu-kb__offer-fact span { color: rgba(255, 253, 248, .62); }
  #shopify-section-{{ section.id }} .mgu-kb__offer ul { display: grid; gap: 12px; margin: 28px 0 36px; padding: 0; list-style: none; }
  #shopify-section-{{ section.id }} .mgu-kb__offer li { display: flex; gap: 10px; color: var(--kb-muted); font-size: 14px; line-height: 1.5; }
  #shopify-section-{{ section.id }} .mgu-kb__offer li::before { color: var(--kb-gold); content: "✓"; font-weight: 800; }
  #shopify-section-{{ section.id }} .mgu-kb__offer--dark li { color: rgba(255, 253, 248, .78); }
  #shopify-section-{{ section.id }} .mgu-kb__offer .mgu-kb__button { width: 100%; margin-top: auto; }

  #shopify-section-{{ section.id }} .mgu-kb__fit {
    display: grid;
    grid-template-columns: minmax(0, .9fr) minmax(0, 1.1fr);
    gap: clamp(48px, 8vw, 100px);
    padding: clamp(84px, 10vw, 132px) 0;
    border-top: 1px solid var(--kb-line);
  }

  #shopify-section-{{ section.id }} .mgu-kb__fit-list { display: grid; gap: 0; }
  #shopify-section-{{ section.id }} .mgu-kb__fit-list > div { display: grid; grid-template-columns: 48px 1fr; gap: 20px; padding: 25px 0; border-bottom: 1px solid var(--kb-line); }
  #shopify-section-{{ section.id }} .mgu-kb__fit-list > div:first-child { border-top: 1px solid var(--kb-line); }
  #shopify-section-{{ section.id }} .mgu-kb__fit-list > div > span { display: grid; width: 42px; height: 42px; place-items: center; border: 1px solid var(--kb-gold); border-radius: 50%; color: var(--kb-gold); font-size: 11px; font-weight: 800; }
  #shopify-section-{{ section.id }} .mgu-kb__fit-list p { margin: 0; color: var(--kb-muted); font-size: 14px; line-height: 1.6; }
  #shopify-section-{{ section.id }} .mgu-kb__fit-list strong { display: block; margin-bottom: 5px; color: var(--kb-forest); font-size: 16px; }

  #shopify-section-{{ section.id }} .mgu-kb__process {
    padding: clamp(84px, 10vw, 126px) 0;
  }

  #shopify-section-{{ section.id }} .mgu-kb__process ol {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 16px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  #shopify-section-{{ section.id }} .mgu-kb__process li {
    display: grid;
    grid-template-columns: 50px 1fr;
    gap: 18px;
    padding: 28px;
    border: 1px solid var(--kb-line);
    border-radius: 22px;
    background: var(--kb-paper);
  }

  #shopify-section-{{ section.id }} .mgu-kb__process li > span { display: grid; width: 46px; height: 46px; place-items: center; border-radius: 50%; background: var(--kb-forest); color: var(--kb-gold-soft); font-family: var(--mgu-font-heading, Georgia, serif); font-size: 20px; }
  #shopify-section-{{ section.id }} .mgu-kb__process strong { color: var(--kb-forest); font-size: 16px; }
  #shopify-section-{{ section.id }} .mgu-kb__process li p { margin: 8px 0 0; color: var(--kb-muted); font-size: 13px; line-height: 1.6; }

  #shopify-section-{{ section.id }} .mgu-kb__closing {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 48px;
    margin-bottom: clamp(72px, 9vw, 110px);
    padding: clamp(38px, 5vw, 62px);
    border-radius: 30px;
    background:
      radial-gradient(circle at 88% 10%, rgba(217, 188, 106, .18), transparent 30%),
      var(--kb-forest);
  }

  #shopify-section-{{ section.id }} .mgu-kb__closing h2 { color: var(--kb-paper); }
  #shopify-section-{{ section.id }} .mgu-kb__closing div > p:last-child { max-width: 650px; color: rgba(255, 253, 248, .72); }
  #shopify-section-{{ section.id }} .mgu-kb__closing .mgu-kb__button { flex: 0 0 auto; }

  @media (max-width: 900px) {
    #shopify-section-{{ section.id }} .mgu-kb__hero { grid-template-columns: 1fr; min-height: 0; }
    #shopify-section-{{ section.id }} .mgu-kb__hero-visual { width: min(620px, 100%); }
    #shopify-section-{{ section.id }} .mgu-kb__offer-grid,
    #shopify-section-{{ section.id }} .mgu-kb__fit { grid-template-columns: 1fr; }
    #shopify-section-{{ section.id }} .mgu-kb__offer { min-height: 0; }
    #shopify-section-{{ section.id }} .mgu-kb__offer-intro { min-height: 0; }
    #shopify-section-{{ section.id }} .mgu-kb__process ol { grid-template-columns: 1fr; }
  }

  @media (max-width: 620px) {
    #shopify-section-{{ section.id }} .mgu-kb__hero,
    #shopify-section-{{ section.id }} .mgu-kb__offers,
    #shopify-section-{{ section.id }} .mgu-kb__fit,
    #shopify-section-{{ section.id }} .mgu-kb__process,
    #shopify-section-{{ section.id }} .mgu-kb__closing { width: min(100% - 28px, 1180px); }
    #shopify-section-{{ section.id }} .mgu-kb__hero { gap: 46px; padding-top: 70px; }
    #shopify-section-{{ section.id }} h1 { font-size: clamp(4rem, 14vw, 5.4rem); }
    #shopify-section-{{ section.id }} .mgu-kb__hero-actions { display: grid; }
