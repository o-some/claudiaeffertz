{% comment %} Chelonaki Shop Theme · © Chelonaki · Build: CHELONAKI-BUILD-0000-MASTER · Nutzung nur mit gültiger Lizenz {% endcomment %}
<style>
  .mgu-rz-grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(260px,1fr));gap:22px}
  .mgu-rz-grid[hidden]{display:none}
  .mgu-rz{background:var(--mgu-paper);border:1px solid var(--mgu-line);border-radius:20px;overflow:hidden;transition:transform .3s,box-shadow .3s;display:flex;flex-direction:column}
  .mgu-rz:hover{transform:translateY(-5px);box-shadow:0 24px 46px -26px rgba(20,37,25,.34)}
  .mgu-rz-img{display:block;width:100%;aspect-ratio:4/3;padding:0;overflow:hidden;border:0;background:var(--mgu-cream);cursor:pointer}
  .mgu-rz-img img{width:100%;height:100%;object-fit:cover;transition:transform .5s}
  .mgu-rz:hover .mgu-rz-img img{transform:scale(1.05)}
  .mgu-rz-img:focus-visible{outline:3px solid var(--mgu-gold);outline-offset:-5px}
  .mgu-rz-body{padding:18px 20px;display:flex;flex-direction:column;gap:8px;flex:1}
  .mgu-rz-meta{display:flex;gap:14px;font-size:12.5px;color:var(--mgu-ink-soft)}
  .mgu-rz-body h3{margin:0;font-size:1.15rem;color:var(--mgu-forest);line-height:1.25}
  .mgu-rz-body a.mgu-rz-link{margin-top:auto;font-size:14px;font-weight:600;color:var(--mgu-gold);text-decoration:none}
  .mgu-rz-open{display:flex;align-items:center;justify-content:space-between;gap:14px;width:100%;margin-top:auto;padding:12px 0 0;border:0;background:transparent;color:var(--mgu-forest);cursor:pointer;font-family:inherit;font-size:13px;font-weight:700;line-height:1.2;text-align:left}
  .mgu-rz-open span:last-child{color:var(--mgu-gold);font-size:18px;transition:transform .2s ease}
  .mgu-rz-open:hover span:last-child{transform:translateX(4px)}
  .mgu-rz-detail[hidden]{display:none}
  .mgu-rz-detail{overflow:hidden;scroll-margin-top:118px;border:1px solid color-mix(in srgb,var(--mgu-gold) 28%,var(--mgu-line));border-radius:28px;background:var(--mgu-paper);box-shadow:0 34px 80px -44px rgba(20,37,25,.48);opacity:0;transform:translateY(22px) scale(.985);transition:opacity .38s ease,transform .48s cubic-bezier(.22,1,.36,1)}
  .mgu-rz-detail.is-open{opacity:1;transform:none}
  .mgu-rz-detail__top{display:flex;align-items:center;justify-content:space-between;gap:20px;padding:20px clamp(22px,4vw,38px);border-bottom:1px solid var(--mgu-line)}
  .mgu-rz-detail__back{display:inline-flex;align-items:center;gap:9px;padding:0;border:0;background:transparent;color:var(--mgu-forest);cursor:pointer;font-family:inherit;font-size:14px;font-weight:700;line-height:1.3}
  .mgu-rz-detail__kicker{color:var(--mgu-gold);font-size:11px;font-weight:800;letter-spacing:.16em;text-transform:uppercase}
  .mgu-rz-detail__grid{display:grid;grid-template-columns:minmax(0,1fr) minmax(0,1.08fr);align-items:stretch}
  .mgu-rz-detail__media{min-height:520px;background:var(--mgu-cream)}
  .mgu-rz-detail__media img{display:block;width:100%;height:100%;object-fit:cover}
  .mgu-rz-detail__content{padding:clamp(28px,5vw,56px)}
  .mgu-rz-detail__content h3{margin:0;color:var(--mgu-forest);font:400 clamp(2.3rem,4vw,4rem)/1.04 var(--mgu-font-heading)}
  .mgu-rz-detail__meta{display:flex;flex-wrap:wrap;gap:10px 18px;margin:18px 0 28px;color:var(--mgu-ink-soft);font-size:13px}
  .mgu-rz-detail__columns{display:grid;grid-template-columns:minmax(180px,.8fr) minmax(0,1.2fr);gap:clamp(24px,4vw,48px)}
  .mgu-rz-detail__columns h4{margin:0 0 13px;color:var(--mgu-forest);font-size:1.1rem}
  .mgu-rz-detail__ingredients{display:grid;gap:8px;margin:0;padding:0;list-style:none}
  .mgu-rz-detail__ingredients li{display:flex;gap:9px;color:var(--mgu-ink-soft);font-size:14px;line-height:1.5}
  .mgu-rz-detail__ingredients li::before{color:var(--mgu-gold);content:"•"}
  .mgu-rz-detail__steps{color:var(--mgu-ink-soft);font-size:14px;line-height:1.7}
  .mgu-rz-detail__steps p:first-child{margin-top:0}
  .mgu-rz-detail__steps p:last-child{margin-bottom:0}
  .mgu-rz-detail__nav{display:flex;flex-wrap:wrap;justify-content:center;gap:10px;padding:18px clamp(22px,4vw,38px);border-top:1px solid var(--mgu-line);background:color-mix(in srgb,var(--mgu-cream) 62%,transparent)}
  .mgu-rz-detail__nav button{width:66px;aspect-ratio:1;padding:3px;overflow:hidden;border:1px solid var(--mgu-line);border-radius:14px;background:var(--mgu-paper);cursor:pointer;transition:border-color .2s ease,box-shadow .2s ease,transform .2s ease}
  .mgu-rz-detail__nav button:hover{border-color:var(--mgu-gold);transform:translateY(-2px)}
  .mgu-rz-detail__nav button:focus-visible{outline:3px solid color-mix(in srgb,var(--mgu-gold) 48%,transparent);outline-offset:2px}
  .mgu-rz-detail__nav button[aria-current="true"]{border-color:var(--mgu-gold);box-shadow:0 0 0 2px var(--mgu-gold)}
  .mgu-rz-detail__nav img{display:block;width:100%;height:100%;border-radius:10px;object-fit:cover}
  @media(max-width:800px){
    .mgu-rz-detail{scroll-margin-top:154px}
    .mgu-rz-detail__grid{grid-template-columns:1fr}
    .mgu-rz-detail__media{min-height:0;aspect-ratio:4/3}
    .mgu-rz-detail__columns{grid-template-columns:1fr}
    .mgu-rz-detail__top{align-items:flex-start;flex-direction:column-reverse;gap:8px}
    .mgu-rz-detail__nav{gap:8px;padding-inline:16px}
    .mgu-rz-detail__nav button{width:54px;border-radius:11px}
    .mgu-rz-detail__nav img{border-radius:8px}
  }
</style>
<section id="rezepte" data-mgu-effect="{{ section.settings.effect | default: 'up' }}" data-mgu-speed="{{ section.settings.effect_speed | default: 'normal' }}" class="mgu mgu-block" style="--mgu-space-top:{{ section.settings.spacing_top }}px;--mgu-space-bottom:{{ section.settings.spacing_bottom }}px;background:{{ section.settings.bg }}" data-mgu-recipes>
  <div class="mgu-wrap">
    <div class="mgu-sec-head mgu-reveal">
      {%- if section.settings.eyebrow != blank -%}<span class="mgu-eyebrow">{{ section.settings.eyebrow }}</span>{%- endif -%}
      <h2>{{ section.settings.heading }}</h2>
    </div>
    <div class="mgu-rz-detail" id="MguRecipeDetail-{{ section.id }}" data-recipe-detail hidden aria-live="polite"></div>
    <div class="mgu-rz-grid">
      {%- for block in section.blocks -%}
        <article class="mgu-rz mgu-reveal" {% if forloop.index > 1 %}style="transition-delay:{{ forloop.index0 | times: 0.06 }}s"{% endif %} {{ block.shopify_attributes }}>
          <button
            class="mgu-rz-img"
            type="button"
            data-recipe-image-open="{{ block.id }}"
            aria-label="{{ block.settings.titel | escape }} – Rezept öffnen"
            aria-controls="MguRecipeDetail-{{ section.id }}"
          >
            {%- if block.settings.bild_asset != blank -%}
              <img width="900" height="675" src="{{ block.settings.bild_asset | asset_url }}" alt="{{ block.settings.titel | escape }}" loading="lazy">
            {%- elsif block.settings.bild != blank -%}
              <img width="{{ block.settings.bild.width }}" height="{{ block.settings.bild.height }}" src="{{ block.settings.bild | image_url: width: 600 }}" alt="{{ block.settings.titel | escape }}" loading="lazy">
            {%- endif -%}
          </button>
          <div class="mgu-rz-body">
            <div class="mgu-rz-meta">
              {%- if block.settings.dauer != blank -%}<span>⏱ {{ block.settings.dauer }}</span>{%- endif -%}
              {%- if block.settings.level != blank -%}<span>📊 {{ block.settings.level }}</span>{%- endif -%}
            </div>
            <h3>{{ block.settings.titel }}</h3>
            <button class="mgu-rz-open" type="button" data-recipe-open="{{ block.id }}" aria-controls="MguRecipeDetail-{{ section.id }}">
              <span>{{ section.settings.link_text }}</span><span aria-hidden="true">→</span>
            </button>
          </div>
        </article>
        <template id="MguRecipeTemplate-{{ section.id }}-{{ block.id }}">
          <div class="mgu-rz-detail__top">
            <button class="mgu-rz-detail__back" type="button" data-recipe-close><span aria-hidden="true">←</span> Alle Rezepte</button>
            <span class="mgu-rz-detail__kicker">Zum Nachkochen · Food Instructor MGU®</span>
          </div>
          <div class="mgu-rz-detail__grid">
            <div class="mgu-rz-detail__media">
              {%- if block.settings.bild_asset != blank -%}
                <img width="900" height="675" src="{{ block.settings.bild_asset | asset_url }}" alt="{{ block.settings.titel | escape }}">
              {%- elsif block.settings.bild != blank -%}
                <img width="{{ block.settings.bild.width }}" height="{{ block.settings.bild.height }}" src="{{ block.settings.bild | image_url: width: 1000 }}" alt="{{ block.settings.titel | escape }}">
              {%- endif -%}
            </div>
            <div class="mgu-rz-detail__content">
              <h3>{{ block.settings.titel }}</h3>
              <div class="mgu-rz-detail__meta">
                <span>⏱ {{ block.settings.dauer }}</span>
                <span>📊 {{ block.settings.level }}</span>
                <span>🍽 {{ block.settings.portions | default: '2 Portionen' }}</span>
              </div>
              <div class="mgu-rz-detail__columns">
                <div>
                  <h4>Zutaten</h4>
                  <ul class="mgu-rz-detail__ingredients">
                    {%- assign recipe_ingredients = block.settings.ingredients | newline_to_br | split: '<br />' -%}
                    {%- for ingredient in recipe_ingredients -%}
                      {%- assign clean_ingredient = ingredient | strip -%}
                      {%- if clean_ingredient != blank -%}<li>{{ clean_ingredient }}</li>{%- endif -%}
                    {%- endfor -%}
                  </ul>
                </div>
                <div>
                  <h4>Zubereitung</h4>
                  <div class="mgu-rz-detail__steps rte">{{ block.settings.preparation }}</div>
                </div>
              </div>
            </div>
          </div>
        </template>
      {%- endfor -%}
    </div>
  </div>
</section>
<script>
  (() => {
    const section = document.querySelector('#shopify-section-{{ section.id }} [data-mgu-recipes]');
    if (!section || section.dataset.recipeInit) return;
    section.dataset.recipeInit = 'true';
    const grid = section.querySelector('.mgu-rz-grid');
    const detail = section.querySelector('[data-recipe-detail]');
    let activeButton = null;

    const renderRecipe = (id, shouldScroll = true) => {
      const template = section.querySelector('#MguRecipeTemplate-{{ section.id }}-' + CSS.escape(id));
      if (!template) return;
      const update = () => {
        detail.replaceChildren(template.content.cloneNode(true));
        const nav = document.createElement('div');
        nav.className = 'mgu-rz-detail__nav';
        section.querySelectorAll('[data-recipe-open]').forEach((button) => {
          const switcher = document.createElement('button');
          const card = button.closest('.mgu-rz');
          const cardImage = card?.querySelector('.mgu-rz-img img');
          const recipeTitle = card?.querySelector('h3')?.textContent?.trim() || 'Rezept';
          switcher.type = 'button';
          switcher.setAttribute('aria-label', recipeTitle + ' anzeigen');
          switcher.dataset.recipeSwitch = button.dataset.recipeOpen;
          if (cardImage) {
            const thumbnail = document.createElement('img');
            thumbnail.src = cardImage.currentSrc || cardImage.src;
            thumbnail.alt = '';
            thumbnail.width = 120;
            thumbnail.height = 120;
            thumbnail.loading = 'lazy';
            switcher.append(thumbnail);
          }
          if (button.dataset.recipeOpen === id) switcher.setAttribute('aria-current', 'true');
          nav.append(switcher);
        });
        detail.append(nav);
        grid.hidden = true;
        detail.hidden = false;
        requestAnimationFrame(() => detail.classList.add('is-open'));
        if (shouldScroll) detail.scrollIntoView({ behavior: 'smooth', block: 'start' });
      };
      document.startViewTransition ? document.startViewTransition(update) : update();
    };

    section.addEventListener('click', (event) => {
      const open = event.target.closest('[data-recipe-open], [data-recipe-image-open]');
      const switcher = event.target.closest('[data-recipe-switch]');
      const close = event.target.closest('[data-recipe-close]');
      if (open) {
        activeButton = open;
        renderRecipe(open.dataset.recipeOpen || open.dataset.recipeImageOpen);
      } else if (switcher) {
        renderRecipe(switcher.dataset.recipeSwitch, false);
      } else if (close) {
        const update = () => {
          detail.classList.remove('is-open');
          window.setTimeout(() => {
            detail.hidden = true;
            detail.replaceChildren();
            grid.hidden = false;
            activeButton?.focus();
          }, 260);
        };
        document.startViewTransition ? document.startViewTransition(update) : update();
      }
    });
  })();
</script>
{% schema %}
{
  "name": "Chelonaki – Rezept-Karten",
  "settings": [
    { "type": "header", "content": "Scroll-Effekt" },
    { "type": "select", "id": "effect", "label": "Erscheinen beim Scrollen", "default": "up", "options": [ { "value": "none", "label": "Kein Effekt" }, { "value": "fade", "label": "Einblenden" }, { "value": "up", "label": "Von unten (Standard)" }, { "value": "left", "label": "Von links" }, { "value": "right", "label": "Von rechts" }, { "value": "zoom", "label": "Sanfter Zoom" }, { "value": "blur", "label": "Aus der Unschärfe" } ] },
    { "type": "select", "id": "effect_speed", "label": "Effekt-Tempo", "default": "normal", "options": [ { "value": "schnell", "label": "Schnell" }, { "value": "normal", "label": "Normal" }, { "value": "langsam", "label": "Langsam" } ] },
    { "type": "text", "id": "eyebrow", "label": "Kicker-Zeile", "default": "Zum Nachkochen" },
    { "type": "inline_richtext", "id": "heading", "label": "Überschrift", "default": "Rezepte, die <em>gelingen.</em>" },
    { "type": "text", "id": "link_text", "label": "Link-Text", "default": "Zum Rezept" },
    { "type": "header", "content": "Abstände zum nächsten Abschnitt" },
    { "type": "range", "id": "spacing_top", "label": "Abstand oben", "min": 0, "max": 160, "step": 8, "unit": "px", "default": 80 },
    { "type": "range", "id": "spacing_bottom", "label": "Abstand unten", "min": 0, "max": 160, "step": 8, "unit": "px", "default": 80 },
    { "type": "color", "id": "bg", "label": "Hintergrundfarbe", "default": "#FBF8F0" }
  ],
  "blocks": [
    { "type": "rezept", "name": "Rezept",
      "settings": [
        { "type": "image_picker", "id": "bild", "label": "Bild" },
        { "type": "text", "id": "bild_asset", "label": "Theme-Dateiname (optional)" },
        { "type": "text", "id": "titel", "label": "Titel", "default": "Gericht-Name" },
        { "type": "text", "id": "dauer", "label": "Dauer", "default": "30 Min" },
        { "type": "text", "id": "level", "label": "Schwierigkeit", "default": "Einfach" },
        { "type": "text", "id": "portions", "label": "Portionen", "default": "2 Portionen" },
        { "type": "textarea", "id": "ingredients", "label": "Zutaten – eine Zutat pro Zeile", "default": "2 Portionen Gemüse\n2 EL Olivenöl\nSalz und Pfeffer" },
        { "type": "richtext", "id": "preparation", "label": "Zubereitung", "default": "<p>Zutaten vorbereiten und Schritt für Schritt zu einem ausgewogenen Gericht zubereiten.</p>" },
        { "type": "url", "id": "link", "label": "Link (Blog/Seite)" }
      ]}
  ],
  "presets": [{ "name": "Chelonaki – Rezept-Karten", "blocks": [ { "type": "rezept" }, { "type": "rezept" }, { "type": "rezept" } ] }]
}
{% endschema %}
