{%- liquid
  assign heading_tag = section.settings.heading_level | default: 'h2'
-%}
{%- if section.settings.heading != blank or section.settings.summary != blank or section.blocks.size > 0 -%}
  <section
    id="ChAnswerSummary-{{ section.id }}"
    class="ch-answer-summary"
    aria-labelledby="ChAnswerSummaryHeading-{{ section.id }}"
    style="--ch-answer-top:{{ section.settings.spacing_top }}px;--ch-answer-bottom:{{ section.settings.spacing_bottom }}px;--ch-answer-inline:{{ section.settings.spacing_inline }}px;--ch-answer-width:{{ section.settings.max_width }}px"
  >
    <div class="ch-answer-summary__inner">
      {%- if section.settings.eyebrow != blank -%}<p class="ch-answer-summary__eyebrow">{{ section.settings.eyebrow | escape }}</p>{%- endif -%}
      {%- if section.settings.heading != blank -%}
        <{{ heading_tag }} id="ChAnswerSummaryHeading-{{ section.id }}">{{ section.settings.heading | escape }}</{{ heading_tag }}>
      {%- endif -%}
      {%- if section.settings.summary != blank -%}<div class="rte ch-answer-summary__summary">{{ section.settings.summary }}</div>{%- endif -%}
      {%- if section.blocks.size > 0 -%}
        <ul class="ch-answer-summary__points" role="list">
          {%- for block in section.blocks -%}
            <li {{ block.shopify_attributes }}>
              {%- if block.settings.title != blank -%}<strong>{{ block.settings.title | escape }}</strong>{%- endif -%}
              {%- if block.settings.text != blank -%}<div class="rte">{{ block.settings.text }}</div>{%- endif -%}
            </li>
          {%- endfor -%}
        </ul>
      {%- endif -%}
    </div>
  </section>
{%- endif -%}

{% style %}
  #shopify-section-{{ section.id }} .ch-answer-summary {
    padding: var(--ch-answer-top) var(--ch-answer-inline) var(--ch-answer-bottom);
  }
  #shopify-section-{{ section.id }} .ch-answer-summary__inner {
    width: min(100%, var(--ch-answer-width));
    margin-inline: auto;
    padding: clamp(2.4rem, 5vw, 5.6rem);
    border: 1px solid rgba(var(--color-foreground), .16);
    border-radius: var(--ch-radius, 2.2rem);
    background: rgb(var(--color-background));
  }
  #shopify-section-{{ section.id }} .ch-answer-summary__eyebrow {
    margin: 0 0 1rem;
    font-weight: 700;
    letter-spacing: .12em;
    text-transform: uppercase;
  }
  #shopify-section-{{ section.id }} .ch-answer-summary h2,
  #shopify-section-{{ section.id }} .ch-answer-summary h3 { margin: 0; }
  #shopify-section-{{ section.id }} .ch-answer-summary__summary { margin-block-start: 1.6rem; font-size: 1.8rem; }
  #shopify-section-{{ section.id }} .ch-answer-summary__points {
    display: grid;
    gap: 1.6rem;
    margin: 2.4rem 0 0;
    padding: 0;
    list-style: none;
  }
  #shopify-section-{{ section.id }} .ch-answer-summary__points li { padding-inline-start: 1.8rem; border-inline-start: .3rem solid var(--ch-accent, currentColor); }
  #shopify-section-{{ section.id }} .ch-answer-summary__points .rte { margin-block-start: .4rem; }
{% endstyle %}

{% schema %}
{
  "name": "Chelonaki – Kurzantwort",
  "tag": "section",
  "class": "section",
  "max_blocks": 8,
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Kleine Bezeichnung", "default": "Kurz erklärt" },
    { "type": "text", "id": "heading", "label": "Klare Frage oder Überschrift", "default": "Das Wichtigste auf einen Blick" },
    { "type": "select", "id": "heading_level", "label": "Überschriftenebene", "default": "h2", "options": [{ "value": "h2", "label": "H2" }, { "value": "h3", "label": "H3" }] },
    { "type": "richtext", "id": "summary", "label": "Direkte Kurzantwort", "default": "<p>Beantworte die zentrale Frage der Seite in zwei bis vier klaren Sätzen.</p>" },
    { "type": "range", "id": "max_width", "label": "Maximale Breite", "min": 640, "max": 1200, "step": 40, "unit": "px", "default": 880 },
    { "type": "range", "id": "spacing_top", "label": "Abstand oben", "min": 0, "max": 160, "step": 8, "unit": "px", "default": 48 },
    { "type": "range", "id": "spacing_bottom", "label": "Abstand unten", "min": 0, "max": 160, "step": 8, "unit": "px", "default": 48 },
    { "type": "range", "id": "spacing_inline", "label": "Abstand links und rechts", "min": 0, "max": 64, "step": 4, "unit": "px", "default": 16 }
  ],
  "blocks": [
    { "type": "point", "name": "Kernaussage", "settings": [
      { "type": "text", "id": "title", "label": "Kurztitel", "default": "Kernaussage" },
      { "type": "richtext", "id": "text", "label": "Erklärung", "default": "<p>Formuliere eine konkrete, überprüfbare Aussage.</p>" }
    ] }
  ],
  "presets": [{ "name": "Chelonaki – Kurzantwort", "blocks": [{ "type": "point" }, { "type": "point" }, { "type": "point" }] }]
}
{% endschema %}
