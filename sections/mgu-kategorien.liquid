<style>
  .mgu-kat-grid{display:grid;grid-template-columns:repeat({{ section.settings.columns }},1fr);gap:22px}
  @media(max-width:990px){.mgu-kat-grid{grid-template-columns:repeat(2,1fr)}}
  @media(max-width:640px){.mgu-kat-grid{grid-template-columns:1fr}}
  .mgu-kat{
    position:relative;border-radius:22px;overflow:hidden;aspect-ratio:{{ section.settings.ratio }};
    box-shadow:0 24px 46px -24px rgba(20,37,25,.35);display:block;
  }
  .mgu-kat img{width:100%;height:100%;object-fit:cover;transition:transform .6s cubic-bezier(.2,.8,.2,1)}
  .mgu-kat:hover img{transform:scale(1.06)}
  .mgu-kat::after{content:"";position:absolute;inset:40% 0 0 0;background:linear-gradient(transparent,rgba(20,37,25,.72))}
  .mgu-kat-label{
    position:absolute;left:22px;right:22px;bottom:20px;z-index:2;
    display:flex;align-items:center;justify-content:space-between;gap:10px;
  }
  .mgu-kat-label h3{color:#FCF9F1;font-size:1.35rem;margin:0;text-shadow:0 2px 14px rgba(0,0,0,.4)}
  .mgu-kat-label .mgu-kat-pfeil{
    flex-shrink:0;width:40px;height:40px;border-radius:50%;
    background:rgba(252,249,241,.16);border:1px solid rgba(217,188,106,.5);
    display:flex;align-items:center;justify-content:center;color:var(--mgu-gold-soft);
    backdrop-filter:blur(6px);transition:background .3s,transform .3s;
  }
  .mgu-kat:hover .mgu-kat-pfeil{background:var(--mgu-gold);color:var(--mgu-forest-deep);transform:translateX(4px)}
</style>

<section data-mgu-effect="{{ section.settings.effect | default: 'up' }}" data-mgu-speed="{{ section.settings.effect_speed | default: 'normal' }}" class="mgu mgu-block" id="mgu-kategorien-{{ section.id }}" style="background:{{ section.settings.bg }}">
  <div class="mgu-wrap">
    <div class="mgu-sec-head mgu-reveal">
      {%- if section.settings.eyebrow != blank -%}
        <span class="mgu-eyebrow">{{ section.settings.eyebrow }}</span>
      {%- endif -%}
      <h2>{{ section.settings.heading }}</h2>
      {%- if section.settings.text != blank -%}
        <p>{{ section.settings.text }}</p>
      {%- endif -%}
    </div>
    <div class="mgu-kat-grid">
      {%- for block in section.blocks -%}
        {%- assign col = block.settings.collection -%}
        {%- assign category_url = col.url | default: block.settings.link -%}
        {%- if category_url != blank -%}<a class="mgu-kat mgu-reveal"
           href="{{ category_url }}"
           {% if forloop.index > 1 %}style="transition-delay:{{ forloop.index0 | times: 0.08 }}s"{% endif %}
           {{ block.shopify_attributes }}>
          {%- assign img = block.settings.image | default: col.featured_image -%}
          {%- if img != blank -%}
            <img width="{{ img.width }}" height="{{ img.height }}" src="{{ img | image_url: width: 800 }}"
                 alt="{{ img.alt | default: block.settings.title | default: col.title | escape }}"
                 loading="lazy">
          {%- else -%}
            {{ 'collection-1' | placeholder_svg_tag }}
          {%- endif -%}
          <div class="mgu-kat-label">
            <h3>{{ block.settings.title | default: col.title }}</h3>
            <span class="mgu-kat-pfeil">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none"><path d="M5 12h14M13 6l6 6-6 6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
            </span>
          </div>
        </a>{%- endif -%}
      {%- endfor -%}
    </div>
  </div>
</section>

{% style %}
  #shopify-section-{{ section.id }} {
    margin-block-start: {{ section.settings.section_gap_top | default: 0 }}px;
    margin-block-end: {{ section.settings.section_gap_bottom | default: 0 }}px;
  }
{% endstyle %}

{% schema %}
{
  "name": "Chelonaki – Kategorien",
