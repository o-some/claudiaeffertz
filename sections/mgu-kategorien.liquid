  "blocks": [
    {
      "type": "kategorie",
      "name": "Kategorie",
      "settings": [
        {
          "type": "collection",
          "id": "collection",
          "label": "Collection"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Eigenes Bild (optional, sonst Collection-Bild)"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Eigener Titel (optional)"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Eigener Link (optional)"
        }
