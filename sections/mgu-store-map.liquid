{% comment %} Chelonaki Shop Theme · © Chelonaki · Build: CHELONAKI-BUILD-0000-MASTER · Nutzung nur mit gültiger Lizenz {% endcomment %}
<style>
  .mgu-sm-head{display:flex;align-items:flex-end;justify-content:space-between;gap:40px;max-width:none}
  .mgu-sm-head-copy{min-width:0}
  .mgu-sm-illustration{width:clamp(180px,22vw,290px);height:auto;flex:0 0 auto;color:var(--mgu-forest);opacity:.9}
  .mgu-sm-illustration .mgu-sm-gold{stroke:var(--mgu-gold)}
  .mgu-sm-illustration .mgu-sm-soft{fill:rgba(185,145,47,.08)}
  .mgu-sm{display:grid;grid-template-columns:1fr 1.1fr;gap:0;border-radius:24px;overflow:hidden;box-shadow:0 40px 80px -35px rgba(20,37,25,.4)}
  @media(max-width:900px){.mgu-sm{grid-template-columns:1fr;grid-template-rows:auto auto}}
  @media(max-width:700px){
    .mgu-sm-head{align-items:flex-start;flex-direction:column;gap:20px}
    .mgu-sm-illustration{width:min(230px,72vw);align-self:flex-end;margin-top:-10px}
  }
  .mgu-sm-list{background:var(--mgu-paper);padding:26px;overflow-y:auto;max-height:520px}
  .mgu-sm-item{padding:14px 12px;border-radius:14px;cursor:pointer;transition:background .2s;border:1px solid transparent}
  .mgu-sm-item:hover,.mgu-sm-item.mgu-sm-active{background:var(--mgu-cream);border-color:var(--mgu-gold-soft)}
  .mgu-sm-item h3{margin:0 0 4px;font-size:15px;color:var(--mgu-forest)}
  .mgu-sm-item p{margin:0;font-size:13px;color:var(--mgu-ink-soft);line-height:1.5}
  .mgu-sm-map{min-height:340px;background:var(--mgu-cream)}
  .mgu-sm-map iframe{width:100%;height:100%;min-height:340px;border:0;display:block}
  .mgu-sm-consent{min-height:340px;padding:32px;display:flex;flex-direction:column;align-items:center;justify-content:center;text-align:center;gap:14px;color:var(--mgu-ink-soft)}
  .mgu-sm-consent [data-mgu-sm-target]{width:100%}
  .mgu-sm-consent p{max-width:48ch;margin:0}
</style>
<section data-mgu-effect="{{ section.settings.effect | default: 'up' }}" data-mgu-speed="{{ section.settings.effect_speed | default: 'normal' }}" class="mgu mgu-block" style="background:{{ section.settings.bg }}">
  <div class="mgu-wrap">
    <div class="mgu-sec-head mgu-sm-head mgu-reveal">
      <div class="mgu-sm-head-copy">
        {%- if section.settings.eyebrow != blank -%}<span class="mgu-eyebrow">{{ section.settings.eyebrow }}</span>{%- endif -%}
        <h2>{{ section.settings.heading }}</h2>
      </div>
      <svg class="mgu-sm-illustration" viewBox="0 0 300 150" role="img" aria-label="Illustration einer handwerklichen Bäckerei mit Brot und Getreide">
        <path class="mgu-sm-soft" d="M57 47h181l18 25v58H39V72z"/>
        <g fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2">
          <path d="M48 70h198l-18-24H66zM45 70v60h204V70M92 130V88h48v42M166 91h47v25h-47z"/>
          <path class="mgu-sm-gold" d="M39 70h217M73 46c4-16 12-27 23-33M82 34l-10-7M88 25l-8-9M96 15l-3-10M226 47c-2-15-8-27-18-37M218 33l10-8M213 23l7-10M207 13l2-10"/>
          <path d="M103 111c0-11 6-18 15-18s15 7 15 18c-8 5-22 5-30 0zM112 97c2 4 3 9 3 17M123 97c-2 5-3 10-3 18"/>
          <path class="mgu-sm-gold" d="M67 130h158M59 137h174"/>
        </g>
        <circle cx="189.5" cy="103.5" r="5.5" fill="var(--mgu-gold)"/>
        <path d="M187 103l2 2 4-5" fill="none" stroke="var(--mgu-paper)" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5"/>
      </svg>
    </div>
    <div class="mgu-sm mgu-reveal">
      <div class="mgu-sm-list" role="list">
        {%- for block in section.blocks -%}
          <div class="mgu-sm-item {% if forloop.first %}mgu-sm-active{% endif %}" role="listitem" tabindex="0"
               data-mgu-sm-query="{{ block.settings.name | append: ' ' | append: block.settings.adresse | url_encode }}"
               {{ block.shopify_attributes }}>
            <h3>{{ block.settings.name }}</h3>
            <p>{{ block.settings.adresse | newline_to_br }}</p>
            {%- if block.settings.zeiten != blank -%}<p>🕐 {{ block.settings.zeiten }}</p>{%- endif -%}
          </div>
        {%- endfor -%}
      </div>
      <div class="mgu-sm-map">
        {%- if section.blocks.size > 0 -%}
          <div class="mgu-sm-consent" data-mgu-sm-consent data-mgu-sm-query="{{ section.blocks.first.settings.name | append: ' ' | append: section.blocks.first.settings.adresse | url_encode }}">
            <div data-mgu-sm-target>
              <p>{{ section.settings.consent_text | escape }}</p>
              <button class="mgu-btn mgu-btn--primary" type="button" data-mgu-sm-load>{{ section.settings.load_label | escape }}</button>
            </div>
            <p role="status" aria-live="polite" data-mgu-sm-status></p>
          </div>
        {%- endif -%}
      </div>
    </div>
  </div>
</section>
<script>
(function(){
  document.querySelectorAll('.mgu-sm:not([data-init])').forEach(function(box){
    box.dataset.init='1';
    var items=box.querySelectorAll('.mgu-sm-item[data-mgu-sm-query]'), consent=box.querySelector('[data-mgu-sm-consent]');
    if(!consent) return;
    var load=consent.querySelector('[data-mgu-sm-load]'), target=consent.querySelector('[data-mgu-sm-target]'), status=consent.querySelector('[data-mgu-sm-status]'), frame=null;
    function mapUrl(){ return 'https://www.google.com/maps?q='+consent.dataset.mguSmQuery+'&output=embed'; }
    function activate(item){
      items.forEach(function(i){ i.classList.remove('mgu-sm-active'); });
      item.classList.add('mgu-sm-active');
      consent.dataset.mguSmQuery=item.dataset.mguSmQuery;
      if(frame) frame.src=mapUrl();
    }
    items.forEach(function(item){
      item.addEventListener('click', function(){ activate(item); });
      item.addEventListener('keydown', function(e){ if(e.key==='Enter'||e.key===' '){ e.preventDefault(); activate(item); } });
    });
    if(load) load.addEventListener('click', function(){
      frame=document.createElement('iframe');
      frame.src=mapUrl();
      frame.loading='lazy';
      frame.referrerPolicy='strict-origin-when-cross-origin';
      frame.title={{ section.settings.heading | strip_html | json }};
      target.replaceChildren(frame);
      if(status) status.textContent={{ section.settings.loaded_text | json }};
    });
  });
})();
</script>
{% style %}
  #shopify-section-{{ section.id }} {
    margin-block-start: {{ section.settings.section_gap_top | default: 0 }}px;
    margin-block-end: {{ section.settings.section_gap_bottom | default: 0 }}px;
  }
{% endstyle %}

{% schema %}
{
  "name": "Chelonaki · Storefinder",
  "settings": [
    {"type":"header","content":"Abstand zum nächsten Abschnitt"},
    {"type":"range","id":"section_gap_top","label":"Zusätzlicher Abstand oben","min":0,"max":200,"step":4,"unit":"px","default":0},
    {"type":"range","id":"section_gap_bottom","label":"Zusätzlicher Abstand unten","min":0,"max":200,"step":4,"unit":"px","default":0},
    { "type": "paragraph", "content": "Standortliste MIT eingebetteter Google-Maps-Karte (kein API-Key nötig, nutzt die kostenlose Embed-Suche). Eigenständig von 'Chelonaki – Händler-Finder' – wähle die passende je nach gewünschter Optik." },
    { "type": "header", "content": "Scroll-Effekt" },
    { "type": "select", "id": "effect", "label": "Erscheinen beim Scrollen", "default": "up", "options": [ { "value": "none", "label": "Kein Effekt" }, { "value": "fade", "label": "Einblenden" }, { "value": "up", "label": "Von unten (Standard)" }, { "value": "left", "label": "Von links" }, { "value": "right", "label": "Von rechts" }, { "value": "zoom", "label": "Sanfter Zoom" }, { "value": "blur", "label": "Aus der Unschärfe" } ] },
    { "type": "select", "id": "effect_speed", "label": "Effekt-Tempo", "default": "normal", "options": [ { "value": "schnell", "label": "Schnell" }, { "value": "normal", "label": "Normal" }, { "value": "langsam", "label": "Langsam" } ] },
    { "type": "text", "id": "eyebrow", "label": "Kicker-Zeile", "default": "Vor Ort" },
    { "type": "inline_richtext", "id": "heading", "label": "Überschrift", "default": "Unsere <em>Standorte.</em>" },
    { "type": "color", "id": "bg", "label": "Hintergrundfarbe", "default": "#F3EDDF" },
    { "type": "textarea", "id": "consent_text", "label": "Datenschutzhinweis Karte", "default": "Beim Laden der Karte werden Daten an Google übertragen." },
    { "type": "text", "id": "load_label", "label": "Beschriftung Karte laden", "default": "Google Maps laden" },
    { "type": "text", "id": "loaded_text", "label": "Status nach dem Laden", "default": "Karte wurde geladen." }
  ],
  "blocks": [
    { "type": "standort", "name": "Standort",
      "settings": [
        { "type": "text", "id": "name", "label": "Name", "default": "Filiale Heidelberg" },
        { "type": "textarea", "id": "adresse", "label": "Adresse", "default": "Hauptstraße 1\n69117 Heidelberg" },
        { "type": "text", "id": "zeiten", "label": "Öffnungszeiten", "default": "Mo–Sa 9–19 Uhr" }
      ]}
  ],
  "presets": [{ "name": "Chelonaki – Store-Locator (mit Karte)", "blocks": [ { "type": "standort" }, { "type": "standort" } ] }]
}
{% endschema %}
