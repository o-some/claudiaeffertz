{% liquid
  assign imprint_url = section.settings.imprint_link
  if imprint_url == blank
    for policy in shop.policies
      assign normalized_title = policy.title | downcase
      if policy.type == 'legal_notice' or normalized_title contains 'impressum' or normalized_title contains 'legal notice'
        assign imprint_url = policy.url
        break
      endif
    endfor
  endif
  if imprint_url == blank and pages.impressum != blank
    assign imprint_url = pages.impressum.url
  endif
%}
<footer class="ch-footer" id="ChFooter-{{ section.id }}" style="--ch-footer-bg:{{ section.settings.background }};--ch-footer-color:{{ section.settings.text_color }}">
  <div class="ch-shell">
    <div class="ch-footer__grid" style="--ch-footer-columns:{{ section.settings.columns }}">
      {% for block in section.blocks %}
        <div {{ block.shopify_attributes }}>
          {% case block.type %}
            {% when 'brand' %}
              <h2>{{ settings.ch_brand_name | default: shop.name | escape }}</h2>
              <div class="rte">{{ block.settings.text }}</div>
            {% when 'menu' %}
              <h2>{{ block.settings.heading | escape }}</h2>
              <ul>{% for link in block.settings.menu.links %}<li><a href="{{ link.url }}">{{ link.title | escape }}</a></li>{% endfor %}</ul>
            {% when 'legal' %}
              <h2>{{ block.settings.heading | escape }}</h2>
              <ul>
                {% if block.settings.show_imprint and imprint_url != blank %}<li><a href="{{ imprint_url }}">{{ block.settings.imprint_label | escape }}</a></li>{% endif %}
                {% if block.settings.show_privacy and shop.privacy_policy != blank %}<li><a href="{{ shop.privacy_policy.url }}">{{ shop.privacy_policy.title | escape }}</a></li>{% endif %}
                {% if block.settings.show_terms and shop.terms_of_service != blank %}<li><a href="{{ shop.terms_of_service.url }}">{{ shop.terms_of_service.title | escape }}</a></li>{% endif %}
                {% if block.settings.show_refund and shop.refund_policy != blank %}<li><a href="{{ shop.refund_policy.url }}">{{ shop.refund_policy.title | escape }}</a></li>{% endif %}
                {% if block.settings.show_shipping and shop.shipping_policy != blank %}<li><a href="{{ shop.shipping_policy.url }}">{{ shop.shipping_policy.title | escape }}</a></li>{% endif %}
              </ul>
            {% when 'contact' %}
              <h2>{{ block.settings.heading | escape }}</h2>
              {% if block.settings.email != blank %}<a href="mailto:{{ block.settings.email | escape }}">{{ block.settings.email | escape }}</a>{% endif %}
              {% if block.settings.phone != blank %}<a href="tel:{{ block.settings.phone | replace: ' ', '' | escape }}">{{ block.settings.phone | escape }}</a>{% endif %}
              <div>{{ block.settings.address | newline_to_br }}</div>
          {% endcase %}
        </div>
      {% endfor %}
    </div>
    <div class="ch-footer__bottom">
      <span>© {{ 'now' | date: '%Y' }} {{ settings.ch_brand_name | default: shop.name | escape }}</span>
      {% if section.settings.show_payment_icons and shop.enabled_payment_types != empty %}
        <ul class="ch-payment-icons" role="list" aria-label="{{ 'sections.footer.payment' | t }}">
          {% for type in shop.enabled_payment_types %}<li>{{ type | payment_type_svg_tag: class: 'icon icon--full-color' }}</li>{% endfor %}
        </ul>
      {% endif %}
    </div>
  </div>
</footer>

{% schema %}
{
  "name": "Chelonaki – Footer",
  "tag": "section",
  "class": "ch-footer-section",
  "settings": [
    { "type": "range", "id": "columns", "label": "Spalten", "min": 1, "max": 4, "step": 1, "default": 3 },
    { "type": "url", "id": "imprint_link", "label": "Impressum (optional)" },
    { "type": "checkbox", "id": "show_payment_icons", "label": "Zahlungshinweis anzeigen", "default": true },
    { "type": "color", "id": "background", "label": "Hintergrund", "default": "#142519" },
    { "type": "color", "id": "text_color", "label": "Text", "default": "#FBF8F0" }
  ],
  "blocks": [
    { "type": "brand", "name": "Marke", "limit": 1, "settings": [{ "type": "richtext", "id": "text", "label": "Beschreibung", "default": "<p>Qualität, die zur Marke passt.</p>" }] },
    { "type": "menu", "name": "Menü", "limit": 4, "settings": [{ "type": "text", "id": "heading", "label": "Überschrift", "default": "Entdecken" }, { "type": "link_list", "id": "menu", "label": "Menü" }] },
    { "type": "legal", "name": "Rechtliches", "limit": 1, "settings": [
      { "type": "text", "id": "heading", "label": "Überschrift", "default": "Rechtliches" },
      { "type": "checkbox", "id": "show_imprint", "label": "Impressum", "default": true },
      { "type": "text", "id": "imprint_label", "label": "Impressum-Text", "default": "Impressum" },
      { "type": "checkbox", "id": "show_privacy", "label": "Datenschutz", "default": true },
      { "type": "checkbox", "id": "show_terms", "label": "AGB", "default": true },
      { "type": "checkbox", "id": "show_refund", "label": "Widerruf", "default": true },
      { "type": "checkbox", "id": "show_shipping", "label": "Versand", "default": true }
    ] },
    { "type": "contact", "name": "Kontakt", "limit": 2, "settings": [
      { "type": "text", "id": "heading", "label": "Überschrift", "default": "Kontakt" },
      { "type": "text", "id": "email", "label": "E-Mail" },
      { "type": "text", "id": "phone", "label": "Telefon" },
      { "type": "textarea", "id": "address", "label": "Adresse" }
    ] }
  ],
  "presets": [{ "name": "Chelonaki – Footer", "blocks": [{ "type": "brand" }, { "type": "menu" }, { "type": "legal" }] }]
}
{% endschema %}
