{% comment %} Chelonaki Shop Theme · © Chelonaki · Build: CHELONAKI-BUILD-0000-MASTER · Nutzung nur mit gültiger Lizenz {% endcomment %}
<style>
  .mgu-dl-list{display:flex;flex-direction:column;gap:12px;max-width:720px;margin:0 auto}
  .mgu-dl{display:flex;align-items:center;gap:16px;padding:16px 20px;background:var(--mgu-paper);border:1px solid var(--mgu-line);border-radius:16px;transition:border-color .3s,transform .3s;text-decoration:none}
  .mgu-dl:hover{border-color:var(--mgu-gold-soft);transform:translateX(4px)}
  .mgu-dl-icon{font-size:1.5rem;flex-shrink:0}
  .mgu-dl-info{flex:1;min-width:0}
  .mgu-dl-info b{display:block;color:var(--mgu-forest);font-size:15px}
  .mgu-dl-info span{font-size:12.5px;color:var(--mgu-ink-soft)}
  .mgu-dl-cta{font-size:13px;font-weight:700;color:var(--mgu-gold);white-space:nowrap}
</style>
<section data-mgu-effect="{{ section.settings.effect | default: 'up' }}" data-mgu-speed="{{ section.settings.effect_speed | default: 'normal' }}" class="mgu mgu-block" style="--mgu-space-top:{{ section.settings.spacing_top }}px;--mgu-space-bottom:{{ section.settings.spacing_bottom }}px;background:{{ section.settings.bg }}">
  <div class="mgu-wrap">
    <div class="mgu-sec-head mgu-reveal" style="text-align:center;margin-left:auto;margin-right:auto">
      {%- if section.settings.eyebrow != blank -%}<span class="mgu-eyebrow">{{ section.settings.eyebrow }}</span>{%- endif -%}
      <h2>{{ section.settings.heading }}</h2>
    </div>
    <div class="mgu-dl-list">
      {%- for block in section.blocks -%}
        {%- assign download_url = block.settings.datei | default: block.settings.url -%}
        {%- if download_url != blank -%}<a class="mgu-dl mgu-reveal" href="{{ download_url }}" target="_blank" rel="noopener" {{ block.shopify_attributes }}>
          <span class="mgu-dl-icon" aria-hidden="true">{{ block.settings.icon }}</span>
          <span class="mgu-dl-info"><b>{{ block.settings.titel }}</b>{%- if block.settings.meta != blank -%}<span>{{ block.settings.meta }}</span>{%- endif -%}</span>
          <span class="mgu-dl-cta">{{ section.settings.cta }} ↓</span>
        </a>{%- elsif request.design_mode -%}<div class="mgu-dl mgu-reveal" aria-disabled="true" {{ block.shopify_attributes }}><span class="mgu-dl-icon" aria-hidden="true">{{ block.settings.icon }}</span><span class="mgu-dl-info"><b>{{ block.settings.titel }}</b><span>Download-Link fehlt</span></span></div>{%- endif -%}
      {%- endfor -%}
    </div>
  </div>
</section>
{% schema %}
{
  "name": "Chelonaki – Downloads",
  "settings": [
    { "type": "paragraph", "content": "Katalog-/Datenblatt-Downloads (B2B). Datei über 'Datei' (Shopify-Upload) ODER externe URL. Kein file_picker im Schema – Dateien via Inhalte→Dateien hochladen und URL einfügen, oder Metaobjekt-Link." },
    { "type": "header", "content": "Scroll-Effekt" },
    { "type": "select", "id": "effect", "label": "Erscheinen beim Scrollen", "default": "up", "options": [ { "value": "none", "label": "Kein Effekt" }, { "value": "fade", "label": "Einblenden" }, { "value": "up", "label": "Von unten (Standard)" }, { "value": "left", "label": "Von links" }, { "value": "right", "label": "Von rechts" }, { "value": "zoom", "label": "Sanfter Zoom" }, { "value": "blur", "label": "Aus der Unschärfe" } ] },
    { "type": "select", "id": "effect_speed", "label": "Effekt-Tempo", "default": "normal", "options": [ { "value": "schnell", "label": "Schnell" }, { "value": "normal", "label": "Normal" }, { "value": "langsam", "label": "Langsam" } ] },
    { "type": "text", "id": "eyebrow", "label": "Kicker-Zeile", "default": "Für Händler" },
    { "type": "inline_richtext", "id": "heading", "label": "Überschrift", "default": "Kataloge & <em>Datenblätter.</em>" },
    { "type": "text", "id": "cta", "label": "Download-Text", "default": "Download" },
    { "type": "header", "content": "Abstände zum nächsten Abschnitt" },
    { "type": "range", "id": "spacing_top", "label": "Abstand oben", "min": 0, "max": 160, "step": 8, "unit": "px", "default": 80 },
    { "type": "range", "id": "spacing_bottom", "label": "Abstand unten", "min": 0, "max": 160, "step": 8, "unit": "px", "default": 80 },
    { "type": "color", "id": "bg", "label": "Hintergrundfarbe", "default": "#FBF8F0" }
  ],
  "blocks": [
    { "type": "datei", "name": "Download",
      "settings": [
        { "type": "text", "id": "icon", "label": "Icon (Emoji)", "default": "📄" },
        { "type": "text", "id": "titel", "label": "Titel", "default": "Produktkatalog 2026" },
        { "type": "text", "id": "meta", "label": "Zusatz (Format/Größe)", "default": "PDF · 4 MB" },
        { "type": "url", "id": "datei", "label": "Datei (Shopify-Upload-URL)" },
        { "type": "url", "id": "url", "label": "oder externe URL" }
      ]}
  ],
  "presets": [{ "name": "Chelonaki – Downloads", "blocks": [ { "type": "datei" }, { "type": "datei", "settings": { "titel": "Produktdatenblatt", "meta": "PDF · 800 KB" } } ] }]
}
{% endschema %}
