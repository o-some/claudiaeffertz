{% comment %} Chelonaki Shop Theme · © Chelonaki · Build: CHELONAKI-BUILD-0000-MASTER · Nutzung nur mit gültiger Lizenz {% endcomment %}

<style>
  .mgu-vgl{overflow-x:auto;-webkit-overflow-scrolling:touch}
  .mgu-vgl table{width:100%;border-collapse:separate;border-spacing:0;min-width:560px}
  .mgu-vgl th,.mgu-vgl td{padding:16px 18px;text-align:center;font-size:14.5px;border-bottom:1px solid var(--mgu-line)}
  .mgu-vgl td:first-child,.mgu-vgl th:first-child{text-align:left;font-weight:600;color:var(--mgu-ink)}
  .mgu-vgl thead th{background:var(--mgu-forest);color:#FCF9F1;font-family:var(--mgu-font-heading);font-weight:400;font-size:1.1rem}
  .mgu-vgl thead th:first-child{background:transparent;border:none}
  .mgu-vgl thead th:nth-child(2){border-radius:18px 0 0 0}
  .mgu-vgl thead th:last-child{border-radius:0 18px 0 0}
  .mgu-vgl .mgu-vgl-preis{color:var(--mgu-gold);font-weight:700;font-size:1.05rem}
  .mgu-vgl td.mgu-ja{color:#2E6B45;font-weight:700}
  .mgu-vgl td.mgu-nein{color:#B9B4A6}
  .mgu-vgl tbody tr:nth-child(odd) td{background:rgba(243,237,223,.5)}
  .mgu-vgl tfoot td{border:none;padding-top:20px}
</style>

<section data-mgu-effect="{{ section.settings.effect | default: 'up' }}" data-mgu-speed="{{ section.settings.effect_speed | default: 'normal' }}" class="mgu mgu-block" style="background:{{ section.settings.bg }}">
  <div class="mgu-wrap">
    <div class="mgu-sec-head mgu-reveal">
      {%- if section.settings.eyebrow != blank -%}<span class="mgu-eyebrow">{{ section.settings.eyebrow }}</span>{%- endif -%}
      <h2>{{ section.settings.heading }}</h2>
    </div>
    {%- assign zeilen = section.settings.merkmale | newline_to_br | split: '<br />' -%}
    <div class="mgu-vgl mgu-reveal">
      <table>
        <thead>
          <tr>
            <th></th>
            {%- for block in section.blocks -%}<th {{ block.shopify_attributes }}>{{ block.settings.titel }}</th>{%- endfor -%}
          </tr>
        </thead>
        <tbody>
          {%- for zeile in zeilen -%}
            {%- assign z = zeile | strip -%}
            {%- if z != blank -%}
              <tr>
                <td>{{ z }}</td>
                {%- for block in section.blocks -%}
                  {%- assign werte = block.settings.werte | newline_to_br | split: '<br />' -%}
                  {%- assign w = werte[forloop.parentloop.index0] | strip | default: '–' -%}
                  {%- if w == 'ja' -%}<td class="mgu-ja">✓</td>
                  {%- elsif w == 'nein' -%}<td class="mgu-nein">–</td>
                  {%- else -%}<td>{{ w }}</td>{%- endif -%}
                {%- endfor -%}
              </tr>
            {%- endif -%}
          {%- endfor -%}
          <tr>
            <td></td>
            {%- for block in section.blocks -%}<td class="mgu-vgl-preis">{{ block.settings.preis }}</td>{%- endfor -%}
          </tr>
        </tbody>
        <tfoot>
          <tr>
            <td></td>
            {%- for block in section.blocks -%}
              <td>{%- if block.settings.button != blank and block.settings.link != blank -%}<a class="mgu-btn mgu-btn--primary" href="{{ block.settings.link }}">{{ block.settings.button }}</a>{%- endif -%}</td>
            {%- endfor -%}
          </tr>
        </tfoot>
      </table>
    </div>
  </div>
</section>

{% style %}
  #shopify-section-{{ section.id }} {
    margin-block-start: {{ section.settings.section_gap_top | default: 0 }}px;
    margin-block-end: {{ section.settings.section_gap_bottom | default: 0 }}px;
  }
{% endstyle %}

{% schema %}
{
  "name": "Chelonaki · Vergleich",
  "settings": [
    {"type":"header","content":"Abstand zum nächsten Abschnitt"},
    {"type":"range","id":"section_gap_top","label":"Zusätzlicher Abstand oben","min":0,"max":200,"step":4,"unit":"px","default":0},
    {"type":"range","id":"section_gap_bottom","label":"Zusätzlicher Abstand unten","min":0,"max":200,"step":4,"unit":"px","default":0},
    { "type": "header", "content": "Scroll-Effekt" },
    { "type": "select", "id": "effect", "label": "Erscheinen beim Scrollen", "default": "up", "options": [ { "value": "none", "label": "Kein Effekt" }, { "value": "fade", "label": "Einblenden" }, { "value": "up", "label": "Von unten (Standard)" }, { "value": "left", "label": "Von links" }, { "value": "right", "label": "Von rechts" }, { "value": "zoom", "label": "Sanfter Zoom" }, { "value": "blur", "label": "Aus der Unschärfe" } ] },
    { "type": "select", "id": "effect_speed", "label": "Effekt-Tempo", "default": "normal", "options": [ { "value": "schnell", "label": "Schnell" }, { "value": "normal", "label": "Normal" }, { "value": "langsam", "label": "Langsam" } ] },
    { "type": "text", "id": "eyebrow", "label": "Kicker-Zeile", "default": "Was passt zu dir?" },
    { "type": "inline_richtext", "id": "heading", "label": "Überschrift", "default": "Was passt <em>zu dir?</em>" },
    { "type": "textarea", "id": "merkmale", "label": "Merkmale (eins pro Zeile)", "default": "Alle Rezepte\nSchritt-für-Schritt-Videos\nZum Nachschlagen\nLebenslanger Zugriff" },
    { "type": "color", "id": "bg", "label": "Hintergrundfarbe", "default": "#FBF8F0" }
  ],
  "blocks": [
    {
      "type": "spalte",
      "name": "Spalte",
      "limit": 4,
      "settings": [
        { "type": "text", "id": "titel", "label": "Titel", "default": "Variante A" },
        { "type": "textarea", "id": "werte", "label": "Werte (eine Zeile pro Merkmal, 'ja'/'nein' wird zu ✓/–)", "default": "ja\nnein\nja\nja" },
        { "type": "text", "id": "preis", "label": "Preis", "default": "29,90 €" },
        { "type": "text", "id": "button", "label": "Button", "default": "Auswählen" },
        { "type": "url", "id": "link", "label": "Link" }
      ]
    }
  ],
  "presets": [{ "name": "Chelonaki – Vergleichstabelle", "blocks": [ { "type": "spalte" }, { "type": "spalte", "settings": { "titel": "Variante B", "werte": "ja\nja\nja\nja", "preis": "89,00 €", "button": "Auswählen" } } ] }]
}
{% endschema %}
