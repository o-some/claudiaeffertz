<section class="ch-section" id="ChRecommendations-{{ section.id }}" data-ch-recommendations data-section-id="{{ section.id }}">
  <div class="page-width"><p class="ch-eyebrow">{{ section.settings.eyebrow | escape }}</p><h2>{{ section.settings.heading | escape }}</h2><p>{{ section.settings.explanation | escape }}</p>
    <ul class="grid product-grid" role="list">{% for block in section.blocks %}{% assign product = block.settings.product %}{% if product != blank %}<li class="grid__item" {{ block.shopify_attributes }}>{% render 'card-product', card_product: product, show_vendor: false %}</li>{% endif %}{% endfor %}</ul>
    {% if section.settings.privacy_link != blank %}<a href="{{ section.settings.privacy_link }}">{{ section.settings.privacy_label | escape }}</a>{% endif %}
  </div>
</section>
{% style %}
  #shopify-section-{{ section.id }} {
    margin-block-start: {{ section.settings.section_gap_top | default: 0 }}px;
    margin-block-end: {{ section.settings.section_gap_bottom | default: 0 }}px;
  }
{% endstyle %}

{% schema %}{"name":"CH Empfehlungen","settings":[
    {"type":"header","content":"Abstand zum nächsten Abschnitt"},
    {"type":"range","id":"section_gap_top","label":"Zusätzlicher Abstand oben","min":0,"max":200,"step":4,"unit":"px","default":0},
    {"type":"range","id":"section_gap_bottom","label":"Zusätzlicher Abstand unten","min":0,"max":200,"step":4,"unit":"px","default":0},{"type":"text","id":"eyebrow","label":"Eyebrow","default":"Für dich ausgewählt"},{"type":"text","id":"heading","label":"Überschrift","default":"Empfehlungen"},{"type":"text","id":"explanation","label":"Erklärung","default":"Nachvollziehbare Vorschläge mit neutralen Bestsellern als Fallback."},{"type":"url","id":"privacy_link","label":"Datenschutz-Link"},{"type":"text","id":"privacy_label","label":"Linktext","default":"Personalisierung verwalten"}],"blocks":[{"type":"product","name":"Produkt","settings":[{"type":"product","id":"product","label":"Produkt"}]}],"max_blocks":4,"presets":[{"name":"CH Empfehlungen"}]}{% endschema %}
