{% comment %} Chelonaki Shop Theme · © Chelonaki · Build: CHELONAKI-BUILD-0000-MASTER · Nutzung nur mit gültiger Lizenz {% endcomment %}
<style>
  .mgu-logos{display:flex;flex-wrap:wrap;justify-content:center;align-items:center;gap:clamp(28px,5vw,64px)}
  .mgu-logos img{display:block;max-width:min(320px,80vw);max-height:{{ section.settings.hoehe }}px;width:auto;height:auto;opacity:{{ section.settings.logo_opacity | divided_by: 100.0 }};filter:{% if section.settings.show_color %}none{% else %}grayscale(1){% endif %};transition:opacity .3s,filter .3s,transform .3s}
  .mgu-logos a:hover img,.mgu-logos img:hover{opacity:1;filter:none}
  .mgu-logos a:hover img{transform:scale(1.035)}
</style>
<section data-mgu-effect="{{ section.settings.effect | default: 'fade' }}" data-mgu-speed="{{ section.settings.effect_speed | default: 'normal' }}" class="mgu" style="background:{{ section.settings.bg }};padding:clamp(34px,5vw,64px) clamp(20px,4vw,48px)">
  <div class="mgu-wrap">
    {%- if section.settings.heading != blank -%}
      <p class="mgu-reveal" style="text-align:center;font-size:12px;letter-spacing:.22em;text-transform:uppercase;font-weight:700;color:var(--mgu-ink-soft);margin:0 0 26px">{{ section.settings.heading }}</p>
    {%- endif -%}
    <div class="mgu-logos mgu-reveal">
      {%- for block in section.blocks -%}
        {%- if block.settings.logo != blank -%}
          {%- if block.settings.link != blank -%}<a href="{{ block.settings.link }}" target="_blank" rel="noopener" {{ block.shopify_attributes }}>{%- endif -%}
          <img width="{{ block.settings.logo.width }}" height="{{ block.settings.logo.height }}" src="{{ block.settings.logo | image_url: width: 800 }}" srcset="{{ block.settings.logo | image_url: width: 320 }} 320w, {{ block.settings.logo | image_url: width: 500 }} 500w, {{ block.settings.logo | image_url: width: 800 }} 800w" sizes="(max-width: 680px) 80vw, 320px" alt="{{ block.settings.name | escape }}" loading="lazy" {% unless block.settings.link != blank %}{{ block.shopify_attributes }}{% endunless %}>
          {%- if block.settings.link != blank -%}</a>{%- endif -%}
        {%- endif -%}
      {%- endfor -%}
    </div>
  </div>
</section>
{% style %}
  #shopify-section-{{ section.id }} {
    margin-block-start: {{ section.settings.section_gap_top | default: 0 }}px;
    margin-block-end: {{ section.settings.section_gap_bottom | default: 0 }}px;
  }
{% endstyle %}

{% schema %}
{
  "name": "Chelonaki – Logo-Leiste",
  "settings": [
    {"type":"header","content":"Abstand zum nächsten Abschnitt"},
    {"type":"range","id":"section_gap_top","label":"Zusätzlicher Abstand oben","min":0,"max":200,"step":4,"unit":"px","default":0},
    {"type":"range","id":"section_gap_bottom","label":"Zusätzlicher Abstand unten","min":0,"max":200,"step":4,"unit":"px","default":0},
    { "type": "header", "content": "Scroll-Effekt" },
    { "type": "select", "id": "effect", "label": "Erscheinen beim Scrollen", "default": "up", "options": [ { "value": "none", "label": "Kein Effekt" }, { "value": "fade", "label": "Einblenden" }, { "value": "up", "label": "Von unten (Standard)" }, { "value": "left", "label": "Von links" }, { "value": "right", "label": "Von rechts" }, { "value": "zoom", "label": "Sanfter Zoom" }, { "value": "blur", "label": "Aus der Unschärfe" } ] },
    { "type": "select", "id": "effect_speed", "label": "Effekt-Tempo", "default": "normal", "options": [ { "value": "schnell", "label": "Schnell" }, { "value": "normal", "label": "Normal" }, { "value": "langsam", "label": "Langsam" } ] },
    { "type": "text", "id": "heading", "label": "Überzeile", "default": "Bekannt aus" },
    { "type": "range", "id": "hoehe", "label": "Logo-Höhe (px)", "min": 24, "max": 184, "step": 4, "default": 96 },
    { "type": "checkbox", "id": "show_color", "label": "Logos farbig anzeigen", "default": true },
    { "type": "range", "id": "logo_opacity", "label": "Deckkraft der Logos", "min": 40, "max": 100, "step": 5, "unit": "%", "default": 100 },
    { "type": "color", "id": "bg", "label": "Hintergrundfarbe", "default": "#FBF8F0" }
  ],
  "blocks": [
    { "type": "logo", "name": "Logo",
      "settings": [
        { "type": "image_picker", "id": "logo", "label": "Logo (PNG/SVG, gern transparent)" },
        { "type": "text", "id": "name", "label": "Name (Alt-Text)", "default": "Partner" },
        { "type": "url", "id": "link", "label": "Link (optional)" }
      ]}
  ],
  "presets": [{ "name": "Chelonaki – Logo-Leiste", "blocks": [ { "type": "logo" }, { "type": "logo" }, { "type": "logo" }, { "type": "logo" } ] }]
}
{% endschema %}
