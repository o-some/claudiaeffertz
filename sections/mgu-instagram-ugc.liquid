{% comment %} Chelonaki Shop Theme · © Chelonaki · Build: CHELONAKI-BUILD-0000-MASTER · Nutzung nur mit gültiger Lizenz {% endcomment %}
<style>
  .mgu-ig-grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(180px,1fr));gap:14px}
  .mgu-ig-item{position:relative;aspect-ratio:1/1;border-radius:16px;overflow:hidden;display:block;background:var(--mgu-cream)}
  .mgu-ig-item img{width:100%;height:100%;object-fit:cover;transition:transform .5s}
  .mgu-ig-item:hover img{transform:scale(1.08)}
  .mgu-ig-item::after{content:"";position:absolute;inset:0;background:linear-gradient(transparent 55%,rgba(20,37,25,.55));opacity:0;transition:opacity .3s}
  .mgu-ig-item:hover::after{opacity:1}
  .mgu-ig-handle{position:absolute;left:12px;bottom:10px;z-index:2;color:#FCF9F1;font-size:12.5px;font-weight:600;opacity:0;transition:opacity .3s}
  .mgu-ig-item:hover .mgu-ig-handle{opacity:1}
</style>
<section data-mgu-effect="{{ section.settings.effect | default: 'up' }}" data-mgu-speed="{{ section.settings.effect_speed | default: 'normal' }}" class="mgu mgu-block" style="background:{{ section.settings.bg }}">
  <div class="mgu-wrap">
    <div class="mgu-sec-head mgu-reveal" style="text-align:center;margin-left:auto;margin-right:auto">
      {%- if section.settings.eyebrow != blank -%}<span class="mgu-eyebrow">{{ section.settings.eyebrow }}</span>{%- endif -%}
      <h2>{{ section.settings.heading }}</h2>
    </div>
    <div class="mgu-ig-grid">
      {%- for block in section.blocks -%}
        {%- if block.settings.link != blank -%}<a class="mgu-ig-item mgu-reveal" href="{{ block.settings.link }}" target="_blank" rel="noopener" {% if forloop.index > 1 %}style="transition-delay:{{ forloop.index0 | times: 0.05 }}s"{% endif %} {{ block.shopify_attributes }}>
          {%- if block.settings.bild != blank -%}<img width="{{ block.settings.bild.width }}" height="{{ block.settings.bild.height }}" src="{{ block.settings.bild | image_url: width: 500 }}" alt="{{ block.settings.alt | default: block.settings.bild.alt | escape }}" loading="lazy">{%- endif -%}
          {%- if block.settings.handle != blank -%}<span class="mgu-ig-handle">{{ block.settings.handle }}</span>{%- endif -%}
        </a>{%- endif -%}
      {%- endfor -%}
    </div>
    {%- if section.settings.profil_link != blank -%}
      <p style="text-align:center;margin-top:22px"><a class="mgu-btn mgu-btn--ghost" href="{{ section.settings.profil_link }}" target="_blank" rel="noopener">{{ section.settings.profil_text }}</a></p>
    {%- endif -%}
  </div>
</section>
{% style %}
  #shopify-section-{{ section.id }} {
    margin-block-start: {{ section.settings.section_gap_top | default: 0 }}px;
    margin-block-end: {{ section.settings.section_gap_bottom | default: 0 }}px;
  }
{% endstyle %}

{% schema %}
{
  "name": "Chelonaki · Instagram",
  "settings": [
    {"type":"header","content":"Abstand zum nächsten Abschnitt"},
    {"type":"range","id":"section_gap_top","label":"Zusätzlicher Abstand oben","min":0,"max":200,"step":4,"unit":"px","default":0},
    {"type":"range","id":"section_gap_bottom","label":"Zusätzlicher Abstand unten","min":0,"max":200,"step":4,"unit":"px","default":0},
    { "type": "paragraph", "content": "Manuell kuratierte Community-/Instagram-Galerie (keine API/App nötig, keine automatische Synchronisierung). Für automatisch synchronisierte Feeds: passenden App-Block im 'App-Container' nutzen." },
    { "type": "header", "content": "Scroll-Effekt" },
    { "type": "select", "id": "effect", "label": "Erscheinen beim Scrollen", "default": "up", "options": [ { "value": "none", "label": "Kein Effekt" }, { "value": "fade", "label": "Einblenden" }, { "value": "up", "label": "Von unten (Standard)" }, { "value": "left", "label": "Von links" }, { "value": "right", "label": "Von rechts" }, { "value": "zoom", "label": "Sanfter Zoom" }, { "value": "blur", "label": "Aus der Unschärfe" } ] },
    { "type": "select", "id": "effect_speed", "label": "Effekt-Tempo", "default": "normal", "options": [ { "value": "schnell", "label": "Schnell" }, { "value": "normal", "label": "Normal" }, { "value": "langsam", "label": "Langsam" } ] },
    { "type": "text", "id": "eyebrow", "label": "Kicker-Zeile", "default": "Community" },
    { "type": "inline_richtext", "id": "heading", "label": "Überschrift", "default": "Getaggt mit <em>#unsereMarke.</em>" },
    { "type": "url", "id": "profil_link", "label": "Profil-Link (optional)" },
    { "type": "text", "id": "profil_text", "label": "Profil-Button-Text", "default": "Folge uns auf Instagram" },
    { "type": "color", "id": "bg", "label": "Hintergrundfarbe", "default": "#FBF8F0" }
  ],
  "blocks": [
    { "type": "bild", "name": "Bild",
      "settings": [
        { "type": "image_picker", "id": "bild", "label": "Bild" },
        { "type": "text", "id": "alt", "label": "Alt-Text" },
        { "type": "text", "id": "handle", "label": "@handle (optional)", "default": "@kundin" },
        { "type": "url", "id": "link", "label": "Link zum Post" }
      ]}
  ],
  "presets": [{ "name": "Chelonaki – Instagram / UGC-Galerie", "blocks": [ { "type": "bild" }, { "type": "bild" }, { "type": "bild" }, { "type": "bild" } ] }]
}
{% endschema %}
