{% comment %} Chelonaki Shop Theme · © Chelonaki · Build: CHELONAKI-BUILD-0000-MASTER · Nutzung nur mit gültiger Lizenz {% endcomment %}

<style>
  #shopify-section-{{ section.id }} .mgu-count {
    --mgu-count-image-width: {{ section.settings.image_width }}%;
    --mgu-count-image-radius: {{ section.settings.image_radius }}px;
    --mgu-count-overlay-opacity: {{ section.settings.overlay_opacity | divided_by: 100.0 }};
    --mgu-count-image-position: {{ section.settings.image_focus }};
  }

  #shopify-section-{{ section.id }} .mgu-count-text h3 {
    color: #fffaf0 !important;
    text-shadow: 0 1px 18px rgba(0, 0, 0, .18);
  }

  #shopify-section-{{ section.id }} .mgu-count-text h3 em {
    color: #e5c868 !important;
  }

  #shopify-section-{{ section.id }} .mgu-count-text p {
    color: rgba(255, 250, 240, .88);
    line-height: 1.6;
  }

  #shopify-section-{{ section.id }} .mgu-count-unit {
    border-color: rgba(229, 200, 104, .52);
    background: rgba(255, 250, 240, .08);
  }

  #shopify-section-{{ section.id }} .mgu-count-unit span {
    color: rgba(255, 250, 240, .82);
  }
</style>

<section data-mgu-effect="{{ section.settings.effect | default: 'up' }}" data-mgu-speed="{{ section.settings.effect_speed | default: 'normal' }}" class="mgu" style="padding:{{ section.settings.spacing_top }}px clamp(20px,4vw,48px) {{ section.settings.spacing_bottom }}px;background:{{ section.settings.bg }}">
  <div class="mgu-wrap">
    <div class="mgu-count mgu-reveal"
         data-mgu-countdown
         data-deadline="{{ section.settings.deadline }}"
         data-hide-over="{{ section.settings.hide_over }}">
      {%- if section.settings.image != blank and section.settings.image_position != 'background' -%}
        <div class="mgu-count-media mgu-count-media--{{ section.settings.image_position }}">
          {{ section.settings.image
            | image_url: width: 1200
            | image_tag:
              loading: 'lazy',
              widths: '320, 480, 640, 800, 1000, 1200',
              sizes: '(max-width: 760px) 100vw, 360px',
              alt: section.settings.image_alt,
              class: 'mgu-count-image'
          }}
        </div>
      {%- endif -%}

      {%- if section.settings.image != blank and section.settings.image_position == 'background' -%}
        <div class="mgu-count-background" aria-hidden="true">
          {{ section.settings.image
            | image_url: width: 2000
            | image_tag:
              loading: 'lazy',
              widths: '750, 1000, 1500, 2000',
              sizes: '100vw',
              alt: '',
              class: 'mgu-count-background-image'
          }}
          <span class="mgu-count-background-overlay"></span>
        </div>
      {%- endif -%}

      <div class="mgu-count-content">
        <div class="mgu-count-text">
          <h3>{{ section.settings.heading }}</h3>
          {%- if section.settings.text != blank -%}<p>{{ section.settings.text }}</p>{%- endif -%}
        </div>
        <div class="mgu-count-right">
        <div class="mgu-count-timer">
          <div class="mgu-count-unit" data-u="d"><b>00</b><span>{{ section.settings.label_days | default: 'Tage' | escape }}</span></div>
          <div class="mgu-count-unit" data-u="h"><b>00</b><span>{{ section.settings.label_hours | default: 'Stunden' | escape }}</span></div>
          <div class="mgu-count-unit" data-u="m"><b>00</b><span>{{ section.settings.label_minutes | default: 'Minuten' | escape }}</span></div>
          <div class="mgu-count-unit" data-u="s"><b>00</b><span>{{ section.settings.label_seconds | default: 'Sekunden' | escape }}</span></div>
        </div>
        {%- if section.settings.button_label != blank and section.settings.button_link != blank -%}
          <a class="mgu-btn mgu-btn--gold" href="{{ section.settings.button_link }}">{{ section.settings.button_label }}</a>
        {%- endif -%}
        </div>
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Chelonaki – Countdown",
  "settings": [
    {
      "type": "header",
      "content": "Scroll-Effekt"
    },
    {
      "type": "select",
      "id": "effect",
      "label": "Erscheinen beim Scrollen",
      "default": "up",
      "options": [
        {
          "value": "none",
          "label": "Kein Effekt"
        },
        {
          "value": "fade",
          "label": "Einblenden"
        },
        {
          "value": "up",
          "label": "Von unten (Standard)"
        },
        {
          "value": "left",
          "label": "Von links"
        },
        {
          "value": "right",
          "label": "Von rechts"
        },
        {
          "value": "zoom",
          "label": "Sanfter Zoom"
        },
        {
          "value": "blur",
          "label": "Aus der Unschärfe"
        }
      ]
    },
    {
      "type": "select",
      "id": "effect_speed",
      "label": "Effekt-Tempo",
      "default": "normal",
      "options": [
        {
          "value": "schnell",
          "label": "Schnell"
        },
        {
          "value": "normal",
          "label": "Normal"
        },
        {
          "value": "langsam",
          "label": "Langsam"
        }
      ]
    },
    {
      "type": "inline_richtext",
      "id": "heading",
      "label": "Überschrift (kursiv = <em>)",
      "default": "Aktion endet <em>bald.</em>"
    },
    {
      "type": "textarea",
      "id": "text",
      "label": "Text",
      "default": "Kurzer Aktionstext – nur für kurze Zeit."
    },
    {
      "type": "header",
      "content": "Optionales Bild"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Bild"
    },
    {
      "type": "text",
      "id": "image_alt",
      "label": "Bildbeschreibung",
      "info": "Beschreibe das Motiv kurz für Barrierefreiheit."
    },
    {
      "type": "select",
      "id": "image_position",
      "label": "Bildposition",
      "default": "left",
      "options": [
        { "value": "left", "label": "Links neben dem Inhalt" },
        { "value": "right", "label": "Rechts neben dem Inhalt" },
        { "value": "background", "label": "Als Hintergrund" }
      ]
    },
    {
      "type": "range",
      "id": "image_width",
      "label": "Bildbreite auf Desktop",
      "min": 20,
      "max": 50,
      "step": 5,
      "unit": "%",
      "default": 35,
      "info": "Gilt für Bilder links oder rechts."
    },
    {
      "type": "select",
      "id": "image_focus",
      "label": "Bildausschnitt",
      "default": "center center",
      "options": [
        { "value": "left top", "label": "Oben links" },
        { "value": "center top", "label": "Oben mittig" },
        { "value": "right top", "label": "Oben rechts" },
        { "value": "left center", "label": "Mitte links" },
        { "value": "center center", "label": "Mitte" },
        { "value": "right center", "label": "Mitte rechts" },
        { "value": "left bottom", "label": "Unten links" },
        { "value": "center bottom", "label": "Unten mittig" },
        { "value": "right bottom", "label": "Unten rechts" }
      ]
    },
    {
      "type": "range",
      "id": "image_radius",
      "label": "Abrundung des Bildes",
      "min": 0,
      "max": 30,
      "step": 2,
      "unit": "px",
      "default": 18,
      "info": "Gilt für Bilder links oder rechts."
    },
    {
      "type": "range",
      "id": "overlay_opacity",
      "label": "Abdunklung bei Hintergrundbild",
      "min": 0,
      "max": 90,
      "step": 5,
      "unit": "%",
      "default": 55
    },
    {
      "type": "text",
      "id": "deadline",
      "label": "Endzeitpunkt",
      "default": "2026-08-01 20:00",
      "info": "Format: JJJJ-MM-TT SS:MM (Uhrzeit deiner Besucher)"
    },
    {
      "type": "header",
      "content": "Bezeichnungen im Countdown"
    },
    {
      "type": "text",
      "id": "label_days",
      "label": "Bezeichnung Tage",
      "default": "Tage"
    },
    {
      "type": "text",
      "id": "label_hours",
      "label": "Bezeichnung Stunden",
      "default": "Stunden"
    },
    {
      "type": "text",
      "id": "label_minutes",
      "label": "Bezeichnung Minuten",
      "default": "Minuten"
    },
    {
      "type": "text",
      "id": "label_seconds",
      "label": "Bezeichnung Sekunden",
      "default": "Sekunden"
    },
    {
      "type": "checkbox",
      "id": "hide_over",
      "label": "Section nach Ablauf komplett ausblenden",
      "default": true
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button-Beschriftung",
      "default": "Jetzt sichern"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button-Link"
    },
    {
      "type": "header",
      "content": "Abstände zum nächsten Abschnitt"
    },
    {
      "type": "range",
      "id": "spacing_top",
      "label": "Abstand oben",
      "min": 0,
      "max": 160,
      "step": 8,
      "unit": "px",
      "default": 64
    },
    {
      "type": "range",
      "id": "spacing_bottom",
      "label": "Abstand unten",
      "min": 0,
      "max": 160,
      "step": 8,
      "unit": "px",
      "default": 64
    },
    {
      "type": "color",
      "id": "bg",
      "label": "Hintergrund der Umgebung",
      "default": "#FBF8F0"
    }
  ],
  "presets": [
    {
      "name": "Chelonaki – Countdown"
    }
  ]
}
{% endschema %}
