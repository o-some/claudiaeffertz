<section class="fi-block fi-books" id="FiBooks" data-fi-reveal-scope style="--fi-module-bg:{{ section.settings.module_bg }};--fi-heading-color:{{ section.settings.heading_color }};--fi-text-color:{{ section.settings.text_color }};--fi-accent-color:{{ section.settings.accent_color }};--fi-card-bg:{{ section.settings.card_bg }};--fi-card-heading:{{ section.settings.card_heading }};--fi-card-text:{{ section.settings.card_text }};--fi-card-border:{{ section.settings.card_border }};--fi-link-color:{{ section.settings.link_color }};--fi-link-hover:{{ section.settings.link_hover }};--fi-tag-bg:{{ section.settings.tag_bg }};--fi-tag-text:{{ section.settings.tag_text }};--fi-tag-border:{{ section.settings.tag_border }}">
  <div class="fi-wrap">
    <div class="fi-section-head fi-reveal">
      {% if section.settings.eyebrow != blank %}<span class="fi-eyebrow">{{ section.settings.eyebrow | escape }}</span>{% endif %}
      <h2>{{ section.settings.heading }}</h2>
      <div class="rte">{{ section.settings.text }}</div>
    </div>

    <div class="fi-book-grid">
      {% for block in section.blocks %}
        {% liquid
          assign card_link = block.settings.link
          if card_link == blank and block.settings.link_target != blank
            assign card_link = block.settings.link_target
          endif
        %}
        <article class="fi-card fi-reveal" style="--fi-reveal-delay:{{ forloop.index0 | times: 0.08 }}s" {{ block.shopify_attributes }}>
          {% if block.settings.tag != blank %}<span class="fi-tag">{{ block.settings.tag | escape }}</span>{% endif %}
          <div class="fi-cover">
            {% if block.settings.image != blank %}
              {{ block.settings.image | image_url: width: 900 | image_tag: widths: '320, 480, 640, 900', sizes: '(max-width: 960px) 80vw, 28vw', loading: 'lazy', alt: block.settings.image_alt }}
            {% else %}
              {% case forloop.index %}
                {% when 1 %}<img src="{{ 'fi-static-002.jpg' | asset_url }}" width="538" height="760" loading="lazy" decoding="async" alt="{{ block.settings.image_alt | escape }}">
                {% when 2 %}<img src="{{ 'fi-static-003.jpg' | asset_url }}" width="538" height="760" loading="lazy" decoding="async" alt="{{ block.settings.image_alt | escape }}">
                {% else %}<img src="{{ 'fi-static-004.jpg' | asset_url }}" width="538" height="760" loading="lazy" decoding="async" alt="{{ block.settings.image_alt | escape }}">
              {% endcase %}
            {% endif %}
          </div>
          <h3>{{ block.settings.title | escape }}</h3>
          <div class="fi-card-text rte">{{ block.settings.text }}</div>
          {% if card_link != blank and block.settings.link_label != blank %}
            <a class="fi-card-cta" href="{{ card_link | escape }}">{{ block.settings.link_label | escape }}{% render 'fi-arrow-icon' %}</a>
          {% endif %}
        </article>
      {% endfor %}
    </div>
    {% if section.settings.shop_button_label != blank and section.settings.shop_button_link != blank %}
      <div class="fi-books-shop">
        <a class="fi-books-shop__button" href="{{ section.settings.shop_button_link }}">
          {{ section.settings.shop_button_label | escape }}{% render 'fi-arrow-icon' %}
        </a>
      </div>
    {% endif %}
  </div>
</section>

{% style %}
  #shopify-section-{{ section.id }} {
    margin-block-start: {{ section.settings.section_gap_top | default: 0 }}px;
    margin-block-end: {{ section.settings.section_gap_bottom | default: 0 }}px;
  }
  #shopify-section-{{ section.id }} .fi-books-shop { display: flex; justify-content: center; margin-top: clamp(28px, 4vw, 48px); }
  #shopify-section-{{ section.id }} .fi-books-shop__button {
    display: inline-flex; align-items: center; justify-content: center; gap: 12px;
    min-height: 52px; padding: 0 26px; border-radius: 999px;
    background: var(--fi-heading-color); color: #fff; font-weight: 750; text-decoration: none;
    box-shadow: 0 14px 34px -18px rgba(20,37,25,.7); transition: transform .2s ease, background .2s ease;
  }
  #shopify-section-{{ section.id }} .fi-books-shop__button:hover { background: var(--fi-accent-color); color: #142519; transform: translateY(-2px); }
  #shopify-section-{{ section.id }} .fi-books-shop__button svg { width: 18px; }
{% endstyle %}

{% schema %}
