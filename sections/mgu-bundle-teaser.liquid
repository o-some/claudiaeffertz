{% comment %} Chelonaki Shop Theme · © Chelonaki · Build: CHELONAKI-BUILD-0000-MASTER · Nutzung nur mit gültiger Lizenz {% endcomment %}
<style>
  .mgu-bt{display:grid;grid-template-columns:1fr 1fr;gap:clamp(28px,5vw,64px);align-items:center;background:var(--mgu-forest,#1F3A2A);border-radius:28px;padding:clamp(28px,4vw,52px);overflow:hidden}
  @media(max-width:820px){.mgu-bt{grid-template-columns:1fr}}
  .mgu-bt-media{aspect-ratio:4/3;border-radius:20px;overflow:hidden;background:rgba(255,255,255,.06)}
  .mgu-bt-media img{width:100%;height:100%;object-fit:cover}
  .mgu-bt-body{color:#FCF9F1}
  .mgu-bt-body h2{font-size:clamp(1.6rem,2.8vw,2.3rem);line-height:1.15;margin:0 0 12px}
  .mgu-bt-body h2 em{font-style:italic;color:var(--mgu-gold-soft,#D9BC6A)}
  .mgu-bt-body p{color:rgba(252,249,241,.75);font-size:15.5px;line-height:1.7;margin:0 0 18px}
  .mgu-bt-items{display:flex;flex-wrap:wrap;gap:8px;margin-bottom:20px}
  .mgu-bt-chip{display:flex;align-items:center;gap:6px;background:rgba(255,255,255,.08);border:1px solid rgba(217,188,106,.3);border-radius:99px;padding:6px 14px;font-size:12.5px;color:#FCF9F1}
  .mgu-bt-plus{color:var(--mgu-gold-soft,#D9BC6A);font-weight:700}
  .mgu-bt-preis{display:flex;align-items:baseline;gap:10px;margin-bottom:18px}
  .mgu-bt-preis del{color:rgba(252,249,241,.5);font-size:14px}
  .mgu-bt-preis b{font-size:1.6rem;color:var(--mgu-gold-soft,#D9BC6A)}
</style>
<section data-mgu-effect="{{ section.settings.effect | default: 'up' }}" data-mgu-speed="{{ section.settings.effect_speed | default: 'normal' }}" class="mgu mgu-block" style="--mgu-space-top:{{ section.settings.spacing_top }}px;--mgu-space-bottom:{{ section.settings.spacing_bottom }}px">
  <div class="mgu-wrap">
    <div class="mgu-bt mgu-reveal">
      <div class="mgu-bt-media">
        {%- if section.settings.bild != blank -%}<img width="{{ section.settings.bild.width }}" height="{{ section.settings.bild.height }}" src="{{ section.settings.bild | image_url: width: 900 }}" alt="{{ section.settings.heading | strip_html | escape }}" loading="lazy">{%- endif -%}
      </div>
      <div class="mgu-bt-body">
        {%- if section.settings.eyebrow != blank -%}<span class="mgu-eyebrow" style="color:var(--mgu-gold-soft)">{{ section.settings.eyebrow }}</span>{%- endif -%}
        <h2>{{ section.settings.heading }}</h2>
        <p>{{ section.settings.text }}</p>
        {%- if section.blocks.size > 0 -%}
          <div class="mgu-bt-items">
            {%- for block in section.blocks -%}
              {%- unless forloop.first %}<span class="mgu-bt-plus" aria-hidden="true">+</span>{% endunless -%}
              <span class="mgu-bt-chip" {{ block.shopify_attributes }}>{{ block.settings.name }}</span>
            {%- endfor -%}
          </div>
        {%- endif -%}
        {%- if section.settings.preis != blank -%}
          <div class="mgu-bt-preis">
            {%- if section.settings.streichpreis != blank -%}<del>{{ section.settings.streichpreis }}</del>{%- endif -%}
            <b>{{ section.settings.preis }}</b>
          </div>
        {%- endif -%}
        {%- if section.settings.button != blank and section.settings.link != blank -%}<a class="mgu-btn mgu-btn--gold" href="{{ section.settings.link }}">{{ section.settings.button }}</a>{%- endif -%}
      </div>
    </div>
  </div>
</section>
{% schema %}
{
  "name": "Chelonaki – Bundle-Teaser",
  "settings": [
    { "type": "paragraph", "content": "Marketing-Teaser für ein Produktbündel. Zeigt Inhalte und Preisvorteil an; die eigentliche Bundle-Verkaufslogik (mehrere Varianten in einem Klick kaufen) läuft über eine Bundle-App – der Button verlinkt auf die Bundle-Produktseite/App-Seite." },
    { "type": "header", "content": "Scroll-Effekt" },
    { "type": "select", "id": "effect", "label": "Erscheinen beim Scrollen", "default": "up", "options": [ { "value": "none", "label": "Kein Effekt" }, { "value": "fade", "label": "Einblenden" }, { "value": "up", "label": "Von unten (Standard)" }, { "value": "left", "label": "Von links" }, { "value": "right", "label": "Von rechts" }, { "value": "zoom", "label": "Sanfter Zoom" }, { "value": "blur", "label": "Aus der Unschärfe" } ] },
    { "type": "select", "id": "effect_speed", "label": "Effekt-Tempo", "default": "normal", "options": [ { "value": "schnell", "label": "Schnell" }, { "value": "normal", "label": "Normal" }, { "value": "langsam", "label": "Langsam" } ] },
    { "type": "image_picker", "id": "bild", "label": "Bild" },
    { "type": "text", "id": "eyebrow", "label": "Kicker-Zeile", "default": "Im Set sparen" },
    { "type": "inline_richtext", "id": "heading", "label": "Überschrift", "default": "Das komplette <em>Starter-Set.</em>" },
    { "type": "richtext", "id": "text", "label": "Text", "default": "<p>Alles, was du für den Einstieg brauchst – gebündelt und günstiger als einzeln.</p>" },
    { "type": "text", "id": "streichpreis", "label": "Streichpreis (optional)", "default": "119,00 €" },
    { "type": "text", "id": "preis", "label": "Bundle-Preis", "default": "89,00 €" },
    { "type": "text", "id": "button", "label": "Button", "default": "Set entdecken" },
    { "type": "url", "id": "link", "label": "Link zum Bundle" },
    { "type": "header", "content": "Abstände zum nächsten Abschnitt" },
    { "type": "range", "id": "spacing_top", "label": "Abstand oben", "min": 0, "max": 160, "step": 8, "unit": "px", "default": 80 },
    { "type": "range", "id": "spacing_bottom", "label": "Abstand unten", "min": 0, "max": 160, "step": 8, "unit": "px", "default": 80 }
  ],
  "blocks": [
    { "type": "item", "name": "Enthaltenes Produkt",
      "settings": [ { "type": "text", "id": "name", "label": "Name", "default": "Produkt" } ]}
  ],
  "presets": [{ "name": "Chelonaki – Bundle-Teaser", "blocks": [ { "type": "item" }, { "type": "item", "settings": { "name": "Produkt 2" } }, { "type": "item", "settings": { "name": "Produkt 3" } } ] }]
}
{% endschema %}
