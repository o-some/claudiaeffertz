{% comment %} Chelonaki Shop Theme · © Chelonaki · Build: CHELONAKI-BUILD-0000-MASTER · Nutzung nur mit gültiger Lizenz {% endcomment %}
<style>
  .mgu-aw-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(200px,1fr));gap:18px}
  .mgu-aw{
    text-align:center;background:var(--mgu-paper);border:1px solid var(--mgu-gold-soft);
    border-radius:18px;padding:26px 20px;transition:transform .3s,box-shadow .3s;
  }
  .mgu-aw:hover{transform:translateY(-4px);box-shadow:0 20px 40px -22px rgba(20,37,25,.3)}
  .mgu-aw img{max-height:64px;width:auto;margin:0 auto 12px}
  .mgu-aw .mgu-aw-emoji{font-size:2rem;display:block;margin-bottom:8px}
  .mgu-aw b{display:block;font-family:var(--mgu-font-heading);font-weight:500;font-size:1.05rem;color:var(--mgu-forest)}
  .mgu-aw span{font-size:12.5px;color:var(--mgu-ink-soft)}
  .mgu-aw i{display:block;font-style:normal;font-size:12px;color:var(--mgu-gold);font-weight:700;letter-spacing:.1em;margin-top:4px}
</style>
<section data-mgu-effect="{{ section.settings.effect | default: 'up' }}" data-mgu-speed="{{ section.settings.effect_speed | default: 'normal' }}" class="mgu mgu-block" style="background:{{ section.settings.bg }}">
  <div class="mgu-wrap">
    <div class="mgu-sec-head mgu-reveal" style="text-align:center;margin-left:auto;margin-right:auto">
      {%- if section.settings.eyebrow != blank -%}<span class="mgu-eyebrow">{{ section.settings.eyebrow }}</span>{%- endif -%}
      <h2>{{ section.settings.heading }}</h2>
    </div>
    <div class="mgu-aw-grid">
      {%- for block in section.blocks -%}
        <div class="mgu-aw mgu-reveal" {% if forloop.index > 1 %}style="transition-delay:{{ forloop.index0 | times: 0.07 }}s"{% endif %} {{ block.shopify_attributes }}>
          {%- if block.settings.bild != blank -%}
            <img width="{{ block.settings.bild.width }}" height="{{ block.settings.bild.height }}" src="{{ block.settings.bild | image_url: width: 240 }}" alt="{{ block.settings.titel | escape }}" loading="lazy">
          {%- elsif block.settings.emoji != blank -%}
            <span class="mgu-aw-emoji" aria-hidden="true">{{ block.settings.emoji }}</span>
          {%- endif -%}
          <b>{{ block.settings.titel }}</b>
          <span>{{ block.settings.quelle }}</span>
          {%- if block.settings.jahr != blank -%}<i>{{ block.settings.jahr }}</i>{%- endif -%}
        </div>
      {%- endfor -%}
    </div>
  </div>
</section>
{% style %}
  #shopify-section-{{ section.id }} {
    margin-block-start: {{ section.settings.section_gap_top | default: 0 }}px;
    margin-block-end: {{ section.settings.section_gap_bottom | default: 0 }}px;
  }
{% endstyle %}

{% schema %}
{
  "name": "Chelonaki · Awards",
  "settings": [
    {"type":"header","content":"Abstand zum nächsten Abschnitt"},
    {"type":"range","id":"section_gap_top","label":"Zusätzlicher Abstand oben","min":0,"max":200,"step":4,"unit":"px","default":0},
    {"type":"range","id":"section_gap_bottom","label":"Zusätzlicher Abstand unten","min":0,"max":200,"step":4,"unit":"px","default":0},
    { "type": "header", "content": "Scroll-Effekt" },
    { "type": "select", "id": "effect", "label": "Erscheinen beim Scrollen", "default": "up", "options": [ { "value": "none", "label": "Kein Effekt" }, { "value": "fade", "label": "Einblenden" }, { "value": "up", "label": "Von unten (Standard)" }, { "value": "left", "label": "Von links" }, { "value": "right", "label": "Von rechts" }, { "value": "zoom", "label": "Sanfter Zoom" }, { "value": "blur", "label": "Aus der Unschärfe" } ] },
    { "type": "select", "id": "effect_speed", "label": "Effekt-Tempo", "default": "normal", "options": [ { "value": "schnell", "label": "Schnell" }, { "value": "normal", "label": "Normal" }, { "value": "langsam", "label": "Langsam" } ] },
    { "type": "text", "id": "eyebrow", "label": "Kicker-Zeile", "default": "Ausgezeichnet" },
    { "type": "inline_richtext", "id": "heading", "label": "Überschrift", "default": "Preise & <em>Auszeichnungen.</em>" },
    { "type": "color", "id": "bg", "label": "Hintergrundfarbe", "default": "#FBF8F0" }
  ],
  "blocks": [
    { "type": "award", "name": "Auszeichnung",
      "settings": [
        { "type": "image_picker", "id": "bild", "label": "Siegel-Bild (optional)" },
        { "type": "text", "id": "emoji", "label": "Emoji-Fallback", "default": "🏆" },
        { "type": "text", "id": "titel", "label": "Titel", "default": "Gold-Auszeichnung" },
        { "type": "text", "id": "quelle", "label": "Vergeben von", "default": "Fachjury 2026" },
        { "type": "text", "id": "jahr", "label": "Jahr", "default": "2026" }
      ]}
  ],
  "presets": [{ "name": "Chelonaki – Awards & Siegel", "blocks": [ { "type": "award" }, { "type": "award" }, { "type": "award" } ] }]
}
{% endschema %}
