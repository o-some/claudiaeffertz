{% comment %} Chelonaki Shop Theme · © Chelonaki · Build: CHELONAKI-BUILD-0000-MASTER · Nutzung nur mit gültiger Lizenz {% endcomment %}

<style>
  .mgu-pd{
    background:var(--mgu-cream);border:1px solid var(--mgu-line);border-radius:20px;
    padding:clamp(22px,3vw,32px);margin:24px 0;
  }
  .mgu-pd h3{font-size:1.1rem;color:var(--mgu-forest);margin:0 0 16px;letter-spacing:.02em}
  .mgu-pd-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(160px,1fr));gap:14px 24px}
  .mgu-pd-item span{display:block;font-size:11.5px;letter-spacing:.14em;text-transform:uppercase;color:var(--mgu-gold);font-weight:600;margin-bottom:3px}
  .mgu-pd-item b{font-size:15px;color:var(--mgu-ink);font-weight:600}
  .mgu-pd-probe{margin-top:18px}
</style>

{%- liquid
  assign mf = product.metafields.custom
  assign hat_daten = false
  if mf.seiten != blank or mf.isbn != blank or mf.format != blank or mf.erscheinung != blank or mf.leseprobe != blank
    assign hat_daten = true
  endif
-%}

{%- if hat_daten -%}
<div class="mgu mgu-pd">
  <h3>{{ section.settings.heading }}</h3>
  <div class="mgu-pd-grid">
    {%- if mf.seiten != blank -%}<div class="mgu-pd-item"><span>Seiten</span><b>{{ mf.seiten }}</b></div>{%- endif -%}
    {%- if mf.format != blank -%}<div class="mgu-pd-item"><span>Format</span><b>{{ mf.format }}</b></div>{%- endif -%}
    {%- if mf.isbn != blank -%}<div class="mgu-pd-item"><span>ISBN</span><b>{{ mf.isbn }}</b></div>{%- endif -%}
    {%- if mf.erscheinung != blank -%}<div class="mgu-pd-item"><span>Erschienen</span><b>{{ mf.erscheinung }}</b></div>{%- endif -%}
  </div>
  {%- if mf.leseprobe != blank -%}
    <div class="mgu-pd-probe">
      <a class="mgu-btn mgu-btn--ghost" href="{{ mf.leseprobe.value.url | default: mf.leseprobe }}" target="_blank" rel="noopener">
        📖 {{ section.settings.probe_label }}
      </a>
    </div>
  {%- endif -%}
</div>
{%- endif -%}

{% style %}
  #shopify-section-{{ section.id }} {
    margin-block-start: {{ section.settings.section_gap_top | default: 0 }}px;
    margin-block-end: {{ section.settings.section_gap_bottom | default: 0 }}px;
  }
{% endstyle %}

{% schema %}
{
  "name": "Chelonaki · Produktinfo",
  "settings": [
    {"type":"header","content":"Abstand zum nächsten Abschnitt"},
    {"type":"range","id":"section_gap_top","label":"Zusätzlicher Abstand oben","min":0,"max":200,"step":4,"unit":"px","default":0},
    {"type":"range","id":"section_gap_bottom","label":"Zusätzlicher Abstand unten","min":0,"max":200,"step":4,"unit":"px","default":0},
    { "type": "paragraph", "content": "Zeigt Metafelder des Produkts: custom.seiten, custom.format, custom.isbn, custom.erscheinung, custom.leseprobe (Datei). Anlegen unter: Einstellungen → Benutzerdefinierte Daten → Produkte. Blendet sich aus, wenn keine Daten vorhanden sind." },
    { "type": "text", "id": "heading", "label": "Überschrift", "default": "Produktdetails" },
    { "type": "text", "id": "probe_label", "label": "Leseprobe-Button", "default": "Leseprobe ansehen (PDF)" }
  ],
  "enabled_on": { "templates": ["product"] },
  "presets": [{ "name": "Chelonaki – Produkt-Details (Metafelder)" }]
}
{% endschema %}
