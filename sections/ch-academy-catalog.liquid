<section class="ch-section ch-academy" id="{{ section.settings.anchor | default: 'academy' | escape }}" data-section-id="{{ section.id }}">
  <div class="ch-shell">
    {% if section.settings.eyebrow != blank %}<p class="ch-eyebrow">{{ section.settings.eyebrow | escape }}</p>{% endif %}
    <h2>{{ section.settings.heading | escape }}</h2>
    {% if section.settings.text != blank %}<div class="rte">{{ section.settings.text }}</div>{% endif %}
    <div class="ch-grid ch-academy__grid">
      {% for block in section.blocks %}
        {% assign course = block.settings.product %}
        <article class="ch-card ch-academy__card" {{ block.shopify_attributes }}>
          {% if course.featured_image %}{{ course.featured_image | image_url: width: 900 | image_tag: loading: 'lazy', widths: '320, 480, 720, 900', sizes: '(min-width: 990px) 33vw, 100vw', alt: course.featured_image.alt }}{% endif %}
          <div class="ch-card__body">
            {% if block.settings.badge != blank %}<span class="ch-badge">{{ block.settings.badge | escape }}</span>{% endif %}
            <h3>{% if course != blank %}{{ course.title | escape }}{% else %}{{ block.settings.title | escape }}{% endif %}</h3>
            {% if block.settings.summary != blank %}<p>{{ block.settings.summary | escape }}</p>{% endif %}
            {% if course != blank %}<p>{% render 'price', product: course, use_variant: true %}</p><a class="ch-button" href="{{ course.url }}">{{ block.settings.action_label | escape }}</a>{% endif %}
          </div>
        </article>
      {% else %}
        <p>{{ section.settings.empty_text | escape }}</p>
      {% endfor %}
    </div>
  </div>
</section>
{% style %}
  #shopify-section-{{ section.id }} {
    margin-block-start: {{ section.settings.section_gap_top | default: 0 }}px;
    margin-block-end: {{ section.settings.section_gap_bottom | default: 0 }}px;
  }
{% endstyle %}

{% schema %}
{
  "name": "Chelonaki – Academy",
  "settings": [
    {"type":"header","content":"Abstand zum nächsten Abschnitt"},
    {"type":"range","id":"section_gap_top","label":"Zusätzlicher Abstand oben","min":0,"max":200,"step":4,"unit":"px","default":0},
    {"type":"range","id":"section_gap_bottom","label":"Zusätzlicher Abstand unten","min":0,"max":200,"step":4,"unit":"px","default":0},
    { "type": "text", "id": "anchor", "label": "Anker", "default": "academy" },
    { "type": "text", "id": "eyebrow", "label": "Überzeile", "default": "Academy" },
    { "type": "text", "id": "heading", "label": "Überschrift", "default": "Kurse entdecken" },
    { "type": "richtext", "id": "text", "label": "Einleitung" },
    { "type": "text", "id": "empty_text", "label": "Text ohne Kurse", "default": "Aktuell sind keine Kurse verfügbar." }
  ],
  "blocks": [{ "type": "course", "name": "Kurs", "settings": [
    { "type": "product", "id": "product", "label": "Shopify-Kursprodukt" },
    { "type": "text", "id": "title", "label": "Fallback-Titel" },
    { "type": "text", "id": "badge", "label": "Kennzeichnung" },
    { "type": "textarea", "id": "summary", "label": "Kurzbeschreibung" },
    { "type": "text", "id": "action_label", "label": "Aktion", "default": "Kurs ansehen" }
  ] }],
  "presets": [{ "name": "Chelonaki – Academy" }]
}
{% endschema %}
