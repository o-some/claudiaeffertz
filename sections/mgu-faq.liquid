{% comment %} Chelonaki Shop Theme · © Chelonaki · Build: CHELONAKI-BUILD-0000-MASTER · Nutzung nur mit gültiger Lizenz {% endcomment %}

<style>
  .mgu-faq-list{max-width:820px;margin:0 auto;display:grid;gap:14px}
  .mgu-faq-item{
    background:var(--mgu-paper);border:1px solid var(--mgu-line);border-radius:18px;
    overflow:hidden;transition:box-shadow .3s;
  }
  .mgu-faq-item[open]{box-shadow:0 18px 38px -22px rgba(20,37,25,.28)}
  .mgu-faq-item summary{
    list-style:none;cursor:pointer;display:flex;justify-content:space-between;align-items:center;gap:16px;
    padding:20px 24px;font-weight:600;font-size:16.5px;color:var(--mgu-forest);
  }
  .mgu-faq-item summary::-webkit-details-marker{display:none}
  .mgu-faq-plus{
    flex-shrink:0;width:32px;height:32px;border-radius:50%;
    border:1.5px solid var(--mgu-gold);color:var(--mgu-gold);
    display:flex;align-items:center;justify-content:center;
    font-size:18px;font-weight:400;transition:transform .35s,background .35s,color .35s;
  }
  .mgu-faq-item[open] .mgu-faq-plus{transform:rotate(45deg);background:var(--mgu-gold);color:var(--mgu-forest-deep)}
  .mgu-faq-body{padding:0 24px 22px;color:var(--mgu-ink-soft);font-size:15.5px;line-height:1.7}
</style>

<section data-mgu-effect="{{ section.settings.effect | default: 'up' }}" data-mgu-speed="{{ section.settings.effect_speed | default: 'normal' }}" class="mgu mgu-block" id="FAQ" data-section-id="mgu-faq-{{ section.id }}" style="--mgu-space-top:{{ section.settings.spacing_top }}px;--mgu-space-bottom:{{ section.settings.spacing_bottom }}px;background:{{ section.settings.bg }}">
  <div class="mgu-wrap">
    <div class="mgu-sec-head mgu-reveal" style="text-align:center;margin-left:auto;margin-right:auto">
      {%- if section.settings.eyebrow != blank -%}<span class="mgu-eyebrow">{{ section.settings.eyebrow }}</span>{%- endif -%}
      <h2>{{ section.settings.heading }}</h2>
    </div>
    <div class="mgu-faq-list mgu-reveal">
      {%- for block in section.blocks -%}
        <details class="mgu-faq-item" {{ block.shopify_attributes }}>
          <summary>{{ block.settings.frage }}<span class="mgu-faq-plus">+</span></summary>
          <div class="mgu-faq-body">{{ block.settings.antwort }}</div>
        </details>
      {%- endfor -%}
    </div>
  </div>
</section>
{%- if section.blocks.size > 0 -%}
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {%- for block in section.blocks -%}
    {
      "@type": "Question",
      "name": {{ block.settings.frage | json }},
      "acceptedAnswer": { "@type": "Answer", "text": {{ block.settings.antwort | strip_html | json }} }
    }{%- unless forloop.last -%},{%- endunless -%}
    {%- endfor -%}
  ]
}
</script>
{%- endif -%}

{% schema %}
{
  "name": "Chelonaki – FAQ",
  "settings": [
    { "type": "header", "content": "Scroll-Effekt" },
    { "type": "select", "id": "effect", "label": "Erscheinen beim Scrollen", "default": "up", "options": [ { "value": "none", "label": "Kein Effekt" }, { "value": "fade", "label": "Einblenden" }, { "value": "up", "label": "Von unten (Standard)" }, { "value": "left", "label": "Von links" }, { "value": "right", "label": "Von rechts" }, { "value": "zoom", "label": "Sanfter Zoom" }, { "value": "blur", "label": "Aus der Unschärfe" } ] },
    { "type": "select", "id": "effect_speed", "label": "Effekt-Tempo", "default": "normal", "options": [ { "value": "schnell", "label": "Schnell" }, { "value": "normal", "label": "Normal" }, { "value": "langsam", "label": "Langsam" } ] },
    { "type": "text", "id": "eyebrow", "label": "Kicker-Zeile", "default": "Gut zu wissen" },
    { "type": "inline_richtext", "id": "heading", "label": "Überschrift", "default": "Häufige <em>Fragen.</em>" },
    { "type": "header", "content": "Abstände zum nächsten Abschnitt" },
    { "type": "range", "id": "spacing_top", "label": "Abstand oben", "min": 0, "max": 160, "step": 8, "unit": "px", "default": 80 },
    { "type": "range", "id": "spacing_bottom", "label": "Abstand unten", "min": 0, "max": 160, "step": 8, "unit": "px", "default": 80 },
    { "type": "color", "id": "bg", "label": "Hintergrundfarbe", "default": "#F3EDDF" }
  ],
  "blocks": [
    {
      "type": "frage",
      "name": "Frage",
      "settings": [
        { "type": "text", "id": "frage", "label": "Frage", "default": "Häufige Frage eins?" },
        { "type": "richtext", "id": "antwort", "label": "Antwort", "default": "<p>Antwort auf die Frage – frei formulierbar.</p>" }
      ]
    }
  ],
  "presets": [
    { "name": "Chelonaki – FAQ", "blocks": [ { "type": "frage" }, { "type": "frage" }, { "type": "frage" } ] }
  ]
}
{% endschema %}
