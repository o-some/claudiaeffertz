{{ 'ce-home.css' | asset_url | stylesheet_tag }}
<script src="{{ 'ce-home.js' | asset_url }}" defer="defer"></script>

<div class="ce-home" data-ce-home>
  <section class="ce-hero" id="start" aria-labelledby="ce-hero-title">
    <div class="ce-shell ce-hero__grid">
      <div class="ce-hero__copy" data-ce-reveal>
        <p class="ce-kicker">Claudia Effertz · Die Brückenbauerin</p>
        <h1 id="ce-hero-title">Vom Verstehen zur Veränderung.</h1>
        <p class="ce-hero__lead">Ich verbinde Menschen, Perspektiven und Möglichkeiten und mache aus komplexen Situationen tragfähige nächste Schritte.</p>
        <div class="ce-actions">
          <a class="ce-button ce-button--primary" href="#angebote">Angebote</a>
          <a class="ce-button ce-button--secondary" href="#buch">Buch &amp; Edition</a>
        </div>
      </div>
      <figure class="ce-hero__media" data-ce-reveal>
        <img src="{{ 'ce-portrait-hero.jpg' | asset_url }}" width="2200" height="1468" alt="Claudia Effertz im grünen Blazer vor einem natürlichen Hintergrund" loading="eager" fetchpriority="high">
        <figcaption>Veränderung gesund gestalten.<br><span>Klar · authentisch · empathisch</span></figcaption>
      </figure>
    </div>
  </section>

  <div class="ce-bridge" aria-hidden="true">
    <svg viewBox="0 0 480 94" role="presentation">
      <path d="M18 70h444M102 24v55M378 24v55M102 28c70 66 206 66 276 0M18 70c38-2 63-19 84-42M378 28c21 23 46 40 84 42"/>
    </svg>
  </div>

  <section class="ce-intro" id="claudia" aria-labelledby="ce-intro-title">
    <div class="ce-shell ce-intro__grid">
      <div data-ce-reveal>
        <p class="ce-kicker">Seit über 30 Jahren</p>
        <h2 id="ce-intro-title">Veränderung darf verständlich sein.</h2>
      </div>
      <div class="ce-intro__text" data-ce-reveal>
        <p>Meine Arbeit beginnt dort, wo einfache Antworten nicht mehr reichen: in Veränderung, Krise, Rollenwechsel, Verantwortung oder Teamdynamik.</p>
        <p>Ich verbinde Wirtschaft und Menschlichkeit, Herz und Verstand, Gesundheit und Leistung, Erfahrung und Innovation, Wissenschaft und Praxis.</p>
      </div>
    </div>
    <div class="ce-shell ce-facts" aria-label="Erfahrung und Arbeitsweise">
      <div data-ce-reveal><strong>21</strong><span>erste Führungsaufgabe</span></div>
      <div data-ce-reveal><strong>1999</strong><span>Start in die Selbstständigkeit</span></div>
      <div data-ce-reveal><strong>30+</strong><span>Jahre Begleitung</span></div>
      <div data-ce-reveal><strong>1000e</strong><span>begleitete Menschen</span></div>
    </div>
  </section>

  <section class="ce-offers" id="angebote" aria-labelledby="ce-offers-title">
    <div class="ce-shell">
      <header class="ce-section-head" data-ce-reveal>
        <h2 id="ce-offers-title">Wobei ich Brücken baue</h2>
        <p>Orientierung, Entwicklung und Umsetzung für Menschen und Organisationen in Bewegung.</p>
      </header>
      <div class="ce-offer-grid">
        <article data-ce-reveal><span>01</span><h3>Führung &amp; Veränderung</h3><p>Menschen stärken, Verantwortung ermöglichen und Wandel gestalten, ohne Menschen zu verlieren.</p></article>
        <article data-ce-reveal><span>02</span><h3>Coaching &amp; Organisationsentwicklung</h3><p>Komplexität sortieren, Ressourcen aktivieren und tragfähige Lösungen gemeinsam entwickeln.</p></article>
        <article data-ce-reveal><span>03</span><h3>Strategische Projektentwicklung</h3><p>Aus einer guten Idee ein klares Konzept, passende Verbindungen und reale Wirkung machen.</p></article>
        <article data-ce-reveal><span>04</span><h3>Krisen &amp; Rollenwechsel</h3><p>Orientierung in Übergängen schaffen und neue Handlungsfähigkeit Schritt für Schritt aufbauen.</p></article>
        <article id="speakerin" data-ce-reveal><span>05</span><h3>Speakerin &amp; Keynotes</h3><p>Vorträge, die nachdenklich machen, Mut geben, zum Lachen bringen und neue Perspektiven öffnen.</p></article>
        <article data-ce-reveal><span>06</span><h3>Gesundheit &amp; Teilhabe</h3><p>Wissenschaftlich fundierte Aufklärung, Vernetzung und gesellschaftliche Veränderung unterstützen.</p></article>
      </div>
      <blockquote class="ce-statement" data-ce-reveal>
        <p>„Menschen erinnern sich selten an Folien. Aber sie erinnern sich an Geschichten.“</p>
      </blockquote>
    </div>
  </section>

  <section class="ce-book" id="buch" aria-labelledby="ce-book-title">
    <div class="ce-shell ce-book__grid">
      <figure class="ce-book__media" data-ce-reveal>
        <img src="{{ 'ce-book-edition.jpg' | asset_url }}" width="1054" height="1510" alt="Brückenbauerin Premium-Edition mit Buch, Brückenkarten, Workbook und Online-Impulsen" loading="lazy">
      </figure>
      <div class="ce-book__copy" data-ce-reveal>
        <p class="ce-kicker">Buch &amp; Brückenbauer-Edition</p>
        <h2 id="ce-book-title">24 Impulse für Führung und Veränderung.</h2>
        <p>Das Buch verbindet Metaphern, Geschichten und Perspektivwechsel. Die Edition ergänzt es um Brückenkarten, Workbook und 24 Audio-Impulse.</p>
        <dl class="ce-book__details">
          <div><dt>24</dt><dd>Metaphern und Geschichten</dd></div>
          <div><dt>4</dt><dd>Formate in einer Edition</dd></div>
          <div><dt>2026</dt><dd>Buchprojekt in Entwicklung</dd></div>
        </dl>
        <a class="ce-button ce-button--gold" href="#kontakt">Interesse vormerken</a>
      </div>
    </div>
  </section>

  <section class="ce-training" id="ausbildungen" aria-labelledby="ce-training-title">
    <div class="ce-shell">
      <header class="ce-section-head" data-ce-reveal>
        <h2 id="ce-training-title">Führung entwickeln. Menschen begleiten.</h2>
        <p>Zwei Schwesterwelten mit gemeinsamer Haltung und unterschiedlichen Zielen.</p>
      </header>
      <div class="ce-training__grid">
        <article data-ce-reveal>
          <h3>Führungsausbildung</h3>
          <p class="ce-training__meta">Basisausbildung · 3 × 2 Tage</p>
          <ol>
            <li><strong>Ich führe:</strong> Selbstführung, Haltung, Verantwortung und Entscheidungen.</li>
            <li><strong>Ich führe Menschen:</strong> Kommunikation, Konflikte und Teamdynamiken.</li>
            <li><strong>Ich führe Veränderung:</strong> Rollen, Widerstand, Kultur und Transfer.</li>
          </ol>
          <a href="https://top-fuehrungsausbildung.de">Führungswelt entdecken</a>
        </article>
        <article data-ce-reveal>
          <h3>Systemische Coachingausbildung</h3>
          <p class="ce-training__meta">5 Module · 135 Unterrichtseinheiten</p>
          <ul>
            <li>5 Einzelcoachings und 20 UE Lerngruppe</li>
            <li>10 UE Gruppensupervision</li>
            <li>Praxisprotokolle, Fachliteratur und Abschlussprüfung</li>
          </ul>
          <a href="https://top-coachingausbildung.de">Coachingwelt entdecken</a>
        </article>
      </div>
    </div>
  </section>

  <section class="ce-podcast" id="podcast" aria-labelledby="ce-podcast-title">
    <div class="ce-shell ce-podcast__grid">
      <div class="ce-podcast__copy" data-ce-reveal>
        <p class="ce-kicker">Podcast im Aufbau</p>
        <h2 id="ce-podcast-title">Gespräche über Führung, Gesundheit, Veränderung und Zukunft.</h2>
        <p>Mich interessieren keine fertigen Antworten. Mich interessieren Menschen, ihre Erfahrungen, Zweifel und die Brücken, die daraus entstehen.</p>
        <div class="ce-platforms" aria-label="Geplante Podcast-Plattformen">
          <span>Spotify</span><span>Apple Podcasts</span><span>YouTube</span><span>LinkedIn</span>
        </div>
      </div>
      <div class="ce-podcast__visual" data-ce-reveal>
        <img src="{{ 'ce-founders.jpg' | asset_url }}" width="1024" height="1536" alt="Claudia Effertz, Die Brückenbauerin, mit Buchprojekt und Brückenmotiv" loading="lazy">
      </div>
    </div>
  </section>

  <section class="ce-ecosystem" aria-labelledby="ce-ecosystem-title">
    <div class="ce-shell">
      <header class="ce-section-head" data-ce-reveal>
        <h2 id="ce-ecosystem-title">Vier Eingangstüren. Ein Entwicklungsmodell.</h2>
        <p>Die Brückenbauerin verbindet persönliche Begleitung, Umsetzung und Qualifizierung.</p>
      </header>
      <div class="ce-ecosystem__grid">
        <a href="#start" data-ce-reveal><small>Leitmarke</small><strong>claudia-effertz.de</strong><span>Expertise, Speaking, Coaching, Buch, Podcast und gesellschaftliche Wirkung.</span></a>
        <a href="https://gesundeunternehmen.com" data-ce-reveal><small>Umsetzung</small><strong>gesundeunternehmen.com</strong><span>Projektentwicklung und ein qualitätsgesichertes Umsetzungsnetzwerk.</span></a>
        <a href="https://top-coachingausbildung.de" data-ce-reveal><small>Begleitung</small><strong>top-coachingausbildung.de</strong><span>Systemische Coachingausbildung, Vertiefung, Supervision und Alumni.</span></a>
        <a href="https://top-fuehrungsausbildung.de" data-ce-reveal><small>Führung</small><strong>top-fuehrungsausbildung.de</strong><span>Fundierte Führungsbasis, Intensivmodule und kontinuierliche Entwicklung.</span></a>
      </div>
    </div>
  </section>

  <section class="ce-engagement" id="engagement" aria-labelledby="ce-engagement-title">
    <div class="ce-shell ce-engagement__grid">
      <div class="ce-engagement__media" data-ce-reveal>
        <img src="{{ 'ce-network.jpg' | asset_url }}" width="1536" height="1536" alt="Infografik zum Netzwerk, Engagement und beruflichen Fundament von Claudia Effertz" loading="lazy">
      </div>
      <div data-ce-reveal>
        <p class="ce-kicker">Gesellschaftliche Wirkung</p>
        <h2 id="ce-engagement-title">Aus Betroffenheit kann Bewegung entstehen.</h2>
        <p>Als Gründungsmitglied und im Vorstand der LipödemGesellschaft e.V. verbindet Claudia wissenschaftlich fundierte Informationen, Betroffene, Fachleute und Politik.</p>
        <p>Die Kampagne „LipöWAS?“ zeigt, wie Aufklärung, Vernetzung und Beteiligung gesellschaftliche Veränderung anstoßen können.</p>
        <p class="ce-note">Die Inhalte dienen der Aufklärung und Vernetzung. Sie ersetzen keine medizinische Beratung, Diagnose oder Therapie.</p>
      </div>
    </div>
  </section>

  <section class="ce-values" aria-labelledby="ce-values-title">
    <div class="ce-shell">
      <header class="ce-section-head" data-ce-reveal>
        <h2 id="ce-values-title">Fünf Sätze. Ein Wertekompass.</h2>
      </header>
      <div class="ce-values__grid">
        <article data-ce-reveal><strong>Respekt</strong><p>„Du darfst alles sagen, wenn die Form stimmt.“</p></article>
        <article data-ce-reveal><strong>Verantwortung</strong><p>„Du darfst alles tun, wenn Du die Konsequenzen trägst.“</p></article>
        <article data-ce-reveal><strong>Zuversicht</strong><p>„Wir finden gemeinsam immer eine Lösung.“</p></article>
        <article data-ce-reveal><strong>Integrität</strong><p>„Ehrlich währt am längsten.“</p></article>
        <article data-ce-reveal><strong>Eigeninitiative</strong><p>„Immer bissche mitdenke.“</p></article>
      </div>
      <blockquote class="ce-testimonial" data-ce-reveal>
        <p>„Sie verbindet Klarheit mit Wärme. Komplexe Zusammenhänge werden plötzlich verständlich.“</p>
      </blockquote>
    </div>
  </section>

  <section class="ce-contact" id="kontakt" aria-labelledby="ce-contact-title">
    <div class="ce-shell ce-contact__grid">
      <div data-ce-reveal>
        <p class="ce-kicker">Kontakt</p>
        <h2 id="ce-contact-title">Welche Brücke möchten Sie bauen?</h2>
        <p>Für Vorträge, Coaching, Organisationsentwicklung, Buch &amp; Edition oder eine erste gemeinsame Klärung.</p>
        <address>
          <strong>Claudia Effertz</strong><br>
          Coach | Speakerin | Autorin<br>
          <a href="tel:+491718327272">0171 832 72 72</a><br>
          <a href="https://www.claudia-effertz.de">www.claudia-effertz.de</a>
        </address>
      </div>
      <div class="ce-contact__form" data-ce-reveal>
        {% form 'contact', id: 'CeContactForm' %}
          {% if form.posted_successfully? %}
            <p class="ce-form-status ce-form-status--success" role="status" tabindex="-1">Vielen Dank. Ihre Nachricht ist angekommen.</p>
          {% endif %}
          {% if form.errors %}
            <div class="ce-form-status ce-form-status--error" role="alert">{{ form.errors | default_errors }}</div>
          {% endif %}
          <div class="ce-field">
            <label for="CeContactName">Name</label>
            <input id="CeContactName" name="contact[name]" type="text" autocomplete="name" required>
          </div>
          <div class="ce-field">
            <label for="CeContactEmail">E-Mail</label>
            <input id="CeContactEmail" name="contact[email]" type="email" autocomplete="email" required>
          </div>
          <div class="ce-field">
            <label for="CeContactTopic">Thema</label>
            <select id="CeContactTopic" name="contact[Thema]">
              <option>Vortrag</option><option>Coaching &amp; Begleitung</option><option>Buch &amp; Edition</option><option>Podcast</option><option>Sonstiges</option>
            </select>
          </div>
          <div class="ce-field">
            <label for="CeContactMessage">Nachricht</label>
            <textarea id="CeContactMessage" name="contact[body]" rows="6" required></textarea>
          </div>
          <button class="ce-button ce-button--primary" type="submit" data-ce-submit>Nachricht senden</button>
        {% endform %}
      </div>
    </div>
  </section>
</div>

{% schema %}
{
  "name": "Claudia Startseite",
  "tag": "section",
  "class": "ce-home-section",
  "settings": []
}
{% endschema %}
