<style>
  .mgu-bt-grid{display:grid;grid-template-columns:1fr 1fr;gap:clamp(34px,6vw,90px);align-items:center}
  @media(max-width:860px){.mgu-bt-grid{grid-template-columns:1fr}}
  .mgu-bt-media{position:relative}
  .mgu-bt-media img{
    width:100%;border-radius:24px;
    box-shadow:0 40px 80px -34px rgba(20,37,25,.4);
  }
  .mgu-bt-media::before{
    content:"";position:absolute;inset:8% -6% -6% 8%;z-index:-1;border-radius:24px;
    background:var(--mgu-cream);border:1px solid var(--mgu-line);
  }
  .mgu-bt-text .mgu-rte{color:var(--mgu-ink-soft);font-size:17px}
  .mgu-bt-text .mgu-rte p{margin:0 0 16px}
  .mgu-bt-text h2{font-size:clamp(1.9rem,3.4vw,2.8rem);color:var(--mgu-forest);line-height:1.12;margin-bottom:20px}
  .mgu-bt-text h2 em{font-style:italic;color:var(--mgu-gold)}
  .mgu-bt-grid.mgu-bt-rechts .mgu-bt-media{order:2}
  @media(max-width:860px){.mgu-bt-grid.mgu-bt-rechts .mgu-bt-media{order:0}}
</style>

<section data-mgu-effect="{{ section.settings.effect | default: 'up' }}" data-mgu-speed="{{ section.settings.effect_speed | default: 'normal' }}" class="mgu mgu-block" id="mgu-bt-{{ section.id }}" style="background:{{ section.settings.bg }}">
  <div class="mgu-wrap">
    <div class="mgu-bt-grid {% if section.settings.bild_rechts %}mgu-bt-rechts{% endif %}">
      <div class="mgu-bt-media mgu-reveal">
        {%- if section.settings.image != blank -%}
          <img width="{{ section.settings.image.width }}" height="{{ section.settings.image.height }}" src="{{ section.settings.image | image_url: width: 1000 }}"
               alt="{{ section.settings.image.alt | escape }}" loading="lazy"
               {% if section.settings.parallax %}data-mgu-parallax="0.07"{% endif %}>
        {%- else -%}
          {{ 'image' | placeholder_svg_tag }}
        {%- endif -%}
      </div>
      <div class="mgu-bt-text mgu-reveal" style="transition-delay:.12s">
        {%- if section.settings.eyebrow != blank -%}<span class="mgu-eyebrow">{{ section.settings.eyebrow }}</span>{%- endif -%}
        <h2>{{ section.settings.heading }}</h2>
        <div class="mgu-rte">{{ section.settings.text }}</div>
        {%- if section.settings.button_label != blank and section.settings.button_link != blank -%}
          <a class="mgu-btn mgu-btn--primary" style="margin-top:10px" href="{{ section.settings.button_link }}">
            {{ section.settings.button_label }}
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none"><path d="M5 12h14M13 6l6 6-6 6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
          </a>
        {%- endif -%}
      </div>
    </div>
  </div>
</section>

{% style %}
  #shopify-section-{{ section.id }} {
    margin-block-start: {{ section.settings.section_gap_top | default: 0 }}px;
    margin-block-end: {{ section.settings.section_gap_bottom | default: 0 }}px;
  }
{% endstyle %}

{% schema %}
{
  "name": "Chelonaki – Bild + Text",
  "settings": [
    {"type":"header","content":"Abstand zum nächsten Abschnitt"},
    {"type":"range","id":"section_gap_top","label":"Zusätzlicher Abstand oben","min":0,"max":200,"step":4,"unit":"px","default":0},
    {"type":"range","id":"section_gap_bottom","label":"Zusätzlicher Abstand unten","min":0,"max":200,"step":4,"unit":"px","default":0},
    { "type": "header", "content": "Scroll-Effekt" },
    { "type": "select", "id": "effect", "label": "Erscheinen beim Scrollen", "default": "up", "options": [ { "value": "none", "label": "Kein Effekt" }, { "value": "fade", "label": "Einblenden" }, { "value": "up", "label": "Von unten (Standard)" }, { "value": "left", "label": "Von links" }, { "value": "right", "label": "Von rechts" }, { "value": "zoom", "label": "Sanfter Zoom" }, { "value": "blur", "label": "Aus der Unschärfe" } ] },
    { "type": "select", "id": "effect_speed", "label": "Effekt-Tempo", "default": "normal", "options": [ { "value": "schnell", "label": "Schnell" }, { "value": "normal", "label": "Normal" }, { "value": "langsam", "label": "Langsam" } ] },
    { "type": "image_picker", "id": "image", "label": "Bild" },
    { "type": "checkbox", "id": "bild_rechts", "label": "Bild rechts statt links", "default": false },
    { "type": "checkbox", "id": "parallax", "label": "Parallax auf dem Bild", "default": false },
    { "type": "text", "id": "eyebrow", "label": "Kicker-Zeile", "default": "Über die Methode" },
    { "type": "inline_richtext", "id": "heading", "label": "Überschrift", "default": "Ernährung, die <em>im Alltag funktioniert.</em>" },
    { "type": "richtext", "id": "text", "label": "Text", "default": "<p>Hier steht deine Geschichte: Wofür deine Methode steht, wie sie entstanden ist und was sie besonders macht.</p>" },
    { "type": "text", "id": "button_label", "label": "Button-Beschriftung" },
    { "type": "url", "id": "button_link", "label": "Button-Link" },
    { "type": "color", "id": "bg", "label": "Hintergrundfarbe", "default": "#FBF8F0" }
  ],
  "presets": [{ "name": "Chelonaki – Bild + Text" }]
}
{% endschema %}
