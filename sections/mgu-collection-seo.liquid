{% comment %} Chelonaki Shop Theme · © Chelonaki · Build: CHELONAKI-BUILD-0000-MASTER · Nutzung nur mit gültiger Lizenz {% endcomment %}
<style>
  .mgu-cseo{max-width:820px;margin:0 auto;color:var(--mgu-ink-soft);font-size:15.5px;line-height:1.75}
  .mgu-cseo h2{font-size:1.5rem;color:var(--mgu-forest);margin:0 0 14px}
  .mgu-cseo h2 em{font-style:italic;color:var(--mgu-gold)}
  .mgu-cseo p{margin:0 0 14px}
  .mgu-cseo a{color:var(--mgu-gold);text-decoration:underline;text-underline-offset:3px}
</style>
<section class="mgu" style="background:{{ section.settings.bg }};padding:clamp(40px,6vw,70px) clamp(20px,4vw,48px)">
  <div class="mgu-cseo">
    {%- if section.settings.heading != blank -%}<h2>{{ section.settings.heading }}</h2>{%- endif -%}
    {{ section.settings.text }}
  </div>
</section>
{% style %}
  #shopify-section-{{ section.id }} {
    margin-block-start: {{ section.settings.section_gap_top | default: 0 }}px;
    margin-block-end: {{ section.settings.section_gap_bottom | default: 0 }}px;
  }
{% endstyle %}

{% schema %}
{
  "name": "Chelonaki · Koll.-SEO",
  "settings": [
    {"type":"header","content":"Abstand zum nächsten Abschnitt"},
    {"type":"range","id":"section_gap_top","label":"Zusätzlicher Abstand oben","min":0,"max":200,"step":4,"unit":"px","default":0},
    {"type":"range","id":"section_gap_bottom","label":"Zusätzlicher Abstand unten","min":0,"max":200,"step":4,"unit":"px","default":0},
    { "type": "paragraph", "content": "SEO-Textblock für Kategorieseiten – unterhalb des Produktrasters platzieren. Nutzt {{ collection.title }} nicht automatisch; Text pro Collection über den Customizer (Vorlage je Collection anlegen) pflegen." },
    { "type": "inline_richtext", "id": "heading", "label": "Überschrift", "default": "Über diese <em>Kategorie.</em>" },
    { "type": "richtext", "id": "text", "label": "SEO-Text", "default": "<p>Beschreibender Text zu dieser Kategorie: Sortiment, Auswahlkriterien, interne Links zu passenden Ratgebern oder Produkten.</p>" },
    { "type": "color", "id": "bg", "label": "Hintergrundfarbe", "default": "#FBF8F0" }
  ],
  "enabled_on": { "templates": ["collection"] },
  "presets": [{ "name": "Chelonaki – Collection-SEO-Text" }]
}
{% endschema %}
