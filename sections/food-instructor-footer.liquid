{% liquid
  assign footer_home_url = routes.root_url
  assign footer_anchor_prefix = ''
  unless request.page_type == 'index'
    assign footer_anchor_prefix = routes.root_url
  endunless
  assign legal_notice_url = section.settings.legal_notice_link
  if legal_notice_url == blank
    for policy in shop.policies
      assign policy_title_normalized = policy.title | downcase
      if policy.type == 'legal_notice' or policy_title_normalized contains 'impressum' or policy_title_normalized contains 'legal notice' or policy_title_normalized contains 'anbieterkennzeichnung'
        assign legal_notice_url = policy.url
        break
      endif
    endfor
  endif
  if legal_notice_url == blank and pages.impressum != blank
    assign legal_notice_url = pages.impressum.url
  endif
  assign privacy_url = section.settings.privacy_link
  if privacy_url == blank and shop.privacy_policy != blank
    assign privacy_url = shop.privacy_policy.url
  endif
  assign withdrawal_label = section.settings.withdrawal_link_label

%}

<footer
  class="fi-footer"
  id="FiFooter-{{ section.id }}"
  style="--fi-module-bg:{{ section.settings.module_bg }};--fi-heading-color:{{ section.settings.heading_color }};--fi-text-color:{{ section.settings.text_color }};--fi-accent-color:{{ section.settings.accent_color }};--fi-link-color:{{ section.settings.link_color }};--fi-link-hover:{{ section.settings.link_hover }};--fi-border-color:{{ section.settings.border_color }};--fi-footer-mobile-align:{{ section.settings.mobile_alignment }}"
>
  <div class="fi-footer-shell">
    {% if section.blocks.size > 0 %}
      <div
        class="fi-footer-top fi-footer-top--modular fi-footer-top--columns-{{ section.settings.desktop_columns }}"
        style="--fi-footer-columns:{{ section.settings.desktop_columns }};--fi-footer-gap:{{ section.settings.column_gap }}px"
      >
        {% for block in section.blocks %}
          <div
            class="fi-footer-block fi-footer-block--{{ block.type }} fi-footer-align--{{ block.settings.alignment | default: 'left' }}"
            style="--fi-footer-block-span:{{ block.settings.column_span | default: 1 }}"
            {{ block.shopify_attributes }}
          >
            {% case block.type %}
              {% when 'brand' %}
                <a class="fi-brand fi-brand--footer" href="{{ block.settings.logo_link | default: footer_home_url }}" aria-label="{{ block.settings.home_label | escape }}">
                  {% render 'fi-logo', width: 34, height: 34 %}
                  <span class="fi-brand-name">{{ block.settings.brand_name | escape }} <b>{{ block.settings.brand_suffix | escape }}</b></span>
                </a>
                {% if block.settings.brand_text != blank %}<div class="fi-footer-brand-copy rte">{{ block.settings.brand_text }}</div>{% endif %}
                {% if block.settings.facebook_url != blank or block.settings.linkedin_url != blank %}
                  <div class="fi-footer-social fi-footer-social--medium" aria-label="Social Media">
                    {% if block.settings.facebook_url != blank %}
                      <a href="{{ block.settings.facebook_url }}" target="_blank" rel="noopener" aria-label="Facebook">
                        {% render 'fi-social-icon', icon: 'facebook', size: 22 %}
                      </a>
                    {% endif %}
                    {% if block.settings.linkedin_url != blank %}
                      <a href="{{ block.settings.linkedin_url }}" target="_blank" rel="noopener" aria-label="LinkedIn">
                        {% render 'fi-social-icon', icon: 'linkedin', size: 22 %}
                      </a>
                    {% endif %}
                  </div>
                {% endif %}

              {% when 'menu' %}
                {% if block.settings.heading != blank %}<h2 class="fi-footer-heading">{{ block.settings.heading | escape }}</h2>{% endif %}
                {% if block.settings.menu != blank %}
                  <ul class="fi-footer-list">
                    {% for link in block.settings.menu.links %}
                      <li><a href="{{ link.url }}"{% if link.current %} aria-current="page"{% endif %}>{{ link.title | escape }}</a></li>
                    {% endfor %}
                  </ul>
                {% elsif request.design_mode %}
                  <p class="fi-footer-editor-note">Wähle hier ein Shopify-Menü aus.</p>
                {% endif %}

              {% when 'links' %}
                {% if block.settings.heading != blank %}<h2 class="fi-footer-heading">{{ block.settings.heading | escape }}</h2>{% endif %}
                <ul class="fi-footer-list fi-footer-list--columns-{{ block.settings.link_columns | default: 1 }}">
                  {% for index in (1..13) %}
                    {% assign label_key = 'link_' | append: index | append: '_label' %}
                    {% assign url_key = 'link_' | append: index | append: '_url' %}
                    {% assign link_label = block.settings[label_key] %}
                    {% assign link_url = block.settings[url_key] %}
                    {% if link_label != blank and link_url != blank %}
                      {% assign link_first_character = link_url | slice: 0 %}
                      {% if request.page_type != 'index' and link_first_character == '#' %}
                        {% assign link_url = footer_anchor_prefix | append: link_url %}
                      {% endif %}
                      <li><a href="{{ link_url }}">{{ link_label | escape }}</a></li>
                    {% endif %}
                  {% endfor %}
                </ul>

              {% when 'legal' %}
                {% liquid
                  assign block_legal_notice_url = block.settings.legal_notice_link | default: legal_notice_url
                  assign block_privacy_url = block.settings.privacy_link
                  if block_privacy_url == blank and shop.privacy_policy != blank
                    assign block_privacy_url = shop.privacy_policy.url
                  endif
                  assign block_terms_url = block.settings.terms_link
                  if block_terms_url == blank and shop.terms_of_service != blank
                    assign block_terms_url = shop.terms_of_service.url
                  endif
                  assign block_refund_url = block.settings.refund_link
                  if block_refund_url == blank and shop.refund_policy != blank
                    assign block_refund_url = shop.refund_policy.url
                  endif
                  assign block_shipping_url = block.settings.shipping_link
                  if block_shipping_url == blank and shop.shipping_policy != blank
                    assign block_shipping_url = shop.shipping_policy.url
                  endif
                %}
                {% if block.settings.heading != blank %}<h2 class="fi-footer-heading">{{ block.settings.heading | escape }}</h2>{% endif %}
                <ul class="fi-footer-list">
                  {% if block_legal_notice_url != blank %}<li><a href="{{ block_legal_notice_url }}">{{ block.settings.legal_notice_label | escape }}</a></li>{% endif %}
                  {% if block_privacy_url != blank %}<li><a href="{{ block_privacy_url }}">{{ block.settings.privacy_label | escape }}</a></li>{% endif %}
                  {% if block_terms_url != blank %}<li><a href="{{ block_terms_url }}">{{ block.settings.terms_label | escape }}</a></li>{% endif %}
                  {% if block_refund_url != blank %}<li><a href="{{ block_refund_url }}">{{ block.settings.refund_label | escape }}</a></li>{% endif %}
                  {% if block_shipping_url != blank %}<li><a href="{{ block_shipping_url }}">{{ block.settings.shipping_label | escape }}</a></li>{% endif %}
                  {% if block.settings.cancellation_link != blank %}<li><a href="{{ block.settings.cancellation_link }}">{{ block.settings.cancellation_label | escape }}</a></li>{% endif %}
                </ul>

              {% when 'contact' %}
                {% if block.settings.heading != blank %}<h2 class="fi-footer-heading">{{ block.settings.heading | escape }}</h2>{% endif %}
                <address class="fi-footer-contact">
                  {% if block.settings.contact_name != blank %}<strong>{{ block.settings.contact_name | escape }}</strong>{% endif %}
                  {% if block.settings.contact_address != blank %}<span>{{ block.settings.contact_address | newline_to_br }}</span>{% endif %}
                  {% if block.settings.contact_phone != blank %}<a href="tel:{{ block.settings.contact_phone | replace: ' ', '' }}">{{ block.settings.contact_phone | escape }}</a>{% endif %}
                  {% if block.settings.contact_email != blank %}<a href="mailto:{{ block.settings.contact_email | escape }}">{{ block.settings.contact_email | escape }}</a>{% endif %}
                  {% if block.settings.contact_link != blank %}<a href="{{ block.settings.contact_link }}">{{ block.settings.contact_label | escape }}</a>{% endif %}
                </address>

              {% when 'social' %}
                {% if block.settings.heading != blank %}<h2 class="fi-footer-heading">{{ block.settings.heading | escape }}</h2>{% endif %}
                {% if block.settings.intro != blank %}<div class="fi-footer-social-intro rte">{{ block.settings.intro }}</div>{% endif %}
                <div class="fi-footer-social fi-footer-social--{{ block.settings.icon_style }} fi-footer-social--{{ block.settings.icon_size }}" aria-label="{{ block.settings.aria_label | escape }}">
                  {% assign social_names = 'instagram,facebook,youtube,linkedin,tiktok,pinterest,x' | split: ',' %}
                  {% for social_name in social_names %}
                    {% assign setting_key = social_name | append: '_url' %}
                    {% assign social_url = block.settings[setting_key] %}
                    {% if social_url != blank %}
                      <a href="{{ social_url }}" target="_blank" rel="noopener" aria-label="{{ social_name | capitalize }}">
                        {% render 'fi-social-icon', icon: social_name, size: 22 %}
                        {% if block.settings.show_labels %}<span>{{ social_name | capitalize }}</span>{% endif %}
                      </a>
                    {% endif %}
                  {% endfor %}
                </div>
            {% endcase %}
          </div>
        {% endfor %}
      </div>
    {% else %}
      {% if request.design_mode %}<p class="fi-footer-editor-note">Füge Footer-Blöcke hinzu und ordne sie per Drag-and-drop an.</p>{% endif %}
    {% endif %}
    {% if section.settings.show_withdrawal_link and withdrawal_label != blank %}
      <div class="fi-footer-withdrawal">
        <a class="fi-footer-withdrawal__link" href="/pages/vertrag-widerrufen" rel="nofollow">
          {{ withdrawal_label | escape }}
        </a>
      </div>
    {% endif %}
    {% if section.settings.show_bottom_bar %}
    <div class="fi-footer-bottom">
      <small>© {{ 'now' | date: '%Y' }} {{ section.settings.copyright_name | escape }} · {{ section.settings.copyright_text | escape }}</small>
      <div class="fi-footer-bottom-links">
        {% if legal_notice_url != blank %}<a href="{{ legal_notice_url }}">{{ section.settings.legal_notice_label | escape }}</a>{% endif %}
        {% if privacy_url != blank %}<a href="{{ privacy_url }}">{{ section.settings.privacy_label | escape }}</a>{% endif %}
        {% if section.settings.contact_link != blank %}<a href="{{ section.settings.contact_link }}">{{ section.settings.contact_label | escape }}</a>{% endif %}
      </div>
    </div>
    {% endif %}
  </div>
</footer>

{% schema %}
{
  "name": "Chelonaki · Web Footer",
  "tag": "section",
  "class": "fi-footer-section",
  "settings": [
    {"type":"paragraph","content":"Inhalte werden unten über verschiebbare Blöcke bearbeitet. Du kannst Blöcke hinzufügen, löschen und neu anordnen."},
    {"type":"header","content":"Untere Leiste"},
    {"type":"text","id":"copyright_name","label":"Name im Copyright","default":"Claudia Effertz"},
    {"type":"text","id":"copyright_text","label":"Copyright-Zusatz","default":"Alle Rechte vorbehalten"},
    {"type":"checkbox","id":"show_bottom_bar","label":"Untere Copyright-Leiste anzeigen","default":true},
    {"type":"text","id":"legal_notice_label","label":"Text Impressum","default":"Impressum"},
    {"type":"url","id":"legal_notice_link","label":"Link Impressum"},
    {"type":"text","id":"privacy_label","label":"Text Datenschutz","default":"Datenschutz"},
    {"type":"url","id":"privacy_link","label":"Link Datenschutz","info":"Leer lassen, um die Shopify-Datenschutzrichtlinie zu verwenden."},
    {"type":"text","id":"contact_label","label":"Text Kontaktlink","default":"Kontaktformular"},
    {"type":"url","id":"contact_link","label":"Link Kontaktformular"},
    {"type":"header","content":"Elektronischer Widerruf"},
    {"type":"checkbox","id":"show_withdrawal_link","label":"Link zur Widerrufsfunktion anzeigen","default":true},
    {"type":"text","id":"withdrawal_link_label","label":"Beschriftung Widerrufsfunktion","default":"Vertrag widerrufen","info":"Führt zum nativen Shopify-Kundenkonto. Übersetzungen können mit Translate & Adapt gepflegt werden."},

    {"type":"header","content":"Modulares Layout"},
    {"type":"range","id":"desktop_columns","label":"Spalten auf Desktop","min":2,"max":6,"step":1,"default":4},
    {"type":"range","id":"column_gap","label":"Abstand zwischen Spalten","min":12,"max":96,"step":4,"unit":"px","default":48},
    {"type":"select","id":"mobile_alignment","label":"Ausrichtung auf Mobile","default":"left","options":[{"value":"left","label":"Links"},{"value":"center","label":"Zentriert"},{"value":"right","label":"Rechts"}]},
    {"type":"header","content":"Farben dieses Moduls"},
    {"type":"color","id":"module_bg","label":"Footer-Hintergrund","default":"#162C49"},
    {"type":"color","id":"heading_color","label":"Überschriften und Marke","default":"#FBF8F2"},
    {"type":"color","id":"text_color","label":"Fließtext","default":"#F4EEE1"},
    {"type":"color","id":"accent_color","label":"Akzent","default":"#DFBD7C"},
    {"type":"color","id":"link_color","label":"Links","default":"#F4EEE1"},
    {"type":"color","id":"link_hover","label":"Links bei Hover","default":"#DFBD7C"},
    {"type":"color","id":"border_color","label":"Trennlinien","default":"#C69A4B"}
  ],
  "blocks": [
    {
      "type":"brand","name":"Marke & Beschreibung","limit":2,
      "settings":[
        {"type":"text","id":"brand_name","label":"Markenname","default":"CLAUDIA"},
        {"type":"text","id":"brand_suffix","label":"Markenzusatz","default":"EFFERTZ"},
        {"type":"richtext","id":"brand_text","label":"Beschreibung","default":"<p>Die Brückenbauerin. Menschen verstehen, verbinden und entwickeln.</p>"},
        {"type":"url","id":"facebook_url","label":"Facebook"},
        {"type":"url","id":"linkedin_url","label":"LinkedIn"},
        {"type":"url","id":"logo_link","label":"Logo-Link"},
        {"type":"text","id":"home_label","label":"Barrierefreie Bezeichnung","default":"Claudia Effertz - Startseite"},
        {"type":"select","id":"column_span","label":"Spaltenbreite","default":"2","options":[{"value":"1","label":"1 Spalte"},{"value":"2","label":"2 Spalten"},{"value":"3","label":"3 Spalten"},{"value":"4","label":"4 Spalten"}]},
        {"type":"select","id":"alignment","label":"Ausrichtung","default":"left","options":[{"value":"left","label":"Links"},{"value":"center","label":"Zentriert"},{"value":"right","label":"Rechts"}]}
      ]
    },
    {
      "type":"links","name":"Einfache Linkliste","limit":6,
      "settings":[
        {"type":"text","id":"heading","label":"Überschrift","default":"Entdecken"},
        {"type":"header","content":"Link 1"},{"type":"text","id":"link_1_label","label":"Text"},{"type":"url","id":"link_1_url","label":"Ziel"},
        {"type":"header","content":"Link 2"},{"type":"text","id":"link_2_label","label":"Text"},{"type":"url","id":"link_2_url","label":"Ziel"},
        {"type":"header","content":"Link 3"},{"type":"text","id":"link_3_label","label":"Text"},{"type":"url","id":"link_3_url","label":"Ziel"},
        {"type":"header","content":"Link 4"},{"type":"text","id":"link_4_label","label":"Text"},{"type":"url","id":"link_4_url","label":"Ziel"},
        {"type":"header","content":"Link 5"},{"type":"text","id":"link_5_label","label":"Text"},{"type":"url","id":"link_5_url","label":"Ziel"},
        {"type":"header","content":"Link 6"},{"type":"text","id":"link_6_label","label":"Text"},{"type":"url","id":"link_6_url","label":"Ziel"},
        {"type":"header","content":"Link 7"},{"type":"text","id":"link_7_label","label":"Text"},{"type":"url","id":"link_7_url","label":"Ziel"},
        {"type":"header","content":"Link 8"},{"type":"text","id":"link_8_label","label":"Text"},{"type":"url","id":"link_8_url","label":"Ziel"},
        {"type":"header","content":"Link 9"},{"type":"text","id":"link_9_label","label":"Text"},{"type":"url","id":"link_9_url","label":"Ziel"},
        {"type":"header","content":"Link 10"},{"type":"text","id":"link_10_label","label":"Text"},{"type":"url","id":"link_10_url","label":"Ziel"},
        {"type":"header","content":"Link 11"},{"type":"text","id":"link_11_label","label":"Text"},{"type":"url","id":"link_11_url","label":"Ziel"},
        {"type":"header","content":"Link 12"},{"type":"text","id":"link_12_label","label":"Text"},{"type":"url","id":"link_12_url","label":"Ziel"},
        {"type":"header","content":"Link 13"},{"type":"text","id":"link_13_label","label":"Text"},{"type":"url","id":"link_13_url","label":"Ziel"},
        {"type":"select","id":"link_columns","label":"Anzahl Linkspalten","default":"2","options":[{"value":"1","label":"Eine Spalte"},{"value":"2","label":"Zwei Spalten"}]},
        {"type":"select","id":"column_span","label":"Spaltenbreite","default":"1","options":[{"value":"1","label":"1 Spalte"},{"value":"2","label":"2 Spalten"},{"value":"3","label":"3 Spalten"}]},
        {"type":"select","id":"alignment","label":"Ausrichtung","default":"left","options":[{"value":"left","label":"Links"},{"value":"center","label":"Zentriert"},{"value":"right","label":"Rechts"}]}
      ]
    },
    {
      "type":"menu","name":"Shopify-Menü","limit":6,
      "settings":[
        {"type":"text","id":"heading","label":"Überschrift","default":"Entdecken"},
        {"type":"link_list","id":"menu","label":"Menü auswählen"},
        {"type":"select","id":"column_span","label":"Spaltenbreite","default":"1","options":[{"value":"1","label":"1 Spalte"},{"value":"2","label":"2 Spalten"},{"value":"3","label":"3 Spalten"},{"value":"4","label":"4 Spalten"}]},
        {"type":"select","id":"alignment","label":"Ausrichtung","default":"left","options":[{"value":"left","label":"Links"},{"value":"center","label":"Zentriert"},{"value":"right","label":"Rechts"}]}
      ]
    },
    {
      "type":"legal","name":"Rechtliches","limit":2,
      "settings":[
        {"type":"text","id":"heading","label":"Überschrift","default":"Rechtliches"},
        {"type":"text","id":"legal_notice_label","label":"Text Impressum","default":"Impressum"},{"type":"url","id":"legal_notice_link","label":"Link Impressum"},
        {"type":"text","id":"privacy_label","label":"Text Datenschutz","default":"Datenschutz"},{"type":"url","id":"privacy_link","label":"Link Datenschutz"},
        {"type":"text","id":"terms_label","label":"Text AGB","default":"AGB"},{"type":"url","id":"terms_link","label":"Link AGB"},
        {"type":"text","id":"refund_label","label":"Text Widerruf/Rückgabe","default":"Widerruf & Rückgabe"},{"type":"url","id":"refund_link","label":"Link Widerruf/Rückgabe"},
