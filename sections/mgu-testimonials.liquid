{% comment %} Chelonaki Shop Theme · Kompakte aufklappbare Kundenstimmen · v2.23 {% endcomment %}

{%- liquid
  assign section_id = 'ChelonakiReviews-' | append: section.id
  assign desktop_columns = section.settings.columns_desktop | default: 3
  if desktop_columns > 3
    assign desktop_columns = 3
  endif
  assign excerpt_lines = section.settings.excerpt_lines | default: 6
  assign read_more_enabled = section.settings.enable_read_more | default: true, allow_false: true
-%}

<style>
  #{{ section_id }} {
    --cr-bg: {{ section.settings.bg }};
    --cr-heading: {{ section.settings.heading_color }};
    --cr-text: {{ section.settings.text_color }};
    --cr-muted: {{ section.settings.muted_color }};
    --cr-card: {{ section.settings.card_bg }};
    --cr-border: {{ section.settings.card_border }};
    --cr-accent: {{ section.settings.star_color }};
    --cr-badge-bg: {{ section.settings.badge_bg }};
    --cr-badge-text: {{ section.settings.badge_text }};
    --cr-button-bg: {{ section.settings.button_bg }};
    --cr-button-text: {{ section.settings.button_text }};
    --cr-button-hover-bg: {{ section.settings.button_hover_bg }};
    --cr-button-hover-text: {{ section.settings.button_hover_text }};
    --cr-excerpt-lines: {{ excerpt_lines }};
    background: var(--cr-bg);
    padding: {{ section.settings.padding_top }}px 0 {{ section.settings.padding_bottom }}px;
  }

  #{{ section_id }} *,
  #{{ section_id }} *::before,
  #{{ section_id }} *::after {
    box-sizing: border-box;
  }

  #{{ section_id }} .cr-wrap {
    width: min(1240px, calc(100% - 48px));
    margin: 0 auto;
  }

  #{{ section_id }} .cr-head {
    max-width: 760px;
    margin: 0 0 34px;
    text-align: {{ section.settings.heading_align }};
  }

  #{{ section_id }} .cr-head.is-center {
    margin-inline: auto;
  }

  #{{ section_id }} .cr-kicker {
    display: inline-flex;
    align-items: center;
    gap: 11px;
    color: color-mix(in srgb, var(--cr-accent) 50%, var(--cr-heading));
    font-size: 12px;
    font-weight: 800;
    letter-spacing: .18em;
    text-transform: uppercase;
  }

  #{{ section_id }} .cr-kicker::before {
    content: "";
    width: 30px;
    height: 1px;
    background: currentColor;
  }

  #{{ section_id }} .cr-head.is-center .cr-kicker::before {
    display: none;
  }

  #{{ section_id }} .cr-head h2 {
    margin: 12px 0 0;
    color: var(--cr-heading);
    font-family: var(--mgu-font-heading, Georgia, serif);
    font-size: clamp(2rem, 4vw, 3.3rem);
    font-weight: 400;
    line-height: 1.08;
  }

  #{{ section_id }} .cr-head h2 em {
    color: color-mix(in srgb, var(--cr-accent) 50%, var(--cr-heading));
  }

  #{{ section_id }} .cr-intro {
    margin-top: 14px;
    color: var(--cr-muted);
    font-size: 17px;
    line-height: 1.65;
  }

  #{{ section_id }} .cr-grid {
    display: grid;
    grid-template-columns: repeat({{ desktop_columns }}, minmax(0, 1fr));
    gap: {{ section.settings.gap }}px;
    align-items: start;
  }

  #{{ section_id }}.is-slider .cr-grid {
    grid-template-columns: none;
    grid-auto-flow: column;
    grid-auto-columns: minmax(400px, 520px);
    overflow-x: auto;
    overscroll-behavior-inline: contain;
    scroll-snap-type: x mandatory;
    scrollbar-width: thin;
    padding: 4px 2px 18px;
  }

  #{{ section_id }} .cr-card {
    position: relative;
    display: flex;
    flex-direction: column;
    min-width: 0;
    min-height: 0;
    padding: {{ section.settings.card_padding }}px;
    border: 1px solid var(--cr-border);
    border-radius: {{ section.settings.card_radius }}px;
    background: var(--cr-card);
    box-shadow: {% if section.settings.show_shadow %}0 20px 52px -40px rgba(20, 37, 25, .46){% else %}none{% endif %};
    overflow: hidden;
    scroll-snap-align: start;
    transition: transform .25s ease, box-shadow .25s ease, border-color .25s ease;
  }

  #{{ section_id }} .cr-card:hover {
    {% if section.settings.hover_lift %}
      transform: translateY(-4px);
      box-shadow: 0 27px 62px -38px rgba(20, 37, 25, .5);
    {% endif %}
  }

  #{{ section_id }} .cr-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    min-height: 28px;
  }

  #{{ section_id }} .cr-stars {
    color: var(--cr-accent);
    font-size: 17px;
    line-height: 1;
    letter-spacing: 2px;
    white-space: nowrap;
  }

  #{{ section_id }} .cr-badge {
    max-width: 58%;
    padding: 6px 10px;
    border-radius: 999px;
    background: var(--cr-badge-bg);
    color: var(--cr-badge-text);
    font-size: 10px;
    font-weight: 800;
    line-height: 1.2;
    letter-spacing: .04em;
    text-transform: uppercase;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  #{{ section_id }} .cr-review {
    position: relative;
    display: flex;
    flex: 0 1 auto;
    flex-direction: column;
    min-width: 0;
    margin: 22px 0 18px;
  }

  #{{ section_id }} .cr-mark {
    position: absolute;
    z-index: 0;
    top: -27px;
    left: -3px;
    color: var(--cr-accent);
    opacity: .10;
    font: 700 80px/1 Georgia, serif;
    pointer-events: none;
  }

  /* Absichtlich keine blockquote-Tags: So können globale Dawn-/Theme-Regeln
     keine schmale Spalte oder senkrechte Linie mehr erzeugen. */
  #{{ section_id }} .cr-copy {
    position: relative;
    z-index: 1;
    display: block !important;
    width: 100% !important;
    max-width: none !important;
    margin: 0 !important;
    padding: 0 !important;
    border: 0 !important;
    border-left: 0 !important;
    color: var(--cr-text) !important;
    font-family: var(--mgu-font-heading, Georgia, serif);
    font-size: {{ section.settings.quote_size }}px;
    font-style: italic;
    font-weight: 400;
    line-height: 1.58;
    white-space: normal !important;
    overflow-wrap: break-word;
    word-break: normal;
  }

  #{{ section_id }}.has-read-more .cr-copy[data-cr-copy]:not(.is-expanded):not(.is-short) {
    display: -webkit-box !important;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: var(--cr-excerpt-lines);
    overflow: hidden;
  }

  #{{ section_id }} .cr-toggle {
    display: none;
    align-items: center;
    align-self: flex-start;
    gap: 8px;
    margin-top: 17px;
    padding: 10px 16px;
    border: 1px solid var(--cr-button-bg);
    border-radius: 999px;
    background: var(--cr-button-bg);
    color: var(--cr-button-text);
    font-family: inherit;
    font-size: 13px;
    font-weight: 800;
    line-height: 1;
    list-style: none;
    cursor: pointer;
    transition: background .2s ease, color .2s ease, transform .2s ease;
  }

  #{{ section_id }} .cr-toggle:not([hidden]) {
    display: inline-flex;
  }

  #{{ section_id }} .cr-toggle::-webkit-details-marker {
    display: none;
  }

  #{{ section_id }} .cr-toggle::marker {
    display: none;
    content: "";
  }

  #{{ section_id }} .cr-toggle::after {
    content: "+";
    font-size: 17px;
    font-weight: 500;
    line-height: .8;
  }

  #{{ section_id }} .cr-toggle[aria-expanded="true"]::after {
    content: "−";
  }

  #{{ section_id }} .cr-toggle:hover {
    background: var(--cr-button-hover-bg);
    color: var(--cr-button-hover-text);
    transform: translateY(-1px);
  }

  #{{ section_id }} .cr-close-label {
    display: none;
  }

  #{{ section_id }} .cr-toggle[aria-expanded="true"] .cr-open-label {
    display: none;
  }

  #{{ section_id }} .cr-toggle[aria-expanded="true"] .cr-close-label {
    display: inline;
  }

  #{{ section_id }} .cr-author {
    display: flex;
    align-items: center;
    gap: 13px;
    margin-top: 0;
    padding-top: 17px;
    border-top: 1px solid var(--cr-border);
  }

  #{{ section_id }} .cr-avatar {
    width: 48px;
    height: 48px;
    min-width: 48px;
    display: grid;
    place-items: center;
    border-radius: {% if section.settings.avatar_style == 'square' %}13px{% else %}50%{% endif %};
    background: {{ section.settings.avatar_bg }};
    color: var(--cr-accent);
    object-fit: cover;
    font-size: 13px;
    font-weight: 800;
  }

  #{{ section_id }} .cr-author strong {
    display: block;
    color: var(--cr-heading);
    font-size: 15px;
    line-height: 1.3;
  }

  #{{ section_id }} .cr-author small {
    display: block;
    margin-top: 3px;
    color: var(--cr-muted);
    font-size: 13px;
    line-height: 1.45;
  }

  @media (max-width: 990px) {
    #{{ section_id }} .cr-grid {
      grid-template-columns: repeat({{ section.settings.columns_tablet }}, minmax(0, 1fr));
    }

  }

  @media (max-width: 680px) {
    #{{ section_id }} {
      padding: {{ section.settings.padding_top_mobile }}px 0 {{ section.settings.padding_bottom_mobile }}px;
    }

    #{{ section_id }} .cr-wrap {
      width: min(100% - 28px, 1240px);
    }

    #{{ section_id }} .cr-head {
      margin-bottom: 25px;
    }

    #{{ section_id }} .cr-grid {
      grid-template-columns: 1fr;
      gap: 16px;
    }

    #{{ section_id }}.is-slider .cr-grid {
      grid-auto-columns: min(88vw, 390px);
    }

    #{{ section_id }} .cr-card {
      min-height: 0;
      padding: 22px;
    }

    #{{ section_id }} .cr-copy {
      font-size: {{ section.settings.quote_size_mobile }}px;
      line-height: 1.55;
    }

    #{{ section_id }} .cr-badge {
      max-width: 52%;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    #{{ section_id }} .cr-card,
    #{{ section_id }} .cr-toggle {
      transition: none;
    }
  }
</style>

<section
  id="{{ section_id }}"
  class="chel-reviews{% if section.settings.layout == 'slider' %} is-slider{% endif %}{% if read_more_enabled %} has-read-more{% endif %}"
  data-mgu-effect="{{ section.settings.effect | default: 'up' }}"
  data-mgu-speed="{{ section.settings.effect_speed | default: 'normal' }}"
>
  <div class="cr-wrap">
    <header class="cr-head{% if section.settings.heading_align == 'center' %} is-center{% endif %}">
      {% if section.settings.eyebrow != blank %}
        <div class="cr-kicker">{{ section.settings.eyebrow | escape }}</div>
      {% endif %}
      {% if section.settings.heading != blank %}
        <h2>{{ section.settings.heading }}</h2>
      {% endif %}
      {% if section.settings.intro != blank %}
        <div class="cr-intro">{{ section.settings.intro }}</div>
      {% endif %}
    </header>

    <div class="cr-grid" role="list">
      {% for block in section.blocks %}
        {%- assign plain_review = block.settings.zitat | strip_html | strip -%}

        <article class="cr-card" role="listitem" {{ block.shopify_attributes }}>
          <div class="cr-top">
            <div class="cr-stars" aria-label="{{ block.settings.sterne }} von 5 Sternen">
              {% for i in (1..5) %}{% if i <= block.settings.sterne %}★{% else %}☆{% endif %}{% endfor %}
            </div>
            {% if block.settings.badge != blank %}
              <span class="cr-badge">{{ block.settings.badge | escape }}</span>
            {% elsif block.settings.verified_purchase %}
              <span class="cr-badge">{{ section.settings.verified_label | escape }}</span>
            {% endif %}
          </div>

          <div class="cr-review">
            {% if section.settings.show_quote_mark %}
              <span class="cr-mark" aria-hidden="true">“</span>
            {% endif %}

            <div
              id="ReviewText-{{ section.id }}-{{ block.id }}"
              class="cr-copy"
              {% if read_more_enabled %}data-cr-copy{% endif %}
            >„{{ plain_review | escape }}“</div>
            {% if read_more_enabled %}
              <button
                class="cr-toggle"
                type="button"
                aria-expanded="false"
                aria-controls="ReviewText-{{ section.id }}-{{ block.id }}"
                data-cr-toggle
                hidden
              >
                <span class="cr-open-label">{{ section.settings.read_more_label | escape }}</span>
                <span class="cr-close-label">{{ section.settings.read_less_label | escape }}</span>
              </button>
            {% endif %}
          </div>

          {% if block.settings.foto != blank or block.settings.name != blank or block.settings.zusatz != blank or block.settings.position != blank or block.settings.company != blank %}
            <div class="cr-author">
              {% if block.settings.foto != blank %}
                {{ block.settings.foto | image_url: width: 160 | image_tag: class: 'cr-avatar', loading: 'lazy', widths: '80,120,160', alt: block.settings.name }}
              {% elsif section.settings.show_initials and block.settings.name != blank %}
                <span class="cr-avatar" aria-hidden="true">{{ block.settings.name | slice: 0 | upcase }}</span>
              {% endif %}
              <div>
                {% if block.settings.name != blank %}<strong>{{ block.settings.name | escape }}</strong>{% endif %}
                {% if block.settings.position != blank or block.settings.company != blank %}
                  <small>
                    {{ block.settings.position | escape }}{% if block.settings.position != blank and block.settings.company != blank %}, {% endif %}{{ block.settings.company | escape }}
                  </small>
                {% endif %}
                {% if block.settings.zusatz != blank %}<small>{{ block.settings.zusatz | escape }}</small>{% endif %}
              </div>
            </div>
          {% endif %}
        </article>
      {% endfor %}
    </div>
  </div>
</section>

<script>
  (() => {
    const root = document.getElementById({{ section_id | json }});
    if (!root || root.dataset.crInitialized === 'true') return;

    root.dataset.crInitialized = 'true';
    root.classList.add('cr-js');

    const assessCopy = (copy) => {
      const button = root.querySelector(`[aria-controls="${copy.id}"]`);
      if (!button) return;

      const wasExpanded = button.getAttribute('aria-expanded') === 'true';
      copy.classList.remove('is-short', 'is-expanded');
      const isOverflowing = copy.scrollHeight > copy.clientHeight + 1;

      if (isOverflowing) {
        button.hidden = false;
        if (wasExpanded) copy.classList.add('is-expanded');
      } else {
        copy.classList.add('is-short');
        button.hidden = true;
        button.setAttribute('aria-expanded', 'false');
      }
    };

    const assessAll = () => root.querySelectorAll('[data-cr-copy]').forEach(assessCopy);

    root.addEventListener('click', (event) => {
      const button = event.target.closest('[data-cr-toggle]');
      if (!button || !root.contains(button)) return;

      const copy = document.getElementById(button.getAttribute('aria-controls'));
      if (!copy) return;

      const expanded = button.getAttribute('aria-expanded') === 'true';
      button.setAttribute('aria-expanded', String(!expanded));
      copy.classList.toggle('is-expanded', !expanded);
    });

    requestAnimationFrame(assessAll);
    if (document.fonts?.ready) document.fonts.ready.then(assessAll);

    if ('ResizeObserver' in window) {
      let resizeFrame;
      const observer = new ResizeObserver(() => {
        cancelAnimationFrame(resizeFrame);
        resizeFrame = requestAnimationFrame(assessAll);
      });
      observer.observe(root.querySelector('.cr-grid'));
    }
  })();
</script>

{% schema %}
{
  "name": "Chelonaki – Kundenstimmen",
  "settings": [
    { "type": "header", "content": "Scroll-Effekt" },
    { "type": "select", "id": "effect", "label": "Erscheinen beim Scrollen", "default": "up", "options": [
      { "value": "none", "label": "Kein Effekt" },
      { "value": "fade", "label": "Einblenden" },
      { "value": "up", "label": "Von unten (Standard)" },
      { "value": "left", "label": "Von links" },
      { "value": "right", "label": "Von rechts" },
      { "value": "zoom", "label": "Sanfter Zoom" },
      { "value": "blur", "label": "Aus der Unschärfe" }
    ] },
    { "type": "select", "id": "effect_speed", "label": "Effekt-Tempo", "default": "normal", "options": [
      { "value": "schnell", "label": "Schnell" },
      { "value": "normal", "label": "Normal" },
      { "value": "langsam", "label": "Langsam" }
    ] },

    { "type": "header", "content": "Inhalt" },
    { "type": "text", "id": "eyebrow", "label": "Kicker-Zeile", "default": "Stimmen" },
    { "type": "inline_richtext", "id": "heading", "label": "Überschrift", "default": "Was Leser und Teilnehmer <em>sagen.</em>" },
    { "type": "richtext", "id": "intro", "label": "Einleitung" },
    { "type": "select", "id": "heading_align", "label": "Ausrichtung der Überschrift", "default": "left", "options": [
      { "value": "left", "label": "Links" },
      { "value": "center", "label": "Mittig" }
    ] },

    { "type": "header", "content": "Darstellung" },
    { "type": "select", "id": "layout", "label": "Darstellungsart", "default": "grid", "options": [
      { "value": "grid", "label": "Raster" },
      { "value": "slider", "label": "Horizontaler Slider" }
    ] },
    { "type": "range", "id": "columns_desktop", "label": "Spalten auf Desktop", "min": 1, "max": 4, "step": 1, "default": 3 },
    { "type": "select", "id": "columns_tablet", "label": "Spalten auf Tablet", "default": "2", "options": [
      { "value": "1", "label": "1 Spalte" },
      { "value": "2", "label": "2 Spalten" }
    ] },
    { "type": "range", "id": "gap", "label": "Abstand zwischen Karten", "min": 8, "max": 48, "step": 2, "unit": "px", "default": 22 },
    { "type": "range", "id": "card_padding", "label": "Innenabstand der Karten", "min": 18, "max": 44, "step": 2, "unit": "px", "default": 28 },
    { "type": "range", "id": "card_radius", "label": "Abrundung der Karten", "min": 0, "max": 36, "step": 2, "unit": "px", "default": 22 },
    { "type": "range", "id": "quote_size", "label": "Größe des Zitattexts Desktop", "min": 15, "max": 22, "step": 1, "unit": "px", "default": 17 },
    { "type": "range", "id": "quote_size_mobile", "label": "Größe des Zitattexts Mobile", "min": 15, "max": 20, "step": 1, "unit": "px", "default": 16 },
    { "type": "checkbox", "id": "show_shadow", "label": "Kartenschatten anzeigen", "default": true },
    { "type": "checkbox", "id": "hover_lift", "label": "Karten beim Darüberfahren anheben", "default": true },
    { "type": "checkbox", "id": "show_quote_mark", "label": "Großes Anführungszeichen anzeigen", "default": true },
    { "type": "checkbox", "id": "show_initials", "label": "Initialen anzeigen, wenn kein Foto vorhanden ist", "default": true },
    { "type": "select", "id": "avatar_style", "label": "Form der Autorenbilder", "default": "round", "options": [
      { "value": "round", "label": "Rund" },
      { "value": "square", "label": "Abgerundetes Quadrat" }
    ] },

    { "type": "header", "content": "Lange Kundenstimmen" },
    { "type": "checkbox", "id": "enable_read_more", "label": "Lange Texte einklappen", "default": true },
    { "type": "range", "id": "excerpt_lines", "label": "Sichtbare Textzeilen vor Weiterlesen", "min": 3, "max": 12, "step": 1, "default": 6 },
    { "type": "text", "id": "read_more_label", "label": "Beschriftung Weiterlesen", "default": "Weiterlesen" },
    { "type": "text", "id": "read_less_label", "label": "Beschriftung Einklappen", "default": "Weniger anzeigen" },
    { "type": "text", "id": "verified_label", "label": "Beschriftung verifizierter Kauf", "default": "Verifizierter Kauf" },

    { "type": "header", "content": "Abstände" },
    { "type": "range", "id": "padding_top", "label": "Abstand oben Desktop", "min": 20, "max": 140, "step": 10, "unit": "px", "default": 60 },
    { "type": "range", "id": "padding_bottom", "label": "Abstand unten Desktop", "min": 20, "max": 140, "step": 10, "unit": "px", "default": 60 },
    { "type": "range", "id": "padding_top_mobile", "label": "Abstand oben Mobile", "min": 20, "max": 100, "step": 10, "unit": "px", "default": 40 },
    { "type": "range", "id": "padding_bottom_mobile", "label": "Abstand unten Mobile", "min": 20, "max": 100, "step": 10, "unit": "px", "default": 40 },

    { "type": "header", "content": "Farben" },
    { "type": "color", "id": "bg", "label": "Bereichshintergrund", "default": "#FBF8F0" },
    { "type": "color", "id": "heading_color", "label": "Überschriften", "default": "#1F3A2A" },
    { "type": "color", "id": "text_color", "label": "Zitattext", "default": "#24352E" },
    { "type": "color", "id": "muted_color", "label": "Zusatztext", "default": "#66756D" },
    { "type": "color", "id": "card_bg", "label": "Kartenhintergrund", "default": "#FFFDF8" },
    { "type": "color", "id": "card_border", "label": "Kartenrahmen", "default": "#D8DDD8" },
    { "type": "color", "id": "star_color", "label": "Sterne und Akzente", "default": "#B9912F" },
    { "type": "color", "id": "badge_bg", "label": "Badge-Hintergrund", "default": "#F3EDDF" },
    { "type": "color", "id": "badge_text", "label": "Badge-Schrift", "default": "#1F3A2A" },
    { "type": "color", "id": "avatar_bg", "label": "Hintergrund Initialen", "default": "#F3EDDF" },
    { "type": "color", "id": "button_bg", "label": "Weiterlesen-Akzent", "default": "#1F3A2A" },
    { "type": "color", "id": "button_text", "label": "Weiterlesen-Schrift", "default": "#FFFFFF" },
    { "type": "color", "id": "button_hover_bg", "label": "Button Hover-Hintergrund", "default": "#142519" },
    { "type": "color", "id": "button_hover_text", "label": "Button Hover-Schrift", "default": "#FFFFFF" }
  ],
  "blocks": [
    {
      "type": "stimme",
      "name": "Kundenstimme",
      "settings": [
        { "type": "range", "id": "sterne", "label": "Sterne", "min": 0, "max": 5, "step": 1, "default": 5 },
        { "type": "textarea", "id": "zitat", "label": "Zitat", "default": "Endlich ein Ernährungsbuch, das ich wirklich im Alltag nutze. Die Rezepte schmecken der ganzen Familie." },
        { "type": "text", "id": "name", "label": "Name", "default": "Sabine K." },
