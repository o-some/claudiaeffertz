{% style %}
  #shopify-section-{{ section.id }} {
    margin-block-start: {{ section.settings.section_gap_top | default: 0 }}px;
    margin-block-end: {{ section.settings.section_gap_bottom | default: 0 }}px;
  }
{% endstyle %}

{% schema %}
{
  "name": "Chelonaki · Scrollstory",
  "tag": "section",
  "class": "fi-scroll-story-section",
  "max_blocks": 8,
  "settings": [
    { "type": "select", "id": "first_heading_level", "label": "Ebene der ersten Überschrift", "default": "h2", "options": [{ "value": "h1", "label": "H1 – Hauptüberschrift der Seite" }, { "value": "h2", "label": "H2 – Untergeordneter Abschnitt" }] },
    {"type":"header","content":"Abstand zum nächsten Abschnitt"},
    {"type":"range","id":"section_gap_top","label":"Zusätzlicher Abstand oben","min":0,"max":200,"step":4,"unit":"px","default":0},
    {"type":"range","id":"section_gap_bottom","label":"Zusätzlicher Abstand unten","min":0,"max":200,"step":4,"unit":"px","default":0},
    {
      "type": "image_picker",
      "id": "poster_image",
      "label": "Statisches Ersatz-/Posterbild"
    },
    {
      "type": "text",
      "id": "poster_alt",
      "label": "Bildbeschreibung",
      "default": "Kochszene: Steak mit Selleriepüree wird zubereitet"
    },
    {
      "type": "text",
      "id": "loading_text",
      "label": "Ladetext",
      "default": "Animation wird vorbereitet …"
    },
    {
      "type": "checkbox",
      "id": "animate_mobile",
      "label": "Frame-Animation auf Mobilgeräten laden",
      "default": true,
      "info": "Auf Mobilgeräten wird automatisch eine optimierte Frame-Auswahl verwendet."
    },
    {
      "type": "range",
      "id": "scroll_length",
      "label": "Länge der Scroll-Animation",
      "min": 220,
      "max": 520,
      "step": 20,
      "unit": "vh",
      "default": 420,
      "info": "Bei reduzierter Bewegung wird automatisch nur das statische Bild gezeigt."
    },
    {
      "type": "header",
      "content": "Farben dieses Moduls"
    },
    {
      "type": "color",
      "id": "module_bg",
      "label": "Modul-Hintergrund",
      "default": "#142519"
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Überschriften in den Karten",
      "default": "#FBF8F0"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Allgemeine Schrift",
      "default": "#FBF8F0"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Kicker / hervorgehobener Text",
      "default": "#D9BC6A"
    },
    {
      "type": "color",
      "id": "panel_bg",
      "label": "Textkarten-Hintergrund",
      "default": "#142519"
    },
    {
      "type": "color",
      "id": "panel_border",
      "label": "Textkarten-Rahmen",
      "default": "#6E5B2A"
    },
    {
      "type": "color",
      "id": "progress_start",
      "label": "Fortschrittsbalken – Startfarbe",
      "default": "#B9912F"
    },
    {
      "type": "color",
      "id": "progress_end",
      "label": "Fortschrittsbalken – Endfarbe",
      "default": "#D9BC6A"
    },
    {
      "type": "color",
      "id": "loading_text_color",
      "label": "Ladeanzeige-Schrift",
      "default": "#EFEAD9"
    }
  ],
  "blocks": [
    {
      "type": "caption",
      "name": "Texteinblendung",
      "settings": [
        {
          "type": "text",
          "id": "kicker",
          "label": "Kleine Überschrift"
        },
        {
          "type": "inline_richtext",
          "id": "heading",
          "label": "Überschrift",
          "default": "Eine <em>starke Aussage.</em>"
        },
        {
          "type": "range",
          "id": "from_percent",
          "label": "Text erscheint ab",
          "min": 0,
          "max": 100,
          "step": 1,
          "unit": "%",
          "default": 0,
          "info": "0 % = Anfang der Animation, 50 % = Mitte, 100 % = Ende. Bei 96 Bildern entspricht 50 % ungefähr Frame 48."
        },
        {
          "type": "range",
          "id": "to_percent",
          "label": "Text bleibt sichtbar bis",
          "min": 0,
          "max": 100,
          "step": 1,
          "unit": "%",
          "default": 25,
          "info": "Dieser Wert muss höher als der Startwert sein. Beispiel: 20–45 % zeigt den Text ungefähr von Frame 20 bis Frame 44."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Chelonaki · Scrollstory",
      "blocks": [
        {
          "type": "caption",
          "settings": {
            "kicker": "Aus der Longevity-Küche",
            "heading": "Gute Küche beginnt mit <em>ehrlichen Zutaten.</em>",
            "from_percent": 0,
            "to_percent": 26
          }
        },
        {
          "type": "caption",
          "settings": {
            "kicker": "Handwerk statt Hektik",
            "heading": "Einfach zubereitet. <em>Bewusst genossen.</em>",
            "from_percent": 30,
            "to_percent": 55
          }
        },
        {
          "type": "caption",
          "settings": {
            "kicker": "Rezept aus dem Buch",
            "heading": "Steak mit Selleriepüree – <em>Genuss, der bleibt.</em>",
            "from_percent": 60,
            "to_percent": 85
          }
        },
        {
          "type": "caption",
          "settings": {
            "kicker": "Food Instructor MGU®",
            "heading": "So schmeckt <em>die Longevity-Küche.</em>",
            "from_percent": 88,
            "to_percent": 100
          }
        }
      ]
    }
  ]
}
{% endschema %}
