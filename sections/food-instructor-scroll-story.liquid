<section class="fi-scroll-story" id="FiStory" data-fi-scroll-story style="--fi-scroll-length:{{ section.settings.scroll_length }}vh;--fi-module-bg:{{ section.settings.module_bg }};--fi-heading-color:{{ section.settings.heading_color }};--fi-text-color:{{ section.settings.text_color }};--fi-accent-color:{{ section.settings.accent_color }};--fi-panel-bg:{{ section.settings.panel_bg }};--fi-panel-border:{{ section.settings.panel_border }};--fi-progress-start:{{ section.settings.progress_start }};--fi-progress-end:{{ section.settings.progress_end }};--fi-loading-text-color:{{ section.settings.loading_text_color }}">
  <span hidden data-fi-mobile-animation="{{ section.settings.animate_mobile }}"></span>
  <div class="fi-scroll-stage">
    <div class="fi-scroll-media">
      {% if section.settings.poster_image != blank %}
        {{ section.settings.poster_image | image_url: width: 1800 | image_tag: class: 'fi-scroll-poster', widths: '600, 900, 1200, 1500, 1800', sizes: '100vw', loading: 'lazy', alt: section.settings.poster_alt }}
      {% else %}
        <img class="fi-scroll-poster" src="{{ 'fi-frame-001.jpg' | asset_url }}" width="1080" height="608" loading="lazy" decoding="async" alt="{{ section.settings.poster_alt | escape }}">
      {% endif %}
      <canvas class="fi-scroll-canvas" data-fi-canvas aria-hidden="true"></canvas>
      <div class="fi-scroll-shade" aria-hidden="true"></div>
      <span class="fi-scroll-loading" data-fi-loading role="status">{{ section.settings.loading_text | escape }}</span>
    </div>

    <div class="fi-scroll-captions" data-fi-captions>
      {% if section.blocks.size > 0 %}
        {% for block in section.blocks %}
          <article
            class="fi-scroll-caption"
            data-from="{{ block.settings.from_percent | divided_by: 100.0 }}"
            data-to="{{ block.settings.to_percent | divided_by: 100.0 }}"
            {{ block.shopify_attributes }}
          >
            <div class="fi-scroll-panel">
              {% if block.settings.kicker != blank %}<span class="fi-scroll-kicker">{{ block.settings.kicker | escape }}</span>{% endif %}
              {%- assign caption_heading_tag = 'h2' -%}
              {%- if forloop.first and section.settings.first_heading_level == 'h1' -%}{%- assign caption_heading_tag = 'h1' -%}{%- endif -%}
              <{{ caption_heading_tag }}>{{ block.settings.heading }}</{{ caption_heading_tag }}>
            </div>
          </article>
        {% endfor %}
      {% else %}
        <article class="fi-scroll-caption" data-from="0" data-to="0.26"><div class="fi-scroll-panel"><span class="fi-scroll-kicker">Aus der Longevity-Küche</span>{% if section.settings.first_heading_level == 'h1' %}<h1>Gute Küche beginnt mit <em>ehrlichen Zutaten.</em></h1>{% else %}<h2>Gute Küche beginnt mit <em>ehrlichen Zutaten.</em></h2>{% endif %}</div></article>
        <article class="fi-scroll-caption" data-from="0.30" data-to="0.55"><div class="fi-scroll-panel"><span class="fi-scroll-kicker">Handwerk statt Hektik</span><h2>Einfach zubereitet. <em>Bewusst genossen.</em></h2></div></article>
        <article class="fi-scroll-caption" data-from="0.60" data-to="0.85"><div class="fi-scroll-panel"><span class="fi-scroll-kicker">Rezept aus dem Buch</span><h2>Steak mit Selleriepüree – <em>Genuss, der bleibt.</em></h2></div></article>
        <article class="fi-scroll-caption" data-from="0.88" data-to="1.01"><div class="fi-scroll-panel"><span class="fi-scroll-kicker">Food Instructor MGU®</span><h2>So schmeckt <em>die Longevity-Küche.</em></h2></div></article>
      {% endif %}
    </div>
    <div class="fi-scroll-progress" aria-hidden="true"><i data-fi-progress></i></div>
  </div>

