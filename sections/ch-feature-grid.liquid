<section class="ch-section ch-feature-grid" id="ChFeatureGrid-{{ section.id }}" style="--ch-columns:{{ section.settings.columns }};--ch-radius:{{ settings.ch_radius | default: 22 }}px">
  <div class="ch-shell">
    {% if section.settings.eyebrow != blank %}<p>{{ section.settings.eyebrow | escape }}</p>{% endif %}
    {% if section.settings.heading != blank %}<h2>{{ section.settings.heading }}</h2>{% endif %}
    <div class="ch-feature-grid__items">
      {% for block in section.blocks %}
        <article class="ch-feature-card" {{ block.shopify_attributes }}>
          {% if block.settings.heading != blank %}<h3>{{ block.settings.heading | escape }}</h3>{% endif %}
          <div class="rte">{{ block.settings.text }}</div>
          {% if block.settings.link_label != blank and block.settings.link != blank %}<a href="{{ block.settings.link }}">{{ block.settings.link_label | escape }}</a>{% endif %}
        </article>
      {% endfor %}
    </div>
  </div>
</section>

{% style %}
  #shopify-section-{{ section.id }} {
    margin-block-start: {{ section.settings.section_gap_top | default: 0 }}px;
    margin-block-end: {{ section.settings.section_gap_bottom | default: 0 }}px;
  }
{% endstyle %}

{% schema %}
{
  "name": "Chelonaki – Vorteile",
  "tag": "section",
  "class": "ch-feature-grid-section",
  "max_blocks": 8,
  "settings": [
    {"type":"header","content":"Abstand zum nächsten Abschnitt"},
    {"type":"range","id":"section_gap_top","label":"Zusätzlicher Abstand oben","min":0,"max":200,"step":4,"unit":"px","default":0},
    {"type":"range","id":"section_gap_bottom","label":"Zusätzlicher Abstand unten","min":0,"max":200,"step":4,"unit":"px","default":0},
    { "type": "text", "id": "eyebrow", "label": "Kleine Überschrift" },
    { "type": "inline_richtext", "id": "heading", "label": "Überschrift", "default": "Was uns auszeichnet" },
    { "type": "range", "id": "columns", "label": "Spalten", "min": 1, "max": 4, "step": 1, "default": 3 }
  ],
  "blocks": [{
    "type": "feature",
    "name": "Vorteil",
    "settings": [
      { "type": "text", "id": "heading", "label": "Überschrift", "default": "Ein Vorteil" },
      { "type": "richtext", "id": "text", "label": "Text", "default": "<p>Erkläre den Vorteil kurz und verständlich.</p>" },
      { "type": "text", "id": "link_label", "label": "Link-Text" },
      { "type": "url", "id": "link", "label": "Link" }
    ]
  }],
  "presets": [{ "name": "Chelonaki – Vorteile", "blocks": [{ "type": "feature" }, { "type": "feature" }, { "type": "feature" }] }]
}
{% endschema %}
