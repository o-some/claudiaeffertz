<script src="{{ 'ch-advisory-quiz.js' | asset_url }}" defer="defer"></script>
<form class="ch-section page-width" data-ch-quiz id="ChQuiz-{{ section.id }}"><h2>{{ section.settings.heading | escape }}</h2><p>{{ section.settings.intro | escape }}</p><progress data-ch-quiz-progress max="{{ section.blocks.size }}" value="1"><span class="visually-hidden">Fortschritt</span></progress>
{% for block in section.blocks %}<fieldset data-ch-quiz-step{% unless forloop.first %} hidden{% endunless %} {{ block.shopify_attributes }}><legend>{{ block.settings.question | escape }}</legend><label><input type="radio" name="q-{{ block.id }}" value="a" required> {{ block.settings.answer_a | escape }}</label><label><input type="radio" name="q-{{ block.id }}" value="b"> {{ block.settings.answer_b | escape }}</label><div>{% unless forloop.first %}<button type="button" data-ch-quiz-action="back">{{ section.settings.back_label | escape }}</button>{% endunless %}{% unless forloop.last %}<button type="button" data-ch-quiz-action="next">{{ section.settings.next_label | escape }}</button>{% else %}<a class="button" href="{{ section.settings.result_link }}">{{ section.settings.result_label | escape }}</a>{% endunless %}</div></fieldset>{% endfor %}<button type="button" data-ch-quiz-action="restart">{{ section.settings.restart_label | escape }}</button></form>
{% style %}
  #shopify-section-{{ section.id }} {
    margin-block-start: {{ section.settings.section_gap_top | default: 0 }}px;
    margin-block-end: {{ section.settings.section_gap_bottom | default: 0 }}px;
  }
{% endstyle %}

{% schema %}{"name":"CH Beratungsquiz","settings":[
    {"type":"header","content":"Abstand zum nächsten Abschnitt"},
    {"type":"range","id":"section_gap_top","label":"Zusätzlicher Abstand oben","min":0,"max":200,"step":4,"unit":"px","default":0},
    {"type":"range","id":"section_gap_bottom","label":"Zusätzlicher Abstand unten","min":0,"max":200,"step":4,"unit":"px","default":0},{"type":"text","id":"heading","label":"Überschrift","default":"Was passt zu dir?"},{"type":"text","id":"intro","label":"Einleitung","default":"Eine Orientierung anhand deiner Antworten – keine medizinische Beratung."},{"type":"text","id":"back_label","label":"Zurück","default":"Zurück"},{"type":"text","id":"next_label","label":"Weiter","default":"Weiter"},{"type":"text","id":"restart_label","label":"Neustart","default":"Neu beginnen"},{"type":"url","id":"result_link","label":"Ergebnis-Link"},{"type":"text","id":"result_label","label":"Ergebnis-Linktext","default":"Auswahl ansehen"}],"blocks":[{"type":"question","name":"Frage","settings":[{"type":"text","id":"question","label":"Frage"},{"type":"text","id":"answer_a","label":"Antwort A"},{"type":"text","id":"answer_b","label":"Antwort B"}]}],"presets":[{"name":"CH Beratungsquiz","blocks":[{"type":"question"},{"type":"question"}]}]}{% endschema %}
