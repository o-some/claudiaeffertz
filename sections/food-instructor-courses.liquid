<section class="fi-block fi-courses" id="FiCourses" data-fi-reveal-scope style="--fi-module-bg:{{ section.settings.module_bg }};--fi-heading-color:{{ section.settings.heading_color }};--fi-text-color:{{ section.settings.text_color }};--fi-accent-color:{{ section.settings.accent_color }};--fi-banner-heading:{{ section.settings.banner_heading_color }};--fi-banner-emphasis:{{ section.settings.banner_emphasis_color }};--fi-banner-text:{{ section.settings.banner_text }};--fi-overlay-color:{{ section.settings.overlay_color }};--fi-badge-bg:{{ section.settings.badge_bg }};--fi-badge-text:{{ section.settings.badge_text }};--fi-input-bg:{{ section.settings.input_bg }};--fi-input-text:{{ section.settings.input_text }};--fi-input-placeholder:{{ section.settings.input_placeholder }};--fi-input-border:{{ section.settings.input_border }};--fi-button-bg:{{ section.settings.button_bg }};--fi-button-text:{{ section.settings.button_text }};--fi-button-hover-bg:{{ section.settings.button_hover_bg }};--fi-button-hover-text:{{ section.settings.button_hover_text }};--fi-success-text:{{ section.settings.success_color }};--fi-error-text:{{ section.settings.error_text }}">
  <div class="fi-wrap">
    <div class="fi-section-head fi-section-head--center fi-reveal">
      {% if section.settings.eyebrow != blank %}<span class="fi-eyebrow">{{ section.settings.eyebrow | escape }}</span>{% endif %}
      <h2>{{ section.settings.heading }}</h2>
    </div>

    <div class="fi-course-banner fi-reveal">
      {% if section.settings.image != blank %}
        {{ section.settings.image | image_url: width: 2000 | image_tag: class: 'fi-course-image', widths: '600, 900, 1200, 1600, 2000', sizes: '(max-width: 1180px) 100vw, 1180px', loading: 'lazy', alt: section.settings.image_alt }}
      {% else %}
        <img class="fi-course-image" src="{{ 'fi-static-011.jpg' | asset_url }}" width="1280" height="720" loading="lazy" decoding="async" alt="{{ section.settings.image_alt | escape }}">
      {% endif %}
      <div class="fi-course-content">
        {% if section.settings.badge != blank %}<span class="fi-badge-soon">{{ section.settings.badge | escape }}</span>{% endif %}
        <h3>{{ section.settings.banner_heading }}</h3>
        <div class="rte">{{ section.settings.text }}</div>

        {%- assign fi_course_form_id = 'FiCourseForm-' | append: section.id -%}
        {% form 'customer', id: fi_course_form_id, class: 'fi-course-form' %}
          <input type="hidden" name="contact[tags]" value="{{ section.settings.customer_tags | escape }}">
          {% if form.posted_successfully? %}
            <p class="fi-form-success" role="status">{{ section.settings.success_text | escape }}</p>
          {% else %}
            <label class="visually-hidden" for="FiEmail-{{ section.id }}">{{ section.settings.email_label | escape }}</label>
            <input id="FiEmail-{{ section.id }}" type="email" name="contact[email]" required autocomplete="email" placeholder="{{ section.settings.email_placeholder | escape }}" value="{% if customer %}{{ customer.email | escape }}{% endif %}" {% if form.errors %}aria-invalid="true" aria-describedby="FiErrors-{{ section.id }}"{% endif %}>
            <button class="fi-btn fi-btn--gold" type="submit">{{ section.settings.submit_label | escape }}</button>
            {% if form.errors %}<div class="fi-form-errors" id="FiErrors-{{ section.id }}" role="alert">{{ form.errors | default_errors }}</div>{% endif %}
          {% endif %}
        {% endform %}
      </div>
    </div>
  </div>
</section>

{% style %}
  #shopify-section-{{ section.id }} {
    margin-block-start: {{ section.settings.section_gap_top | default: 0 }}px;
    margin-block-end: {{ section.settings.section_gap_bottom | default: 0 }}px;
  }
{% endstyle %}

