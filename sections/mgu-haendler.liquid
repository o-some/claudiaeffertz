{% comment %} Chelonaki Shop Theme · © Chelonaki · Build: CHELONAKI-BUILD-0000-MASTER · Nutzung nur mit gültiger Lizenz {% endcomment %}

<style>
  .mgu-hd-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(260px,1fr));gap:20px}
  .mgu-hd{
    background:var(--mgu-paper);border:1px solid var(--mgu-line);border-radius:20px;padding:26px;
    display:flex;flex-direction:column;gap:8px;
    transition:transform .3s,box-shadow .3s;
  }
  .mgu-hd:hover{transform:translateY(-5px);box-shadow:0 22px 42px -24px rgba(20,37,25,.3)}
  .mgu-hd h3{font-size:1.2rem;color:var(--mgu-forest);margin:0}
  .mgu-hd p{color:var(--mgu-ink-soft);font-size:14.5px;margin:0;line-height:1.6}
  .mgu-hd a.mgu-hd-route{margin-top:auto;padding-top:12px;font-weight:600;font-size:14px;color:var(--mgu-gold);text-decoration:none}
  .mgu-hd a.mgu-hd-route:hover{text-decoration:underline;text-underline-offset:3px}
</style>

<section data-mgu-effect="{{ section.settings.effect | default: 'up' }}" data-mgu-speed="{{ section.settings.effect_speed | default: 'normal' }}" class="mgu mgu-block" style="background:{{ section.settings.bg }}">
  <div class="mgu-wrap">
    <div class="mgu-sec-head mgu-reveal">
      {%- if section.settings.eyebrow != blank -%}<span class="mgu-eyebrow">{{ section.settings.eyebrow }}</span>{%- endif -%}
      <h2>{{ section.settings.heading }}</h2>
    </div>
    <div class="mgu-hd-grid">
      {%- for block in section.blocks -%}
        <div class="mgu-hd mgu-reveal" {% if forloop.index > 1 %}style="transition-delay:{{ forloop.index0 | times: 0.07 }}s"{% endif %} {{ block.shopify_attributes }}>
          <h3>{{ block.settings.name }}</h3>
          <p>{{ block.settings.adresse | newline_to_br }}</p>
          {%- if block.settings.zeiten != blank -%}<p>🕐 {{ block.settings.zeiten }}</p>{%- endif -%}
          {%- if block.settings.telefon != blank -%}<p>📞 <a href="tel:{{ block.settings.telefon | remove: ' ' }}">{{ block.settings.telefon }}</a></p>{%- endif -%}
          <a class="mgu-hd-route" href="https://www.google.com/maps/search/?api=1&query={{ block.settings.name | append: ' ' | append: block.settings.adresse | url_encode }}" target="_blank" rel="noopener">{{ 'mgu.allgemein.route' | t }} →</a>
        </div>
      {%- endfor -%}
    </div>
  </div>
</section>

{% style %}
  #shopify-section-{{ section.id }} {
    margin-block-start: {{ section.settings.section_gap_top | default: 0 }}px;
    margin-block-end: {{ section.settings.section_gap_bottom | default: 0 }}px;
  }
{% endstyle %}

{% schema %}
{
  "name": "Chelonaki · Händlerfinder",
  "settings": [
    {"type":"header","content":"Abstand zum nächsten Abschnitt"},
    {"type":"range","id":"section_gap_top","label":"Zusätzlicher Abstand oben","min":0,"max":200,"step":4,"unit":"px","default":0},
    {"type":"range","id":"section_gap_bottom","label":"Zusätzlicher Abstand unten","min":0,"max":200,"step":4,"unit":"px","default":0},
    { "type": "header", "content": "Scroll-Effekt" },
    { "type": "select", "id": "effect", "label": "Erscheinen beim Scrollen", "default": "up", "options": [ { "value": "none", "label": "Kein Effekt" }, { "value": "fade", "label": "Einblenden" }, { "value": "up", "label": "Von unten (Standard)" }, { "value": "left", "label": "Von links" }, { "value": "right", "label": "Von rechts" }, { "value": "zoom", "label": "Sanfter Zoom" }, { "value": "blur", "label": "Aus der Unschärfe" } ] },
    { "type": "select", "id": "effect_speed", "label": "Effekt-Tempo", "default": "normal", "options": [ { "value": "schnell", "label": "Schnell" }, { "value": "normal", "label": "Normal" }, { "value": "langsam", "label": "Langsam" } ] },
    { "type": "text", "id": "eyebrow", "label": "Kicker-Zeile", "default": "Vor Ort" },
    { "type": "inline_richtext", "id": "heading", "label": "Überschrift", "default": "Hier findest du <em>unsere Partner.</em>" },
    { "type": "color", "id": "bg", "label": "Hintergrundfarbe", "default": "#F3EDDF" }
  ],
  "blocks": [
    {
      "type": "standort",
      "name": "Standort",
      "settings": [
        { "type": "text", "id": "name", "label": "Name", "default": "Buchhandlung Beispiel" },
        { "type": "textarea", "id": "adresse", "label": "Adresse", "default": "Hauptstraße 1\n69117 Heidelberg" },
        { "type": "text", "id": "zeiten", "label": "Öffnungszeiten", "default": "Mo–Sa 9–19 Uhr" },
        { "type": "text", "id": "telefon", "label": "Telefon" }
      ]
    }
  ],
  "presets": [{ "name": "Chelonaki – Händler-Finder", "blocks": [ { "type": "standort" }, { "type": "standort" }, { "type": "standort" } ] }]
}
{% endschema %}
