<section
  class="mgu-about-markus"
  id="MguAboutMarkus-{{ section.id }}"
  style="
    --about-bg:{{ section.settings.background }};
    --about-card:{{ section.settings.card_background }};
    --about-heading:{{ section.settings.heading_color }};
    --about-text:{{ section.settings.text_color }};
    --about-accent:{{ section.settings.accent_color }};
    --about-border:{{ section.settings.border_color }};
  "
>
  <div class="mgu-about-markus__hero">
    <div class="mgu-about-markus__intro">
      {% if section.settings.eyebrow != blank %}<p class="mgu-about-markus__eyebrow">{{ section.settings.eyebrow | escape }}</p>{% endif %}
      <h1>{{ section.settings.title | escape }}</h1>
      {% if section.settings.lead != blank %}<div class="mgu-about-markus__lead rte">{{ section.settings.lead }}</div>{% endif %}
    </div>

    <figure class="mgu-about-markus__portrait">
      {% if section.settings.image != blank %}
        {{ section.settings.image
          | image_url: width: 1600
          | image_tag:
            widths: '480, 720, 960, 1280, 1600',
            sizes: '(max-width: 760px) 100vw, 46vw',
            loading: 'eager',
            alt: section.settings.image_alt
        }}
      {% else %}
        <img
          src="https://cdn.shopify.com/s/files/1/1039/9167/3169/files/Familie.jpg?v=1778749318"
          alt="{{ section.settings.image_alt | escape }}"
          width="1600"
          height="1200"
          loading="eager"
        >
      {% endif %}
      {% if section.settings.image_caption != blank %}<figcaption>{{ section.settings.image_caption | escape }}</figcaption>{% endif %}
    </figure>
  </div>

  <div class="mgu-about-markus__story">
    <p class="mgu-about-markus__story-title">{{ section.settings.story_label | escape }}</p>
    <div class="mgu-about-markus__copy rte">{{ section.settings.story }}</div>
  </div>

  {% if section.settings.quote != blank %}
    <blockquote class="mgu-about-markus__quote">
      <p>{{ section.settings.quote | escape }}</p>
    </blockquote>
  {% endif %}
</section>

{% style %}
  body:not(.fi-home-active) #MainContent > #shopify-section-{{ section.id }},
  #shopify-section-{{ section.id }} {
    display: block !important;
    height: auto !important;
    opacity: 1 !important;
    visibility: visible !important;
    transform: none !important;
  }
  #MguAboutMarkus-{{ section.id }} {
    display: block;
    padding: clamp(54px, 8vw, 110px) clamp(18px, 4vw, 48px);
    background: var(--about-bg);
    color: var(--about-text);
  }
  #MguAboutMarkus-{{ section.id }} .mgu-about-markus__hero,
  #MguAboutMarkus-{{ section.id }} .mgu-about-markus__story,
  #MguAboutMarkus-{{ section.id }} .mgu-about-markus__quote {
    width: min(1180px, 100%);
    margin-inline: auto;
  }
  #MguAboutMarkus-{{ section.id }} .mgu-about-markus__hero {
    display: grid;
    grid-template-columns: minmax(0, .9fr) minmax(320px, 1.1fr);
    align-items: center;
    gap: clamp(36px, 7vw, 90px);
  }
  #MguAboutMarkus-{{ section.id }} .mgu-about-markus__eyebrow,
  #MguAboutMarkus-{{ section.id }} .mgu-about-markus__story-title {
    margin: 0 0 16px;
    color: var(--about-accent);
    font-size: 12px;
    font-weight: 800;
    letter-spacing: .2em;
    text-transform: uppercase;
  }
  #MguAboutMarkus-{{ section.id }} h1 {
    margin: 0;
    color: var(--about-heading);
    font-family: var(--fi-font-heading, Georgia, serif);
    font-size: clamp(4.2rem, 7vw, 7.6rem);
    line-height: .98;
    text-wrap: balance;
  }
  #MguAboutMarkus-{{ section.id }} .mgu-about-markus__lead {
    max-width: 560px;
    margin-top: 26px;
    font-size: clamp(1.7rem, 2vw, 2.1rem);
    line-height: 1.65;
  }
  #MguAboutMarkus-{{ section.id }} .mgu-about-markus__portrait {
    margin: 0;
  }
  #MguAboutMarkus-{{ section.id }} .mgu-about-markus__portrait img {
    display: block;
    width: 100%;
    height: clamp(280px, 42vw, 520px);
    aspect-ratio: 4 / 3;
    object-fit: cover;
    border-radius: 28px;
    box-shadow: 0 30px 70px rgba(20, 37, 25, .18);
  }
  #MguAboutMarkus-{{ section.id }} figcaption {
    margin-top: 12px;
    color: var(--about-text);
    font-size: 13px;
    opacity: .75;
  }
  #MguAboutMarkus-{{ section.id }} .mgu-about-markus__story {
    display: grid;
    grid-template-columns: minmax(170px, .35fr) minmax(0, 1fr);
    gap: clamp(28px, 6vw, 80px);
    margin-top: clamp(60px, 9vw, 120px);
    padding: clamp(28px, 5vw, 58px);
    border: 1px solid var(--about-border);
    border-radius: 28px;
    background: var(--about-card);
  }
  #MguAboutMarkus-{{ section.id }} .mgu-about-markus__copy {
    font-size: clamp(1.55rem, 1.7vw, 1.8rem);
    line-height: 1.78;
  }
  #MguAboutMarkus-{{ section.id }} .mgu-about-markus__copy > :first-child { margin-top: 0; }
  #MguAboutMarkus-{{ section.id }} .mgu-about-markus__copy > :last-child { margin-bottom: 0; }
  #MguAboutMarkus-{{ section.id }} .mgu-about-markus__quote {
    margin-top: clamp(42px, 7vw, 80px);
    padding-left: clamp(22px, 4vw, 46px);
    border-left: 4px solid var(--about-accent);
  }
  #MguAboutMarkus-{{ section.id }} .mgu-about-markus__quote p {
    max-width: 900px;
    margin: 0;
    color: var(--about-heading);
    font-family: var(--fi-font-heading, Georgia, serif);
    font-size: clamp(2.5rem, 4.4vw, 4.7rem);
    font-style: italic;
    line-height: 1.2;
  }
  @media (max-width: 760px) {
    #MguAboutMarkus-{{ section.id }} { padding: 42px 18px 58px; }
    #MguAboutMarkus-{{ section.id }} .mgu-about-markus__hero { grid-template-columns: 1fr; gap: 32px; }
    #MguAboutMarkus-{{ section.id }} .mgu-about-markus__intro { order: 1; }
    #MguAboutMarkus-{{ section.id }} .mgu-about-markus__portrait { order: 2; }
    #MguAboutMarkus-{{ section.id }} h1 { font-size: clamp(3.8rem, 14vw, 5.6rem); }
    #MguAboutMarkus-{{ section.id }} .mgu-about-markus__portrait img { height: min(72svh, 360px); border-radius: 20px; }
    #MguAboutMarkus-{{ section.id }} .mgu-about-markus__story { grid-template-columns: 1fr; margin-top: 50px; padding: 24px 20px; border-radius: 20px; }
  }
{% endstyle %}

{% schema %}
{
  "name": "Chelonaki · Über Markus",
  "tag": "section",
  "class": "mgu-about-page-section",
  "settings": [
    {"type":"text","id":"eyebrow","label":"Kleine Überschrift","default":"Der Mensch hinter MGU®"},
    {"type":"text","id":"title","label":"Seitentitel","default":"Über Markus Riebel"},
    {"type":"richtext","id":"lead","label":"Einleitung","default":"<p>Ernährung war für mich nie nur ein Trend – sondern von Anfang an ein selbstverständlicher Teil des Lebens.</p>"},
    {"type":"image_picker","id":"image","label":"Bild von Markus / Familie"},
    {"type":"text","id":"image_alt","label":"Bildbeschreibung","default":"Markus Riebel – Food Instructor MGU"},
    {"type":"text","id":"image_caption","label":"Bildunterschrift"},
    {"type":"text","id":"story_label","label":"Überschrift Lebensgeschichte","default":"Mein Weg"},
    {
      "type":"richtext",
      "id":"story",
      "label":"Lebensgeschichte",
      "default":"<p>Ich wurde als sogenanntes „Mangelkind“ geboren und wuchs gemeinsam mit meinem Zwillingsbruder in einer liebevoll-konservativen Lehrerfamilie auf, in der Werte, Traditionen und Gemeinschaft eine große Rolle spielten. Meine Eltern ermöglichten uns eine kleine Landwirtschaft mit frischen Eiern, Ziegenmilch, Obst und Gemüse aus eigenem Anbau, hausgeschlachtetem Fleisch und selbstgebackenem Brot. Ernährung war bei uns nie ein Trend – sondern ein selbstverständlicher Teil des Lebens.</p><p>Mit zehn Jahren begann meine Leidenschaft für den Sport. Bereits sechs Jahre später spielte ich Handball in der 2. Bundesliga und erreichte beim Bundesfinale der Deutschen Schülermeisterschaften den dritten Platz im Kugelstoßen und Speerwerfen. Schon damals erkannte ich den enormen Zusammenhang zwischen Ernährung, Leistungsfähigkeit und körperlicher Entwicklung.</p><p>Während viele Gleichaltrige durch Fast Food körperlich kaum belastbar waren, durfte ich erfahren, wie sehr natürliche und hochwertige Ernährung Energie, Kraft und Gesundheit beeinflusst.</p><p>Aus dieser Erfahrung entstand der Wunsch, den Menschen und seinen Körper besser zu verstehen. Es folgten das Sportabitur, das Studium der Sportwissenschaften und anschließend – um Theorie und Praxis miteinander zu verbinden – eine Ausbildung zum Koch.</p><p>Vor über 15 Jahren gründete ich schließlich Food Instructor MGU®. Ein schwerer Verkehrsunfall meines Zwillingsbruders verstärkte in mir den Wunsch, Menschen auf einfache, ehrliche und alltagstaugliche Weise zu helfen. Genau daraus entstand meine Philosophie: Ernährung neu zu denken – verständlich, genussvoll und nachhaltig.</p><p>Was mich bis heute fasziniert, ist die Möglichkeit, Menschen über vertraute Geschmäcker und ehrliche Gerichte wieder zurückzuführen in eine Zeit, in der Essen noch Natürlichkeit, Energie und Gemeinschaft bedeutete. Mein Ziel ist es, Menschen nicht nur kulinarisch zu begeistern, sondern sie auch wieder in einen körperlichen und gesundheitlichen Zustand zu begleiten, der dieser ursprünglichen Lebensweise näherkommt.</p>"
    },
    {"type":"text","id":"quote","label":"Abschlusszitat","default":"Ernährung neu denken – verständlich, genussvoll und nachhaltig."},
    {"type":"header","content":"Farben"},
    {"type":"color","id":"background","label":"Seitenhintergrund","default":"#FBF8F0"},
    {"type":"color","id":"card_background","label":"Textkarten-Hintergrund","default":"#F3EDDF"},
    {"type":"color","id":"heading_color","label":"Überschriften","default":"#142519"},
    {"type":"color","id":"text_color","label":"Fließtext","default":"#425047"},
    {"type":"color","id":"accent_color","label":"Akzent","default":"#B9912F"},
    {"type":"color","id":"border_color","label":"Rahmen","default":"#D9D2C3"}
  ],
  "presets": [{"name":"Chelonaki · Über Markus"}]
}
{% endschema %}
