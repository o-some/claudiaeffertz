<section
  class="fi-newsletter"
  id="FiNewsletter"
  style="
    --fi-newsletter-bg: {{ section.settings.background_color }};
    --fi-newsletter-panel: {{ section.settings.panel_color }};
    --fi-newsletter-heading: {{ section.settings.heading_color }};
    --fi-newsletter-text: {{ section.settings.text_color }};
    --fi-newsletter-accent: {{ section.settings.accent_color }};
    --fi-newsletter-border: {{ section.settings.border_color }};
    --fi-newsletter-input-bg: {{ section.settings.input_background }};
    --fi-newsletter-input-text: {{ section.settings.input_text_color }};
    --fi-newsletter-button-bg: {{ section.settings.button_background }};
    --fi-newsletter-button-text: {{ section.settings.button_text_color }};
    --fi-newsletter-button-hover: {{ section.settings.button_hover_background }};
  "
>
  <div class="fi-newsletter__wrap">
    <div class="fi-newsletter__panel">
      <div class="fi-newsletter__copy">
        {% if section.settings.eyebrow != blank %}
          <p class="fi-newsletter__eyebrow">{{ section.settings.eyebrow | escape }}</p>
        {% endif %}

        <h2 class="fi-newsletter__heading">{{ section.settings.heading }}</h2>

        {% if section.settings.text != blank %}
          <div class="fi-newsletter__text rte">{{ section.settings.text }}</div>
        {% endif %}
      </div>

      <div class="fi-newsletter__visual" aria-hidden="true">
        <svg viewBox="0 0 180 210" role="presentation">
          <circle class="fi-newsletter__visual-halo" cx="90" cy="105" r="78"/>
          <path class="fi-newsletter__visual-branch" d="M132 158c15-13 24-31 25-52M143 139c10-1 18-7 21-16M149 124c-8-3-13-9-14-17M154 108c8-3 13-9 14-17"/>
          <g class="fi-newsletter__visual-card">
            <rect x="50" y="28" width="80" height="116" rx="10"/>
            <path d="M69 55h42M69 69h33M69 83h38"/>
            <path class="fi-newsletter__visual-leaf" d="M91 112c-13-7-14-18-14-18 11 0 18 5 20 14 2-12 9-19 20-21 0 0 2 17-17 26"/>
          </g>
          <g class="fi-newsletter__visual-envelope">
            <path d="M24 91h132v91H24z"/>
            <path d="m25 94 65 50 65-50M25 180l49-48M155 180l-49-48"/>
          </g>
          <circle class="fi-newsletter__visual-seal" cx="90" cy="145" r="15"/>
          <path class="fi-newsletter__visual-seal-mark" d="M83 145h14M90 138v14"/>
        </svg>
        <span>Rezepte & Wissen direkt ins Postfach</span>
      </div>

      <div class="fi-newsletter__signup">
        {%- assign newsletter_form_id = 'FiNewsletterForm-' | append: section.id -%}
        {% form 'customer', id: newsletter_form_id, class: 'fi-newsletter__form' %}
          <input type="hidden" name="contact[tags]" value="{{ section.settings.customer_tags | escape }}">

          {% if form.posted_successfully? %}
            <div class="fi-newsletter__message fi-newsletter__message--success" role="status" tabindex="-1" autofocus>
              <span aria-hidden="true">✓</span>
              <p>{{ section.settings.success_text | escape }}</p>
            </div>
          {% else %}
            <div class="fi-newsletter__fields">
              <label class="visually-hidden" for="FiNewsletterEmail-{{ section.id }}">
                {{ section.settings.email_label | escape }}
              </label>
              <input
                id="FiNewsletterEmail-{{ section.id }}"
                class="fi-newsletter__input"
                type="email"
                name="contact[email]"
                value="{{ form.email | default: customer.email | escape }}"
                autocomplete="email"
                autocorrect="off"
                autocapitalize="off"
                spellcheck="false"
                required
                placeholder="{{ section.settings.email_placeholder | escape }}"
                {% if form.errors %}
                  autofocus
                  aria-invalid="true"
                  aria-describedby="FiNewsletterError-{{ section.id }}"
                {% endif %}
              >
              <button class="fi-newsletter__button" type="submit">
                <span>{{ section.settings.submit_label | escape }}</span>
                <span aria-hidden="true">→</span>
              </button>
            </div>

            {% if form.errors %}
              <div class="fi-newsletter__message fi-newsletter__message--error" id="FiNewsletterError-{{ section.id }}" role="alert">
                {{ form.errors | default_errors }}
              </div>
            {% endif %}

            {% if section.settings.trust_text != blank %}
              <div class="fi-newsletter__trust rte">{{ section.settings.trust_text }}</div>
            {% endif %}
          {% endif %}
        {% endform %}
      </div>
    </div>
  </div>
</section>

{% style %}
  #shopify-section-{{ section.id }} {
    background: var(--fi-newsletter-bg);
  }

  #shopify-section-{{ section.id }} .fi-newsletter {
    background:
      radial-gradient(circle at 12% 14%, color-mix(in srgb, var(--fi-newsletter-accent) 13%, transparent) 0, transparent 34%),
      var(--fi-newsletter-bg);
    color: var(--fi-newsletter-text);
    padding: {{ section.settings.padding_top | times: 0.75 | round }}px 20px {{ section.settings.padding_bottom | times: 0.75 | round }}px;
  }

  #shopify-section-{{ section.id }} .fi-newsletter__wrap {
    width: min(1180px, 100%);
    margin: 0 auto;
  }

  #shopify-section-{{ section.id }} .fi-newsletter__panel {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 1.08fr) minmax(118px, .36fr) minmax(320px, .94fr);
    align-items: center;
    gap: clamp(24px, 3.4vw, 48px);
    overflow: hidden;
    padding: clamp(34px, 6vw, 76px);
    border: 1px solid var(--fi-newsletter-border);
    border-radius: 28px;
    background: var(--fi-newsletter-panel);
    box-shadow: 0 28px 70px rgba(4, 17, 10, .16);
  }

  #shopify-section-{{ section.id }} .fi-newsletter__panel::after {
    position: absolute;
    right: -90px;
    bottom: -120px;
    width: 300px;
    height: 300px;
    border: 1px solid color-mix(in srgb, var(--fi-newsletter-accent) 32%, transparent);
    border-radius: 50%;
    content: "";
    pointer-events: none;
  }

  #shopify-section-{{ section.id }} .fi-newsletter__copy,
  #shopify-section-{{ section.id }} .fi-newsletter__visual,
  #shopify-section-{{ section.id }} .fi-newsletter__signup {
    position: relative;
    z-index: 1;
  }

  #shopify-section-{{ section.id }} .fi-newsletter__visual {
    display: grid;
    width: clamp(118px, 11vw, 158px);
    justify-self: center;
    place-items: center;
    color: var(--fi-newsletter-accent);
  }

  #shopify-section-{{ section.id }} .fi-newsletter__visual svg {
    display: block;
    width: 100%;
    height: auto;
    overflow: visible;
  }

  #shopify-section-{{ section.id }} .fi-newsletter__visual-halo {
    fill: color-mix(in srgb, var(--fi-newsletter-accent) 8%, transparent);
    stroke: color-mix(in srgb, var(--fi-newsletter-accent) 24%, transparent);
    stroke-width: 1;
  }

  #shopify-section-{{ section.id }} .fi-newsletter__visual-card rect {
    fill: var(--fi-newsletter-heading);
    stroke: var(--fi-newsletter-accent);
    stroke-width: 1.5;
  }

  #shopify-section-{{ section.id }} .fi-newsletter__visual-card > path:not(.fi-newsletter__visual-leaf) {
    fill: none;
    stroke: color-mix(in srgb, var(--fi-newsletter-panel) 55%, transparent);
    stroke-linecap: round;
    stroke-width: 2;
  }

  #shopify-section-{{ section.id }} .fi-newsletter__visual-leaf,
  #shopify-section-{{ section.id }} .fi-newsletter__visual-branch {
    fill: none;
    stroke: var(--fi-newsletter-accent);
    stroke-linecap: round;
    stroke-linejoin: round;
    stroke-width: 2;
  }

  #shopify-section-{{ section.id }} .fi-newsletter__visual-envelope {
    fill: var(--fi-newsletter-panel);
    stroke: var(--fi-newsletter-accent);
    stroke-linecap: round;
    stroke-linejoin: round;
    stroke-width: 2;
  }

  #shopify-section-{{ section.id }} .fi-newsletter__visual-seal {
    fill: var(--fi-newsletter-accent);
  }

  #shopify-section-{{ section.id }} .fi-newsletter__visual-seal-mark {
    fill: none;
    stroke: var(--fi-newsletter-panel);
    stroke-linecap: round;
    stroke-width: 1.8;
  }

  #shopify-section-{{ section.id }} .fi-newsletter__visual span {
    max-width: 150px;
    margin-top: -4px;
    color: var(--fi-newsletter-text);
    font-size: 1.05rem;
    font-weight: 650;
    letter-spacing: .09em;
    line-height: 1.45;
    text-align: center;
    text-transform: uppercase;
  }

  #shopify-section-{{ section.id }} .fi-newsletter__eyebrow {
    margin: 0 0 14px;
    color: var(--fi-newsletter-accent);
    font-size: 1.2rem;
    font-weight: 700;
    letter-spacing: .16em;
    line-height: 1.3;
    text-transform: uppercase;
  }

  #shopify-section-{{ section.id }} .fi-newsletter__heading {
    max-width: 680px;
    margin: 0;
    color: var(--fi-newsletter-heading);
    font-size: clamp(3.4rem, 5vw, 6.4rem);
    line-height: 1.02;
  }

  #shopify-section-{{ section.id }} .fi-newsletter__heading em {
    color: var(--fi-newsletter-accent);
    font-weight: inherit;
  }

  #shopify-section-{{ section.id }} .fi-newsletter__text {
    max-width: 610px;
    margin-top: 22px;
    color: var(--fi-newsletter-text);
    font-size: clamp(1.6rem, 1.7vw, 1.9rem);
    line-height: 1.65;
  }

  #shopify-section-{{ section.id }} .fi-newsletter__text p,
  #shopify-section-{{ section.id }} .fi-newsletter__trust p {
    margin: 0;
  }

  #shopify-section-{{ section.id }} .fi-newsletter__fields {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  #shopify-section-{{ section.id }} .fi-newsletter__input,
  #shopify-section-{{ section.id }} .fi-newsletter__button {
    width: 100%;
    min-height: 58px;
    border-radius: 12px;
    font: inherit;
  }

  #shopify-section-{{ section.id }} .fi-newsletter__input {
    appearance: none;
    padding: 0 18px;
    border: 1px solid var(--fi-newsletter-border);
    outline: none;
    background: var(--fi-newsletter-input-bg);
    color: var(--fi-newsletter-input-text);
    font-size: 1.6rem;
    transition: border-color .2s ease, box-shadow .2s ease;
  }

  #shopify-section-{{ section.id }} .fi-newsletter__input::placeholder {
    color: color-mix(in srgb, var(--fi-newsletter-input-text) 62%, transparent);
    opacity: 1;
  }

  #shopify-section-{{ section.id }} .fi-newsletter__input:focus-visible {
    border-color: var(--fi-newsletter-accent);
    box-shadow: 0 0 0 3px color-mix(in srgb, var(--fi-newsletter-accent) 25%, transparent);
  }

  #shopify-section-{{ section.id }} .fi-newsletter__button {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 20px;
    padding: 0 21px;
    border: 0;
    background: var(--fi-newsletter-button-bg);
    color: var(--fi-newsletter-button-text);
    cursor: pointer;
    font-size: 1.5rem;
    font-weight: 750;
    letter-spacing: .04em;
    transition: background-color .2s ease, transform .2s ease;
  }

  #shopify-section-{{ section.id }} .fi-newsletter__button:hover {
    background: var(--fi-newsletter-button-hover);
    transform: translateY(-1px);
  }

  #shopify-section-{{ section.id }} .fi-newsletter__button:focus-visible {
    outline: 3px solid var(--fi-newsletter-heading);
    outline-offset: 3px;
  }

  #shopify-section-{{ section.id }} .fi-newsletter__trust {
    margin-top: 14px;
    color: var(--fi-newsletter-text);
    font-size: 1.25rem;
    line-height: 1.5;
    opacity: .78;
  }

  #shopify-section-{{ section.id }} .fi-newsletter__trust a {
    color: inherit;
    text-underline-offset: 3px;
  }

  #shopify-section-{{ section.id }} .fi-newsletter__message {
    font-size: 1.45rem;
    line-height: 1.5;
  }

  #shopify-section-{{ section.id }} .fi-newsletter__message--success {
    display: flex;
    align-items: flex-start;
    gap: 14px;
    padding: 20px;
    border: 1px solid var(--fi-newsletter-accent);
    border-radius: 12px;
    color: var(--fi-newsletter-heading);
  }

  #shopify-section-{{ section.id }} .fi-newsletter__message--success span {
    display: grid;
    flex: 0 0 28px;
    width: 28px;
    height: 28px;
    place-items: center;
    border-radius: 50%;
    background: var(--fi-newsletter-accent);
    color: var(--fi-newsletter-button-text);
  }

  #shopify-section-{{ section.id }} .fi-newsletter__message--success p {
    margin: 2px 0 0;
  }

  #shopify-section-{{ section.id }} .fi-newsletter__message--error {
    margin-top: 10px;
    color: #ffd7d7;
  }

  #shopify-section-{{ section.id }} .fi-newsletter__message--error ul {
    margin: 0;
    padding-left: 20px;
  }

  @media screen and (min-width: 750px) {
    #shopify-section-{{ section.id }} .fi-newsletter {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }

  @media screen and (max-width: 820px) {
    #shopify-section-{{ section.id }} .fi-newsletter__panel {
      grid-template-columns: 1fr;
      gap: 26px;
    }

    #shopify-section-{{ section.id }} .fi-newsletter__visual {
      width: 138px;
      justify-self: start;
      margin: -8px 0 -6px;
    }
  }

  @media screen and (max-width: 520px) {
    #shopify-section-{{ section.id }} .fi-newsletter {
      padding-right: 14px;
      padding-left: 14px;
    }

    #shopify-section-{{ section.id }} .fi-newsletter__panel {
      padding: 30px 22px;
      border-radius: 20px;
    }

    #shopify-section-{{ section.id }} .fi-newsletter__heading {
      font-size: clamp(3.1rem, 11vw, 4.4rem);
    }

    #shopify-section-{{ section.id }} .fi-newsletter__visual {
      width: 118px;
    }

    #shopify-section-{{ section.id }} .fi-newsletter__visual span {
      font-size: .95rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    #shopify-section-{{ section.id }} .fi-newsletter__input,
    #shopify-section-{{ section.id }} .fi-newsletter__button {
      transition: none;
    }
  }
{% endstyle %}

{% schema %}
{
  "name": "Chelonaki · Newsletter",
  "tag": "section",
  "class": "fi-newsletter-section",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Kleine Überschrift",
      "default": "Wissen, Rezepte & Inspiration"
    },
    {
      "type": "inline_richtext",
      "id": "heading",
      "label": "Überschrift",
      "default": "Post aus der <em>Longevity-Küche.</em>"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Beschreibung",
      "default": "<p>Erhalte ausgewählte Rezepte, alltagstaugliches Ernährungswissen und Neuigkeiten von Markus Riebel direkt in dein Postfach.</p>"
    },
    {
      "type": "text",
      "id": "email_label",
      "label": "Feldbezeichnung",
      "default": "E-Mail-Adresse"
    },
    {
      "type": "text",
      "id": "email_placeholder",
      "label": "Platzhalter",
      "default": "Deine E-Mail-Adresse"
    },
    {
      "type": "text",
      "id": "submit_label",
      "label": "Buttontext",
      "default": "Kostenlos anmelden"
    },
    {
      "type": "richtext",
      "id": "trust_text",
      "label": "Hinweis unter dem Formular",
      "default": "<p>Inspirierend statt aufdringlich. Jederzeit abmeldbar.</p>"
    },
    {
      "type": "text",
      "id": "success_text",
      "label": "Erfolgsmeldung",
      "default": "Schön, dass du dabei bist! Bitte prüfe jetzt dein E-Mail-Postfach."
    },
    {
      "type": "text",
      "id": "customer_tags",
      "label": "Shopify-Kundentags",
      "default": "newsletter,food-instructor-startseite"
    },
    {
      "type": "header",
      "content": "Abstände"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 24,
      "max": 160,
      "step": 4,
      "unit": "px",
      "label": "Abstand oben",
      "default": 88
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 24,
      "max": 160,
      "step": 4,
      "unit": "px",
      "label": "Abstand unten",
      "default": 88
    },
    {
      "type": "header",
      "content": "Farben"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Bereichshintergrund",
      "default": "#FBF8F0"
    },
    {
      "type": "color",
      "id": "panel_color",
      "label": "Kartenhintergrund",
      "default": "#142519"
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Überschrift",
      "default": "#FBF8F0"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Fließtext",
      "default": "#EFEAD9"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Akzent",
      "default": "#D9BC6A"
    },
    {
      "type": "color",
      "id": "border_color",
      "label": "Rahmen",
      "default": "#526055"
    },
    {
      "type": "color",
      "id": "input_background",
      "label": "Eingabefeld-Hintergrund",
      "default": "#203526"
    },
    {
      "type": "color",
      "id": "input_text_color",
      "label": "Eingabefeld-Text",
      "default": "#FFFFFF"
    },
    {
      "type": "color",
      "id": "button_background",
      "label": "Button-Hintergrund",
      "default": "#B9912F"
    },
    {
      "type": "color",
      "id": "button_text_color",
      "label": "Button-Text",
      "default": "#142519"
    },
    {
      "type": "color",
      "id": "button_hover_background",
      "label": "Button-Hintergrund bei Hover",
      "default": "#D9BC6A"
    }
  ],
  "presets": [
    {
      "name": "Chelonaki · Newsletter"
    }
  ]
}
{% endschema %}
