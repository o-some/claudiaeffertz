{% comment %} Chelonaki Shop Theme · © Chelonaki · Build: CHELONAKI-BUILD-0000-MASTER · Nutzung nur mit gültiger Lizenz {% endcomment %}

<section class="mgu mgu-hero" id="mgu-hero-{{ section.id }}">
  <div class="mgu-hero-grid">
    <div class="mgu-hero-text">
      {%- if section.settings.eyebrow != blank -%}
        <span class="mgu-eyebrow">{{ section.settings.eyebrow }}</span>
      {%- endif -%}
      <h1>{{ section.settings.heading }}</h1>
      {%- if section.settings.text != blank -%}
        <p>{{ section.settings.text }}</p>
      {%- endif -%}
      {%- if section.blocks.size > 0 -%}
        <div class="mgu-btn-row">
          {%- for block in section.blocks -%}
            {%- if block.settings.label != blank and block.settings.link != blank -%}<a class="mgu-btn mgu-btn--{{ block.settings.style }}" href="{{ block.settings.link }}" {{ block.shopify_attributes }}>
              {{ block.settings.label }}
              {%- if block.settings.style == 'primary' -%}
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none"><path d="M5 12h14M13 6l6 6-6 6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
              {%- endif -%}
            </a>{%- endif -%}
          {%- endfor -%}
        </div>
      {%- endif -%}
    </div>
    <div class="mgu-hero-visual">
      <div class="mgu-hero-halo"></div>
      {%- if section.settings.image != blank -%}
        <img width="{{ section.settings.image.width }}" height="{{ section.settings.image.height }}" class="mgu-hero-book" {% if section.settings.parallax %}data-mgu-parallax="0.1"{% endif %}
             src="{{ section.settings.image | image_url: width: 900 }}"
             srcset="{{ section.settings.image | image_url: width: 600 }} 600w, {{ section.settings.image | image_url: width: 900 }} 900w"
             sizes="(max-width: 860px) 72vw, 440px"
             alt="{{ section.settings.image.alt | default: section.settings.heading | escape }}"
             loading="eager">
      {%- else -%}
        {{ 'image' | placeholder_svg_tag: 'mgu-hero-book' }}
      {%- endif -%}
    </div>
    {%- if section.settings.show_hint -%}
      <div class="mgu-scroll-hint">{{ 'mgu.allgemein.scrollen' | t }}</div>
    {%- endif -%}
  </div>
</section>

{% style %}
  #shopify-section-{{ section.id }} {
    margin-block-start: {{ section.settings.section_gap_top | default: 0 }}px;
    margin-block-end: {{ section.settings.section_gap_bottom | default: 0 }}px;
  }
{% endstyle %}

{% schema %}
{
  "name": "Chelonaki – Hero",
  "tag": "div",
  "settings": [
    {"type":"header","content":"Abstand zum nächsten Abschnitt"},
    {"type":"range","id":"section_gap_top","label":"Zusätzlicher Abstand oben","min":0,"max":200,"step":4,"unit":"px","default":0},
    {"type":"range","id":"section_gap_bottom","label":"Zusätzlicher Abstand unten","min":0,"max":200,"step":4,"unit":"px","default":0},
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Kicker-Zeile",
      "default": "Dein Claim · Deine Marke"
    },
    {
      "type": "inline_richtext",
      "id": "heading",
      "label": "Überschrift (kursiv = <em>)",
      "default": "Deine Marke, <em>neu gedacht.</em>"
    },
    {
      "type": "textarea",
      "id": "text",
      "label": "Einleitungstext",
      "default": "Kurzer Einleitungstext deiner Marke: Was macht dein Angebot besonders? Zwei bis drei Sätze reichen."
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Hero-Bild (z.B. Produkt-Mockup)"
    },
    {
      "type": "checkbox",
      "id": "show_hint",
      "label": "Scroll-Hinweis anzeigen",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "parallax",
      "label": "Parallax-Effekt auf dem Hero-Bild",
      "default": true
    }
  ],
  "blocks": [
    {
      "type": "button",
      "name": "Button",
      "limit": 3,
      "settings": [
        {
          "type": "text",
          "id": "label",
          "label": "Beschriftung",
          "default": "Jetzt entdecken"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link"
        },
        {
          "type": "select",
          "id": "style",
          "label": "Stil",
          "default": "primary",
          "options": [
            {
              "value": "primary",
              "label": "Grün (primär)"
            },
            {
              "value": "ghost",
              "label": "Umrandet"
            },
            {
              "value": "gold",
              "label": "Gold"
            }
          ]
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Chelonaki – Hero",
      "blocks": [
        {
          "type": "button",
          "settings": {
            "label": "Jetzt entdecken",
            "style": "primary"
          }
        },
        {
          "type": "button",
          "settings": {
            "label": "Mehr erfahren",
            "style": "ghost"
          }
        }
      ]
    }
  ]
}
{% endschema %}
