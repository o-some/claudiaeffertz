{% comment %} Chelonaki Shop Theme · © Chelonaki · Build: CHELONAKI-BUILD-0000-MASTER · Nutzung nur mit gültiger Lizenz {% endcomment %}
<style>
  .mgu-pg{display:grid;gap:20px;grid-template-columns:repeat(4,1fr);grid-auto-rows:220px}
  @media(max-width:900px){.mgu-pg{grid-template-columns:repeat(2,1fr)}}
  .mgu-pg-item{position:relative;border-radius:20px;overflow:hidden;display:flex;align-items:flex-end;box-shadow:0 22px 44px -24px rgba(20,37,25,.35)}
  .mgu-pg-item.mgu-pg--gross{grid-column:span 2;grid-row:span 2}
  @media(max-width:560px){.mgu-pg-item.mgu-pg--gross{grid-column:span 2;grid-row:span 1}}
  .mgu-pg-item img{position:absolute;inset:0;width:100%;height:100%;object-fit:cover;transition:transform .6s}
  .mgu-pg-item:hover img{transform:scale(1.05)}
  .mgu-pg-item::after{content:"";position:absolute;inset:35% 0 0 0;background:linear-gradient(transparent,rgba(20,37,25,.72))}
  .mgu-pg-text{position:relative;z-index:2;padding:18px 20px;color:#FCF9F1}
  .mgu-pg-text small{display:block;font-size:11px;letter-spacing:.16em;text-transform:uppercase;font-weight:700;color:var(--mgu-gold-soft)}
  .mgu-pg-text h3{margin:3px 0 0;font-size:1.25rem;line-height:1.2}
</style>
<section data-mgu-effect="{{ section.settings.effect | default: 'up' }}" data-mgu-speed="{{ section.settings.effect_speed | default: 'normal' }}" class="mgu mgu-block" style="background:{{ section.settings.bg }}">
  <div class="mgu-wrap">
    {%- if section.settings.heading != blank -%}
      <div class="mgu-sec-head mgu-reveal"><h2>{{ section.settings.heading }}</h2></div>
    {%- endif -%}
    <div class="mgu-pg">
      {%- for block in section.blocks -%}
        {%- if block.settings.link != blank -%}<a class="mgu-pg-item mgu-reveal {% if block.settings.gross %}mgu-pg--gross{% endif %}"
           href="{{ block.settings.link }}"
           {% if forloop.index > 1 %}style="transition-delay:{{ forloop.index0 | times: 0.07 }}s"{% endif %}
           {{ block.shopify_attributes }}>
          {%- if block.settings.bild != blank -%}
            <img width="{{ block.settings.bild.width }}" height="{{ block.settings.bild.height }}" src="{{ block.settings.bild | image_url: width: 900 }}" alt="{{ block.settings.titel | escape }}" loading="lazy">
          {%- endif -%}
          <div class="mgu-pg-text">
            {%- if block.settings.label != blank -%}<small>{{ block.settings.label }}</small>{%- endif -%}
            <h3>{{ block.settings.titel }}</h3>
          </div>
        </a>{%- endif -%}
      {%- endfor -%}
    </div>
  </div>
</section>
{% style %}
  #shopify-section-{{ section.id }} {
    margin-block-start: {{ section.settings.section_gap_top | default: 0 }}px;
    margin-block-end: {{ section.settings.section_gap_bottom | default: 0 }}px;
  }
{% endstyle %}

{% schema %}
{
  "name": "Chelonaki – Promo-Kacheln",
  "settings": [
    {"type":"header","content":"Abstand zum nächsten Abschnitt"},
    {"type":"range","id":"section_gap_top","label":"Zusätzlicher Abstand oben","min":0,"max":200,"step":4,"unit":"px","default":0},
    {"type":"range","id":"section_gap_bottom","label":"Zusätzlicher Abstand unten","min":0,"max":200,"step":4,"unit":"px","default":0},
    { "type": "header", "content": "Scroll-Effekt" },
    { "type": "select", "id": "effect", "label": "Erscheinen beim Scrollen", "default": "up", "options": [ { "value": "none", "label": "Kein Effekt" }, { "value": "fade", "label": "Einblenden" }, { "value": "up", "label": "Von unten (Standard)" }, { "value": "left", "label": "Von links" }, { "value": "right", "label": "Von rechts" }, { "value": "zoom", "label": "Sanfter Zoom" }, { "value": "blur", "label": "Aus der Unschärfe" } ] },
    { "type": "select", "id": "effect_speed", "label": "Effekt-Tempo", "default": "normal", "options": [ { "value": "schnell", "label": "Schnell" }, { "value": "normal", "label": "Normal" }, { "value": "langsam", "label": "Langsam" } ] },
    { "type": "inline_richtext", "id": "heading", "label": "Überschrift (optional)" },
    { "type": "color", "id": "bg", "label": "Hintergrundfarbe", "default": "#FBF8F0" }
  ],
  "blocks": [
    { "type": "kachel", "name": "Kachel",
      "settings": [
        { "type": "image_picker", "id": "bild", "label": "Bild" },
        { "type": "text", "id": "label", "label": "Label", "default": "Aktion" },
        { "type": "text", "id": "titel", "label": "Titel", "default": "Jetzt entdecken" },
        { "type": "url", "id": "link", "label": "Link" },
        { "type": "checkbox", "id": "gross", "label": "Große Kachel (2×2)", "default": false }
      ]}
  ],
  "presets": [{ "name": "Chelonaki – Promo-Kacheln", "blocks": [ { "type": "kachel", "settings": { "gross": true } }, { "type": "kachel" }, { "type": "kachel" } ] }]
}
{% endschema %}
