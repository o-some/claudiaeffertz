{%- comment -%}
  Rendert ein vom Händler gepflegtes Shopify-Menü für Desktop und Mobil.
  Die Reihenfolge und Verschachtelung stammen ausschließlich aus
  Onlineshop > Navigation / Inhalte > Menüs.
{%- endcomment -%}

{%- liquid
  assign has_team_link = false
  assign has_recipe_link = false
  assign has_courses_advice_link = false
  for menu_link in menu.links
    assign menu_link_title = menu_link.title | strip | downcase
    if menu_link_title == 'team'
      assign has_team_link = true
    endif
    if menu_link_title == 'rezepte'
      assign has_recipe_link = true
    endif
  endfor
-%}

{%- for link in menu.links -%}
  {%- liquid
    assign nav_url = link.url
    assign normalized_title = link.title | strip | downcase
    assign is_courses_advice_link = false
    if normalized_title == 'kurse & beratung' or normalized_title == 'kurse und beratung'
      assign is_courses_advice_link = true
    endif
    assign is_training_link = false
    if normalized_title == 'ausbildung'
      assign nav_url = '/pages/ausbildung-1?view=ausbildung-neu'
      assign is_training_link = true
    endif
    assign nav_url_first_character = nav_url | slice: 0
    if request.page_type != 'index' and nav_url_first_character == '#'
      assign nav_url = routes.root_url | append: nav_url
    endif
  -%}

  {%- unless is_courses_advice_link -%}
  {%- if link.links != blank -%}
    <details class="fi-nav-item fi-nav-item--parent{% if link.child_active %} is-active{% endif %}">
      <summary{% if link.child_active %} aria-current="true"{% endif %}>
        <span>{{ link.title | escape }}</span>
        <svg viewBox="0 0 12 8" aria-hidden="true" focusable="false"><path d="m1 1 5 5 5-5" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5"/></svg>
      </summary>
      <div class="fi-nav-submenu">
        <a class="fi-nav-parent-link" href="{{ nav_url }}"{% if link.current %} aria-current="page"{% endif %}>
          Alle {{ link.title | escape }}
        </a>
        {%- for childlink in link.links -%}
          {%- liquid
            assign child_url = childlink.url
            assign child_url_first_character = child_url | slice: 0
            if request.page_type != 'index' and child_url_first_character == '#'
              assign child_url = routes.root_url | append: child_url
            endif
          -%}
          {%- if childlink.links != blank -%}
            <div class="fi-nav-subgroup">
              <a class="fi-nav-subgroup__title" href="{{ child_url }}"{% if childlink.current %} aria-current="page"{% endif %}>
                {{ childlink.title | escape }}
              </a>
              {%- for grandchildlink in childlink.links -%}
                {%- liquid
                  assign grandchild_url = grandchildlink.url
                  assign grandchild_url_first_character = grandchild_url | slice: 0
                  if request.page_type != 'index' and grandchild_url_first_character == '#'
                    assign grandchild_url = routes.root_url | append: grandchild_url
                  endif
                -%}
                <a class="fi-nav-subgroup__link" href="{{ grandchild_url }}"{% if grandchildlink.current %} aria-current="page"{% endif %}>
                  {{ grandchildlink.title | escape }}
                </a>
              {%- endfor -%}
            </div>
          {%- else -%}
            <a href="{{ child_url }}"{% if childlink.current %} aria-current="page"{% endif %}>
              {{ childlink.title | escape }}
            </a>
          {%- endif -%}
        {%- endfor -%}
      </div>
    </details>
  {%- else -%}
    <a href="{{ nav_url }}" data-fi-nav-link{% if link.current or is_training_link and page.handle == 'ausbildung-1' %} class="is-active" aria-current="page"{% endif %}>{{ link.title | escape }}</a>
  {%- endif -%}
  {%- if normalized_title == 'startseite' and has_team_link == false -%}
    <a href="{{ home_anchor_prefix }}#kompetenzteam" data-fi-nav-link>Team</a>
  {%- endif -%}
  {%- if normalized_title == 'bücher' and has_recipe_link == false -%}
    <a href="{{ home_anchor_prefix }}#rezepte" data-fi-nav-link>Rezepte</a>
  {%- endif -%}
  {%- if normalized_title == 'gutscheine' and has_courses_advice_link == false -%}
    <a href="/pages/kurse-beratung?view=kurse-beratung" data-fi-nav-link{% if page.handle == 'kurse-beratung' %} class="is-active" aria-current="page"{% endif %}>Kurse &amp; Beratung</a>
  {%- endif -%}
  {%- endunless -%}
{%- endfor -%}
