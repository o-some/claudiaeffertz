{%- comment -%}
  Zentrale Marken-Tokens. Schriften werden über Shopifys Font-Picker/CDN geladen;
  dadurch sind keine externen Google-Font-Verbindungen notwendig.
  Wichtig: font_face erzeugt CSS und muss deshalb innerhalb eines style-Tags stehen.
{%- endcomment -%}
<style id="mgu-design-tokens">
  {%- if settings.mgu_font_heading != blank -%}
    {{ settings.mgu_font_heading | font_face: font_display: 'swap' }}
  {%- endif -%}
  {%- if settings.mgu_font_body != blank -%}
    {{ settings.mgu_font_body | font_face: font_display: 'swap' }}
  {%- endif -%}

  :root, .mgu, .fi-page {
    {%- if settings.mgu_font_heading != blank -%}
      --mgu-font-heading: {{ settings.mgu_font_heading.family }}, {{ settings.mgu_font_heading.fallback_families }};
    {%- endif -%}
    {%- if settings.mgu_font_body != blank -%}
      --mgu-font-body: {{ settings.mgu_font_body.family }}, {{ settings.mgu_font_body.fallback_families }};
    {%- endif -%}
    {%- if settings.mgu_aktiv -%}
      --mgu-paper: {{ settings.mgu_paper }};
      --mgu-cream: {{ settings.mgu_cream }};
      --mgu-forest: {{ settings.mgu_primary }};
      --mgu-forest-deep: {{ settings.mgu_primary_dark }};
      --mgu-gold: {{ settings.mgu_akzent }};
      --mgu-accent-text: {{ settings.mgu_akzent_text }};
      --mgu-gold-soft: {{ settings.mgu_akzent_hell }};
      --mgu-ink: {{ settings.mgu_text }};
      --mgu-ink-soft: {{ settings.mgu_text_soft }};
      --mgu-radius: {{ settings.mgu_radius }}px;
    {%- endif -%}
    --ch-primary: var(--mgu-forest, #1e3a5f);
    --ch-primary-dark: var(--mgu-forest-deep, #162c49);
    --ch-accent: var(--mgu-gold, #c69a4b);
    --ch-accent-text: var(--mgu-accent-text, #80611f);
    --ch-accent-light: var(--mgu-gold-soft, #dfbd7c);
    --ch-surface: var(--mgu-paper, #fbf8f2);
    --ch-text: var(--mgu-ink, #2b3a4a);
    --ch-text-soft: var(--mgu-ink-soft, #586777);
    --ch-focus: var(--mgu-accent-text, #80611f);
    --ch-font-heading: var(--mgu-font-heading, var(--font-heading-family));
    --ch-font-body: var(--mgu-font-body, var(--font-body-family));
    --ch-radius: var(--mgu-radius, 14px);
    --ch-space: .8rem;
    --ch-shadow-alpha: .12;
    --ch-motion-duration: 180ms;
    --ch-motion-distance: .2rem;
    --ch-border: color-mix(in srgb, var(--ch-text) 16%, transparent);
    --ch-shadow: 0 1.2rem 3rem rgb(0 0 0 / var(--ch-shadow-alpha));
  }
</style>
