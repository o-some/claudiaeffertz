{% if settings.logo != blank %}
  {% assign rendered_logo_width = width | default: 160 %}
  {{ settings.logo | image_url: width: 600 | image_tag: class: 'fi-logo-icon fi-logo-icon--custom', widths: '80, 160, 320, 600', width: rendered_logo_width, alt: shop.name }}
{% elsif settings.fi_generated_logo_asset != blank %}
  <img class="fi-logo-icon fi-logo-icon--custom" src="{{ settings.fi_generated_logo_asset | asset_url }}" width="{{ width | default: 160 }}" height="{{ height | default: 48 }}" alt="{{ shop.name | escape }}">
{% else %}
<svg class="fi-logo-icon" viewBox="0 0 64 40" fill="none" width="{{ width | default: 52 }}" height="{{ height | default: 34 }}" aria-hidden="true" focusable="false">
  <path d="M3 30h58M16 8v27M48 8v27M16 10c8 19 24 19 32 0M3 30c7 0 10-8 13-20M48 10c3 12 6 20 13 20" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
</svg>
{% endif %}
