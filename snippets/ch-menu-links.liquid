{% comment %}Neutrale, rekursive Chelonaki-Navigation für Shopify-Menüs.{% endcomment %}
{% for link in links %}
  <li class="ch-nav__item{% if link.links != blank %} ch-nav__item--parent{% endif %}">
    <a href="{{ link.url }}" data-ch-nav-link{% if link.current %} class="is-active" aria-current="page"{% endif %}>
      {{ link.title | escape }}
    </a>
    {% if link.links != blank %}
      <ul class="ch-nav__children">
        {% render 'ch-menu-links', links: link.links %}
      </ul>
    {% endif %}
  </li>
{% endfor %}
