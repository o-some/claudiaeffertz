{%- liquid
  assign featured_media = product.featured_media
  assign first_variant = product.selected_or_first_available_variant
  assign has_single_variant = product.has_only_default_variant
-%}
<article class="mgu-shop-card"{% if block %} {{ block.shopify_attributes }}{% endif %}>
  <a class="mgu-shop-card__media" href="{{ product.url }}" aria-label="{{ product.title | escape }}">
    {% if featured_media %}
      {{ featured_media | image_url: width: 900 | image_tag: loading: 'lazy', widths: '320, 480, 640, 900', sizes: '(min-width: 990px) 25vw, (min-width: 650px) 50vw, 100vw', alt: featured_media.alt | default: product.title }}
    {% else %}
      {{ 'product-1' | placeholder_svg_tag: 'placeholder-svg' }}
    {% endif %}
    {% if product.compare_at_price_max > product.price %}<span class="mgu-shop-card__badge">Angebot</span>{% endif %}
  </a>
  <div class="mgu-shop-card__body">
    {% if section.settings.show_vendor and product.vendor != blank %}<p class="mgu-shop-card__meta">{{ product.vendor | escape }}</p>{% endif %}
    <h3><a href="{{ product.url }}">{{ product.title | escape }}</a></h3>
    {% if section.settings.show_description and product.description != blank %}<div class="mgu-shop-card__description">{{ product.description | strip_html | truncate: 115 }}</div>{% endif %}
    <div class="mgu-shop-card__price">
      {% if product.price_varies %}<span class="mgu-shop-card__from">ab </span>{% endif %}
      <span>{{ product.price | money }}</span>
      {% if product.compare_at_price_max > product.price %}<s>{{ product.compare_at_price_max | money }}</s>{% endif %}
    </div>

    {% if section.settings.show_quick_add %}
      {% if product.available and has_single_variant %}
        <product-form class="mgu-shop-card__form" data-hide-errors="false">
          {% form 'product', product, id: 'MguShopForm-' | append: section.id | append: '-' | append: product.id, class: 'form', novalidate: 'novalidate', data-type: 'add-to-cart-form' %}
            <input type="hidden" name="id" value="{{ first_variant.id }}" class="product-variant-id">
            <button type="submit" name="add" class="fi-btn mgu-shop-card__button"{% unless first_variant.available %} disabled{% endunless %}>
              <span>{{ section.settings.add_to_cart_label | escape }}</span>
              <span class="sold-out-message hidden">{{ section.settings.sold_out_label | escape }}</span>
              {% render 'loading-spinner' %}
            </button>
          {% endform %}
          <div class="product-form__error-message-wrapper" role="alert" hidden><span class="product-form__error-message"></span></div>
        </product-form>
      {% elsif product.available %}
        <a class="fi-btn mgu-shop-card__button" href="{{ product.url }}">{{ section.settings.choose_options_label | escape }}</a>
      {% else %}
        <button class="fi-btn mgu-shop-card__button" type="button" disabled>{{ section.settings.sold_out_label | escape }}</button>
      {% endif %}
    {% else %}
      <a class="fi-btn mgu-shop-card__button" href="{{ product.url }}">Produkt ansehen</a>
    {% endif %}
  </div>
</article>
