{% comment %}
  Chelonaki Komplett-Einbindung für den Seitenkörper.
  In layout/theme.liquid direkt VOR </body> genau EINE Zeile:
  {% render 'mgu-body' %}
  Parameter (alle optional):
    versand_schwelle: 50            → Gratisversand-Balken ab Betrag (0 = aus)
    upsell_collection: 'bestseller' → Warenkorb-Empfehlungen (leer = aus)
    upsell_titel: 'Passt dazu'
    alkohol_hinweis: true           → Warenkorb-Hinweis für Tag "alkohol"
    alkohol_badges: true            → 18+-Badge auf Produktkarten (Tag "alkohol")
    produkt_badges: '[{"tag":"vegan","label":"Vegan"},{"tag":"neu","label":"Neu"}]'
                                    → generische Badges nach Tag (JSON)
  Beispiel:
  {% render 'mgu-body', versand_schwelle: 50, upsell_collection: 'bestseller', alkohol_hinweis: true, alkohol_badges: true %}
{% endcomment %}
{%- assign schwelle = versand_schwelle | default: 0 | plus: 0 -%}
{%- if schwelle > 0 -%}
  {% render 'mgu-versand-bar', schwelle: schwelle %}
{%- endif -%}
{%- if upsell_collection != blank -%}
  {% render 'mgu-upsell', collection: upsell_collection, titel: upsell_titel %}
{%- endif -%}
{%- if warenkorb_hinweis or mindestwert -%}
  {% render 'mgu-warenkorb-hinweise', mindestwert: mindestwert, hinweis_text: warenkorb_hinweis %}
{%- endif -%}
{%- if alkohol_hinweis -%}
  {% render 'mgu-alkohol-warenkorb' %}
{%- endif -%}
{%- if produkt_badges != blank -%}
  <div data-mgu-tag-badges data-pairs='{{ produkt_badges }}' hidden></div>
{%- endif -%}
{%- if alkohol_badges -%}
  <div data-mgu-alk-badge data-tag="alkohol" data-text="18+" hidden></div>
{%- endif -%}
