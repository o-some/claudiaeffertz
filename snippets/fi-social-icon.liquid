{%- liquid
  assign icon_name = icon | downcase
  assign icon_size = size | default: 20
-%}
<svg
  class="fi-social-svg fi-social-svg--{{ icon_name | escape }}"
  width="{{ icon_size }}"
  height="{{ icon_size }}"
  viewBox="0 0 24 24"
  fill="none"
  aria-hidden="true"
  focusable="false"
>
  {%- case icon_name -%}
    {%- when 'instagram' -%}
      <rect x="3" y="3" width="18" height="18" rx="5" stroke="currentColor" stroke-width="1.8"/>
      <circle cx="12" cy="12" r="4.2" stroke="currentColor" stroke-width="1.8"/>
      <circle cx="17.4" cy="6.7" r="1.1" fill="currentColor"/>
    {%- when 'facebook' -%}
      <path d="M14.2 8.2h3V4.3c-.52-.07-2.3-.23-4.42-.23-4.18 0-7.04 2.55-7.04 7.23v4.03H2v4.37h3.74V24h4.59v-4.3h3.83l.61-4.37h-4.44v-3.6c0-1.27.35-2.13 2.2-2.13h1.67V8.2Z" fill="currentColor" transform="scale(.82) translate(2.5 0)"/>
    {%- when 'youtube' -%}
      <path d="M21.6 7.2a3 3 0 0 0-2.1-2.13C17.65 4.56 12 4.56 12 4.56s-5.65 0-7.5.51A3 3 0 0 0 2.4 7.2 31.1 31.1 0 0 0 1.9 12c0 1.62.17 3.24.5 4.8a3 3 0 0 0 2.1 2.13c1.85.51 7.5.51 7.5.51s5.65 0 7.5-.51a3 3 0 0 0 2.1-2.13c.33-1.56.5-3.18.5-4.8 0-1.62-.17-3.24-.5-4.8Z" stroke="currentColor" stroke-width="1.7"/>
      <path d="m10 15.2 5.2-3.2L10 8.8v6.4Z" fill="currentColor"/>
    {%- when 'linkedin' -%}
      <rect x="3" y="3" width="18" height="18" rx="2.5" stroke="currentColor" stroke-width="1.7"/>
      <circle cx="8" cy="8" r="1.35" fill="currentColor"/>
      <path d="M6.8 10.5h2.4v7H6.8v-7Zm4 0h2.3v.96h.03c.32-.61 1.1-1.25 2.27-1.25 2.43 0 2.88 1.6 2.88 3.68v3.61h-2.4v-3.2c0-.76-.01-1.75-1.07-1.75-1.07 0-1.23.84-1.23 1.7v3.25h-2.4v-7Z" fill="currentColor"/>
    {%- when 'tiktok' -%}
      <path d="M15.2 3c.33 2.12 1.58 3.57 3.8 3.7v3.02a8.55 8.55 0 0 1-3.77-.92v5.72A5.53 5.53 0 1 1 10.46 9v3.08a2.54 2.54 0 1 0 1.76 2.42V3h2.98Z" fill="currentColor"/>
    {%- when 'pinterest' -%}
      <path d="M12 2.5a9.5 9.5 0 0 0-3.46 18.35c-.08-1.55-.02-3.4.39-5.14l1.22-5.15s-.3-.62-.3-1.53c0-1.44.83-2.51 1.87-2.51.88 0 1.31.66 1.31 1.46 0 .89-.57 2.21-.86 3.44-.24 1.03.52 1.87 1.54 1.87 1.85 0 3.27-1.95 3.27-4.77 0-2.5-1.79-4.24-4.35-4.24-2.97 0-4.71 2.22-4.71 4.52 0 .9.35 1.86.78 2.38.09.1.1.18.07.29l-.29 1.2c-.05.19-.15.23-.35.14-1.3-.61-2.12-2.5-2.12-4.02 0-3.28 2.38-6.29 6.87-6.29 3.61 0 6.41 2.57 6.41 6.01 0 3.59-2.26 6.48-5.4 6.48-1.05 0-2.04-.55-2.38-1.2l-.65 2.46c-.23.9-.87 2.02-1.3 2.7.98.3 2.02.46 3.1.46A9.5 9.5 0 0 0 12 2.5Z" fill="currentColor"/>
    {%- when 'x' -%}
      <path d="M4.2 3h4.3l4.22 5.63L17.7 3h2.1l-6.1 7.17L20.4 21h-4.3l-4.65-6.2L6.1 21H4l6.45-7.75L4.2 3Zm3.2 1.7 9.55 14.6h1.85L9.25 4.7H7.4Z" fill="currentColor"/>
    {%- else -%}
      <circle cx="12" cy="12" r="9" stroke="currentColor" stroke-width="1.8"/>
      <path d="M8 12h8M12 8v8" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/>
  {%- endcase -%}
</svg>
