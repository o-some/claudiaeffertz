{%- unless page.handle == 'vertrag-widerrufen' -%}
  <a class="fi-withdrawal-access" href="/pages/vertrag-widerrufen" rel="nofollow">
    Vertrag widerrufen
  </a>
  <style>
    .fi-withdrawal-access {
      position: fixed;
      right: max(16px, env(safe-area-inset-right));
      bottom: max(16px, env(safe-area-inset-bottom));
      z-index: 45;
      display: inline-flex;
      min-height: 48px;
      align-items: center;
      justify-content: center;
      padding: 12px 20px;
      border: 2px solid #fbf8f0;
      border-radius: 999px;
      background: #142519;
      box-shadow: 0 10px 30px rgba(20, 37, 25, .28);
      color: #fff !important;
      font: 700 15px/1.2 system-ui, sans-serif;
      text-decoration: none;
    }
    .fi-withdrawal-access:hover,
    .fi-withdrawal-access:focus-visible {
      background: #b9912f;
      color: #142519 !important;
      outline: 3px solid #fff;
      outline-offset: 2px;
    }
    @media (max-width: 520px) {
      .fi-withdrawal-access {
        right: 12px;
        bottom: max(12px, env(safe-area-inset-bottom));
        min-height: 44px;
        padding: 10px 16px;
        font-size: 14px;
      }
    }
    @media print {
      .fi-withdrawal-access { display: none; }
    }
  </style>
{%- endunless -%}
