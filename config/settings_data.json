          },
          "markus_education": {
            "type": "timeline_step",
            "settings": {
              "date_label": "Wissen & Handwerk",
              "heading": "Sportwissenschaft und Kochausbildung verbinden Theorie und Praxis",
              "text": "<p>Es folgten das Sportabitur, das Studium der Sportwissenschaften und anschließend – um Theorie und Praxis miteinander zu verbinden – eine Ausbildung zum Koch.</p><p>So entstand die Grundlage, komplexes Ernährungswissen verständlich, genussvoll und alltagstauglich zu vermitteln.</p>",
              "status": "confirmed",
