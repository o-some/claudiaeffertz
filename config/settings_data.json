              "text": "<p>Wie Blutzucker, Insulin, Entzündungen und Stoffwechsel zusammenwirken – klar erklärt statt kompliziert.</p>"
            }
          },
          "point_2": {
            "type": "point",
            "settings": {
              "title": "Einfach erklären können",
              "text": "<p>Typische Ernährungsprobleme erkennen und Menschen unterstützen, ohne sie zu überfordern.</p>"
            }
          },
          "point_3": {
            "type": "point",
            "settings": {
              "title": "Alltagstaugliche Lösungen",
              "text": "<p>Moderne Ernährungsbildung: verständlich, präventiv, praxisorientiert und nah am Menschen.</p>"
            }
          },
          "method_m": {
            "type": "method",
            "settings": {
              "letter": "M",
              "title": "Muskelversorgung",
              "text": "<p>Eiweiß, Nährstoffe und Mahlzeiten, die den Körper wirklich versorgen.</p>"
            }
          },
          "method_g": {
            "type": "method",
            "settings": {
              "letter": "G",
              "title": "Gelenke & Gesundheit",
              "text": "<p>Beweglichkeit, Wohlbefinden und langfristige Stärke im Blick behalten.</p>"
            }
          },
          "method_u": {
            "type": "method",
            "settings": {
              "letter": "U",
              "title": "Umsetzung im Alltag",
              "text": "<p>Routinen und Rezepte, die in ein echtes Leben passen – Tag für Tag.</p>"
            }
          }
        },
