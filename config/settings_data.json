          "markus_foundation": {
            "type": "timeline_step",
            "settings": {
              "date_label": "Gründung",
              "heading": "Food Instructor MGU® entsteht",
              "text": "<p>Vor über 15 Jahren gründete ich Food Instructor MGU®. Ein schwerer Verkehrsunfall meines Zwillingsbruders verstärkte in mir den Wunsch, Menschen auf einfache, ehrliche und alltagstaugliche Weise zu helfen.</p><p>Daraus entstand meine Philosophie: Ernährung neu zu denken – verständlich, genussvoll und nachhaltig.</p>",
              "status": "highlight",
              "status_label": "Gründung",
              "source_name": "",
