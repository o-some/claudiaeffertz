          "markus_insight": {
            "type": "timeline_step",
            "settings": {
            "date_label": "Die Erkenntnis",
              "heading": "Hochwertige Lebensmittel verändern Energie und Wohlbefinden",
              "text": "<p>Während viele Gleichaltrige durch Fast Food körperlich kaum belastbar waren, durfte ich erfahren, wie sehr natürliche und hochwertige Ernährung Energie, Kraft und Gesundheit beeinflusst.</p><p>Aus dieser Erfahrung entstand der Wunsch, den Menschen und seinen Körper besser zu verstehen.</p>",
              "status": "statement",
              "status_label": "Erkenntnis",
              "source_name": "",
              "source_url": "",
